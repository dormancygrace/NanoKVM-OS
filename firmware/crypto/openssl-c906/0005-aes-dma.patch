--- /dev/null
+++ b/crypto/sg2002_cipher.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stdint.h>
+#include <string.h>
+#include <openssl/crypto.h>
+#include "crypto/sg2002.h"
+
+/* Advance just the chosen suffix. GCM uses 32 bits; ordinary CTR uses 128. */
+static void increment(unsigned char *iv, unsigned int bytes, unsigned int blocks)
+{
+    for (unsigned int i = bytes; i != 0 && blocks != 0; --i) {
+        blocks += iv[i-1];
+        iv[i-1] = (unsigned char)blocks;
+        blocks >>= 8;
+    }
+}
+
+size_t ossl_sg2002_cipher(unsigned int algorithm, unsigned int mode, int enc,
+    const unsigned char *key, size_t keylen, unsigned char *iv,
+    unsigned int counter_bytes, const unsigned char *in, unsigned char *out,
+    size_t len, size_t minimum, size_t continuation_minimum)
+{
+    struct sg2002_crypto_request r;
+    unsigned char saved_iv[16];
+    const unsigned int block = 16;
+    size_t done = 0;
+    int fd;
+
+    if (len < minimum || minimum == 0 || minimum > SG2002_CRYPTO_MAX
+        || continuation_minimum < block || continuation_minimum > minimum
+        || algorithm != SG2002_ALG_AES
+        || mode > SG2002_MODE_CTR || keylen > sizeof(r.key)
+        || (mode != SG2002_MODE_ECB && iv == NULL)
+        || (mode == SG2002_MODE_CTR && counter_bytes != 4 && counter_bytes != block))
+        return 0;
+    fd = ossl_sg2002_begin(algorithm);
+    if (fd < 0)
+        return 0;
+    memset(&r, 0, sizeof(r));
+    r.version = SG2002_CRYPTO_ABI;
+    r.algorithm = algorithm;
+    r.mode = mode;
+    r.encrypt = mode == SG2002_MODE_CTR ? 1 : enc != 0;
+    r.key_length = (unsigned int)keylen;
+    memcpy(r.key, key, keylen);
+    /* Only the first submission pays descriptor acquisition. A later RUN
+     * still has a fixed cost, so the caller supplies a separate tail floor. */
+    while (len - done >= (done ? continuation_minimum : minimum)) {
+        size_t chunk = len - done;
+        if (chunk > SG2002_CRYPTO_MAX)
+            chunk = SG2002_CRYPTO_MAX;
+        chunk -= chunk % block;
+        if (mode == SG2002_MODE_CTR) {
+            uint32_t counter = (uint32_t)iv[block-4] << 24
+                | (uint32_t)iv[block-3] << 16 | (uint32_t)iv[block-2] << 8 | iv[block-1];
+            uint64_t remaining = (UINT64_C(1) << 32) - counter;
+            if (chunk / block > remaining)
+                chunk = (size_t)remaining * block;
+        }
+        if (chunk == 0)
+            break;
+        r.length = r.output_length = (unsigned int)chunk;
+        r.input = (uintptr_t)(in + done);
+        r.output = (uintptr_t)(out + done);
+        if (mode != SG2002_MODE_ECB)
+            memcpy(r.iv, iv, block);
+        if (mode == SG2002_MODE_CBC && !enc)
+            memcpy(saved_iv, in + done + chunk - block, block);
+        if (!ossl_sg2002_run(fd, &r))
+            break;
+        if (mode == SG2002_MODE_CBC)
+            memcpy(iv, enc ? out + done + chunk - block : saved_iv, block);
+        else if (mode == SG2002_MODE_CTR)
+            increment(iv + block - counter_bytes, counter_bytes, (unsigned int)(chunk / block));
+        done += chunk;
+    }
+    ossl_sg2002_end(fd);
+    OPENSSL_cleanse(&r, sizeof(r));
+    OPENSSL_cleanse(saved_iv, sizeof(saved_iv));
+    return done;
+}
--- /dev/null
+++ b/providers/implementations/ciphers/cipher_aes_sg2002.inc
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "crypto/sg2002.h"
+#include "cipher_aes_sg2002.h"
+static size_t aes_sg2002_prefix(PROV_CIPHER_CTX *ctx, unsigned int mode,
+    unsigned char *out, const unsigned char *in, size_t len)
+{
+    PROV_AES_CTX *a = (PROV_AES_CTX *)ctx;
+    size_t minimum = mode == SG2002_MODE_CTR
+        ? SG2002_AES_CTR_MIN : SG2002_AES_BLOCK_MIN;
+    if (len < minimum)
+        return 0;
+    return ossl_sg2002_cipher(SG2002_ALG_AES, mode, ctx->enc,
+        a->plat.sg2002.key, ctx->keylen, ctx->iv, 16, in, out, len,
+        minimum, SG2002_AES_CONTINUE_MIN);
+}
+static int cipher_sg2002_aes_cbc(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    const unsigned char *in, size_t len)
+{
+    size_t n = aes_sg2002_prefix(ctx, SG2002_MODE_CBC, out, in, len);
+    return n == len || ossl_cipher_hw_generic_cbc(ctx, out + n, in + n, len - n);
+}
+static int cipher_sg2002_aes_ecb(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    const unsigned char *in, size_t len)
+{
+    size_t n = aes_sg2002_prefix(ctx, SG2002_MODE_ECB, out, in, len);
+    return n == len || ossl_cipher_hw_generic_ecb(ctx, out + n, in + n, len - n);
+}
+static int cipher_sg2002_aes_ctr(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    const unsigned char *in, size_t len)
+{
+    size_t n;
+    if (len == 0) return 1;
+    if (ctx->num >= 16) return ossl_cipher_hw_generic_ctr(ctx, out, in, len);
+    if (ctx->num != 0) {
+        n = 16 - ctx->num;
+        if (n > len) n = len;
+        if (!ossl_cipher_hw_generic_ctr(ctx, out, in, n)) return 0;
+        out += n; in += n; len -= n;
+    }
+    n = aes_sg2002_prefix(ctx, SG2002_MODE_CTR, out, in, len);
+    return n == len || ossl_cipher_hw_generic_ctr(ctx, out + n, in + n, len - n);
+}
+#define cipher_sg2002_aes_ofb128 ossl_cipher_hw_generic_ofb128
+#define cipher_sg2002_aes_cfb128 ossl_cipher_hw_generic_cfb128
+#define cipher_sg2002_aes_cfb1 ossl_cipher_hw_generic_cfb1
+#define cipher_sg2002_aes_cfb8 ossl_cipher_hw_generic_cfb8
+#define AES_GENERIC_CIPHER(mode) cipher_sg2002_aes_##mode
