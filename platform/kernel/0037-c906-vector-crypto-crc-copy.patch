index 000000000..d9ad0c531
--- /dev/null
+++ b/lib/crc/riscv/crc32-xtheadvector-asm.S
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+	.option push
+	.option arch, rv64imac_zicsr_zifencei_xtheadvector
+	.text
+SYM_FUNC_START(__riscv_th_crc_lanes)
+	th.vsetvli zero,a3,e32,m4
+	th.vmv.v.i v0,0
+	th.vid.v v4
+	th.vsll.vi v4,v4,8
+	li t0,256
+.Lcrc_loop:
+	th.vlxbu.v v8,(a0),v4
+	th.vxor.vv v8,v0,v8
+	li t1,255
+	th.vand.vx v8,v8,t1
+	th.vsll.vi v8,v8,2
+	th.vlxwu.v v12,(a1),v8
+	th.vsrl.vi v0,v0,8
+	th.vxor.vv v0,v0,v12
+	th.vadd.vi v4,v4,1
+	addi t0,t0,-1
+	bnez t0,.Lcrc_loop
+	th.vsw.v v0,(a2)
+	ret
+SYM_FUNC_END(__riscv_th_crc_lanes)
+	.option pop
diff --git a/lib/crc/riscv/crc32-xtheadvector.c b/lib/crc/riscv/crc32-xtheadvector.c
new file mode 100644
index 000000000..22036b471
--- /dev/null
+++ b/lib/crc/riscv/crc32-xtheadvector.c
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <asm/xtheadvector_kernel.h>
+#include <linux/types.h>
+#include <linux/minmax.h>
+#include <linux/unaligned.h>
+#include <linux/init.h>
+#include <linux/cache.h>
+#include <asm/simd.h>
+#include <asm/vector.h>
+
+void __init __riscv_th_tables_init(void);
+u32 __riscv_th_crc_scalar(u32, const u8 *, size_t, bool);
+u32 __riscv_th_crc_vector(u32, const u8 *, size_t, bool);
+u32 __riscv_th_crc32(u32, const u8 *, size_t, bool);
+
+struct __riscv_th_crc_tables { u32 slice[8][256], advance[4][256]; };
+static struct __riscv_th_crc_tables tables[2] __ro_after_init;
+bool __riscv_th_crc_ready __ro_after_init;
+extern void __riscv_th_crc_lanes(const u8 *, const u32 *, u32 *, size_t);
+static u32 bytes_crc(u32 crc, const u8 *p, size_t n, const u32 *t)
+{
+	while (n--) crc = t[(crc ^ *p++) & 255] ^ (crc >> 8);
+	return crc;
+}
+void __init __riscv_th_tables_init(void)
+{
+	unsigned int kind, i, j, k;
+	for (kind = 0; kind < 2; kind++) {
+		u32 poly = kind ? 0x82f63b78 : 0xedb88320;
+		struct __riscv_th_crc_tables *t = &tables[kind];
+		for (i = 0; i < 256; i++) {
+			u32 c = i;
+			for (j = 0; j < 8; j++) c = (c >> 1) ^ ((0U - (c & 1)) & poly);
+			t->slice[0][i] = c;
+		}
+		for (k = 1; k < 8; k++) for (i = 0; i < 256; i++) {
+			u32 c = t->slice[k-1][i];
+			t->slice[k][i] = t->slice[0][c & 255] ^ (c >> 8);
+		}
+		for (k = 0; k < 4; k++) for (i = 0; i < 256; i++) {
+			u32 c = i << (8*k);
+			for (j = 0; j < 256; j++) c = t->slice[0][c & 255] ^ (c >> 8);
+			t->advance[k][i] = c;
+		}
+	}
+	__riscv_th_crc_ready = true;
+}
+u32 __riscv_th_crc_scalar(u32 crc, const u8 *p, size_t n, bool kind)
+{
+	const u32 (*t)[256] = tables[kind].slice;
+	while (n >= 8) {
+		crc ^= get_unaligned_le32(p);
+		crc = t[7][crc & 255] ^ t[6][(crc >> 8) & 255] ^
+			t[5][(crc >> 16) & 255] ^ t[4][crc >> 24] ^
+			t[3][p[4]] ^ t[2][p[5]] ^ t[1][p[6]] ^ t[0][p[7]];
+		p += 8; n -= 8;
+	}
+	return bytes_crc(crc, p, n, t[0]);
+}
+u32 __riscv_th_crc_vector(u32 crc, const u8 *p, size_t n, bool kind)
+{
+	const struct __riscv_th_crc_tables *t = &tables[kind];
+	u32 lanes[16] __aligned(16);
+	while (n >= 512) {
+		size_t count = min_t(size_t, n / 256, 16), i;
+		__riscv_th_crc_lanes(p, t->slice[0], lanes, count);
+		for (i = 0; i < count; i++)
+			crc = t->advance[0][crc & 255] ^ t->advance[1][(crc >> 8) & 255] ^
+				t->advance[2][(crc >> 16) & 255] ^ t->advance[3][crc >> 24] ^ lanes[i];
+		p += count * 256; n -= count * 256;
+	}
+	return __riscv_th_crc_scalar(crc, p, n, kind);
+}
+
+u32 __riscv_th_crc32(u32 crc, const u8 *p, size_t n, bool kind)
+{
+	if (xtheadvector_kernel_usable(n, 8192)) {
+		kernel_vector_begin();
+		crc = __riscv_th_crc_vector(crc, p, n, kind);
+		kernel_vector_end();
+		return crc;
+	}
+	return __riscv_th_crc_scalar(crc, p, n, kind);
+}
diff --git a/lib/crc/riscv/crc32.h b/lib/crc/riscv/crc32.h
index 3ec6eee98..4ca151301 100644
--- a/lib/crc/riscv/crc32.h
+++ b/lib/crc/riscv/crc32.h
@@ -10,8 +10,20 @@
 
 #include "crc-clmul.h"
 
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_CRC
+#include <asm/vector.h>
+extern bool __riscv_th_crc_ready;
+void __riscv_th_tables_init(void);
+u32 __riscv_th_crc32(u32, const u8 *, size_t, bool);
+#define crc32_mod_init_arch __riscv_th_tables_init
+#endif
+
 static inline u32 crc32_le_arch(u32 crc, const u8 *p, size_t len)
 {
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_CRC
+	if (__riscv_th_crc_ready && len >= 1024 && has_xtheadvector())
+		return __riscv_th_crc32(crc, p, len, false);
+#endif
 	if (riscv_has_extension_likely(RISCV_ISA_EXT_ZBC))
 		return crc32_lsb_clmul(crc, p, len,
 				       &crc32_lsb_0xedb88320_consts);
@@ -28,6 +40,10 @@ static inline u32 crc32_be_arch(u32 crc, const u8 *p, size_t len)
 
 static inline u32 crc32c_arch(u32 crc, const u8 *p, size_t len)
 {
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_CRC
+	if (__riscv_th_crc_ready && len >= 1024 && has_xtheadvector())
+		return __riscv_th_crc32(crc, p, len, true);
+#endif
 	if (riscv_has_extension_likely(RISCV_ISA_EXT_ZBC))
 		return crc32_lsb_clmul(crc, p, len,
 				       &crc32_lsb_0x82f63b78_consts);
