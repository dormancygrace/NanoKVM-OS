#!/bin/sh
# Internal APK trigger: put the packaged fip.bin (FSBL, OpenSBI, U-Boot) on the
# boot partition. The ROM loads /boot/fip.bin by that name and has no fallback
# copy (docs/BOOT.md), so the name always points at a complete bootloader, the
# old one or the new one:
# 1. the new file is written beside it as fip.new and checked on the card;
# 2. the old one is copied (not renamed) to fip.prev and checked, the copy
#    that recovery puts back;
# 3. fip.new is renamed over fip.bin. FAT rewrites fip.bin's directory entry
#    in place to point at the new clusters, then removes fip.new's. The old
#    clusters are freed when the old file is let go, and sync writes the FAT
#    before the directory: so the old file is held open until the new entry
#    is on the card, and its clusters stay allocated until then.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
payload=/usr/lib/nanokvm/bootloader/fip.bin
optout=/etc/kvm/bootloader-update.disabled
[ -s "$payload" ] || { echo 'Bootloader payload is missing' >&2; exit 1; }
if [ -e "$optout" ]; then
    echo "Bootloader update skipped: $optout exists."
    exit 0
fi
# Serialize with kernel activation and the video memory selection.
mkdir -p /run
exec 9>/run/nanokvm-boot.lock
flock -x 9
mounted=0
previous_saved=0
previous=
mkdir -p /boot
if ! mountpoint -q /boot; then
    mount -t vfat /dev/mmcblk0p1 /boot
    mounted=1
fi
cleanup() {
    result=$?
    trap - EXIT
    # A detected I/O failure is recoverable while Linux is still running.
    # Keep a nonzero status even if restoring the previous FIP succeeds.
    if [ "$result" != 0 ] && [ "$previous_saved" = 1 ]; then
        # The same way back as forward: the file being replaced is held
        # until the entry naming the previous one is on the card. The
        # original stays held (fd 8) until then too.
        if [ "$(oncard /boot/fip.bin)" = "$previous" ] ||
            { exec 7< /boot/fip.bin && mv /boot/fip.prev /boot/fip.bin && sync /boot &&
                exec 7<&- && sync /boot; }; then
            echo 'Bootloader update failed; fip.bin is the previous one.' >&2
        else
            echo 'Bootloader rollback failed; do not reboot before repairing /boot/fip.bin.' >&2
        fi
        exec 7<&- 8<&-
        sync /boot || true
    fi
    if [ "$mounted" = 1 ]; then
        umount /boot || result=1
    fi
    exit "$result"
}
trap cleanup EXIT
awk '$1 == "/dev/mmcblk0p1" && $2 == "/boot" && $3 == "vfat" { found=1 } END { exit !found }' /proc/mounts
[ ! -e /boot/rec ] || { echo 'Recovery is active; bootloader update refused' >&2; exit 1; }
want=$(sha256sum "$payload" | cut -d ' ' -f 1)
# The card's own bytes, not the page cache.
oncard() { dd if="$1" bs=64k iflag=direct 2>/dev/null | sha256sum | cut -d ' ' -f 1; }
if [ -f /boot/fip.bin ] && [ "$(oncard /boot/fip.bin)" = "$want" ]; then
    rm -f /boot/fip.new
    exit 0
fi
rm -f /boot/fip.new
cp "$payload" /boot/fip.new
sync /boot/fip.new
if [ "$(oncard /boot/fip.new)" != "$want" ]; then
    rm -f /boot/fip.new
    echo 'The bootloader written to /boot does not match the package; fip.bin is unchanged.' >&2
    exit 1
fi
if [ -f /boot/fip.bin ]; then
    previous=$(sha256sum < /boot/fip.bin | cut -d ' ' -f 1)
    rm -f /boot/fip.prev
    cp /boot/fip.bin /boot/fip.prev
    sync /boot/fip.prev
    if [ "$(oncard /boot/fip.prev)" != "$previous" ]; then
        rm -f /boot/fip.prev /boot/fip.new
        echo 'The copy of the previous bootloader does not match; fip.bin is unchanged.' >&2
        exit 1
    fi
    previous_saved=1
    exec 8< /boot/fip.bin
fi
mv /boot/fip.new /boot/fip.bin
sync /boot
exec 8<&-
sync /boot
[ "$(oncard /boot/fip.bin)" = "$want" ] || { echo 'Installed bootloader does not match the package.' >&2; exit 1; }
previous_saved=0
printf '%s\n' 'Bootloader updated; reboot to use it.' > /run/reboot-required
printf '%s\n' nanokvm-bootloader >> /run/reboot-required.pkgs
echo "NanoKVM bootloader $want installed; the previous one is /boot/fip.prev; reboot required."
