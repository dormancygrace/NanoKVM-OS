From 3c9fecb0ecb098302bbe5f808d2616020cbbebb4 Mon Sep 17 00:00:00 2001
From: dgrace <g.pesin@globalte.ru>
Date: Mon, 7 Sep 2026 00:06:45 +0300
Subject: [PATCH] mmc: cv1800b: preserve board voltage and frequency limits

---
 arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi | 4 ++++
 drivers/mmc/cv1800b_sdhci.c                       | 5 +++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi b/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi
index b108990a..f3d9ba1e 100644
--- a/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi
+++ b/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi
@@ -4,3 +4,7 @@
 		compatible = "sophgo,cv1800b-sysreset";
 	};
 };
+
+&sdhci0 {
+	max-frequency = <25000000>;
+};
diff --git a/drivers/mmc/cv1800b_sdhci.c b/drivers/mmc/cv1800b_sdhci.c
index 8ff55565..c42b8676 100644
--- a/drivers/mmc/cv1800b_sdhci.c
+++ b/drivers/mmc/cv1800b_sdhci.c
@@ -121,11 +121,12 @@ static int cv1800b_sdhci_probe(struct udevice *dev)
 	host->ops = &cv1800b_sdhci_sd_ops;
 	host->max_clk = MMC_MAX_CLOCK;
 
-	ret = mmc_of_parse(dev, &plat->cfg);
+	ret = sdhci_setup_cfg(&plat->cfg, host, 0, 200000);
 	if (ret)
 		return ret;
 
-	ret = sdhci_setup_cfg(&plat->cfg, host, 0, 200000);
+	/* Apply board limits after the controller advertises its capabilities. */
+	ret = mmc_of_parse(dev, &plat->cfg);
 	if (ret)
 		return ret;
 
-- 
2.43.0

