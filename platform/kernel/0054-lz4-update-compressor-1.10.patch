+ * lz4_compress_110.c. The upstream stream layout remains private.
+ */
+#ifndef LZ4_110_MEMORY_USAGE
+#define LZ4_110_MEMORY_USAGE 14
+#endif
+#define LZ4_110_HASHLOG (LZ4_110_MEMORY_USAGE - 2)
+#define LZ4_110_HASHTABLESIZE (1 << LZ4_110_MEMORY_USAGE)
+#define LZ4_110_HASH_SIZE_U32 (1 << LZ4_110_HASHLOG)
+#define LZ4_ACCELERATION_MAX 65537
+#define LZ4_DISTANCE_MAX 65535
+#define LZ4_FORCE_MEMORY_ACCESS 1
+#define LZ4_FAST_DEC_LOOP 0
+#define LZ4_ALIGN_TEST 1
+#define LZ4_FORCE_INLINE static __always_inline
+#define LZ4_FORCE_O2
+#define LZ4_STATIC_ASSERT(c) static_assert(c)
+#define DEBUGLOG(...) do { } while (0)
+#define assert(c) do { } while (0)
