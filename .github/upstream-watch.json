      "lock_entry": "json-c",
      "pull_request": {
        "id": "json-c",
        "mode": "git-pin"
      }
    },
    {
      "name": "miniz",
      "path": "platform/sources.lock",
      "pattern": "^miniz\\s+\\S+\\s+([0-9a-f]{40})",
