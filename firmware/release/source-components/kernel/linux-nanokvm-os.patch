 #include <linux/mfd/core.h>
+#include <linux/mfd/syscon.h>
+#include <linux/reboot.h>
+#include <linux/regmap.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/property.h>
 
+/* Warm-reset sequence from the Sophgo CV181x BSP cvi-reboot driver. */
+#define RTC_CTRL0_UNLOCKKEY	0x0004
+#define RTC_CTRL0		0x0008
+#define RTC_32K_READ_SELECT	0x103c
+#define RTC_EN_WARM_RST_REQ	0x10cc
+#define RTC_RSM_STATE		0x10d4
+#define RTC_STATE_ON		0x3
+
+static int cv1800_rtcsys_restart(struct sys_off_data *data)
+{
+	struct regmap *map = data->cb_data;
+	unsigned int val;
+	int ret;
+
+	ret = regmap_write(map, RTC_32K_READ_SELECT, 1);
+	if (ret)
+		goto failed;
+	ret = regmap_write(map, RTC_CTRL0_UNLOCKKEY, 0xab18);
+	if (ret)
+		goto failed;
+	ret = regmap_write(map, RTC_EN_WARM_RST_REQ, 1);
+	if (ret)
+		goto failed;
+	ret = regmap_read_poll_timeout_atomic(map, RTC_EN_WARM_RST_REQ,
+					     val, val == 1, 10, 100000);
+	if (ret)
+		goto failed;
+	ret = regmap_read_poll_timeout_atomic(map, RTC_RSM_STATE,
+					     val, val == RTC_STATE_ON, 10, 100000);
+	if (ret)
+		goto failed;
+	ret = regmap_write(map, RTC_CTRL0, 0xffff0810);
+	if (!ret)
+		return NOTIFY_DONE;
+failed:
+	dev_err(data->dev, "warm reset failed: %d\n", ret);
+	return notifier_from_errno(ret);
+}
+
 static struct resource cv1800_rtcsys_irq_resources[] = {
 	DEFINE_RES_IRQ_NAMED(0, "alarm"),
 };
