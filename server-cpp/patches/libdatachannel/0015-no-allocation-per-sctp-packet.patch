+
+message_ptr Transport::spareMessage(const byte *data, size_t size) {
+	message_ptr message;
+	{
+		std::lock_guard lock(mSpareMutex);
+		if (mSpareCount)
+			message = std::move(mSpare[--mSpareCount]);
+	}
+	if (!message)
+		return make_message(data, data + size);
+	message->assign(data, data + size);
+	message->type = Message::Binary;
+	message->stream = 0;
+	message->dscp = 0;
+	message->reliability.reset();
+	message->frameInfo.reset();
+	return message;
+}
+
+void Transport::keepSpare(message_vector &messages) noexcept {
+	// Called from the burst send, which must not throw: moving a pointer into a slot allocates nothing. A
+	// message that finds no slot, or that something else still holds, is simply let go.
+	std::unique_lock lock(mSpareMutex, std::try_to_lock);
+	if (!lock.owns_lock())
+		return;
+	for (auto &m : messages)
+		if (m && m.use_count() == 1 && mSpareCount < maxSpare)
+			mSpare[mSpareCount++] = std::move(m);
 }
 
