 	int ds = int(messages.front()->dscp << 2);
-	return juice_send_batch(mAgent.get(), data.data(), sizes.data(), int(data.size()), ds) >= 0;
+	// juice_send_batch returns how many datagrams the socket took, which can be fewer than were given: after its
+	// bounded wait for a full socket buffer the rest is dropped. Only here is that number known, so the datagrams
+	// not sent are counted here, and a batch sent in part is not a success. The accepted ones are on their way and
+	// are not given again.
+	int sent = juice_send_batch(mAgent.get(), data.data(), sizes.data(), int(data.size()), ds);
+	size_t accepted = sent > 0 ? size_t(sent) : 0;
+	if (accepted < data.size()) {
+		unsentMediaDatagrams += data.size() - accepted;
+		return false;
+	}
+	return true;
 }
 
