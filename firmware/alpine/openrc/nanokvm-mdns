#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
description="NanoKVM mDNS preference"
# avahi-daemon needs D-Bus and starts it itself: with mDNS off neither runs.
depend() { use nanokvm-board net; after nanokvm-network; }
start() {
    [ ! -e /etc/kvm/mdns_disabled ] || return 0
    rc-service avahi-daemon start
}
stop() { rc-service avahi-daemon stop; }
