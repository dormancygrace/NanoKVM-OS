+bool DtlsSrtpTransport::sendMediaBatch(message_vector &messages) {
+	if (!mProtector) {
+		bool ret = false;
+		for (auto &m : messages)
+			ret = sendMedia(std::move(m));
+		return ret;
+	}
+	std::vector<message_ptr> rtp;
+	bool ret = false;
+	{
+		std::lock_guard lock(sendMutex);
+		if (!mInitDone) {
+			PLOG_ERROR << "SRTP media sent before keys are derived";
+			return false;
+		}
+		std::vector<std::byte *> data;
+		std::vector<size_t> sizes;
+		for (auto &m : messages) {
+			if (!m || IsRtcp(*m))
+				continue;
+			size_t size = m->size();
+			auto copy = make_message(size + SrtpProtectorRoom, m);
+			copy->dscp = m->dscp ? m->dscp : 36;
+			data.push_back(copy->data());
+			sizes.push_back(size);
+			rtp.push_back(std::move(copy));
+		}
+		if (!rtp.empty()) {
+			if (!mProtector->protect(data.data(), sizes.data(), rtp.size()))
+				throw std::runtime_error("SRTP frame protect error");
+			for (size_t i = 0; i < rtp.size(); ++i)
+				rtp[i]->resize(sizes[i]);
+		}
+	}
+	if (!rtp.empty())
+		ret = Transport::outgoingBatch(rtp); // bypass DTLS DSCP marking
+	for (auto &m : messages)
+		if (m && IsRtcp(*m))
+			ret = sendMedia(std::move(m));
+	return ret;
+}
