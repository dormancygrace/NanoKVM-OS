From 5d939490da65e0013cc24055ed8f1b1219c06f55 Mon Sep 17 00:00:00 2001
From: dgrace <g.pesin@globalte.ru>
Date: Sat, 5 Sep 2026 18:30:49 +0300
Subject: [PATCH] Preserve full unsigned 64-bit range when reading ISP JSON

---
 modules/isp/cv181x/isp_bin/src/cvi_json_struct_comm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/modules/isp/cv181x/isp_bin/src/cvi_json_struct_comm.c b/modules/isp/cv181x/isp_bin/src/cvi_json_struct_comm.c
index f7d1019..3104cb3 100644
--- a/modules/isp/cv181x/isp_bin/src/cvi_json_struct_comm.c
+++ b/modules/isp/cv181x/isp_bin/src/cvi_json_struct_comm.c
@@ -311,7 +311,7 @@ void CVI_U64_JSON(int r_w_flag, JSON *j, char *key, CVI_U64 *value)
 				return;
 			}
 			temp = cvi_json_object_get_uint64(obj);
-			JSON_CHECK_RANGE_OF_U64(key, &temp, 0, CVI_U32_MAX);
+			JSON_CHECK_RANGE_OF_U64(key, &temp, 0, CVI_U64_MAX);
 			*value = temp;
 		} else {
 			JSON_PRINT_ERR_NOT_EXIST(key);
-- 
