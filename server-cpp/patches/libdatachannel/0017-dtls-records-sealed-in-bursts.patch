+namespace {
+
+constexpr size_t RecordHeader = 13, ExplicitNonce = 8, GcmTag = 16;
+constexpr unsigned int UnsealedRecord = 0xFFFFFFFF; // Message::stream of a record built here, still to be sealed
+
+uint64_t loadBe48(const uint8_t *p) {
+	uint64_t v = 0;
+	for (int i = 0; i < 6; i++)
+		v = (v << 8) | p[i];
+	return v;
+}
+
+void storeBe48(uint8_t *p, uint64_t v) {
+	for (int i = 5; i >= 0; i--, v >>= 8)
+		p[i] = uint8_t(v);
+}
+
+// AES-128-GCM in software, in place: the fallback, and the proof of the derived keys.
+bool gcm128(bool encrypt, const uint8_t *key, const uint8_t *nonce, const uint8_t *aad, size_t aadLength,
+            uint8_t *data, size_t length, uint8_t *tag) {
+	EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+	if (!ctx)
+		return false;
+	int n = 0;
+	bool ok = (encrypt ? EVP_EncryptInit_ex(ctx, EVP_aes_128_gcm(), nullptr, key, nonce)
+	                   : EVP_DecryptInit_ex(ctx, EVP_aes_128_gcm(), nullptr, key, nonce)) == 1;
+	ok = ok && (encrypt ? EVP_EncryptUpdate(ctx, nullptr, &n, aad, int(aadLength))
+	                    : EVP_DecryptUpdate(ctx, nullptr, &n, aad, int(aadLength))) == 1;
+	ok = ok && (encrypt ? EVP_EncryptUpdate(ctx, data, &n, data, int(length))
+	                    : EVP_DecryptUpdate(ctx, data, &n, data, int(length))) == 1;
+	if (ok && !encrypt)
+		ok = EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, int(GcmTag), tag) == 1;
+	ok = ok && (encrypt ? EVP_EncryptFinal_ex(ctx, data + n, &n) : EVP_DecryptFinal_ex(ctx, data + n, &n)) == 1;
+	if (ok && encrypt)
+		ok = EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_GET_TAG, int(GcmTag), tag) == 1;
+	EVP_CIPHER_CTX_free(ctx);
+	return ok;
+}
+
