#!/bin/sh
# Sipeed's offline update entry point. Its /root/old is the stock updater's
# own backup. Restore that application before checking/staging the migration,
# so a refused migration leaves a working stock web interface.
set -eu
case "${1:-}" in start|restart) ;; stop) exit 0 ;; *) exit 2 ;; esac
package=/root/.nanokvm-stock-package
[ ! -e "$package" ] || { echo "$package already exists" >&2; exit 1; }
[ -f /root/old/server/NanoKVM-Server ] && [ -x /root/old/system/init.d/S95nanokvm ] || {
    echo 'Stock updater backup /root/old is missing; installation stopped.' >&2; exit 1;
}
mv /kvmapp "$package"
if ! mv /root/old /kvmapp; then
    mv "$package" /kvmapp
    exit 1
fi
# A detached controller survives the stock server's restart and SSH/browser
# disconnects. Its log is bounded to this one invocation.
nohup sh "$package/migration/offline-run.sh" > /var/log/nanokvm-stock-install.log 2>&1 </dev/null &
