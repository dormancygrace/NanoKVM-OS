+int
+lws_http_server_pause_body(struct lws *wsi, int pause)
+{
+	if (!wsi || !lwsi_role_server(wsi))
+		return 1;
+	if (wsi->http.rx_body_paused == !!pause)
+		return 0;
+	if (wsi->mux_substream) {
+#if defined(LWS_ROLE_H2)
+		if (!lwsi_role_h2(lws_get_network_wsi(wsi)))
+			return 1;
+		if (pause) {
+			if (wsi->mux_stream_immortal)
+				return 1;
+			/* Keeps the shared connection alive; closing the stream also
+			 * releases this reference if the client resets it first. */
+			lws_mux_mark_immortal(wsi);
+		} else {
+			lws_http_close_immortal(wsi);
+			if (lws_h2_resume_body_window(wsi))
+				return 1;
+		}
+#else
+		return 1;
+#endif
+	} else {
+		if (lws_rx_flow_control(wsi, pause ? 0 :
+					LWS_RXFLOW_REASON_APPLIES_ENABLE |
+					LWS_RXFLOW_REASON_USER_BOOL |
+					LWS_RXFLOW_REASON_FLAG_PROCESS_NOW))
+			return 1;
+		if (pause)
+			lws_set_timeout(wsi, NO_PENDING_TIMEOUT, 0);
+	}
+
+	wsi->http.rx_body_paused = !!pause;
+	if (!pause && !wsi->http.rx_body_done) {
+		wsi->http.rx_body_start = lws_wsi_now(wsi);
+		wsi->http.rx_body_count = 0;
+		lws_http_body_timeout_arm(wsi);
+	}
+
+	return 0;
+}
