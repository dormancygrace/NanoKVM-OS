+/* Keep the CVITEK carveout ABI, but lend unused pages to Linux through CMA.
+ * The bitmap tracks ION ownership only. Free runs are reclaimable upper
+ * bounds: migration can fail or take time, so they are not reservations. */
+bool ion_carveout_cma_state(struct ion_heap *heap, u64 *total, u64 *free,
+			   u64 *largest)
+{
+#ifdef CONFIG_DMA_CMA
+	struct ion_carveout_heap *h = container_of(heap, struct ion_carveout_heap, heap);
+	unsigned long start = 0, end, available = 0, maximum = 0;
+	unsigned long flags;
+
+	if (!h->cma)
+		return false;
+	spin_lock_irqsave(&h->bitmap_lock, flags);
+	while (start < h->nr_pages) {
+		start = find_next_zero_bit(h->allocated, h->nr_pages, start);
+		if (start == h->nr_pages)
+			break;
+		end = find_next_bit(h->allocated, h->nr_pages, start);
+		available += end - start;
+		maximum = max(maximum, end - start);
+		start = end;
+	}
+	spin_unlock_irqrestore(&h->bitmap_lock, flags);
+	*total += (u64)h->nr_pages << PAGE_SHIFT;
+	*free += (u64)available << PAGE_SHIFT;
+	*largest = max(*largest, (u64)maximum << PAGE_SHIFT);
+	return true;
+#else
+	return false;
+#endif
+}
 
