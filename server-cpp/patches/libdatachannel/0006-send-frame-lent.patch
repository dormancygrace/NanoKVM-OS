+
+	// The frame's bytes when Track::sendFrame(const byte *, size_t, FrameInfo) lends them for the duration of the
+	// call; the message itself is then empty.
+	const byte *borrowedData = nullptr;
+	size_t borrowedSize = 0;
 };
 
