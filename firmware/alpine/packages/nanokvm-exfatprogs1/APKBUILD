pkgname=nanokvm-exfatprogs1
pkgver=${PKGVER:-0.1.0}
pkgrel=${PKGREL:-0}
pkgdesc="exFAT tools (exfatprogs), built for the C906"
url="https://github.com/exfatprogs/exfatprogs"
arch="riscv64"
license="GPL-2.0-or-later"
# In place of Alpine's exfatprogs from the community repository, so that
# nanokvm-release needs nothing from it: installing this package removes it,
# and a dependency on exfatprogs is satisfied by this one.
provides="exfatprogs=$pkgver-r100"
# mkfs.exfat probes devices with libblkid; the programs link it and musl.
depends="libblkid"
replaces="nanokvm-exfatprogs exfatprogs"
provider_priority=100
source="$pkgname-$pkgver.tar.gz"
# Programs from build.sh (tools step), built with the image's toolchain.
options="!check !strip !tracedeps"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
