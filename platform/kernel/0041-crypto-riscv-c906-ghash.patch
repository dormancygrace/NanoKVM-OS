diff --git a/lib/crypto/riscv/gf128hash.h b/lib/crypto/riscv/gf128hash.h
index 4301a0384..39a780533 100644
--- a/lib/crypto/riscv/gf128hash.h
+++ b/lib/crypto/riscv/gf128hash.h
@@ -5,16 +5,104 @@
  * Copyright (C) 2023 VRULL GmbH
  * Copyright (C) 2023 SiFive, Inc.
  * Copyright 2026 Google LLC
+ *
+ * T-Head C906 backend: NanoKVM OS.
  */
 
 #include <asm/simd.h>
 #include <asm/vector.h>
+#include <linux/linkage.h>
+
+/* Zvkg under the same conditions as before the C906 backend. */
+#if defined(CONFIG_TOOLCHAIN_HAS_VECTOR_CRYPTO) && \
+	defined(CONFIG_RISCV_EFFICIENT_VECTOR_UNALIGNED_ACCESS)
+#define GHASH_RISCV_ZVKG
+#endif
 
+#ifdef GHASH_RISCV_ZVKG
 static __ro_after_init DEFINE_STATIC_KEY_FALSE(have_zvkg);
 
 asmlinkage void ghash_zvkg(u8 accumulator[GHASH_BLOCK_SIZE],
 			   const u8 key[GHASH_BLOCK_SIZE],
 			   const u8 *data, size_t nblocks);
+#endif
+
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+static __ro_after_init DEFINE_STATIC_KEY_FALSE(have_c906);
+static __ro_after_init DEFINE_STATIC_KEY_FALSE(have_c906_vector);
+
+/*
+ * Multiply operands are kept below 2^32, where the C906 multiplier is fast
+ * and its timing does not depend on the data. The scalar function uses no
+ * vector state; the five-block one runs four blocks in XTheadVector lanes and
+ * the fifth in scalar registers, and needs kernel_vector_begin().
+ */
+asmlinkage void ghash_blocks_c906(struct polyval_elem *acc, const u64 kp[40],
+				  const u8 *data, size_t nblocks);
+asmlinkage void ghash_blocks_c906_v(struct polyval_elem *acc, const u64 kp[112],
+				    const u8 *data, size_t ngroups);
+
+#define GHASH_C906_GROUP	5
+
+/*
+ * The key operands of the assembly, see ghash-riscv64-c906.S: 32-bit operands
+ * of H (scalar words) and of H^5 to H^2 (lane l holds H^(5-l)), each split
+ * into its four hole classes.
+ */
+static void ghash_c906_preparekey(u64 kp[112], const struct polyval_elem *h)
+{
+	static const u64 holes[4] = {
+		0x1111111111111111ULL, 0x2222222222222222ULL,
+		0x4444444444444444ULL, 0x8888888888888888ULL,
+	};
+	struct polyval_elem pw[6];
+	u32 *lanes = (u32 *)&kp[40];
+	int p, r, j, l;
+
+	pw[1] = *h;
+	for (p = 2; p <= 5; p++) {
+		pw[p] = pw[p - 1];
+		polyval_mul_generic(&pw[p], h);
+	}
+	for (j = 0; j < 4; j++)
+		kp[j] = holes[j];
+	for (p = 0; p < 3; p++) {
+		for (l = 0; l <= 4; l++) {
+			/* l = 4: H for the scalar words; l = 0..3: H^(5-l) in lane l. */
+			const struct polyval_elem *x = &pw[l == 4 ? 1 : 5 - l];
+			u64 lo = le64_to_cpu(x->lo), hi = le64_to_cpu(x->hi);
+			u64 part = p == 0 ? lo : p == 1 ? hi : lo ^ hi;
+			u64 ops[3] = { (u32)part, part >> 32, (u32)part ^ (part >> 32) };
+
+			for (r = 0; r < 3; r++)
+				for (j = 0; j < 4; j++) {
+					if (l == 4)
+						kp[4 + 4 * (3 * p + r) + j] = ops[r] & holes[j];
+					else
+						lanes[16 * (3 * p + r) + 4 * j + l] =
+							ops[r] & (u32)holes[j];
+				}
+		}
+	}
+	memzero_explicit(pw, sizeof(pw));
+}
+
+static void ghash_blocks_c906_any(struct polyval_elem *acc, const u64 kp[112],
+				  const u8 *data, size_t nblocks)
+{
+	if (static_branch_likely(&have_c906_vector) &&
+	    nblocks >= GHASH_C906_GROUP && likely(may_use_simd())) {
+		size_t groups = nblocks / GHASH_C906_GROUP;
+
+		kernel_vector_begin();
+		ghash_blocks_c906_v(acc, kp, data, groups);
+		kernel_vector_end();
+		data += groups * GHASH_C906_GROUP * GHASH_BLOCK_SIZE;
+		nblocks -= groups * GHASH_C906_GROUP;
+	}
+	ghash_blocks_c906(acc, kp, data, nblocks);	/* nblocks may be 0 */
+}
+#endif
 
 #define ghash_preparekey_arch ghash_preparekey_arch
 static void ghash_preparekey_arch(struct ghash_key *key,
@@ -25,6 +113,10 @@ static void ghash_preparekey_arch(struct ghash_key *key,
 
 	/* Save key in GHASH format for zvkg */
 	memcpy(key->h_raw, raw_key, GHASH_BLOCK_SIZE);
+
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	ghash_c906_preparekey(key->c906_kp, &key->h);
+#endif
 }
 
 #define ghash_blocks_arch ghash_blocks_arch
@@ -32,6 +124,7 @@ static void ghash_blocks_arch(struct polyval_elem *acc,
 			      const struct ghash_key *key,
 			      const u8 *data, size_t nblocks)
 {
+#ifdef GHASH_RISCV_ZVKG
 	if (static_branch_likely(&have_zvkg) && likely(may_use_simd())) {
 		u8 ghash_acc[GHASH_BLOCK_SIZE];
 
@@ -43,15 +136,36 @@ static void ghash_blocks_arch(struct polyval_elem *acc,
 
 		ghash_acc_to_polyval(ghash_acc, acc);
 		memzero_explicit(ghash_acc, sizeof(ghash_acc));
-	} else {
-		ghash_blocks_generic(acc, &key->h, data, nblocks);
+		return;
+	}
+#endif
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	if (static_branch_likely(&have_c906)) {
+		ghash_blocks_c906_any(acc, key->c906_kp, data, nblocks);
+		return;
 	}
+#endif
+	ghash_blocks_generic(acc, &key->h, data, nblocks);
 }
 
 #define gf128hash_mod_init_arch gf128hash_mod_init_arch
 static void gf128hash_mod_init_arch(void)
 {
+#ifdef GHASH_RISCV_ZVKG
 	if (riscv_isa_extension_available(NULL, ZVKG) &&
 	    riscv_vector_vlen() >= 128)
 		static_branch_enable(&have_zvkg);
+#endif
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	/*
+	 * XTheadVector stands for a T-Head core here (C906, C910, C920): all
+	 * of them implement XTheadBb, whose th.rev the assembly uses. The
+	 * vector function sets vl to 4 and needs VLEN >= 128.
+	 */
+	if (has_xtheadvector()) {
+		static_branch_enable(&have_c906);
+		if (riscv_vector_vlen() >= 128)
+			static_branch_enable(&have_c906_vector);
+	}
+#endif
 }
