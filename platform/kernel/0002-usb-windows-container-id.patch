+/* Shared with an external display to associate a Windows digitizer. */
+static ssize_t os_desc_container_id_show(struct config_item *item, char *page)
+{
+	struct gadget_info *gi = os_desc_item_to_gadget_info(item);
+	ssize_t ret;
+
+	mutex_lock(&gi->lock);
+	ret = sysfs_emit(page, "%pUl\n", gi->cdev.os_container_id);
+	mutex_unlock(&gi->lock);
+	return ret;
+}
+
+static ssize_t os_desc_container_id_store(struct config_item *item,
+		const char *page, size_t len)
+{
+	struct gadget_info *gi = os_desc_item_to_gadget_info(item);
+	guid_t id;
+	int ret;
+
+	if (len != UUID_STRING_LEN &&
+	    (len != UUID_STRING_LEN + 1 || page[UUID_STRING_LEN] != '\n'))
+		return -EINVAL;
+	ret = guid_parse(page, &id);
+	if (ret)
+		return ret;
+	mutex_lock(&gi->lock);
+	if (gi->composite.gadget_driver.udc_name) {
+		mutex_unlock(&gi->lock);
+		return -EBUSY;
+	}
+	memcpy(gi->cdev.os_container_id, &id, sizeof(id));
+	mutex_unlock(&gi->lock);
+	return len;
+}
+
