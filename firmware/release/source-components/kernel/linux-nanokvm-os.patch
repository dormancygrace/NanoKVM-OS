 	spin_unlock_irqrestore(&hsotg->lock, flags);
 }
 
+/* Remote wakeup for the non-power-down mode used by CV18xx/SG2002. */
+static int dwc2_hsotg_wakeup(struct usb_gadget *gadget)
+{
+	struct dwc2_hsotg *hsotg = to_hsotg(gadget);
+	unsigned long flags;
+	u32 pcgctl;
+	int ret = -EAGAIN;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	if (!hsotg->remote_wakeup_allowed) {
+		ret = -EACCES;
+		goto out;
+	}
+	/* Other power modes require their complete register restore sequence. */
+	if (hsotg->params.power_down != DWC2_POWER_DOWN_PARAM_NONE) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (hsotg->lx_state != DWC2_L2 || !dwc2_is_device_mode(hsotg))
+		goto out;
+
+	if (hsotg->bus_suspended) {
+		pcgctl = dwc2_readl(hsotg, PCGCTL);
+		pcgctl &= ~PCGCTL_GATEHCLK;
+		dwc2_writel(hsotg, pcgctl, PCGCTL);
+		udelay(5);
+		pcgctl &= ~PCGCTL_STOPPCLK;
+		dwc2_writel(hsotg, pcgctl, PCGCTL);
+		udelay(5);
+		hsotg->bus_suspended = false;
+	}
+
+	/* USB 2.0 resume signaling must last between 1 and 15 ms. */
+	dwc2_set_bit(hsotg, DCTL, DCTL_RMTWKUPSIG);
+	mdelay(10);
+	dwc2_clear_bit(hsotg, DCTL, DCTL_RMTWKUPSIG);
+	call_gadget(hsotg, resume);
+	hsotg->lx_state = DWC2_L0;
+	ret = 0;
+out:
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+	return ret;
+}
+
 static const struct usb_gadget_ops dwc2_hsotg_gadget_ops = {
+	.wakeup			= dwc2_hsotg_wakeup,
 	.get_frame	= dwc2_hsotg_gadget_getframe,
 	.set_selfpowered	= dwc2_hsotg_set_selfpowered,
 	.udc_start		= dwc2_hsotg_udc_start,
