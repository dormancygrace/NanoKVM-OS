--- a/aic8800_fdrv/rwnx_rx.c
+++ b/aic8800_fdrv/rwnx_rx.c
@@ -2265,6 +2265,11 @@
 	if (hw_rxhdr->flags_upload)
 		status |= RX_STAT_FORWARD;
 
+#ifndef CONFIG_RWNX_MON_DATA
+	if (status & RX_STAT_MONITOR)
+		status &= ~RX_STAT_FORWARD;
