+/* Output: our own buffer written with write(2), not wide stdio. It is
+ * flushed when full and before waiting for input, so a partial line or a
+ * slow producer (tail -f) shows at once. */
+static unsigned char obuf[1 << 16];
+static size_t olen;
+
+static void out_flush(void)
+{
+    size_t done = 0;
+    while (done < olen) {
+        ssize_t n = write(STDOUT_FILENO, obuf + done, olen - done);
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            exit(1);
+        }
+        done += n;
+    }
+    olen = 0;
+}
+
+static void out_bytes(const void *p, size_t n)
+{
+    if (olen + n > sizeof(obuf))
+        out_flush();
+    memcpy(obuf + olen, p, n);
+    olen += n;
+}
+
+#define out_lit(s) out_bytes(s, sizeof(s) - 1)
+
+static void out_fmt(const char *fmt, ...)
+{
+    char tmp[64];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(tmp, sizeof(tmp), fmt, ap);
+    va_end(ap);
+    if (n > 0)
+        out_bytes(tmp, MIN((size_t)n, sizeof(tmp) - 1));
+}
+
+/* The 256-colour escapes, foreground and background, made once. */
+static char esc256[2][256][12];
+static unsigned char esc256len[2][256];
+
+static void out_256(int invert, unsigned char code)
+{
+    out_bytes(esc256[invert][code], esc256len[invert][code]);
+}
+
+/* Input: bytes read with read(2), decoded as UTF-8 here. A character's own
+ * bytes are copied to the output, so a malformed sequence passes through
+ * unchanged (as U+FFFD for the width) instead of ending the input. */
+struct reader {
+    int fd, eof, err;
+    size_t pos, len;
+    unsigned char buf[1 << 16];
+};
+
+static int reader_peek(struct reader *r)
+{
+    if (r->pos == r->len) {
+        if (r->eof)
+            return -1;
+        out_flush();
+        ssize_t n;
+        do {
+            n = read(r->fd, r->buf, sizeof(r->buf));
+        } while (n < 0 && errno == EINTR);
+        if (n <= 0) {
+            r->eof = 1;
+            if (n < 0)
+                r->err = errno;
+            return -1;
+        }
+        r->pos = 0;
+        r->len = n;
+    }
+    return r->buf[r->pos];
+}
+
+static wint_t reader_char(struct reader *r, unsigned char raw[4], int *rawlen)
+{
+    int b = reader_peek(r);
+    if (b < 0)
+        return WEOF;
+    r->pos++;
+    raw[0] = b;
+    *rawlen = 1;
+    if (b < 0x80)
+        return b;
+    int more = b >= 0xc2 && b <= 0xdf ? 1 : b >= 0xe0 && b <= 0xef ? 2 : b >= 0xf0 && b <= 0xf4 ? 3 : -1;
+    if (more < 0)
+        return 0xfffd;
+    wint_t c = b & (0x3f >> more);
+    for (int k = 0; k < more; k++) {
+        int n = reader_peek(r);
+        if (n < 0x80 || n > 0xbf)
+            return 0xfffd;
+        r->pos++;
+        raw[(*rawlen)++] = n;
+        c = c << 6 | (n & 0x3f);
+    }
+    return c;
+}
