+namespace {
+
+struct Burst {
+	int depth = 0;
+	Transport *owner = nullptr;
+	message_vector messages;
+};
+
+thread_local Burst tBurst;
+
+// A burst is cut here: the largest batch the UDP send takes in one call is bounded anyway (UDP_SEGMENT), and a
+// longer wait would only delay the first packets.
+constexpr size_t maxBurst = 32;
+
+} // namespace
+
+Transport::BurstScope::BurstScope() { ++tBurst.depth; }
+
+Transport::BurstScope::~BurstScope() {
+	if (--tBurst.depth == 0)
+		Transport::flushBurst();
+}
+
+bool Transport::collectBurst(message_ptr &message) {
+	if (tBurst.depth == 0 || !message)
+		return false;
+	if (tBurst.owner && tBurst.owner != this)
+		flushBurst();
+	tBurst.owner = this;
+	tBurst.messages.push_back(std::move(message));
+	if (tBurst.messages.size() >= maxBurst)
+		flushBurst();
+	return true;
+}
+
+void Transport::flushBurst() noexcept {
+	Transport *owner = std::exchange(tBurst.owner, nullptr);
+	if (!owner || tBurst.messages.empty())
+		return;
+	message_vector messages;
+	messages.swap(tBurst.messages);
+	try {
+		owner->outgoingBatch(messages);
+	} catch (const std::exception &e) {
+		PLOG_WARNING << "Burst send: " << e.what();
+	}
+	messages.clear();
+	if (tBurst.messages.empty())
+		tBurst.messages.swap(messages); // keeps the capacity for the next burst
+}
+
 bool Transport::outgoingBatch(message_vector &messages) {
 	if (mLower)
 		return mLower->sendBatch(messages);
