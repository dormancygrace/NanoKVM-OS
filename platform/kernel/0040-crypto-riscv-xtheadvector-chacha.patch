+{
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	if (static_branch_likely(&use_xtheadvector) &&
+	    bytes >= CHACHA_XTHEADVECTOR_MIN_BYTES && crypto_simd_usable())
+		return chacha_crypt_xtheadvector(state, dst, src, bytes, nrounds);
+#endif
+#ifdef CHACHA_RISCV_ZVKB
+	if (static_branch_likely(&use_zvkb) && crypto_simd_usable())
+		return chacha_crypt_zvkb(state, dst, src, bytes, nrounds);
+#endif
+	chacha_crypt_generic(state, dst, src, bytes, nrounds);
+}
 
