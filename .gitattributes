# Unified diff context and mail signatures contain intentional whitespace.
# Validate applied source whitespace separately; preserve patch syntax.
*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Preserve byte-exact device transcripts and generated evidence tables.
firmware/alpine/evidence/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
firmware/alpine/evidence/**/*.tsv -text whitespace=-blank-at-eol,-blank-at-eof
firmware/alpine/evidence/**/APKINDEX -text whitespace=-blank-at-eol,-blank-at-eof
