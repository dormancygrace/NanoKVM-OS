#!/bin/sh

# Keep DHCP-installed default routes consistent with the management-uplink
# preference after every DHCP bound/renew.
# Alpine's udhcpc script runs this from /etc/udhcpc/post-bound/ and
# post-renew/ without arguments: the event is the directory name then.
ACTION="${1:-$(basename "$(dirname "$0")")}"
ACTION="${ACTION#post-}"
PREFERENCE_FILE=/etc/kvm/network/gateway.preferred
UDHCPC_CONF=/etc/udhcpc/udhcpc.conf

[ "$ACTION" = bound ] || [ "$ACTION" = renew ] || exit 0

# Alpine sources this file without exporting NO_GATEWAY to its post hooks.
# Read the same policy before adding any preferred default route.
[ ! -f "$UDHCPC_CONF" ] || . "$UDHCPC_CONF"
for excluded in $NO_GATEWAY; do
    [ "$excluded" = "$interface" ] && exit 0
done

preference=$(cat "$PREFERENCE_FILE" 2>/dev/null)
case "$preference:$interface" in
    ethernet:eth*) metric=10 ;;
    wifi:wlan*) metric=10 ;;
    ethernet:wlan*|wifi:eth*) metric=200 ;;
    *) exit 0 ;;
esac

# RFC3442: when option 121 is present, ignore option 3 entirely, even if
# option 121 contains no default route. Match Alpine's zero-gateway filter.
gateways=
if [ -n "$staticroutes" ]; then
    set -- $staticroutes
    while [ "$#" -ge 2 ]; do
        if [ "$1" = "0.0.0.0/0" ] && [ "$2" != "0.0.0.0" ]; then
            gateways="$gateways $2"
        fi
        shift 2
    done
else
    gateways="$router"
fi

# The metric is part of a route's identity: replace adds this route next to
# the one udhcpc installed with its own metric, which then goes.
for gateway in $gateways; do
    ip -4 route replace default via "$gateway" dev "$interface" proto dhcp metric "$metric"
    ip -4 route show default via "$gateway" dev "$interface" | while read -r line; do
        old=$(printf '%s\n' "$line" | sed -n 's/.* metric \([0-9][0-9]*\).*/\1/p')
        [ "${old:-0}" = "$metric" ] || ip -4 route del default via "$gateway" dev "$interface" metric "${old:-0}"
    done
    metric=$((metric + 1))
done
