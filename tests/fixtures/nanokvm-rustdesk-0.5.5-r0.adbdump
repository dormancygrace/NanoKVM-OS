scripts:
  pre-deinstall: |
    #!/bin/sh
    set -eu
    [ -f /run/openrc/softlevel ] || exit 0
    if rc-service nanokvm-rustdesk status >/dev/null 2>&1; then
        rc-service nanokvm-rustdesk stop
    fi
    rc-update del nanokvm-rustdesk default >/dev/null 2>&1 || true
    # /etc/nanokvm-rustdesk is user state and is preserved by apk del.
  pre-upgrade: |
    #!/bin/sh
    set -eu
    [ -f /run/openrc/softlevel ] || exit 0
    if rc-service nanokvm-rustdesk status >/dev/null 2>&1; then
        mkdir -p /run/nanokvm-rustdesk
        touch /run/nanokvm-rustdesk/restart-after-upgrade
        rc-service nanokvm-rustdesk stop
    fi
  post-upgrade: |
    #!/bin/sh
    set -eu
    [ -f /run/openrc/softlevel ] || exit 0
    if [ -f /run/nanokvm-rustdesk/restart-after-upgrade ]; then
        rm -f /run/nanokvm-rustdesk/restart-after-upgrade
        rc-service nanokvm-rustdesk start
    fi
