+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef OSSL_NANOKVM_AES_HWCRYPTO_H
+#define OSSL_NANOKVM_AES_HWCRYPTO_H
+/* Wall-clock break-even with the shared descriptor (stand, openssl speed -elapsed). */
+#define HWCRYPTO_AES_BLOCK_MIN 512
+#define HWCRYPTO_AES_CTR_MIN 512
+#define HWCRYPTO_AES_CONTINUE_MIN 512
+/* The longest RUN of the AES modes: the driver's buffers (64 KiB). One RUN of
+ * 64 KiB takes half the time of sixteen of 4 KiB. */
+#define HWCRYPTO_AES_RUN_MAX 65536
+/* GCM updates from here go to HWCRYPTO_GCM, where the driver hashes while
+ * the engine encrypts. Measured with the application stopped, AES-256,
+ * encrypt / decrypt: with 4096 a record of 2048 bytes takes 54 / 50 us and
+ * one of 3072 bytes 69 / 66; with 2048 they take 69 / 67 and 83 / 78; with
+ * 8192 a record of 4096 bytes takes 95 / 103 us against 99 / 91. */
+#define HWCRYPTO_AES_GCM_MIN 4096
+#endif
