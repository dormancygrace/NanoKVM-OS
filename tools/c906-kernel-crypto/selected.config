CONFIG_RISCV_ISA_XTHEADVECTOR_CHACHA=y
CONFIG_RISCV_ISA_XTHEADVECTOR_CRC=y
CONFIG_RISCV_ISA_XTHEADVECTOR_COPY_CSUM=y
