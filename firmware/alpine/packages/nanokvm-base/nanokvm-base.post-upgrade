#!/bin/sh
# Retire the earlier package-owned wildcard flowtable before enabling
# interface-scoped USB sharing. Never flush foreign nftables policy.
if [ -x /usr/libexec/nanokvm/legacy/S35flowoffload ]; then
    /usr/libexec/nanokvm/legacy/S35flowoffload start ||
        echo "Could not retire the legacy NanoKVM flowtable; check the policy service." >&2
fi
set -eu
if [ -x /usr/libexec/nanokvm/console-policy ]; then
    /usr/libexec/nanokvm/console-policy
fi
# Alpine's standard loopback service is needed by local applications.
rc-update add loopback boot
# D-Bus serves only avahi, which starts it when mDNS is on (nanokvm-mdns).
# A running D-Bus keeps running until the next boot.
if [ -e /etc/runlevels/default/dbus ] && [ -x /etc/init.d/nanokvm-mdns ] &&
    ! grep -q 'need dbus' /etc/init.d/nanokvm-mdns; then
    rc-update del dbus default
fi

# fstab /boot noauto: nanokvm-storage mounts the boot and data partitions
# itself, checking a volume left dirty by a power loss; localmount would mount
# them before that. Only the two NanoKVM entries change.
nanokvm_fstab_entry='($1 == "/dev/mmcblk0p1" && $2 == "/boot" || $1 == "/dev/mmcblk0p3" && $2 == "/data") && $4 !~ /(^|,)noauto(,|$)/'
if [ -f /etc/fstab ] && awk "$nanokvm_fstab_entry { found = 1 } END { exit !found }" /etc/fstab; then
    awk "$nanokvm_fstab_entry"' { $4 = "noauto," $4 } { print }' \
        /etc/fstab > /etc/.fstab.nanokvm && mv /etc/.fstab.nanokvm /etc/fstab
fi
unset nanokvm_fstab_entry
# fstab end
if [ -x /etc/init.d/nanokvm-usb-internet ]; then
    rc-update add nanokvm-usb-internet default
    if [ -e /run/openrc/softlevel ] && rc-service nanokvm-usb status >/dev/null 2>&1; then
        rc-service nanokvm-usb-internet reload || echo "USB uplink watcher could not follow the current USB composition." >&2
    fi
fi
if [ -e /run/openrc/softlevel ] && ! rc-service loopback status >/dev/null 2>&1; then
    rc-service loopback start
fi

# The live system log stays in RAM: syslogd writes /run/log/messages (up to
# 512 KiB, one rotated file) and the server archives the new lines to the SD
# card once a minute (/var/log/nanokvm-boots, docs/LOGS.md). Only the Alpine
# default is replaced; the generated file, edited or not, and any other
# setting stay as they are.
syslog_conf=/etc/conf.d/syslog
syslog_marker='# NanoKVM: the live system log in RAM'
syslog_changed=no
if [ ! -e "$syslog_conf" ] || [ "$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$syslog_conf")" = 'SYSLOGD_OPTS="-t"' ]; then
    mkdir -p "$(dirname "$syslog_conf")"
    printf '%s\n%s\n%s\n' "$syslog_marker" 'mkdir -p /run/log' \
        'SYSLOGD_OPTS="-t -O /run/log/messages -s 512 -b 1"' > "$syslog_conf"
    syslog_changed=yes
fi
# Move a running syslog to the RAM log, then remove the card copies it wrote.
if [ "$syslog_changed" = yes ]; then
    if [ -e /run/openrc/softlevel ] && rc-service syslog status >/dev/null 2>&1; then
        mkdir -p /run/log
        rc-service syslog restart >/dev/null 2>&1 || echo "syslog could not restart; it writes the RAM log after the next boot." >&2
    fi
    if [ ! -e /run/openrc/softlevel ] || [ -e /run/log/messages ]; then
        rm -f /var/log/messages /var/log/messages.0 /var/log/messages.1
    fi
fi
unset syslog_conf syslog_marker syslog_changed

tmpfs_entry='tmpfs /tmp tmpfs rw,nosuid,nodev,mode=1777,size=64M 0 0'
if ! grep -qE '^[^#]+[[:space:]]+/tmp[[:space:]]' /etc/fstab 2>/dev/null; then
    printf '%s\n' "$tmpfs_entry" >> /etc/fstab
fi
unset tmpfs_entry

# Move the legacy package greeting to the interactive profile script. Do not
# replace a MOTD that differs from the two texts managed by NanoKVM/Alpine.
if [ ! -s /etc/motd ] || grep -qx 'Welcome to Alpine!' /etc/motd || \
   [ "$(cat /etc/motd)" = 'Welcome to NanoKVM OS!

Manage your device through its web interface.
System and package updates are available through apk.' ]; then
    : > /etc/motd
fi

# Remove only the one-line root profile generated by older NanoKVM app init
# scripts. A custom profile must continue to override the system prompt.
legacy_root_profile='export PS1="\u@\h:\w# "'
if [ -f /root/.profile ] && [ "$(cat /root/.profile)" = "$legacy_root_profile" ]; then
    rm -f /root/.profile
fi
unset legacy_root_profile
