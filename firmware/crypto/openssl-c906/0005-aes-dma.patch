+++ b/providers/implementations/ciphers/cipher_aes_gcm_sg2002.inc
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stddef.h>
+#include <stdint.h>
+#include "crypto/sg2002.h"
+#include "cipher_aes_sg2002.h"
+static void aes_sg2002_gcm_ctr(const unsigned char *in, unsigned char *out,
+    size_t blocks, const void *key, const unsigned char ivec[16])
+{
+    const PROV_AES_GCM_CTX *a = (const PROV_AES_GCM_CTX *)
+        ((const unsigned char *)key - offsetof(PROV_AES_GCM_CTX, ks.ks));
+    unsigned char iv[16], stream[16];
+    size_t n = 0;
+    memcpy(iv, ivec, sizeof(iv));
+    if (blocks >= SG2002_AES_CTR_MIN / 16)
+        n = ossl_sg2002_cipher(SG2002_ALG_AES, SG2002_MODE_CTR, 1,
+        a->plat.sg2002.key, a->base.keylen, iv, 4, in, out, blocks * 16,
+        SG2002_AES_CTR_MIN, SG2002_AES_CONTINUE_MIN);
+    in += n; out += n; blocks -= n / 16;
+    while (blocks-- != 0) {
+        AES_encrypt(iv, stream, key);
+        for (unsigned int j = 0; j < 16; ++j) out[j] = in[j] ^ stream[j];
+        for (unsigned int j = 16; j > 12; --j) if (++iv[j-1]) break;
+        in += 16; out += 16;
+    }
+    OPENSSL_cleanse(stream, sizeof(stream));
+    OPENSSL_cleanse(iv, sizeof(iv));
+}
