From 3c9fecb0ecb098302bbe5f808d2616020cbbebb4 Mon Sep 17 00:00:00 2001
From: Gleb Pesin <dormancygrace@gmail.com>
Date: Mon, 7 Sep 2026 00:06:45 +0300
Subject: [PATCH] mmc: cv1800b: preserve board voltage and frequency limits

---
 drivers/mmc/cv1800b_sdhci.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

--- a/drivers/mmc/cv1800b_sdhci.c
+++ b/drivers/mmc/cv1800b_sdhci.c
@@ -124,11 +124,12 @@
 	if (dev_read_bool(dev, "no-1-8-v"))
 		host->quirks |= SDHCI_QUIRK_NO_1_8_V;
 
-	ret = mmc_of_parse(dev, &plat->cfg);
+	ret = sdhci_setup_cfg(&plat->cfg, host, 0, 200000);
 	if (ret)
 		return ret;
 
-	ret = sdhci_setup_cfg(&plat->cfg, host, 0, 200000);
+	/* Apply board limits after the controller advertises its capabilities. */
+	ret = mmc_of_parse(dev, &plat->cfg);
 	if (ret)
 		return ret;
 
