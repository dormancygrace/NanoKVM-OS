From: Gleb Pesin <dormancygrace@gmail.com>
Subject: Media buffers without a zero fill before the copy

make_message(size, orig) and RtpPacketizer::packetize value-initialized their buffers (a memset of the whole
packet) and then copied over them. The buffer is now built from the copied bytes; only the bytes that
nothing copies (the RTP header, the SRTP room) are zeroed.
---
diff --git a/src/message.cpp b/src/message.cpp
index 0ce3256..5f9d177 100644
--- a/src/message.cpp
+++ b/src/message.cpp
@@ -34,8 +34,12 @@ message_ptr make_message(size_t size, message_ptr orig) {
 	if (!orig)
 		return nullptr;
 
-	auto message = std::make_shared<Message>(size, orig->type);
-	std::copy(orig->begin(), orig->begin() + std::min(size, orig->size()), message->begin());
+	// Copied, then only the rest zeroed: a value-initialized buffer would be zeroed whole and overwritten.
+	binary data;
+	data.reserve(size);
+	data.assign(orig->begin(), orig->begin() + std::min(size, orig->size()));
+	data.resize(size);
+	auto message = std::make_shared<Message>(std::move(data), orig->type);
 	message->stream = orig->stream;
 	message->reliability = orig->reliability;
 	message->frameInfo = orig->frameInfo;
diff --git a/src/rtppacketizer.cpp b/src/rtppacketizer.cpp
index 4a15e83..193c716 100644
--- a/src/rtppacketizer.cpp
+++ b/src/rtppacketizer.cpp
@@ -82,7 +82,12 @@ message_ptr RtpPacketizer::packetize(const binary &payload, bool mark) {
 	// according to RFC 3550, sec. 5.3.1.
 	rtpExtHeaderSize = (rtpExtHeaderSize + 3) & ~3;
 
-	auto message = make_message(RtpHeaderSize + rtpExtHeaderSize + payload.size());
+	// The header zeroed, the payload appended: not the whole packet zeroed and then overwritten.
+	binary data;
+	data.reserve(RtpHeaderSize + rtpExtHeaderSize + payload.size());
+	data.resize(RtpHeaderSize + rtpExtHeaderSize);
+	data.insert(data.end(), payload.begin(), payload.end());
+	auto message = make_message(std::move(data));
 	auto *rtp = (RtpHeader *)message->data();
 	rtp->setPayloadType(rtpConfig->payloadType);
 	rtp->setSeqNumber(rtpConfig->sequenceNumber++); // increase sequence number
@@ -157,8 +162,6 @@ message_ptr RtpPacketizer::packetize(const binary &payload, bool mark) {
 
 	rtp->preparePacket();
 
-	std::memcpy(message->data() + RtpHeaderSize + rtpExtHeaderSize, payload.data(), payload.size());
-
 	return message;
 }
 
