+/*
+ * Hash the original kernel pages. A mapped iterator callback cannot hand its
+ * temporary kmap_local address to an asynchronous provider. Extract page
+ * references instead, wait for completion, then release only the SG metadata.
+ * The request owns the pages throughout; user iterators are not accepted here.
+ */
+static int smb3_cmac_digest(struct crypto_ahash *tfm, struct smb_rqst *rqst,
+			   size_t headlen, size_t total, u8 *signature)
+{
+	struct ahash_request *req = NULL;
+	struct iov_iter headers, data = rqst->rq_iter;
+	struct sg_table sgt = {};
+	DECLARE_CRYPTO_WAIT(wait);
+	size_t datalen = iov_iter_count(&data);
+	unsigned int num_sgs, data_sgs;
+	ssize_t extracted;
+	int rc;
+
+	if (datalen && iov_iter_extract_will_pin(&data))
+		return -EIO;
+
+	iov_iter_kvec(&headers, ITER_SOURCE, rqst->rq_iov, rqst->rq_nvec, headlen);
+	num_sgs = iov_iter_npages(&headers, INT_MAX);
+	data_sgs = datalen ? iov_iter_npages(&data, INT_MAX) : 0;
+	if (check_add_overflow(num_sgs, data_sgs, &num_sgs) || !num_sgs)
+		return -EOVERFLOW;
+	sgt.sgl = kvmalloc_array(num_sgs, sizeof(*sgt.sgl), GFP_NOFS);
+	if (!sgt.sgl)
+		return -ENOMEM;
+	sg_init_table(sgt.sgl, num_sgs);
+	extracted = extract_iter_to_sg(&headers, headlen, &sgt, num_sgs, 0);
+	if (extracted < 0 || extracted != headlen) {
+		rc = extracted < 0 ? extracted : -EIO;
+		goto out;
+	}
+	if (datalen) {
+		extracted = extract_iter_to_sg(&data, datalen, &sgt,
+					      num_sgs - sgt.nents, 0);
+		if (extracted < 0 || extracted != datalen) {
+			rc = extracted < 0 ? extracted : -EIO;
+			goto out;
+		}
+	}
+	sg_mark_end(&sgt.sgl[sgt.nents - 1]);
+	req = ahash_request_alloc(tfm, GFP_NOFS);
+	if (!req) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	ahash_request_set_callback(req, CRYPTO_TFM_REQ_MAY_SLEEP |
+				  CRYPTO_TFM_REQ_MAY_BACKLOG, crypto_req_done, &wait);
+	ahash_request_set_crypt(req, sgt.sgl, signature, total);
+	rc = crypto_wait_req(crypto_ahash_digest(req), &wait);
+out:
+	ahash_request_free(req);
+	kvfree(sgt.sgl);
+	return rc;
+}
+
 static int
 smb3_calc_signature(struct smb_rqst *rqst, struct TCP_Server_Info *server)
 {
+	struct smb2_hdr *shdr;
