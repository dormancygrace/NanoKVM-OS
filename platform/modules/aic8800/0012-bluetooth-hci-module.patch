 #include "aic_priv_cmd.h"
@@ -6384,12 +6384,8 @@ int rwnx_cfg80211_init(struct rwnx_plat *rwnx_plat, void **platform_data)
 	AICWFDBG(LOGINFO, "New interface create %s \r\n", vif->ndev->name);
 
 #ifdef CONFIG_SDIO_BT
-#if CONFIG_BLUEDROID
-	btchr_init();
-	hdev_init();
-#else
-	btsdio_init();
-#endif
+	/* aic8800_btsdio, when loaded, registers hci0 through this. */
+	aicwf_bt_platform_up(rwnx_hw);
 #endif
 
 #ifdef  CONFIG_USE_P2P0
@@ -6518,12 +6514,7 @@ void rwnx_cfg80211_deinit(struct rwnx_hw *rwnx_hw)
 	rwnx_hw->fwlog_en = 0;
 
 #ifdef CONFIG_SDIO_BT
-#if CONFIG_BLUEDROID
-	btchr_exit();
-	hdev_exit();
-#else
-	btsdio_remove();
-#endif
+	aicwf_bt_platform_down();
 #endif
 
 	flush_workqueue(rwnx_hw->apmStaloss_wq);
