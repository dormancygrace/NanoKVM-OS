+    memset((void *)(uintptr_t)ctrl.stMem.u64VirAddr, 0, ctrl.stMem.u32Size);
+    /* Poll during probe, before any user opens the device. Kernel-owned
+     * scratch memory must never be passed through copy_to_user(). */
+    ret = ive_st_candi_corner(ndev, &src, &dst, &ctrl, CVI_TRUE, false);
+    if (ret != CVI_SUCCESS) {
+        /* Stop the engine before releasing its scratch buffers. */
+        cvi_ive_reset(ndev, 0);
+        ret = -EIO;
+    }
+    sys_ion_free(ctrl.stMem.u64PhyAddr);
+free_dst:
+    sys_ion_free(dst.u64PhyAddr[0]);
+free_src:
+    sys_ion_free(src.u64PhyAddr[0]);
+    return ret;
 }
 
