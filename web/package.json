    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.7.2",
    "axios": "1.21.1",
    "clsx": "2.1.1",
    "i18next": "27.2.6",
    "jotai": "3.0.2",
    "lucide-react": "1.78.0",
    "mediabunny": "1.66.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-draggable": "4.7.2",
    "react-error-boundary": "6.1.6",
    "react-i18next": "18.0.3",
    "react-markdown": "10.1.0",
