From d68198d9252660a651e9c512ee47c7a33f6b26df Mon Sep 17 00:00:00 2001
From: Gleb Pesin <dormancygrace@gmail.com>
Date: Sat, 5 Sep 2026 17:48:51 +0300
Subject: [PATCH] Support GCC 16 and fix GDC buffer-wrap result lifetime

---
 include/linux/cvi_defines.h | 2 +-
 modules/gdc/src/cvi_gdc.c   | 7 +++++--
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/include/linux/cvi_defines.h b/include/linux/cvi_defines.h
index de72c86..0f34d02 100644
--- a/include/linux/cvi_defines.h
+++ b/include/linux/cvi_defines.h
@@ -16,7 +16,7 @@ extern "C" {
 #endif
 #endif /* __cplusplus */
 
-#ifndef __CV180X__
+#if !defined(__CV180X__) && !defined(__CV181X__)
 	#define __CV180X__
 #endif
 
diff --git a/modules/gdc/src/cvi_gdc.c b/modules/gdc/src/cvi_gdc.c
index 10217cc..6b46ef2 100644
--- a/modules/gdc/src/cvi_gdc.c
+++ b/modules/gdc/src/cvi_gdc.c
@@ -330,6 +330,9 @@ CVI_S32 CVI_GDC_GetBufWrapAttr(GDC_HANDLE hHandle, const GDC_TASK_ATTR_S *pstTas
 	struct vdev *d;
 	CVI_S32 s32Ret;
 
+	MOD_CHECK_NULL_PTR(CVI_ID_GDC, pstTask);
+	MOD_CHECK_NULL_PTR(CVI_ID_GDC, pstBufWrap);
+
 	d = get_dev_info(VDEV_TYPE_DWA, 0);
 	if (!IS_VDEV_OPEN(d->state)) {
 		CVI_TRACE_GDC(CVI_DBG_ERR, "gdc state(%d) incorrect.", d->state);
@@ -348,11 +351,11 @@ CVI_S32 CVI_GDC_GetBufWrapAttr(GDC_HANDLE hHandle, const GDC_TASK_ATTR_S *pstTas
 
 	s32Ret = gdc_get_chn_buf_wrap(d->fd, cfg);
 
-	free(cfg);
-
 	if (s32Ret == CVI_SUCCESS)
 		memcpy(pstBufWrap, &cfg->stBufWrap, sizeof(*pstBufWrap));
 
+	free(cfg);
+
 	return s32Ret;
 }
 
-- 
2.43.0

