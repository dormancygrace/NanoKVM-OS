#!/bin/sh
# Optional shared CryptoDMA owner. cryptodev (/dev/crypto) stays installed
# but is not loaded: nothing in the system uses it (`modprobe cryptodev`).
case "$1" in
    start|restart)
        if [ ! -e /etc/kvm/disable_hardware_aes ] && [ ! -d /sys/module/sg2002_aes_probe ]; then
            if [ -f "/lib/modules/$(uname -r)/extra/sg2002_aes_probe.ko" ]; then
                modprobe sg2002_aes_probe || echo 'SG2002 CryptoDMA unavailable; application fallback remains available' >&2
            fi
        fi
        ;;
    stop)
        # Active sessions or uncertain DMA ownership may pin the module.
        # Shutdown must never force-unload the shared owner.
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
exit 0
