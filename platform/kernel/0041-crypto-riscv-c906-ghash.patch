 lib/crypto/Kconfig                    |   1 +
 lib/crypto/Makefile                   |   7 +-
 lib/crypto/riscv/gf128hash.h          |  73 ++++-
 lib/crypto/riscv/ghash-riscv64-c906.S | 558 ++++++++++++++++++++++++++++++++++
 5 files changed, 640 insertions(+), 3 deletions(-)

