pkgname=nanokvm-i2c-tools
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="Compatibility package for Alpine I2C tools"
url="https://github.com/dormancygrace/NanoKVM-OS"
arch="riscv64"
license="GPL-3.0-only"
# Older rollback clients require this concrete name in the signed OS index.
# Explicit world selections keep the commands from Alpine community.
depends="i2c-tools"
options="!check !strip !tracedeps"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
}
