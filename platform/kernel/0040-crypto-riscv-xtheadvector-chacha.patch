From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] crypto: riscv - XTheadVector ChaCha for the T-Head C906

ChaCha for lib/crypto on cores with XTheadVector (RVV 0.7.1, VLEN >= 128),
such as the C906 of the SG2002. Five 64-byte blocks per group: four in vector
lanes (SEW 32, LMUL 1), the fifth in scalar registers, their instructions
interleaved, as in the NanoKVM OS Go kernel. Vector instructions are .4byte
words generated and checked by firmware/cpu/go-crypto-c906/gen_chacha_linux.py,
so the toolchain needs no XTheadVector support.

CRYPTO_LIB_CHACHA_ARCH now also defaults to y with RISCV_ISA_XTHEADVECTOR; the
Zvkb backend keeps its previous conditions. Messages shorter than 129 bytes
stay generic. Requires the xtheadvector status fixes (0032, 0034, 0035).

diff --git a/lib/crypto/Kconfig b/lib/crypto/Kconfig
index 83d4c95..9d8ba6f 100644
--- a/lib/crypto/Kconfig
+++ b/lib/crypto/Kconfig
@@ -82,6 +82,7 @@ config CRYPTO_LIB_CHACHA_ARCH
 	default y if PPC64 && CPU_LITTLE_ENDIAN && VSX
 	default y if RISCV && 64BIT && TOOLCHAIN_HAS_VECTOR_CRYPTO && \
 		     RISCV_EFFICIENT_VECTOR_UNALIGNED_ACCESS
+	default y if RISCV && 64BIT && RISCV_ISA_XTHEADVECTOR
 	default y if S390
 	default y if X86_64
 
diff --git a/lib/crypto/Makefile b/lib/crypto/Makefile
index f1e9bf8..59ce240 100644
--- a/lib/crypto/Makefile
+++ b/lib/crypto/Makefile
@@ -114,7 +114,12 @@ AFLAGS_mips/chacha-core.o += -O2 # needed to fill branch delay slots
 endif
 
 libchacha-$(CONFIG_PPC) += powerpc/chacha-p10le-8x.o
-libchacha-$(CONFIG_RISCV) += riscv/chacha-riscv64-zvkb.o
+ifeq ($(CONFIG_RISCV),y)
+ifeq ($(CONFIG_TOOLCHAIN_HAS_VECTOR_CRYPTO)$(CONFIG_RISCV_EFFICIENT_VECTOR_UNALIGNED_ACCESS),yy)
+libchacha-y += riscv/chacha-riscv64-zvkb.o
+endif
+libchacha-$(CONFIG_RISCV_ISA_XTHEADVECTOR) += riscv/chacha-riscv64-xtheadvector.o
+endif
 libchacha-$(CONFIG_S390) += s390/chacha-s390.o
 libchacha-$(CONFIG_X86) += x86/chacha-ssse3-x86_64.o \
 			   x86/chacha-avx2-x86_64.o \
