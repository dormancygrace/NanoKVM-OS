 lib/crypto/Kconfig                    |    1 +
 lib/crypto/Makefile                   |    7 +-
 lib/crypto/riscv/gf128hash.h          |  118 +-
 lib/crypto/riscv/ghash-riscv64-c906.S | 1978 +++++++++++++++++++++++++++++++++
 5 files changed, 2108 insertions(+), 3 deletions(-)

