+namespace {
+
+// The transports that took records on this thread since its outermost scope was opened.
+struct Burst {
+	int depth = 0;
+	std::vector<Transport *> owners;
+};
+
+thread_local Burst tBurst;
+
+// A burst goes to the layer below this many records at a time: the largest batch the UDP send takes in one call is
+// bounded anyway (UDP_SEGMENT).
+constexpr size_t maxBurst = 32;
+// From the first time the socket did not take everything, a batch has this long. It is an absolute time: every
+// later call is made only before it, and is told how long it may still wait for the socket.
+constexpr auto burstRetry = std::chrono::seconds(1);
+
+} // namespace
+
+Transport::BurstScope::BurstScope() { ++tBurst.depth; }
+
+Transport::BurstScope::~BurstScope() {
+	if (--tBurst.depth == 0)
+		Transport::flushBurst();
+}
+
+bool Transport::collectBurst(message_ptr &message) {
+	if (tBurst.depth == 0) {
+		// No scope on this thread (usrsctp's timer thread: a retransmission, a heartbeat). The record leaves at
+		// once only if nothing of this transport is queued or being sent: it then takes the sender's place
+		// until endDirectBurst(), so nothing made after it can leave before it. Otherwise it goes behind the
+		// records made before it, and may leave with them: the thread that is sending takes it, or the scope
+		// that queued them does when it ends.
+		std::lock_guard lock(mBurstMutex);
+		if (mBurstQueue.empty() && !mBurstSending) {
+			mBurstSending = true;
+			return false;
+		}
+		mBurstQueue.push_back(std::move(message));
+		mBurstReady = mBurstQueue.size();
+		return true;
+	}
+	// Always taken while a scope is open, however many there are already, and never sent from here: the caller
+	// may hold the SCTP and SSL locks, where a send could wait for the socket. The record goes to the end of
+	// this transport's queue at once, so the queue has the records of all threads in the order they were made.
+	bool known = false;
+	for (Transport *owner : tBurst.owners)
+		known = known || owner == this;
+	if (!known)
+		tBurst.owners.push_back(this);
+	std::lock_guard lock(mBurstMutex);
+	mBurstQueue.push_back(std::move(message));
+	return true;
+}
+
+bool Transport::endDirectBurst() noexcept {
+	// The record sent outside a scope has left. Records queued behind it meanwhile were left to this thread as
+	// the sender (true): the caller, which may hold the SSL lock, has another thread call continueBurst().
+	std::lock_guard lock(mBurstMutex);
+	if (mBurstReady == 0)
+		mBurstSending = false;
+	return mBurstSending;
+}
+
+void Transport::continueBurst() noexcept { sendBurst(true); }
+
+void Transport::flushBurst() noexcept {
+	// No lock of the caller is held here. The list is emptied first: a transport is named in it once.
+	for (size_t i = 0; i < tBurst.owners.size(); ++i)
+		tBurst.owners[i]->sendBurst();
+	tBurst.owners.clear();
+}
+
+void Transport::sendBurst(bool sender) noexcept {
+	// A scope has ended: what the queue holds now may leave, the records other threads put before this thread's
+	// included (they are older). What comes later waits for the end of a scope again, so that a thread still
+	// making records has them sent together, not one by one as they appear.
+	// One thread at a time sends, from the front of the queue, so the records leave in the queue's order
+	// whichever threads made them. A thread that finds another one sending leaves its records to it: that one
+	// looks again before it stops. The batch keeps its capacity from burst to burst.
+	thread_local message_vector batch;
+	{
+		std::lock_guard lock(mBurstMutex);
+		if (sender) {
+			// Taking over from a record sent outside a scope (endDirectBurst).
+			if (!takeBurst(batch)) {
+				mBurstSending = false;
+				return;
+			}
+		} else {
+			mBurstReady = mBurstQueue.size();
+			if (mBurstSending || !takeBurst(batch))
+				return;
+			mBurstSending = true;
+		}
+	}
+	// The time the socket has to take what it refused. It is one for everything this thread sends here: records
+	// queued while a batch waited are not given a second of their own behind it.
+	std::chrono::steady_clock::time_point giveUp{};
+	for (;;) {
+		sendBurstBatch(batch, giveUp);
+		batch.clear();
+		std::lock_guard lock(mBurstMutex);
+		if (!takeBurst(batch)) {
+			mBurstSending = false;
+			return;
+		}
+	}
