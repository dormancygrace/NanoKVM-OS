Subject: [PATCH] riscv: use native C906 loads for unaligned usercopy

Replace shifted-word reconstruction with native misaligned scalar loads.
Preserve the existing short and aligned paths byte-for-byte, including their
addresses, and retry faulting copies bytewise for an exact accessible prefix.

--- a/arch/riscv/lib/uaccess.S
+++ b/arch/riscv/lib/uaccess.S
@@ -103,7 +103,7 @@
 	 */
 	/* a1 - start of src */
 	andi	a3, a1, SZREG-1
-	bnez	a3, .Lshift_copy
+	bnez	a3, .Lnative_copy
 #endif
 .Lword_copy:
         /*
@@ -115,22 +115,22 @@
 	 */
 	addi	t0, t0, -(8*SZREG) /* not to over run */
 2:
-	fixup REG_L   a4,        0(a1), 10f
-	fixup REG_L   a5,    SZREG(a1), 10f
-	fixup REG_L   a6,  2*SZREG(a1), 10f
-	fixup REG_L   a7,  3*SZREG(a1), 10f
-	fixup REG_L   t1,  4*SZREG(a1), 10f
-	fixup REG_L   t2,  5*SZREG(a1), 10f
-	fixup REG_L   t3,  6*SZREG(a1), 10f
-	fixup REG_L   t4,  7*SZREG(a1), 10f
-	fixup REG_S   a4,        0(a0), 10f
-	fixup REG_S   a5,    SZREG(a0), 10f
-	fixup REG_S   a6,  2*SZREG(a0), 10f
-	fixup REG_S   a7,  3*SZREG(a0), 10f
-	fixup REG_S   t1,  4*SZREG(a0), 10f
-	fixup REG_S   t2,  5*SZREG(a0), 10f
-	fixup REG_S   t3,  6*SZREG(a0), 10f
-	fixup REG_S   t4,  7*SZREG(a0), 10f
+	fixup REG_L   a4,        0(a1), .Lbulk_fault
+	fixup REG_L   a5,    SZREG(a1), .Lbulk_fault
+	fixup REG_L   a6,  2*SZREG(a1), .Lbulk_fault
+	fixup REG_L   a7,  3*SZREG(a1), .Lbulk_fault
+	fixup REG_L   t1,  4*SZREG(a1), .Lbulk_fault
+	fixup REG_L   t2,  5*SZREG(a1), .Lbulk_fault
+	fixup REG_L   t3,  6*SZREG(a1), .Lbulk_fault
+	fixup REG_L   t4,  7*SZREG(a1), .Lbulk_fault
+	fixup REG_S   a4,        0(a0), .Lbulk_fault
+	fixup REG_S   a5,    SZREG(a0), .Lbulk_fault
+	fixup REG_S   a6,  2*SZREG(a0), .Lbulk_fault
+	fixup REG_S   a7,  3*SZREG(a0), .Lbulk_fault
+	fixup REG_S   t1,  4*SZREG(a0), .Lbulk_fault
+	fixup REG_S   t2,  5*SZREG(a0), .Lbulk_fault
+	fixup REG_S   t3,  6*SZREG(a0), .Lbulk_fault
+	fixup REG_S   t4,  7*SZREG(a0), .Lbulk_fault
 	addi	a0, a0, 8*SZREG
 	addi	a1, a1, 8*SZREG
 	bleu	a0, t0, 2b
@@ -138,61 +138,35 @@
 	addi	t0, t0, 8*SZREG /* revert to original value */
 	j	.Lbyte_copy_tail
 
-#if !defined(CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS)
-.Lshift_copy:
-
-	/*
-	 * Word copy with shifting.
-	 * For misaligned copy we still perform aligned word copy, but
-	 * we need to use the value fetched from the previous iteration and
-	 * do some shifts.
-	 * This is safe because reading is less than a word size.
-	 *
-	 * a0 - start of aligned dst
-	 * a1 - start of src
-	 * a3 - a1 & mask:(SZREG-1)
-	 * t0 - end of uncopied dst
-	 * t1 - end of aligned dst
-	 */
-	/* calculating aligned word boundary for dst */
-	andi	t1, t0, ~(SZREG-1)
-	/* Converting unaligned src to aligned src */
-	andi	a1, a1, ~(SZREG-1)
-
-	/*
-	 * Calculate shifts
-	 * t3 - prev shift
-	 * t4 - current shift
-	 */
-	slli	t3, a3, 3 /* converting bytes in a3 to bits */
-	li	a5, SZREG*8
-	sub	t4, a5, t3
-
-	/* Load the first word to combine with second word */
-	fixup REG_L   a5, 0(a1), 10f
-
-3:
-	/* Main shifting copy
-	 *
-	 * a0 - start of aligned dst
-	 * a1 - start of aligned src
-	 * t1 - end of aligned dst
-	 */
-
-	/* At least one iteration will be executed */
-	srl	a4, a5, t3
-	fixup REG_L   a5, SZREG(a1), 10f
+/*
+ * C906 performs misaligned scalar loads in hardware. The destination was
+ * aligned above; replace the shift/or reconstruction with bounded word
+ * copies. Keep the existing small-copy and aligned bulk paths unchanged.
+ */
+.Lnative_copy:
+	addi	t1, t0, -SZREG
+.Lnative_word:
+	fixup REG_L a5, 0(a1), .Lcopy_fault
+	fixup REG_S a5, 0(a0), .Lcopy_fault
+	addi	a0, a0, SZREG
 	addi	a1, a1, SZREG
-	sll	a2, a5, t4
-	or	a2, a2, a4
-	fixup REG_S   a2, 0(a0), 10f
-	addi	a0, a0, SZREG
-	bltu	a0, t1, 3b
-
-	/* Revert src to original unaligned value  */
-	add	a1, a1, a3
-#endif
-
+	bleu	a0, t1, .Lnative_word
+	j	.Lbyte_copy_tail
+
+.Lbulk_fault:
+	/* The unrolled loop has not advanced a0/a1 yet. Retry its accessible
+	 * prefix bytewise, including any words stored before the fault. */
+	addi	t0, t0, 8*SZREG
+.Lcopy_fault:
+	/* Retry the first byte here, then share the existing byte-store
+	 * loop. This retains the original exception-table entry count. */
+	fixup lb a5, 0(a1), 10f
+	addi	a1, a1, 1
+	j	.Lbyte_store
+
+	/* Preserve the original 44-byte region: all normal short/aligned
+	 * instructions and subsequent kernel text retain their addresses. */
+	.org .Lnative_copy + 44
 .Lbyte_copy_tail:
 	/*
 	 * Byte copy anything left.
@@ -205,6 +179,7 @@
 4:
 	fixup lb      a5, 0(a1), 10f
 	addi	a1, a1, 1	/* src */
+.Lbyte_store:
 	fixup sb      a5, 0(a0), 10f
 	addi	a0, a0, 1	/* dst */
 	bltu	a0, t0, 4b	/* t0 - end of dst */
