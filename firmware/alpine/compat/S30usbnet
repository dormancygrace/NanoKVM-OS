#!/bin/sh
# USB network service for the active NCM gadget composition.
set -eu

# A base-only update must keep serving the older application's settings.
if [ -f /usr/share/nanokvm/usb-flags-layout ] && [ -e /etc/kvm/usb/.layout-v1 ]; then
    : "${NANOKVM_USB_NET_BOOT:=/etc/kvm/usb}"
else
    : "${NANOKVM_USB_NET_BOOT:=/boot}"
fi
: "${NANOKVM_USB_NET_RUN:=/run/nanokvm-usbnet}"
# The same gadget the helper reads (NANOKVM_USB_NET_GADGET).
: "${NANOKVM_USB_NET_GADGET:=/sys/kernel/config/usb_gadget/g0}"
: "${NANOKVM_USB_NET_CONFIG:=$NANOKVM_USB_NET_GADGET/configs/c.1}"
: "${NANOKVM_USB_NET_UID:=/sys/class/cvi-base/base_uid}"
# The address and DHCP/DNS server for usb0 belong to this helper; the same
# package installs it.
: "${NANOKVM_USB_INTERNET_HELPER:=/usr/sbin/nkos-usb-internet}"
: "${NANOKVM_USB_WATCH_SERVICE:=/etc/init.d/nanokvm-usb-internet}"

# The Go helper costs about 0.3 s per call on this CPU, and boot calls this
# script several times. With no USB network function bound and nothing
# applied (no applied.json, or the empty one the helper writes when idle) it
# has nothing to set up or undo. The empty form is pinned by a Go test.
idle_applied='{"FlowUnsupported":false,"AddressOwned":false,"Prefix":"","Address":"","Uplink":"","Config":"","Rules":"","Routing":"","Forward":{}}'
helper_idle() {
    [ ! -L "$NANOKVM_USB_NET_CONFIG/ncm.usb0" ] && [ ! -L "$NANOKVM_USB_NET_CONFIG/rndis.usb0" ] || return 1
    # ReadStatus keeps cleanup errors visible until a successful retry. An
    # empty/missing applied state alone does not prove the last call succeeded.
    if [ -e "$NANOKVM_USB_NET_RUN/status.json" ]; then
        status=$(cat "$NANOKVM_USB_NET_RUN/status.json") || return 1
        case "$status" in *'"state":"error"'*) return 1 ;; esac
    fi
    [ -e "$NANOKVM_USB_NET_RUN/applied.json" ] || return 0
    [ "$(cat "$NANOKVM_USB_NET_RUN/applied.json")" = "$idle_applied" ]
}

stop() {
    helper_idle || "$NANOKVM_USB_INTERNET_HELPER" stop
}

prefix() {
    if [ -e "$NANOKVM_USB_NET_BOOT/rndis.ipv4_prefix" ]; then
        value=$(sed 's/\r$//' "$NANOKVM_USB_NET_BOOT/rndis.ipv4_prefix")
        # A prefix is data, not shell syntax. Require three decimal IPv4 octets.
        printf '%s\n' "$value" | awk -F. '
            NR != 1 || NF != 3 { exit 1 }
            { for (i=1; i<=3; i++) if ($i !~ /^[0-9]+$/ || length($i)>3 || $i>255 || (length($i)>1 && substr($i,1,1)=="0")) exit 1 }
            $1 == 0 || $1 == 127 || $1 >= 224 { exit 1 }
        ' || { echo 'Invalid USB IPv4 prefix' >&2; return 1; }
        printf '%s\n' "$value"
    else
        uid=$(sha512sum "$NANOKVM_USB_NET_UID") || return 1
        uid=${uid%% *}
        id2=$(printf '%d' "0x$(printf '%s' "$uid" | cut -c1-2)")
        id3=$(printf '%d' "0x$(printf '%s' "$uid" | cut -c3-4)")
        [ "$id2" -ne "$id3" ] || id2=$((id2 + 1))
        [ "$id2" -lt 255 ] || id2=253
        [ "$id3" -lt 255 ] || id3=254
        printf '10.%s.%s\n' "$id2" "$id3"
    fi
}

start() {
    # Repeated starts leave the helper's address and daemon untouched.
    helper_idle && return 0
    ipv4_prefix=$(prefix) || return 1
    "$NANOKVM_USB_INTERNET_HELPER" apply "$ipv4_prefix"
}

mkdir -p "$NANOKVM_USB_NET_RUN"
chmod 700 "$NANOKVM_USB_NET_RUN"
# Stop the producer before taking its reconciliation lock. Otherwise it can
# queue another apply between our cleanup and the supervisor stop.
if [ "${NANOKVM_USB_NET_WATCHER:-0}" != 1 ] && [ -x "$NANOKVM_USB_WATCH_SERVICE" ]; then
    case "${1:-}" in
        stop|restart|reload) "$NANOKVM_USB_WATCH_SERVICE" stop ;;
    esac
fi
exec 9> "$NANOKVM_USB_NET_RUN/lock"
flock -x 9
case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
# The child watcher also reconciles through this script. Release the lock
# before supervisor changes and never let that child stop/restart itself.
flock -u 9
exec 9>&-
if [ "${NANOKVM_USB_NET_WATCHER:-0}" != 1 ] && [ -x "$NANOKVM_USB_WATCH_SERVICE" ]; then
    case "${1:-}" in
        stop) ;;
        *) "$NANOKVM_USB_WATCH_SERVICE" reload ;;
    esac
fi
