#!/bin/sh
# Load the Wi-Fi driver for the SDIO card on this board; fail at once without
# a supported card (S30wifi then does not wait for wlan0). udev does not load
# these drivers (modprobe.d/nanokvm-wifi.conf). The IDs follow the AIC8800
# (aicbsp_sdio_ids.h) and 8733bs drivers.
set -eu
[ "${1:-}" = start ] || exit 0
SDIO_DEVICES_DIR=${NANOKVM_SDIO_DEVICES_DIR:-/sys/bus/sdio/devices}
MODPROBE=${NANOKVM_MODPROBE:-modprobe}
WIFI_ETC_DIR=${NANOKVM_WIFI_ETC_DIR:-/etc/kvm}
MODPROBE_DIR=${NANOKVM_MODPROBE_DIR:-/etc/modprobe.d}
STANDARDS_CONF=$MODPROBE_DIR/nanokvm-wifi-standards.conf

# Wi-Fi 5 (VHT) and Wi-Fi 6 (HE) of the AIC8801 and AIC8800D80, as chosen in
# the web interface (wifi.vht, wifi.he: "0" off, anything else on). Without a
# choice the AIC8801 has both off: it stalls its transmissions for one to two
# seconds at a time in Wi-Fi 6 links. The AIC8800D80 keeps the driver's
# default, both on. The options go to a modprobe.d file, not to this
# modprobe: the Bluetooth module loads the driver as a dependency too.
standard_flag() {
    value=
    [ -e "$WIFI_ETC_DIR/$1" ] || { echo "$2"; return; }
    read -r value < "$WIFI_ETC_DIR/$1" || true
    case "$value" in 0*) echo N ;; *) echo Y ;; esac
}

aic8800_standards() {
    vht=$(standard_flag wifi.vht "$1")
    # Wi-Fi 6 on 5 GHz needs the Wi-Fi 5 capabilities.
    he=N
    [ "$vht" = N ] || he=$(standard_flag wifi.he "$1")
    mkdir -p "$MODPROBE_DIR"
    temporary=$(mktemp "$MODPROBE_DIR/.nanokvm-wifi-standards.XXXXXX")
    printf '%s\n' '# Managed by S25wifimod from /etc/kvm/wifi.vht and wifi.he.' \
        "options aic8800_fdrv vht_on=$vht he_on=$he" > "$temporary"
    chmod 644 "$temporary"
    mv -f "$temporary" "$STANDARDS_CONF"
}

for alias in "$SDIO_DEVICES_DIR"/*/modalias; do
    id=
    [ ! -r "$alias" ] || read -r id < "$alias" || true
    case "$id" in
        sdio:c*v5449d0145*|sdio:c*v5449d0146*|sdio:c*v544Ad0146*)
            aic8800_standards N
            exec "$MODPROBE" aic8800_fdrv ;;
        sdio:c*vC8A1dC08D*|sdio:c*vC8A1d0082*|sdio:c*vC8A1d0182*)
            aic8800_standards Y
            exec "$MODPROBE" aic8800_fdrv ;;
        sdio:c*vC8A1d908[1-6]*|sdio:c*vC8A1d2082*)
            rm -f "$STANDARDS_CONF"
            exec "$MODPROBE" aic8800_fdrv ;;
        sdio:c*v024CdB733*|sdio:c*v024CdB73A*)
            exec "$MODPROBE" 8733bs ;;
    esac
done
echo 'NanoKVM OS: supported SDIO Wi-Fi device not present' >&2
exit 1
