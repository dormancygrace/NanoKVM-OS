-static void sensor_standby_restart(struct cvi_cif_dev *dev, bool enable)
-{
-	int i;
-	struct isp_i2c_data *i2c_data;
-	i2c_data = kzalloc(sizeof(struct isp_i2c_data), __GFP_RETRY_MAYFAIL);
-	if (!i2c_data) {
-		printk("i2c_data kzalloc failed\n");
-	}
-
-	i2c_data->i2c_dev = dev->sensor_i2c_info.i2c_base_info.i2c_dev;
-	i2c_data->dev_addr = dev->sensor_i2c_info.i2c_base_info.dev_addr;
-	i2c_data->addr_bytes = dev->sensor_i2c_info.i2c_base_info.addr_bytes;
-	i2c_data->data_bytes = dev->sensor_i2c_info.i2c_base_info.data_bytes;
-	if (enable) {
-		for (i = 0; i < dev->sensor_i2c_info.i2c_base_info.resume_seq_length; i++) {
-			sensor_i2c_write(i2c_data, dev->sensor_i2c_info.sns_resume_info[i].addr,
-				dev->sensor_i2c_info.sns_resume_info[i].data);
-		}
-	} else {
-		for (i = 0; i < dev->sensor_i2c_info.i2c_base_info.suspend_seq_length; i++) {
-			sensor_i2c_write(i2c_data, dev->sensor_i2c_info.sns_suspend_info[i].addr,
-				dev->sensor_i2c_info.sns_suspend_info[i].data);
-		}
+/* PM callbacks run in sleepable context. Stop at the first failed write;
+ * a partially applied sensor sequence cannot be treated as successful. */
+static int sensor_standby_restart(struct cvi_cif_dev *dev, bool enable)
+{
+	const struct sns_i2c_info *info = &dev->sensor_i2c_info;
+	const struct sns_i2c_attr *attr = &info->i2c_base_info;
+	const struct addr_data_seq *seq = enable ? info->sns_resume_info : info->sns_suspend_info;
+	int count = enable ? attr->resume_seq_length : attr->suspend_seq_length;
+	struct isp_i2c_data data = {0};
+	int i, ret;
+
+	if (count < 0 || count > (int)ARRAY_SIZE(info->sns_resume_info))
+		return -EINVAL;
+	data.i2c_dev = attr->i2c_dev;
+	data.dev_addr = attr->dev_addr;
+	data.addr_bytes = attr->addr_bytes;
+	data.data_bytes = attr->data_bytes;
+	for (i = 0; i < count; i++) {
+		data.reg_addr = seq[i].addr;
+		data.data = seq[i].data;
+		ret = vip_sys_cmm_cb_i2c(CVI_SNS_I2C_WRITE, &data);
+		if (ret)
+			return ret;
 	}
-	kfree(i2c_data);
-	i2c_data = NULL;
+	return 0;
 }
 static int cvi_cif_suspend(struct platform_device *pdev)
 {
 	struct cvi_cif_dev *dev;
-	int i;
+	int i, ret;
 
-	if (!pdev) {
-		dev_err(&pdev->dev, "invalid param");
+	if (!pdev)
 		return -EINVAL;
-	}
 
 	dev = dev_get_drvdata(&pdev->dev);
 
@@ -3469,7 +3459,9 @@ static int cvi_cif_suspend(struct platform_device *pdev)
 		return 0;
 	}
 
-	sensor_standby_restart(dev, 0);
+	ret = sensor_standby_restart(dev, 0);
+	if (ret)
+		return ret;
 	cif_enable_snsr_clk(dev, 0, 0);
   
 	for (i = 0; i < MAX_LINK_NUM; i++) {
@@ -3488,12 +3480,10 @@ static int cvi_cif_suspend(struct platform_device *pdev)
 static int cvi_cif_resume(struct platform_device *pdev)
 {
 	struct cvi_cif_dev *dev;
-	int i;
+	int i, ret;
 
-	if (!pdev) {
-		dev_err(&pdev->dev, "invalid param");
+	if (!pdev)
 		return -EINVAL;
-	}
 
 	dev = dev_get_drvdata(&pdev->dev);
 
@@ -3510,7 +3500,9 @@ static int cvi_cif_resume(struct platform_device *pdev)
 	}
 
 	cif_enable_snsr_clk(dev, 0, 1);
-	sensor_standby_restart(dev, 1);
+	ret = sensor_standby_restart(dev, 1);
+	if (ret)
+		return ret;
 
 	dev_info(&pdev->dev, "cif resume end");
 	return 0;
