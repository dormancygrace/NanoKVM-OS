 void rwnx_cfg80211_unlink_bss(struct rwnx_hw *rwnx_hw, struct rwnx_vif *rwnx_vif);
 
@@ -479,7 +479,7 @@ static inline int rwnx_bt_recv_ind(struct rwnx_hw *rwnx_hw,
         ind->data_len > sizeof(ind->bt_data) ||
         ind->data_len > msg->param_len - offsetof(struct mm_bt_recv_ind, bt_data))
         return -EINVAL;
-    return bt_sdio_recv(ind->bt_data, ind->data_len);
+    return aicwf_bt_deliver(ind->bt_data, ind->data_len);
 }
 #endif
 
