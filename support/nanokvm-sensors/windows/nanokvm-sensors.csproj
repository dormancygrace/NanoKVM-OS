<Project Sdk="Microsoft.NET.Sdk">

  <!-- nanokvm-sensors.exe: one file for Windows 10 and 11, which have .NET
       Framework 4.8, so no runtime is installed or carried. Builds on Linux
       too (the reference assemblies come from NuGet). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>nanokvm-sensors</AssemblyName>
    <RootNamespace>NanoKvmSensors</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <!-- The library's code is per architecture (runtimes/win-x64 in its
         package): 64-bit Windows on x86 processors. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>NanoKVM OS</Product>
    <Description>Sends this computer's sensors to the NanoKVM plugged into it</Description>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- The PawnIO driver's installer (GPL-2.0, github.com/namazso/PawnIO.Setup),
       given by the build as -p:PawnIoSetup=FILE, goes into the exe too:
       "nanokvm-sensors install" offers to run it. Without it the exe names
       the driver's site instead. -->
  <ItemGroup Condition="'$(PawnIoSetup)' != ''">
    <EmbeddedResource Include="$(PawnIoSetup)" LogicalName="pawnio/PawnIO_setup.exe" Type="Non-Resx" WithCulture="false" />
  </ItemGroup>

  <!-- The libraries go into the exe as resources "lib/<name>.dll"; Program
       loads them from there (AssemblyResolve). -->
  <Target Name="EmbedLibraries" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile;PrepareResources">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>lib/%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
