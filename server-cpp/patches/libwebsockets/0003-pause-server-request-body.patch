 /**
+ * lws_http_server_pause_body() - hold / resume reception of a server request body
+ *
+ * Call on the service thread with a request wsi, from its HTTP callback. HTTP/1
+ * pauses socket reads. HTTP/2 lets the stream's outstanding window run down
+ * while keeping other streams moving. Body already in flight may still arrive.
+ * Pass 0 after the receiver is ready, before starting the HTTP response.
+ * The application's wait is excluded from the peer's body deadline.
+ * Returns 0 on success.
+ */
+LWS_VISIBLE LWS_EXTERN int
+lws_http_server_pause_body(struct lws *wsi, int pause);
