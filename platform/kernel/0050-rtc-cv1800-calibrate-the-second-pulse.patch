From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] rtc: cv1800: calibrate the second pulse to the 32K clock

Without a 32K crystal the RTC counts the 32K RC oscillator, which runs near
21 kHz on the SG2002, while the internal second pulse counts 32768 cycles:
the RTC kept 0.65 of real time. Measure the clock against the 25 MHz crystal
and set the second pulse to it, after probe and every 30 minutes: the RC
oscillator does not hold its rate (some 70 ppm within a run, more between
boots).

Signed-off-by: Gleb Pesin <dormancygrace@gmail.com>
---
diff --git a/drivers/rtc/rtc-cv1800.c b/drivers/rtc/rtc-cv1800.c
--- a/drivers/rtc/rtc-cv1800.c
+++ b/drivers/rtc/rtc-cv1800.c
@@ -5,15 +5,23 @@
  * Author: Jingbao Qiu <qiujingbao.dlmu@gmail.com>
  */
 
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/irq.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/mfd/syscon.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/rtc.h>
+#include <linux/workqueue.h>
+
+/* 32K clock measurement against the 25 MHz crystal */
+#define FC_FINE_EN             0x0048
+#define FC_FINE_PERIOD         0x004C
+#define FC_FINE_CAL            0x0050
 
 #define SEC_PULSE_GEN          0x1004
 #define ALARM_TIME             0x1008
@@ -31,14 +39,92 @@
 
 #define ALARM_ENABLE_MASK      BIT(0)
 #define SEL_SEC_PULSE          BIT(31)
+#define SEC_PULSE_GEN_RATE     GENMASK(23, 0)
+
+#define FC_FINE_VALUE          GENMASK(23, 0)
+#define FC_FINE_TIME           GENMASK(31, 24)
+/* 32K cycles per measurement: about 0.2 s; the 24-bit count holds 0.67 s */
+#define CALIB_PERIOD           4096
+#define CALIB_REF_HZ           25000000ULL
+/* The RC oscillator does not hold its rate: measure it again */
+#define CALIB_INTERVAL         (30 * 60 * HZ)
 
 struct cv1800_rtc_priv {
 	struct rtc_device *rtc_dev;
 	struct regmap *rtc_map;
 	struct clk *clk;
 	int irq;
+	struct device *dev;
+	struct delayed_work calibrate;
+	bool calibrated;
 };
 
+/*
+ * The internal second pulse counts SEC_PULSE_GEN_INT + FRAC/256 cycles of the
+ * 32K clock, 32768 at reset. With no 32K crystal the clock is the 32K RC
+ * oscillator, which runs anywhere near 21 kHz on the SG2002: the RTC then
+ * kept 0.65 of real time. Measure the clock against the 25 MHz crystal (SoC
+ * TRM, RTC initialization, fine tune) and set the second pulse to it. Only
+ * the rate changes; the counter and the pulse source stay as they are.
+ */
+static int cv1800_rtc_measure(struct cv1800_rtc_priv *info, u32 *ticks)
+{
+	u32 val, time;
+	int i, ret;
+
+	regmap_write(info->rtc_map, FC_FINE_PERIOD, CALIB_PERIOD);
+	regmap_read(info->rtc_map, FC_FINE_CAL, &val);
+	time = FIELD_GET(FC_FINE_TIME, val);
+	regmap_write(info->rtc_map, FC_FINE_EN, 1);
+	/* The first completion may cover a partial period: take the second. */
+	for (i = 0; i < 2; i++) {
+		ret = regmap_read_poll_timeout(info->rtc_map, FC_FINE_CAL, val,
+					       FIELD_GET(FC_FINE_TIME, val) != time,
+					       10000, 1000000);
+		if (ret)
+			break;
+		time = FIELD_GET(FC_FINE_TIME, val);
+	}
+	regmap_write(info->rtc_map, FC_FINE_EN, 0);
+	*ticks = FIELD_GET(FC_FINE_VALUE, val);
+	return ret;
+}
+
+static void cv1800_rtc_calibrate(struct work_struct *work)
+{
+	struct cv1800_rtc_priv *info = container_of(to_delayed_work(work),
+						    struct cv1800_rtc_priv, calibrate);
+	u32 ticks, rate;
+	u64 hz256;
+	int ret;
+
+	ret = cv1800_rtc_measure(info, &ticks);
+	if (ret || !ticks) {
+		dev_warn_once(info->dev, "32K clock measurement failed: %d\n", ret);
+		goto next;
+	}
+	hz256 = div_u64(CALIB_PERIOD * CALIB_REF_HZ * 256, ticks);
+	if (hz256 < 16384 * 256 || hz256 > 49152 * 256) {
+		dev_warn_once(info->dev, "32K clock out of range: %llu/256 Hz\n", hz256);
+		goto next;
+	}
+	rate = hz256;
+	regmap_update_bits(info->rtc_map, SEC_PULSE_GEN, SEC_PULSE_GEN_RATE, rate);
+	if (!info->calibrated)
+		dev_info(info->dev, "32K clock %u.%02u Hz, second pulse calibrated\n",
+			 rate >> 8, (rate & 0xff) * 100 / 256);
+	info->calibrated = true;
+next:
+	schedule_delayed_work(&info->calibrate, CALIB_INTERVAL);
+}
+
+static void cv1800_rtc_stop_calibration(void *data)
+{
+	struct cv1800_rtc_priv *info = data;
+
+	cancel_delayed_work_sync(&info->calibrate);
+}
+
 static bool cv1800_rtc_enabled(struct device *dev)
 {
 	struct cv1800_rtc_priv *info = dev_get_drvdata(dev);
@@ -179,6 +265,14 @@
 				     "rtc clk not found\n");
 
 	platform_set_drvdata(pdev, rtc);
+	rtc->dev = &pdev->dev;
+
+	/* Off the probe path: a measurement takes some 0.4 s. */
+	INIT_DELAYED_WORK(&rtc->calibrate, cv1800_rtc_calibrate);
+	ret = devm_add_action_or_reset(&pdev->dev, cv1800_rtc_stop_calibration, rtc);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&rtc->calibrate, 0);
 
 	device_init_wakeup(&pdev->dev, 1);
 
