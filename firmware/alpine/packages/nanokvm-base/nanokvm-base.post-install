#!/bin/sh
set -eu
if [ -x /usr/libexec/nanokvm/console-policy ]; then
    /usr/libexec/nanokvm/console-policy
fi

# Make a clean Alpine minirootfs bootable on NanoKVM. rc-update is idempotent.
for service in devfs dmesg procfs sysfs; do
    [ ! -x "/etc/init.d/$service" ] || rc-update add "$service" sysinit
done
# NanoKVM services load their drivers explicitly; the kernel set the clock
# from the RTC (osclock provides "clock" instead of hwclock).
for service in loopback bootmisc hostname localmount modules osclock sysctl udev udev-trigger; do
    [ ! -x "/etc/init.d/$service" ] || rc-update add "$service" boot
done
for service in nanokvm-storage nanokvm-modules nanokvm-board \
	       nanokvm-network nanokvm-usb-internet nanokvm-usb nanokvm-policy nanokvm-ssh nanokvm-app nanokvm-watchdog chronyd crond nanokvm-mdns; do
	[ ! -x "/etc/init.d/$service" ] || rc-update add "$service" default
done
[ ! -x /etc/init.d/mount-ro ] || rc-update add mount-ro shutdown
# OpenRC builds its dependency tree from all init scripts at every boot (about
# 2 s) unless savecache kept it at shutdown; it rebuilds the tree by itself
# when a script or a setting changed since.
[ ! -x /etc/init.d/savecache ] || rc-update add savecache shutdown

# Boot time settings of Alpine services (NanoKVM boot order):
# - sshd's depend() runs `sshd -G`, which waits for the kernel's random pool
#   while OpenRC builds its dependency tree at every boot; nanokvm-ssh starts
#   sshd, and the config binds no single address, so it needs nothing more.
# - bootmisc's copy of the kernel log on the SD card at every boot duplicates
#   the boot log archive.
# - udev-trigger replays the add event of every device at boot, about 530 on
#   the SG2002. Without coldplug it replays those with a /dev node and the
#   network interfaces: the same nodes, permissions and links, and the same
#   modules, since the NanoKVM services load theirs (the SD Wi-Fi drivers are
#   kept from udev anyway). On the stand the server started 1 s sooner. An
#   rc_coldplug the user set stays.
if [ -f /etc/conf.d/sshd ] && ! grep -q '^[[:space:]]*rc_need=' /etc/conf.d/sshd; then
    printf '%s\n' '# NanoKVM: no `sshd -G` while OpenRC builds its dependency tree' 'rc_need=""' >> /etc/conf.d/sshd
fi
if [ -f /etc/conf.d/bootmisc ]; then
    sed -i 's/^log_dmesg="YES"$/log_dmesg="NO"/' /etc/conf.d/bootmisc
fi
# NanoKVM udev coldplug default: evaluated when OpenRC sources the config.
# Preserve service-local, exported, global and legacy-uppercase preferences.
udev_trigger=/etc/conf.d/udev-trigger
udev_default=': "${rc_coldplug:=${RC_COLDPLUG:-NO}}"'
if [ -f "$udev_trigger" ] && ! grep -Fqx "$udev_default" "$udev_trigger"; then
    printf '\n%s\n%s\n' '# NanoKVM: default to device-node and network replay' "$udev_default" >> "$udev_trigger"
fi
unset udev_trigger udev_default
# End NanoKVM udev coldplug default

# Fresh images are closed to SSH until the user enables it. Recovery restores
# the complete old /etc/kvm directory, including the absence of this marker.
mkdir -p /etc/kvm
mkdir -p /etc/conf.d
printf '%s\n' 'command_args="-f /etc/chrony.conf"' > /etc/conf.d/chronyd
touch /etc/kvm/ssh_stop

# The live system log stays in RAM: syslogd writes /run/log/messages (up to
# 512 KiB, one rotated file) and the server archives the new lines to the SD
# card once a minute (/var/log/nanokvm-boots, docs/LOGS.md). Only the Alpine
# default is replaced; the generated file, edited or not, and any other
# setting stay as they are.
syslog_conf=/etc/conf.d/syslog
syslog_marker='# NanoKVM: the live system log in RAM'
syslog_changed=no
if [ ! -e "$syslog_conf" ] || [ "$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$syslog_conf")" = 'SYSLOGD_OPTS="-t"' ]; then
    mkdir -p "$(dirname "$syslog_conf")"
    printf '%s\n%s\n%s\n' "$syslog_marker" 'mkdir -p /run/log' \
        'SYSLOGD_OPTS="-t -O /run/log/messages -s 512 -b 1"' > "$syslog_conf"
    syslog_changed=yes
fi
# A fresh image starts syslog with the RAM log; nothing was written to the card.
unset syslog_conf syslog_marker syslog_changed
mkdir -p /etc/kvm/cron/crontabs
if [ ! -L /etc/crontabs ]; then
    cp -an /etc/crontabs/. /etc/kvm/cron/crontabs/ 2>/dev/null || true
    rm -rf /etc/crontabs
    ln -s /etc/kvm/cron/crontabs /etc/crontabs
fi

# The package owns the complete tested files. These fallbacks also cover an
# older payload during an in-place package upgrade.
if ! grep -qE '^[^#]+[[:space:]]+/boot[[:space:]]' /etc/fstab 2>/dev/null; then
    printf '%s\n' '/dev/mmcblk0p1 /boot vfat noauto,rw,nosuid,nodev,noexec 0 0' >> /etc/fstab
fi
if ! grep -qE '^[^#]+[[:space:]]+/data[[:space:]]' /etc/fstab 2>/dev/null; then
    printf '%s\n' '/dev/mmcblk0p3 /data exfat noauto,rw,nosuid,nodev,noexec 0 0' >> /etc/fstab
fi
tmpfs_entry='tmpfs /tmp tmpfs rw,nosuid,nodev,mode=1777,size=64M 0 0'
if ! grep -qE '^[^#]+[[:space:]]+/tmp[[:space:]]' /etc/fstab 2>/dev/null; then
    printf '%s\n' "$tmpfs_entry" >> /etc/fstab
fi
unset tmpfs_entry
if ! grep -q '^ttyS0::respawn:' /etc/inittab 2>/dev/null; then
    printf '%s\n' 'ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100' >> /etc/inittab
fi
[ -s /etc/hostname ] || printf '%s\n' nanokvm-alpine > /etc/hostname

# The SSH greeting is owned by /etc/profile.d/nanokvm-banner.sh so it runs
# only for an interactive shell. Clear solely the two known package/upstream
# MOTDs: sshd could otherwise emit them before remote commands. Any other
# user-authored MOTD is left untouched.
if [ ! -s /etc/motd ] || grep -qx 'Welcome to Alpine!' /etc/motd || \
   [ "$(cat /etc/motd)" = 'Welcome to NanoKVM OS!

Manage your device through its web interface.
System and package updates are available through apk.' ]; then
    : > /etc/motd
fi

# The legacy application init script created this exact root profile. On ash it
# is read after /etc/profile.d and therefore overwrites the coloured NanoKVM
# prompt. Remove only the package-generated one-line file; preserve every
# user-authored profile.
legacy_root_profile='export PS1="\u@\h:\w# "'
if [ -f /root/.profile ] && [ "$(cat /root/.profile)" = "$legacy_root_profile" ]; then
    rm -f /root/.profile
fi
unset legacy_root_profile

# A new image has no user password yet. Do not change an existing password.
if [ ! -e /run/openrc/softlevel ] && awk -F: '$1 == "root" { exit !($2 == "*" || $2 == "!" || $2 == "!!") }' /etc/shadow; then
    printf 'root:root\n' | chpasswd
fi
mkdir -p /etc/ssh/sshd_config.d
if [ ! -e /etc/ssh/sshd_config.d/00-nanokvm-root.conf ]; then
    printf 'PermitRootLogin yes\n' > /etc/ssh/sshd_config.d/00-nanokvm-root.conf
fi

exit 0
