# embed_messages.cmake -DSRC=<dir of <language>.json> -DOUT=<header>: the notification message catalogues as
# string literals (system/notify.cpp parses them once).
file(GLOB files "${SRC}/*.json")
list(SORT files)
set(out "// Generated by cmake/embed_messages.cmake from the notification message catalogues.\n#pragma once\n\n")
string(APPEND out "#include <string_view>\n#include <utility>\n\nnamespace nkos::system::notify::catalogue {\n\n")
string(APPEND out "inline constexpr std::pair<std::string_view, std::string_view> files[] = {\n")
foreach(f IN LISTS files)
	get_filename_component(language "${f}" NAME_WE)
	file(READ "${f}" content)
	string(APPEND out "\t{\"${language}\", R\"nkosjson(${content})nkosjson\"},\n")
endforeach()
string(APPEND out "};\n\n} // namespace nkos::system::notify::catalogue\n")
file(WRITE "${OUT}" "${out}")
