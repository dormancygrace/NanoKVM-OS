diff --git a/Documentation/ABI/testing/sysfs-platform-nanokvm-hdmi-reset b/Documentation/ABI/testing/sysfs-platform-nanokvm-hdmi-reset
new file mode 100644
index 0000000..ffd7a09
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-platform-nanokvm-hdmi-reset
@@ -0,0 +1,30 @@
+What:           /sys/bus/platform/devices/hdmi-reset/pulse
+Date:           September 2026
+Contact:        NanoKVM Enhanced maintainers
+Description:
+                Write "1" to assert the board HDMI receiver reset for 100ms,
+                then release it and wait another 100ms. Root write permission
+                is required. This is a synchronous operation. Overlapping
+                requests return EBUSY instead of queuing another reset.
+
+                The line is requested deasserted during probe and remains
+                owned by the driver. GPIO polarity comes from Device Tree.
+                Release is attempted even if assertion reports an error.
+                Removal drains active sysfs callbacks before freeing the GPIO.
+
+                Users must stop competing HDMI/I2C activity before using this
+                maintenance interface. It does not update EDID, manage the
+                video pipeline, or operate the host's ATX reset.
+
+What:           /sys/bus/platform/devices/hdmi-reset/asserted
+Date:           September 2026
+Contact:        NanoKVM Enhanced maintainers
+Description:
+                Read the logical reset level. Write "1" to hold the HDMI
+                receiver in reset, or "0" to release it. Polarity follows DT;
+                on NanoKVM PCIe asserted means the physical line is low.
+                Writes require root and reject any other value with EINVAL.
+                Access overlaps with pulse are rejected with EBUSY. GPIO errors
+                propagate. No delay or capture/I2C coordination is implicit.
+                The driver starts with reset released. Users must coordinate
+                capture before assertion and allow bridge startup after release.
diff --git a/Documentation/devicetree/bindings/misc/sipeed,nanokvm-hdmi-reset.yaml b/Documentation/devicetree/bindings/misc/sipeed,nanokvm-hdmi-reset.yaml
new file mode 100644
index 0000000..78d79f1
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/sipeed,nanokvm-hdmi-reset.yaml
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/sipeed,nanokvm-hdmi-reset.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: NanoKVM PCIe HDMI maintenance reset
+
+maintainers:
+  - dgrace <g.pesin@globalte.ru>
+
+description: |
+  Board reset line of the HDMI-to-CSI receiver. It is separate from the
+  optional camera sensor reset handled by CIF and from host ATX controls.
+
+properties:
+  compatible:
+    const: sipeed,nanokvm-hdmi-reset
+  reset-gpios:
+    maxItems: 1
+    description: Active-low HDMI receiver reset.
+  pinctrl-names:
+    items:
+      - const: default
+  pinctrl-0: true
+
+required:
+  - compatible
+  - reset-gpios
+
+additionalProperties: false
+...
