+/*
+ * NanoKVM OS: the memory of a hash from its own anonymous mapping, aligned to 2 MiB (a RISC-V Sv39 huge page) and
+ * marked MADV_HUGEPAGE: with transparent huge pages for madvise, its page faults are 2 MiB at a time instead of 4 KiB,
+ * and the pages come zeroed, so there is no memset either. Only with OpenSSL's own memory functions (an application's
+ * ones keep seeing the allocation) and without the secure heap; otherwise, or if the mapping fails, NULL and the
+ * allocation of OpenSSL.
+ */
+static BLOCK *argon2_map_memory(size_t len, size_t *mapped)
+{
+#if defined(__linux__) && defined(MADV_HUGEPAGE)
+    const size_t huge = (size_t)2 << 20;
+    size_t page = (size_t)sysconf(_SC_PAGESIZE), total;
+    CRYPTO_malloc_fn malloc_fn;
+    CRYPTO_realloc_fn realloc_fn;
+    CRYPTO_free_fn free_fn;
+    char *p, *a;
+
+    *mapped = 0;
+    CRYPTO_get_mem_functions(&malloc_fn, &realloc_fn, &free_fn);
+    if (malloc_fn != CRYPTO_malloc || realloc_fn != CRYPTO_realloc
+        || free_fn != CRYPTO_free || CRYPTO_secure_malloc_initialized()
+        || page == 0 || page > huge || len > SIZE_MAX - 2 * huge)
+        return NULL;
+    len = (len + page - 1) / page * page;
+    total = len + huge;
+    p = mmap(NULL, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p == MAP_FAILED)
+        return NULL;
+    a = (char *)(((uintptr_t)p + huge - 1) & ~(uintptr_t)(huge - 1));
+    if (a > p)
+        munmap(p, (size_t)(a - p));
+    if (p + total > a + len)
+        munmap(a + len, (size_t)(p + total - (a + len)));
+    (void)madvise(a, len, MADV_HUGEPAGE);
+    *mapped = len;
+    return (BLOCK *)a;
+#else
+    *mapped = 0;
+    return NULL;
+#endif
+}
+
+/* The memory of a hash, cleansed and released the way it was allocated. */
+static void argon2_release_memory(KDF_ARGON2 *ctx)
+{
+    size_t len = ctx->memory_blocks * sizeof(BLOCK);
+
+    if (ctx->memory == NULL)
+        return;
+    if (ctx->memory_mapped != 0) {
+        OPENSSL_cleanse(ctx->memory, len);
+#if defined(__linux__)
+        munmap(ctx->memory, ctx->memory_mapped);
+#endif
+    } else if (ctx->type != ARGON2_D) {
+        OPENSSL_secure_clear_free(ctx->memory, len);
+    } else {
+        OPENSSL_clear_free(ctx->memory, len);
+    }
+    ctx->memory = NULL;
+    ctx->memory_mapped = 0;
+}
