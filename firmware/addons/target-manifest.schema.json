{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dormancygrace.github.io/NanoKVM-OS-packages/addons-contract.schema.json",
  "title": "NanoKVM OS immutable addon target contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "base_abi", "server_api", "features", "trust", "repositories"],
  "properties": {
    "format": {"const": 1},
    "base_abi": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "server_api": {"type": "integer", "minimum": 1},
    "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^nkos-feature-[a-z0-9][a-z0-9-]*=[0-9]+$"}},
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {"keys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/key"}}}
    },
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+_.-]*$"},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "public_key_pem"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "filename": {"$ref": "#/$defs/id"},
        "public_key_pem": {"type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----\\n.+\\n-----END PUBLIC KEY-----\\n$"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "key_ids"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "key_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
