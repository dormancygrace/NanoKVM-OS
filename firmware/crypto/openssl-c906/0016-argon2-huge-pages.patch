+/*
+ * NanoKVM OS: the memory of a hash from its own anonymous mapping, aligned to 2 MiB (a RISC-V Sv39 huge page) and
+ * marked MADV_HUGEPAGE: with transparent huge pages for madvise, its page faults are 2 MiB at a time instead of 4 KiB,
+ * and the pages come zeroed, so there is no memset either. Only when the secure heap is not in use; otherwise, or if
+ * the mapping fails, NULL and the allocation of OpenSSL. Freed like OPENSSL_clear_free: cleansed, then unmapped.
+ */
+static BLOCK *argon2_map_memory(size_t len, size_t *mapped)
+{
+#if defined(__linux__) && defined(MADV_HUGEPAGE)
+    const size_t huge = (size_t)2 << 20;
+    size_t page = (size_t)sysconf(_SC_PAGESIZE), total;
+    char *p, *a;
+
+    *mapped = 0;
+    if (CRYPTO_secure_malloc_initialized() || page == 0 || page > huge
+        || len > SIZE_MAX - 2 * huge)
+        return NULL;
+    len = (len + page - 1) / page * page;
+    total = len + huge;
+    p = mmap(NULL, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p == MAP_FAILED)
+        return NULL;
+    a = (char *)(((uintptr_t)p + huge - 1) & ~(uintptr_t)(huge - 1));
+    if (a > p)
+        munmap(p, (size_t)(a - p));
+    if (p + total > a + len)
+        munmap(a + len, (size_t)(p + total - (a + len)));
+    (void)madvise(a, len, MADV_HUGEPAGE);
+    *mapped = len;
+    return (BLOCK *)a;
+#else
+    *mapped = 0;
+    return NULL;
+#endif
+}
+
+static void argon2_unmap_memory(BLOCK *memory, size_t len, size_t mapped)
+{
+    OPENSSL_cleanse(memory, len);
+#if defined(__linux__)
+    munmap(memory, mapped);
+#endif
+}
