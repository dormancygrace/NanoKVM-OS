From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] lib: lz4: update the compressor to upstream 1.10.0

Import the compression core from lz4/lz4 v1.10.0 (ebb370c), retaining
BSD-2-Clause attribution. Keep the existing exported kernel API, workspace
size and alignment behind wrappers; the new stream layout is private.
Keep the decoder and high-compression implementation unchanged.
No allocating convenience API or new decoder is imported.

diff --git a/lib/lz4/Makefile b/lib/lz4/Makefile
--- a/lib/lz4/Makefile
+++ b/lib/lz4/Makefile
@@ -2,5 +2,6 @@
 ccflags-y += $(if $(filter -O%,$(KCFLAGS)),$(lastword $(filter -O%,$(KCFLAGS))),-O2)
 
 obj-$(CONFIG_LZ4_COMPRESS) += lz4_compress.o
+lz4_compress-y := lz4_compress_110.o
 obj-$(CONFIG_LZ4HC_COMPRESS) += lz4hc_compress.o
 obj-$(CONFIG_LZ4_DECOMPRESS) += lz4_decompress.o
diff --git a/lib/lz4/lz4_compress.c b/lib/lz4/lz4_compress.c
deleted file mode 100644
--- a/lib/lz4/lz4_compress.c
+++ /dev/null
@@ -1,939 +0,0 @@
