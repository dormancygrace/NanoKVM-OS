+/* SPDX-License-Identifier: Apache-2.0 */
+/* NanoKVM OS: the shared five-block ChaCha kernel; protocol, buffering and
+ * counter limits remain in OpenSSL. Hardware capability is detected by the
+ * existing OpenSSL startup hwprobe, never by file I/O on the cipher path.
+ */
+#define _GNU_SOURCE
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <openssl/crypto.h>
+#include "crypto/chacha.h"
+#include "crypto/riscv_arch.h"
+#include "chacha_c906.h"
+
+static CRYPTO_ONCE once = CRYPTO_ONCE_STATIC_INIT;
+static int disabled;
+
+static void detect_override(void)
+{
+    const char *override = secure_getenv("NANOKVM_OPENSSL_CHACHA20");
+    /* Per-call prctl can be fatal under a caller-installed seccomp filter.
+     * Enable only in clients whose syscall policy has been qualified.
+     * An absent/unknown value, including secure execution, stays generic.
+     */
+    disabled = override == NULL || strcmp(override, "auto") != 0;
+}
+
+#ifdef NKOS_CHACHA_TEST
+/* Incremented at the assembly entry; excluded from the production build.
+ * The test build exports only the accessor in its private version script.
+ */
+#include <stdatomic.h>
+_Atomic unsigned long ossl_chacha_c906_test_count;
+unsigned long nkos_chacha_test_hits(void)
+{
+    return atomic_load_explicit(&ossl_chacha_c906_test_count, memory_order_relaxed);
+}
+#endif
+
+void ossl_chacha20_c906_blocks(unsigned int state[16],
+    const unsigned char *in, unsigned char *out, size_t groups, int rounds);
+
+int ossl_chacha20_c906(unsigned char *out, const unsigned char *in, size_t len,
+    const unsigned int key[8], const unsigned int counter[4])
+{
+    unsigned int state[16];
+    size_t bytes;
+    int control;
+
+    if (len < OSSL_CHACHA_C906_MIN_BYTES || !ossl_riscv_has_xtheadvector
+        || !CRYPTO_THREAD_run_once(&once, detect_override) || disabled)
+        return 0;
+    /* PR_RISCV_V_GET_CONTROL is per-thread; do not cache its result.
+     * Older kernels and disabled vector state safely use upstream code.
+     */
+    control = prctl(70, 0L, 0L, 0L, 0L);
+    if (control < 0 || (control & 3) != 2)
+        return 0;
+    state[0] = 0x61707865;
+    state[1] = 0x3320646e;
+    state[2] = 0x79622d32;
+    state[3] = 0x6b206574;
+    memcpy(state + 4, key, 32);
+    memcpy(state + 12, counter, 16);
+    bytes = len / OSSL_CHACHA_C906_GROUP_BYTES * OSSL_CHACHA_C906_GROUP_BYTES;
+    ossl_chacha20_c906_blocks(state, in, out,
+        len / OSSL_CHACHA_C906_GROUP_BYTES, 20);
+    /* The primitive wraps only the low 32-bit counter, like ctr32_c.
+     * Higher-level OpenSSL callers own the nonce and counter-width policy.
+     */
+    if (len != bytes)
+        ChaCha20_ctr32_c(out + bytes, in + bytes, len - bytes, key, state + 12);
+    OPENSSL_cleanse(state, sizeof(state));
+    return 1;
+}
