#!/bin/sh

# The USB gadget settings: on the root file system since the flags left the
# FAT boot partition (usb-flags-migrate).
conf=/etc/kvm/usb
# During a live package transaction the old server still uses /boot. Its
# replacement activates the new directory after the old process has stopped.
[ -e "$conf/.layout-v1" ] || conf=/boot

# Vendor kernels expose a role procfs control; mainline uses the DT device role.
set_usb_role() {
    if [ -w /proc/cviusb/otg_role ]; then
        echo "$1" > /proc/cviusb/otg_role || return 1
    fi
}

set_hid_wakeup(){
    # The extension is optional on upstream kernels; never create configfs files.
    [ -w "$1/wakeup_on_write" ] || return 0
    if [ -e $conf/usb.notwakeup ]; then
        echo 0 > "$1/wakeup_on_write"
    else
        echo 1 > "$1/wakeup_on_write"
    fi
}

# kvmhwd Rev2.2

reset_usb_config_links(){
    _gadget=$1
    [ -d "$_gadget" ] || return 0
    # Linux returns ENODEV if an already-unbound gadget is unbound again.
    if [ -n "$(cat "$_gadget/UDC")" ]; then
        echo '' > "$_gadget/UDC" || return 1
    fi
    # Reusing old links changes interface numbers when an optional function
    # is re-enabled. Unlink first, then start_usb_dev links in stable order.
    # This also releases configfs references before updating HID attributes.
    for _link in "$_gadget"/configs/c.1/* "$_gadget"/os_desc/c.1
    do
        [ -L "$_link" ] || continue
        rm "$_link" || return 1
    done
}

# SCSI identity is independent of the USB device descriptor and volume labels.
# Read a bounded value, retaining newlines so damaged files cannot be accepted.
storage_value() (
    LC_ALL=C
    export LC_ALL
    # Shell substitutions discard NUL; map it to another invalid byte first.
    value=$(head -c "$(( $2 + 2 ))" "$conf/usb.storage.$1" 2>/dev/null | tr '\000' '\177'; printf '.')
    value=${value%.}
    value=${value%'
'}
    case "$value" in
        ''|*[!\ -~]*|' '*|*' ') value=$3 ;;
        *) [ "${#value}" -le "$2" ] || value=$3 ;;
    esac
    printf '%s' "$value"
)

storage_inquiry() {
    _storage_vendor=$(storage_value vendor 8 NanoKVM)
    _storage_product=$(storage_value "$1" 16 "$2")
    printf '%-8s%-16s0520\n' "$_storage_vendor" "$_storage_product"
}

start_usb_dev(){
    # At cold boot an empty composition needs no descriptors or identity.
    # Keep the mode readable and reserve HID minors in the usual order;
    # a later enable fills the existing objects through the normal path.
    # When adding a USB function, update this enabling-flag guard, S03usbhid
    # if the function is supported there, and the enabling cases in
    # tests/test-usb-layout-start.py together.
    if [ ! -d /sys/kernel/config/usb_gadget/g0 ] &&
        { [ -e "$conf/disable_hid" ] ||
          { [ -e "$conf/usb.disable_keyboard" ] &&
            [ -e "$conf/usb.disable_relative" ] &&
            [ -e "$conf/usb.disable_absolute" ]; }; } &&
        [ ! -e "$conf/usb.acm" ] &&
        [ ! -e "$conf/usb.ncm" ] &&
        [ ! -e "$conf/usb.rndis0" ] &&
        [ ! -e "$conf/usb.disk0" ] &&
        [ ! -e "$conf/usb.audio" ]; then
        mkdir -p /sys/kernel/config/usb_gadget/g0/configs/c.1 \
            /sys/kernel/config/usb_gadget/g0/functions/hid.GS0 \
            /sys/kernel/config/usb_gadget/g0/functions/hid.GS1 \
            /sys/kernel/config/usb_gadget/g0/functions/hid.GS2 || return 1
        echo 0x0510 > /sys/kernel/config/usb_gadget/g0/bcdDevice || return 1
        echo "USB functions disabled"
        return 0
    fi
    . /etc/profile
    reset_usb_config_links /sys/kernel/config/usb_gadget/g0 || return 1
    # Retire RNDIS and release NCM too when USB networking is disabled.
    # An unlinked function otherwise retains usb0 and its endpoint resources.
    for unused in rndis.usb0 ncm.usb0; do
        if [ "$unused" = ncm.usb0 ] && { [ -e $conf/usb.ncm ] || [ -e $conf/usb.rndis0 ]; }; then
            continue
        fi
        if [ -d "/sys/kernel/config/usb_gadget/g0/functions/$unused" ]; then
            rmdir "/sys/kernel/config/usb_gadget/g0/functions/$unused" || return 1
        fi
    done
    echo "usb mode: device"
    cd /sys/kernel/config/usb_gadget

    mkdir -p g0
    cd g0

    echo 0x0200 > bcdUSB
    echo 0 > os_desc/use
    # The retired Windows pointer profile set a ContainerID; g0 keeps it
    # across a service restart, so clear it while kernels have the attribute.
    if [ -w os_desc/container_id ]; then
        echo 00000000-0000-0000-0000-000000000000 > os_desc/container_id || return 1
    fi

    if [ -e $conf/usb.acm ]
    then
        echo 0x0511 > bcdDevice
    else
        echo 0x0510 > bcdDevice
    fi

    # echo 0x3346 > idVendor
    # echo 0x1009 > idProduct
    if [ -e $conf/usb.vid ]
    then
        cat $conf/usb.vid > idVendor
    else
        echo 0x3346 > idVendor
    fi
    if [ -e $conf/usb.pid ]
    then
        cat $conf/usb.pid > idProduct
    else
        echo 0x1009 > idProduct
    fi

    echo 0xEF > bDeviceClass
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol

    mkdir -p strings/0x409
    _serial='0123456789ABCDEF'
    if [ -f /sys/class/cvi-base/base_uid ]
    then
        _uid_serial=$(awk '{print $2}' /sys/class/cvi-base/base_uid | tr -d '_')
        if [ ${#_uid_serial} -ge 12 ]
        then
            _serial="$_uid_serial"
        fi
    fi
    # A serial number set on the USB settings page replaces the chip UID.
    if [ -s $conf/usb.serialnumber ]
    then
        _serial=$(head -n 1 $conf/usb.serialnumber)
    fi
    echo "$_serial" > strings/0x409/serialnumber
    # The identity files are written by the USB settings page; a missing
    # file is the factory value.
    if [ -s $conf/usb.manufacturer ]
    then
        head -n 1 $conf/usb.manufacturer > strings/0x409/manufacturer
    else
        echo 'sipeed' > strings/0x409/manufacturer
    fi
    if [ -s $conf/usb.product ]
    then
        head -n 1 $conf/usb.product > strings/0x409/product
    else
        echo 'NanoKVM' > strings/0x409/product
    fi

    mkdir -p configs/c.1
    echo 0xE0 > configs/c.1/bmAttributes
    echo 120 > configs/c.1/MaxPower
    mkdir -p configs/c.1/strings/0x409
    echo "NanoKVM" >  configs/c.1/strings/0x409/configuration

    # Deterministic gadget MACs from the chip UID so the host-side NCM
    # interface keeps a STABLE MAC across re-enumeration/reboot. Without this
    # the kernel assigns a random dev_addr/host_addr on every bind, so the
    # attached PC sees a brand-new network adapter (and MAC) each time.
    usb_uid=$(sha512sum /sys/class/cvi-base/base_uid | head -c 4)
    if [ -n "$usb_uid" ]
    then
        usb_dev_mac="48:da:35:6e:${usb_uid%??}:${usb_uid#??}"
        usb_host_mac="48:da:35:6d:${usb_uid%??}:${usb_uid#??}"
    fi

    # Accept the old boot marker as NCM for upgrades from previous images.
    if [ -e $conf/usb.ncm ] || [ -e $conf/usb.rndis0 ]
    then
        mkdir -p functions/ncm.usb0
        [ -n "$usb_dev_mac" ]  && echo "$usb_dev_mac"  > functions/ncm.usb0/dev_addr
        [ -n "$usb_host_mac" ] && echo "$usb_host_mac" > functions/ncm.usb0/host_addr
        echo WINNCM > functions/ncm.usb0/os_desc/interface.ncm/compatible_id
        ln -s functions/ncm.usb0 configs/c.1/
    fi

    if [ -e $conf/usb.ncm ] || [ -e $conf/usb.rndis0 ]
    then
        # Microsoft OS 1.0 extended compatibility descriptor
        echo 1 > os_desc/use
        echo 0xCD > os_desc/b_vendor_code
        echo MSFT100 > os_desc/qw_sign
        ln -s configs/c.1 os_desc
    fi

    # Reserve HID minors in fixed order even when individual functions are disabled.
    # keyboard
    mkdir -p functions/hid.GS0
    echo 1 > functions/hid.GS0/subclass
    set_hid_wakeup functions/hid.GS0 || return 1
    echo 1 > functions/hid.GS0/protocol
    echo 8 > functions/hid.GS0/report_length
    echo -ne \\x05\\x01\\x09\\x06\\xa1\\x01\\x05\\x07\\x19\\xe0\\x29\\xe7\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\x95\\x01\\x75\\x08\\x81\\x03\\x95\\x05\\x75\\x01\\x05\\x08\\x19\\x01\\x29\\x05\\x91\\x02\\x95\\x01\\x75\\x03\\x91\\x03\\x95\\x06\\x75\\x08\\x15\\x00\\x25\\xE7\\x05\\x07\\x19\\x00\\x29\\xE7\\x81\\x00\\xc0 > functions/hid.GS0/report_desc
    if [ ! -e $conf/disable_hid ] && [ ! -e $conf/usb.disable_keyboard ]; then
        ln -s functions/hid.GS0 configs/c.1
    fi

    # mouse
    mkdir -p functions/hid.GS1
    echo 1 > functions/hid.GS1/subclass
    set_hid_wakeup functions/hid.GS1 || return 1
    echo 2 > functions/hid.GS1/protocol
    echo 5 > functions/hid.GS1/report_length
    echo -ne \\x5\\x1\\x9\\x2\\xa1\\x1\\x9\\x1\\xa1\\x0\\x5\\x9\\x19\\x1\\x29\\x3\\x15\\x0\\x25\\x1\\x95\\x3\\x75\\x1\\x81\\x2\\x95\\x1\\x75\\x5\\x81\\x3\\x5\\x1\\x9\\x30\\x9\\x31\\x9\\x38\\x15\\x81\\x25\\x7f\\x75\\x8\\x95\\x3\\x81\\x6\\x05\\x0c\\x0a\\x38\\x02\\x15\\x81\\x25\\x7f\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0 > functions/hid.GS1/report_desc
    if [ ! -e $conf/disable_hid ] && [ ! -e $conf/usb.disable_relative ]; then
        ln -s functions/hid.GS1 configs/c.1
    fi

    # touchpad
    mkdir -p functions/hid.GS2
    echo 0 > functions/hid.GS2/subclass
    set_hid_wakeup functions/hid.GS2 || return 1
    echo 2 > functions/hid.GS2/protocol
    echo 7 > functions/hid.GS2/report_length
    echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x05\\x15\\x00\\x25\\x01\\x95\\x05\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x03\\x81\\x01\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x35\\x00\\x45\\x00\\x75\\x08\\x95\\x01\\x81\\x06\\x05\\x0c\\x0a\\x38\\x02\\x15\\x81\\x25\\x7f\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0 > functions/hid.GS2/report_desc
    if [ ! -e $conf/disable_hid ] && [ ! -e $conf/usb.disable_absolute ]; then
        ln -s functions/hid.GS2 configs/c.1
    fi

    if [ -e $conf/usb.acm ]
    then
        mkdir -p functions/acm.GS0
        ln -s functions/acm.GS0 configs/c.1/
    fi

    if [ -e $conf/usb.disk0 ]
    then
            mkdir -p functions/mass_storage.disk0
            # With USB serial, a second read-only LUN carries the headless
            # Linux console helper (setup.sh), so the computer can set up a
            # login on the serial port without any network. The LUN goes
            # away with serial, so the drives match the composition. A LUN
            # can be added or removed only while the function is not linked
            # into the configuration (the kernel answers "Resource busy"
            # otherwise), so this comes before the link.
            _helper=/kvmapp/system/share/serial-console/nanokvm-serial-console.img
            if [ -e $conf/usb.acm ] && [ -f "$_helper" ]
            then
                    mkdir -p functions/mass_storage.disk0/lun.1
            elif [ -d functions/mass_storage.disk0/lun.1 ]
            then
                    echo '' > functions/mass_storage.disk0/lun.1/file
                    rmdir functions/mass_storage.disk0/lun.1
            fi
            # The user disk: a writable FAT32 image on the data partition
            # (BIOS updates, profiles), a third LUN while $conf/usb.userdisk
            # names an existing image. Same rule: added or removed only
            # before the link.
            # Only the image the server makes: the marker must not be able
            # to put any file on the card on a writable USB drive.
            _userdisk=
            if [ -s $conf/usb.userdisk ]
            then
                    _userdisk=$(head -n 1 $conf/usb.userdisk)
                    if [ "$_userdisk" != /data/.nanokvm/user-disk.img ] || [ ! -f "$_userdisk" ]
                    then
                            _userdisk=
                    fi
            fi
            if [ -n "$_userdisk" ]
            then
                    mkdir -p functions/mass_storage.disk0/lun.2
            elif [ -d functions/mass_storage.disk0/lun.2 ]
            then
                    echo '' > functions/mass_storage.disk0/lun.2/file
                    rmdir functions/mass_storage.disk0/lun.2
            fi
            ln -s functions/mass_storage.disk0 configs/c.1/
            if [ -d functions/mass_storage.disk0/lun.2 ]
            then
                    # ro and cdrom are refused (EBUSY) while a file is set:
                    # a LUN kept from the previous start still has one
                    echo '' > functions/mass_storage.disk0/lun.2/file 2>/dev/null
                    echo 1 > functions/mass_storage.disk0/lun.2/removable
                    echo 0 > functions/mass_storage.disk0/lun.2/ro
                    echo 0 > functions/mass_storage.disk0/lun.2/cdrom
                    storage_inquiry user "User Disk" > functions/mass_storage.disk0/lun.2/inquiry_string || return 1
                    echo "$_userdisk" > functions/mass_storage.disk0/lun.2/file
            fi
            if [ -d functions/mass_storage.disk0/lun.1 ]
            then
                    echo '' > functions/mass_storage.disk0/lun.1/file 2>/dev/null
                    echo 1 > functions/mass_storage.disk0/lun.1/removable
                    echo 1 > functions/mass_storage.disk0/lun.1/ro
                    echo 0 > functions/mass_storage.disk0/lun.1/cdrom
                    storage_inquiry setup "Setup Disk" > functions/mass_storage.disk0/lun.1/inquiry_string || return 1
                    echo "$_helper" > functions/mass_storage.disk0/lun.1/file
            fi
            echo 1 > functions/mass_storage.disk0/lun.0/removable
            if [ -e $conf/usb.disk0.ro ]
            then
                    echo 1 > functions/mass_storage.disk0/lun.0/ro
                    echo 0 > functions/mass_storage.disk0/lun.0/cdrom
            fi
            disk=$(cat $conf/usb.disk0)
            if [ -n "${disk}" ]
            then
                    cat $conf/usb.disk0 > functions/mass_storage.disk0/lun.0/file
            fi
            _image_name="USB Mass Storage"
            if [ "$(cat functions/mass_storage.disk0/lun.0/cdrom)" = 1 ]; then
                    _image_name="USB CD/DVD-ROM"
                    if [ "$(cat functions/mass_storage.disk0/lun.0/file)" = /dev/nbd0 ]; then
                            _image_name="Remote ISO"
                    fi
            fi
            storage_inquiry image "$_image_name" > functions/mass_storage.disk0/lun.0/inquiry_string || return 1
            # When usb.disk0 is empty, no backing file is set. The device
            # reports "no media" (removable=1). Previously this defaulted to
            # /dev/mmcblk0p3, exposing the NanoKVM's raw eMMC partition as a
            # USB disk — causing Legacy BIOS systems to hang during boot.
            # See: https://github.com/sipeed/NanoKVM/issues/633
    fi

    # UAC1 host speaker -> local ALSA capture. No microphone or interrupt FU.
    # Link last to preserve existing interface numbering.
    if [ -e $conf/usb.audio ]; then
        mkdir -p functions/uac1.audio0 || return 1
        echo 0 > functions/uac1.audio0/p_chmask || return 1
        echo 3 > functions/uac1.audio0/c_chmask || return 1
        echo 48000 > functions/uac1.audio0/c_srate || return 1
        echo 8 > functions/uac1.audio0/req_number || return 1
        echo 2 > functions/uac1.audio0/c_ssize || return 1
        echo 0 > functions/uac1.audio0/c_mute_present || return 1
        echo 0 > functions/uac1.audio0/c_volume_present || return 1
        echo 0 > functions/uac1.audio0/p_mute_present || return 1
        echo 0 > functions/uac1.audio0/p_volume_present || return 1
        ln -s functions/uac1.audio0 configs/c.1/ || return 1
    fi

    # An empty composition means USB disconnected, not an empty enumerated device.
    _has_function=0
    for _link in configs/c.1/*; do
        if [ -L "$_link" ]; then _has_function=1; break; fi
    done
    if [ "$_has_function" = 0 ]; then
        echo "USB functions disabled"
        return 0
    fi
    ls /sys/class/udc/ | cat > UDC
    set_usb_role device
    # NCM netdev can be recreated when the USB composition changes.
    if [ -x /etc/init.d/S29qdisc ]; then
        /etc/init.d/S29qdisc usb0 || echo "Could not apply fq_codel to USB NCM" >&2
    fi
}

stop_usb_dev(){
    if [ -n "$(cat /sys/kernel/config/usb_gadget/g0/UDC)" ]; then
        echo '' > /sys/kernel/config/usb_gadget/g0/UDC || return 1
    fi
}

restart_usb_dev(){
    # Preserve a deliberately empty composition across the USB reset action.
    _has_function=0
    for _link in /sys/kernel/config/usb_gadget/g0/configs/c.1/*; do
        if [ -L "$_link" ]; then _has_function=1; break; fi
    done
    if [ "$_has_function" = 0 ]; then
        stop_usb_dev
        return $?
    fi
    echo > /sys/kernel/config/usb_gadget/g0/UDC
    sleep 1
    ls /sys/class/udc/ | cat > /sys/kernel/config/usb_gadget/g0/UDC
    echo "USB Restart OK!"
}

case "$1" in
  start)
    start_usb_dev
  ;;
  restart)
    restart_usb_dev
  ;;
  stop)
    stop_usb_dev
  ;;
  stop_start)
    stop_usb_dev
    start_usb_dev
  ;;
   restart_phy)
    # Keep the legacy API action name, but preserve the controller device.
    # Removing DWC2 leaves retained NCM netdevs referring to its old gadget
    # parent on vendor kernels. Rebuild the composition via UDC detach/bind.
    start_usb_dev || exit 1
  ;;
esac
