#!/bin/sh
# Explicit live TX scheduling, with a same-boot restoration journal.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
proc=/proc
state_dir=/run/nanokvm-wifi-tx-live
state=$state_dir/saved
temporary=
fail() { echo "$*" >&2; exit 1; }
[ "$#" -eq 1 ] || fail 'Usage: nanokvm-wifi-tx-live status|normal|restore'
case "$1" in status|normal|restore) ;; *) fail 'Unknown live operation' ;; esac
[ "${NANOKVM_SYSROOT:-/}" = / ] || fail 'Live scheduling cannot target an offline image'
[ "$(id -u)" -eq 0 ] || fail 'Live scheduling requires root'
[ ! -L "$state_dir" ] || fail 'Refusing symlink state directory'
umask 077
mkdir -p "$state_dir"
[ "$(ls -nd "$state_dir" | awk '{print $3}')" = 0 ] || fail 'State directory is not root-owned'
chmod 700 "$state_dir"
[ ! -L "$state" ] || fail 'Refusing symlink journal'
[ ! -L "$state_dir/lock" ] || fail 'Refusing symlink lock'
exec 9>"$state_dir/lock"
flock -n 9 || fail 'Another live TX operation is running'
trap '[ -z "$temporary" ] || rm -f "$temporary"' EXIT
trap 'exit 130' HUP INT TERM
boot=$(cat "$proc/sys/kernel/random/boot_id")

# comm has no spaces; PF_KTHREAD and kthreadd parent distinguish kernel threads.
inspect() {
    [ -r "$proc/$1/stat" ] || return 1
    awk -v pid="$1" '$1 == pid && $2 == "(aicwf_bustx_thread)" && $4 == 2 && int($9/2097152)%2 == 1 {print $1,$22,$41,$40; found=1} END {exit !found}' "$proc/$1/stat"
}
discover() {
    for item in "$proc"/[0-9]*/comm; do
        read -r comm < "$item" 2>/dev/null || continue
        [ "$comm" = aicwf_bustx_thread ] || continue
        pid=${item%/comm}; pid=${pid##*/}
        inspect "$pid" 2>/dev/null || :
    done
}
validate_state() {
    [ -f "$state" ] && [ ! -L "$state" ] || return 1
    awk 'NR==1 {if(NF!=2 || $1!="NK_WIFI_TX_V1" || length($2)!=36 || $2!~/^[0-9a-f-]+$/) exit 1;next}
    {if(NF!=4 || $1!~/^[0-9]+$/ || $2!~/^[0-9]+$/ || $3!~/^[01]$/ || $4!~/^[01]$/ || $1<=0 || $2<=0 || seen[$1]++ || !(($3==0 && $4==0)||($3==1 && $4==1))) exit 1;count++}
    END {if(count<1 || count>16) exit 1}' "$state"
}
restore_saved() {
    [ -e "$state" ] || { echo 'No saved live policy'; return 0; }
    validate_state || { echo 'Invalid restoration journal' >&2; return 1; }
    read -r tag saved_boot < "$state"
    if [ "$saved_boot" != "$boot" ]; then
        rm -f "$state"
        echo 'Discarded previous-boot journal; no threads changed'
        return 0
    fi
    restore_failed=0
    while read -r saved_pid saved_start saved_policy saved_priority; do
        [ "$saved_pid" != NK_WIFI_TX_V1 ] || continue
        if ! row=$(inspect "$saved_pid"); then echo "Skipped exited/replaced TX $saved_pid"; continue; fi
        set -- $row
        if [ "$2" != "$saved_start" ]; then echo "Skipped reused PID $saved_pid"; continue; fi
        if [ "$3:$4" = "$saved_policy:$saved_priority" ]; then continue; fi
        if [ "$3:$4" != 0:0 ]; then echo "TX $saved_pid changed externally; journal retained" >&2; restore_failed=1;continue;fi
        flag=-o; [ "$saved_policy" = 0 ] || flag=-f
        if ! chrt "$flag" -p "$saved_priority" "$saved_pid"; then restore_failed=1;continue;fi
        if ! after=$(inspect "$saved_pid") || [ "$after" != "$saved_pid $saved_start $saved_policy $saved_priority" ]; then restore_failed=1;continue;fi
        echo "Restored TX $saved_pid policy=$saved_policy priority=$saved_priority"
    done < "$state"
    [ "$restore_failed" = 0 ] || return 1
    rm -f "$state"
}
if [ "$1" = status ]; then
    if [ -e "$state" ]; then validate_state || fail 'Invalid restoration journal'; echo 'Saved live policy: present'; head -1 "$state";else echo 'Saved live policy: absent';fi
    echo 'PID START_TICKS POLICY PRIORITY (0=OTHER, 1=FIFO)'
    discover
    exit 0
fi
if [ "$1" = restore ]; then restore_saved;exit $?;fi

temporary=$(mktemp "$state_dir/.snapshot.XXXXXX")
printf 'NK_WIFI_TX_V1 %s\n' "$boot" > "$temporary"
discover >> "$temporary"
count=$(awk 'END {print NR-1}' "$temporary")
[ "$count" -gt 0 ] && [ "$count" -le 16 ] || fail 'No TX kernel threads, or unexpected thread count'
awk 'NR>1 && !(($3==0 && $4==0)||($3==1 && $4==1)) {exit 1}' "$temporary" || fail 'Unsupported existing TX policy; no changes made'
if [ -e "$state" ]; then
    validate_state || fail 'Invalid restoration journal'
    read -r tag saved_boot < "$state"
    [ "$saved_boot" = "$boot" ] || fail 'Previous-boot journal: run restore before applying'
    [ "$(awk 'NR>1 {print $1,$2}' "$state" | sort -n)" = "$(awk 'NR>1 {print $1,$2}' "$temporary" | sort -n)" ] || fail 'TX thread set changed: restore before applying'
    awk 'NR>1 && ($3!=0 || $4!=0) {exit 1}' "$temporary" || fail 'Saved policy exists but TX is not normal: restore first'
    echo 'Live TX already normal; original restoration journal preserved'
    exit 0
fi
# Commit the original state before any scheduler changes. SIGKILL may leave this
# journal behind; explicit restore verifies boot, thread identity and policy.
mv "$temporary" "$state"
temporary=
apply_failed=0
while read -r saved_pid saved_start saved_policy saved_priority; do
    [ "$saved_pid" != NK_WIFI_TX_V1 ] || continue
    if ! row=$(inspect "$saved_pid") || [ "$row" != "$saved_pid $saved_start $saved_policy $saved_priority" ];then apply_failed=1;break;fi
    if [ "$saved_policy:$saved_priority" = 0:0 ]; then continue;fi
    if ! chrt -o -p 0 "$saved_pid"; then apply_failed=1;break;fi
    if ! after=$(inspect "$saved_pid") || [ "$after" != "$saved_pid $saved_start 0 0" ];then apply_failed=1;break;fi
    echo "Applied TX $saved_pid policy=0 priority=0"
done < "$state"
if [ "$apply_failed" != 0 ]; then
    echo 'Apply failed; attempting restoration' >&2
    restore_saved || echo 'Restoration incomplete; journal retained for retry' >&2
    exit 1
fi
echo 'Live TX normal; original policy saved for restore'
