#!/bin/sh
# Optional shared CryptoDMA owner (platform/modules/hwcrypto).
case "$1" in
    start|restart)
        [ -e /etc/kvm/disable_hardware_aes ] || modprobe nanokvm_hwcrypto ||
            echo 'CryptoDMA unavailable; the application uses software AES' >&2
        ;;
    stop)
        # Active sessions or uncertain DMA ownership may pin the module.
        # Shutdown must never force-unload the shared owner.
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
exit 0
