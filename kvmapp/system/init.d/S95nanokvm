#!/bin/sh
# nanokvm Rev3.1

wait_for_exit() {
    process="$1"
    timeout="$2"
    elapsed=0

    while pidof "$process" >/dev/null 2>&1; do
        if [ "$elapsed" -ge "$timeout" ]; then
            return 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

stop_process() {
    process="$1"

    if ! pidof "$process" >/dev/null 2>&1; then
        return
    fi

    # Non-interactive shells start asynchronous jobs with SIGINT ignored.
    # SIGTERM is handled by NanoKVM-Server and reaches detached services.
    killall -TERM "$process" 2>/dev/null || true
    if wait_for_exit "$process" 10; then
        return
    fi

    killall -KILL "$process" 2>/dev/null || true
    if wait_for_exit "$process" 2; then
        return 0
    fi

    echo "Cannot stop $process; refusing to restart NanoKVM services" >&2
    return 1
}

server_supervisor() {
    /kvmapp/system/init.d/nanokvm-server-supervisor "$@"
}

stop_services() {
    server_supervisor stop || return 1
    # The server owns VI/VPSS. Let it release MMF before stopping kvm_system.
    stop_process NanoKVM-Server || return 1
    server_supervisor wait || return 1
    stop_process kvm_system || return 1
}

server=/kvmapp/server/NanoKVM-Server
hardware_daemon=/kvmapp/kvm_system/kvm_system

start_background() {
    executable="$1"
    if [ "$executable" = "$server" ]; then
        # Preserve the currently tested Go sysmon policy; 0 explicitly disables it.
        : "${NANOKVM_SYSMON_TIMER_SLACK_NS:=250000}"
        # Sysmon sleep floor while GOMAXPROCS=1; 0 explicitly disables it.
        : "${NANOKVM_SYSMON_MIN_DELAY_US:=1000}"
        export NANOKVM_SYSMON_TIMER_SLACK_NS NANOKVM_SYSMON_MIN_DELAY_US
        # Measured WebRTC packet sender settings; explicit overrides are kept.
        # (The frame queue, UDP batching with GSO and CryptoDMA SRTP AES are built in.)
        : "${NANOKVM_WEBRTC_UDP_BATCH_FLUSH_US:=1000}"
        : "${GOMAXPROCS:=1}"
        export NANOKVM_WEBRTC_UDP_BATCH_FLUSH_US
        export GOMAXPROCS
        : "${LD_LIBRARY_PATH:=/kvmapp/server/dl_lib}"
        export LD_LIBRARY_PATH
    fi
    if [ "$executable" = "$server" ]; then
        # The server raises itself to nice -10 until the first viewer
        # (startpriority), but only once its runtime has started; starting
        # it there covers that start too. Restarts keep it as well.
        nohup nice -n -10 /kvmapp/system/init.d/nanokvm-server-supervisor run "$executable" </dev/null >/dev/null 2>&1 &
    else
        nohup "$executable" </dev/null >/dev/null 2>&1 &
    fi
    if [ "$executable" = "$hardware_daemon" ]; then
        # Let the OOM killer take helpers such as apk before the hardware
        # daemon. NanoKVM-Server sets the same value for itself at start.
        { echo -300 > "/proc/$!/oom_score_adj"; } 2>/dev/null || true
    fi
}

# The video settings are the device's, not a package's: write the defaults
# where a setting is missing (a fresh image or a restored root). Shell tests
# only, no process, when they are there.
video_settings() {
    [ -d /kvmapp/kvm ] || mkdir -p /kvmapp/kvm
    [ -s /kvmapp/kvm/fps ] || printf '90' > /kvmapp/kvm/fps
    [ -s /kvmapp/kvm/qlty ] || printf '15000' > /kvmapp/kvm/qlty
    [ -s /kvmapp/kvm/res ] || printf '0' > /kvmapp/kvm/res
    [ -s /kvmapp/kvm/type ] || printf 'h265' > /kvmapp/kvm/type
}

prepare_hdmi_receiver() {
    # A stopped/idle capture leaves the driver-owned receiver reset asserted.
    # Release it before kvm_system probes I2C and the server initializes VI/MMF.
    # The server reapplies the persisted capture-disabled policy before serving
    # clients; this does not enable streaming or change the user's preference.
    # The driver releases the reset at probe, so a boot finds it released and
    # does not wait; a restart after a stopped capture does.
    reset_state=/sys/bus/platform/devices/hdmi-reset/asserted
    receiver_reset=
    read -r receiver_reset < "$reset_state" || return 1
    [ "$receiver_reset" = 1 ] || return 0
    printf '0' > "$reset_state" || return 1
    # The receiver must see no I2C until it has loaded its firmware
    # (docs/VIDEO.md): a minimum quiet window, so not an I2C poll. UXC keeps
    # its one-second startup warmup; C/D load firmware more slowly.
    model=
    [ ! -r /etc/kvm/hdmi_version ] || read -r model < /etc/kvm/hdmi_version || true
    case "$model" in
        ux) sleep 1 ;;
        *) sleep 2.5 ;;
    esac
}

start_services() {
    # One look for a running server: every process started here comes before
    # the server's, at boot as well.
    server_running=0
    pidof NanoKVM-Server >/dev/null 2>&1 && server_running=1
    # Migrate only after the old server has stopped writing the legacy flags.
    # Refuse to start a server that would interpret an incomplete set.
    if [ "$server_running" = 0 ]; then
        /usr/libexec/nanokvm/usb-flags-migrate || return 1
    fi
    # Runtime telemetry is regenerated on every boot. Keep the high-frequency
    # state off the persistent application filesystem and recreate its tmpfs
    # directory on every normal start.
    mkdir -p /run/nanokvm
    chmod 755 /run/nanokvm
    printf '0' > /run/nanokvm/now_fps
    printf '0' > /run/nanokvm/state
    printf '0' > /run/nanokvm/wifi_state
    # MMF needs a valid provisional capture size before the HDMI receiver has
    # published its first measurement. These are the vendor defaults.
    printf '1920' > /run/nanokvm/width
    printf '1080' > /run/nanokvm/height

    if [ "$server_running" = 0 ]; then
        # Without a usable receiver reset the server still starts, without video.
        prepare_hdmi_receiver || echo 'Starting without video: the HDMI receiver reset is not usable' >&2
        # The server writes it once it listens (nanokvm-app waits for it).
        [ ! -e /run/nanokvm/listening ] || rm -f /run/nanokvm/listening
    fi

    video_settings
    start_background "$hardware_daemon"

    if [ "$server_running" = 0 ]; then
        start_background "$server"
    fi
}

case "$1" in
  start)
    # Here and below the shell reads the small files itself: each process
    # started at boot comes before the server's.

    # Generate unique device key: the two fields of "UID: <first>_<second>"
    # joined, as cut took them, read by the shell itself.
    if [ -f /sys/class/cvi-base/base_uid ]; then
        read -r _ str_value _ < /sys/class/cvi-base/base_uid
        first_uint=${str_value%%_*}
        second_uint=${str_value#*_}
        second_uint=${second_uint%%_*}
        device_key="$first_uint$second_uint"
        current_key=
        [ ! -r /device_key ] || read -r current_key < /device_key || true
        [ "$current_key" = "$device_key" ] || printf '%s\n' "$device_key" > /device_key
    fi

    # Firewall policy is configured separately; app startup adds no rules.

    # Start services
    start_services
   ;;

  stop)
    stop_services || exit 1
    echo "OK"
   ;;

  restart)
    stop_services || exit 1
    start_services || exit 1

    sync
    echo "OK"
   ;;
    
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
  ;;
esac
