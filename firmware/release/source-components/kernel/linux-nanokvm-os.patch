+/* The UDC checks whether the host enabled USB remote wakeup. */
+static void hidg_wakeup_host(struct f_hidg *hidg)
+{
+	struct usb_gadget *gadget = NULL;
+	unsigned long flags;
+
+	/* An open HID file may outlive disconnect. Pin the gadget while active. */
+	spin_lock_irqsave(&hidg->write_spinlock, flags);
+	if (hidg->req && hidg->func.config->cdev->suspended) {
+		gadget = hidg->func.config->cdev->gadget;
+		get_device(&gadget->dev);
+	}
+	spin_unlock_irqrestore(&hidg->write_spinlock, flags);
+
+	if (gadget) {
+		usb_gadget_wakeup(gadget);
+		put_device(&gadget->dev);
+	}
+}
