{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "mocked": "vite --mode mocked",
    "build": "tsc && vite build",
    "test:usb": "node --experimental-strip-types --test tests/usb-composition.test.mjs",
    "test:direct": "node --import tsx --test tests/direct-playout.test.mjs tests/direct-worker.test.mjs",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@xterm/addon-attach": "0.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.3",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "crypto-js": "4.2.0",
    "i18next": "26.4.2",
    "jotai": "3.0.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-draggable": "4.7.1",
    "react-error-boundary": "6.1.5",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.0.13",
    "react-markdown": "10.1.0",
    "react-responsive": "10.0.1",
    "react-router-dom": "7.18.3",
    "react-simple-keyboard": "3.8.270",
    "remark-gfm": "4.0.1",
    "vaul": "1.1.2",
    "websocket": "1.0.35",
    "yocto-queue": "1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/crypto-js": "4.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/websocket": "1.0.10",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.6",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "msw": "2.15.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "yaml": "2.9.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "4.23.13"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
