#!/sbin/openrc-run

description="NanoKVM hardware daemon and web server"

# Startup policy belongs to the app package. A base-owned copy remains stale
# after an app-only update and silently loses the runtime defaults from the app.

depend() {
    # nanokvm-board fails only when settings recovery failed: then the
    # restored configuration cannot be used. Without the media modules or the
    # board's hardware steps the server still starts, without video if need
    # be: settings, updates, ATX power and USB HID stay reachable. A failed
    # step used to keep a remote device locked out.
    need nanokvm-storage nanokvm-board
    use nanokvm-modules nanokvm-policy
    after nanokvm-modules nanokvm-policy
    # Not after the network: the server listens on every address and serves
    # each interface as it comes up.
    after nanokvm-usb
    before chronyd crond
}

# The server writes it once its web listener is bound; S95nanokvm removes it
# before starting the server.
: "${NANOKVM_SERVER_LISTENING:=/run/nanokvm/listening}"
: "${NANOKVM_APP_START:=/kvmapp/system/init.d/S95nanokvm}"

start() {
    local n=0
    ebegin "Starting NanoKVM application"
    "$NANOKVM_APP_START" start || { eend 1; return 1; }
    # The services after this one start once the server listens (at most
    # 15 s): on one core they would slow its start, and with it the first
    # video frame. A file test per step, no process.
    while [ ! -e "$NANOKVM_SERVER_LISTENING" ] && [ "$n" -lt 150 ]; do
        sleep 0.1
        n=$((n + 1))
    done
    eend 0
}

stop() {
    ebegin "Stopping NanoKVM application"
    /kvmapp/system/init.d/S95nanokvm stop
    eend $?
}
