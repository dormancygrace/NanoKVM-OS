#!/sbin/openrc-run

description="NanoKVM board identity and hardware setup"

: "${NANOKVM_BOARD_LEGACY_DIR:=/usr/libexec/nanokvm/legacy}"

depend() {
    need nanokvm-storage
    # The chip UID for the hostname and Ethernet MAC comes from cv181x_base.
    # Apply the identity even if a later media module fails; nanokvm-app
    # requires the complete module set itself.
    use nanokvm-modules
    before nanokvm-network nanokvm-app
}

run_legacy() {
    local script="$1"
    [ ! -x "$NANOKVM_BOARD_LEGACY_DIR/$script" ] ||
        "$NANOKVM_BOARD_LEGACY_DIR/$script" start
}

start() {
    local script failed=
    ebegin "Configuring NanoKVM board"
    # Apply queued settings before identity, networking or the application.
    # An ordinary failure rolls back; an incomplete rollback fails closed.
    if [ -e /var/lib/nanokvm-recovery/pending.json ]; then
        /usr/sbin/nkos-update recovery-resume || { eend 1 "Settings recovery failed"; return 1; }
    fi
    # Run every step. A missing sensor configuration or an unidentified HDMI
    # receiver must not skip the device identity used by the network. Nor do
    # they stop the board: its consumers start without video then, and only a
    # failed settings recovery above keeps them stopped (docs/BOOT.md).
    for script in S02config S10uuid S15kvmhwd; do
        run_legacy "$script" || failed="$failed $script"
    done
    if [ -n "$failed" ]; then
        ewarn "NanoKVM board setup incomplete:$failed; starting without it"
        logger -t nanokvm-board "board setup incomplete:$failed" 2>/dev/null || true
    fi
    eend 0
}
