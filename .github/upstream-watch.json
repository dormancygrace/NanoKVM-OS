{
  "sources": [
    {
      "name": "Linux",
      "path": "platform/sources.lock",
      "pattern": "linux-([0-9.]+)\\.tar",
      "kind": "index",
      "url": "https://www.kernel.org/releases.json",
      "upstream_pattern": "\"version\"\\s*:\\s*\"([0-9]+\\.[0-9]+\\.[1-9][0-9]*)\"",
      "lock_entry": "linux"
    },
    {
      "name": "Buildroot",
      "path": "platform/sources.lock",
      "pattern": "buildroot-([0-9.]+)\\.tar",
      "kind": "index",
      "url": "https://buildroot.org/downloads/",
      "upstream_pattern": "href=\"buildroot-([0-9]{4}\\.[0-9]{2}(?:\\.[0-9]+)?)\\.tar\\.(?:gz|xz)\"",
      "lock_entry": "buildroot",
      "pull_request": {
        "id": "buildroot",
        "mode": "archive-pin"
      }
    },
    {
      "name": "U-Boot",
      "path": "platform/sources.lock",
      "pattern": "(?m)^u-boot\\s+\\S*/v([0-9.]+)\\.tar\\.gz",
      "kind": "github-tags",
      "upstream_pattern": "^v([0-9]{4}\\.[0-9]{2}(?:\\.[0-9]+)?)$",
      "lock_entry": "u-boot",
      "repo": "u-boot/u-boot",
      "pull_request": {
        "id": "u-boot",
        "mode": "archive-pin"
      }
    },
    {
      "name": "osdrv",
      "path": "platform/sources.lock",
      "pattern": "^osdrv\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "sophgo/osdrv",
      "branch": "sg200x-dev",
      "lock_entry": "osdrv",
      "pull_request": {
        "id": "osdrv",
        "mode": "git-pin"
      }
    },
    {
      "name": "aic8800",
      "path": "platform/sources.lock",
      "pattern": "^aic8800\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "radxa-pkg/aic8800",
      "branch": null,
      "lock_entry": "aic8800",
      "pull_request": {
        "id": "aic8800",
        "mode": "git-pin"
      }
    },
    {
      "name": "cryptodev",
      "path": "platform/sources.lock",
      "pattern": "^cryptodev\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "cryptodev-linux/cryptodev-linux",
      "branch": null,
      "lock_entry": "cryptodev",
      "pull_request": {
        "id": "cryptodev",
        "mode": "git-pin"
      }
    },
    {
      "name": "sipeed-sdk",
      "path": "platform/sources.lock",
      "pattern": "^sipeed-sdk\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "sipeed/LicheeRV-Nano-Build",
      "branch": null,
      "lock_entry": "sipeed-sdk",
      "pull_request": {
        "id": "sipeed-sdk",
        "mode": "git-pin"
      }
    },
    {
      "name": "sophgo_cvi_mpi",
      "path": "platform/sources.lock",
      "pattern": "^cvi-mpi\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "sophgo/cvi_mpi",
      "branch": "sg200x-dev",
      "lock_entry": "cvi-mpi",
      "pull_request": {
        "id": "sophgo-cvi-mpi",
        "mode": "git-pin"
      }
    },
    {
      "name": "sophgo_kernel_port_reference",
      "path": "firmware/sources.json",
      "pattern": "\"sophgo_kernel_port_reference\"\\s*:\\s*\\{[^}]*\"commit\"\\s*:\\s*\"([0-9a-f]{40})\"",
      "kind": "github-commit",
      "repo": "sophgo/linux_5.10",
      "branch": null,
      "pull_request": {
        "id": "sophgo-kernel-port-reference",
        "mode": "review"
      }
    },
    {
      "name": "json_c",
      "path": "firmware/sources.json",
      "pattern": "\"json_c\"\\s*:\\s*\\{[^}]*\"version\"\\s*:\\s*\"([0-9.]+)\"",
      "kind": "github-tags",
      "repo": "json-c/json-c",
      "upstream_pattern": "^json-c-([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)-[0-9]{8}$",
      "lock_entry": "json-c",
      "pull_request": {
        "id": "json-c",
        "mode": "git-pin"
      }
    },
    {
      "name": "miniz",
      "path": "platform/sources.lock",
      "pattern": "^miniz\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-release-commit",
      "repo": "richgel999/miniz",
      "lock_entry": "miniz",
      "pull_request": {
        "id": "miniz",
        "mode": "git-pin"
      }
    },
    {
      "name": "inih",
      "path": "platform/sources.lock",
      "pattern": "^inih\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-release-commit",
      "repo": "benhoyt/inih",
      "lock_entry": "inih",
      "pull_request": {
        "id": "inih",
        "mode": "git-pin"
      }
    },
    {
      "name": "sophgo_sensors",
      "path": "platform/sources.lock",
      "pattern": "^sensors\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "sophgo/SensorSupportList",
      "branch": "sg200x-dev",
      "lock_entry": "sensors",
      "pull_request": {
        "id": "sophgo-sensors",
        "mode": "git-pin"
      }
    },
    {
      "name": "Go runtime",
      "path": "firmware/cpu/sysmon-runtime/go-source-pin.json",
      "pattern": "\"go_version\":\\s*\"go([0-9.]+)\"",
      "kind": "index",
      "url": "https://go.dev/dl/?mode=json",
      "upstream_pattern": "\"version\"\\s*:\\s*\"go([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)\"",
      "lock_entry": "go",
      "pull_request": {
        "id": "go-runtime",
        "mode": "review"
      }
    },
    {
      "name": "Alpine stable branch",
      "path": "scripts/build-alpine-packages.sh",
      "pattern": "ALPINE_VERSION=\"([0-9.]+)\"",
      "kind": "index",
      "url": "https://dl-cdn.alpinelinux.org/alpine/",
      "upstream_pattern": "href=\"v([0-9]+\\.[0-9]+)/\"",
      "pull_request": {
        "id": "alpine-stable-branch",
        "mode": "review"
      }
    },
    {
      "name": "Opus",
      "path": "platform/sources.lock",
      "pattern": "opus-([0-9.]+)\\.tar",
      "kind": "github-tags",
      "repo": "xiph/opus",
      "upstream_pattern": "^v([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$",
      "lock_entry": "opus",
      "pull_request": {
        "id": "opus",
        "mode": "archive-pin"
      }
    },
    {
      "name": "exfatprogs",
      "path": "platform/sources.lock",
      "pattern": "exfatprogs-([0-9.]+)\\.tar",
      "kind": "github-tags",
      "repo": "exfatprogs/exfatprogs",
      "upstream_pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)$",
      "lock_entry": "exfatprogs",
      "pull_request": {
        "id": "exfatprogs",
        "mode": "archive-pin"
      }
    },
    {
      "name": "i2c-tools",
      "lock_entry": "i2c-tools",
      "path": "platform/sources.lock",
      "pattern": "i2c-tools-([0-9.]+)\\.tar",
      "kind": "index",
      "url": "https://www.kernel.org/pub/software/utils/i2c-tools/",
      "upstream_pattern": "i2c-tools-([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)\\.tar",
      "pull_request": {
        "id": "i2c-tools",
        "mode": "archive-pin"
      }
    },
    {
      "name": "tinyalsa",
      "path": "platform/sources.lock",
      "pattern": "^tinyalsa\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "tinyalsa/tinyalsa",
      "branch": null,
      "lock_entry": "tinyalsa",
      "pull_request": {
        "id": "tinyalsa",
        "mode": "git-pin"
      },
      "cadence": "quarterly"
    },
    {
      "name": "Patched Pion dtls/v3",
      "path": "server/go.mod",
      "pattern": "github.com/pion/dtls/v3\\s+v([0-9.]+)",
      "kind": "github-tags",
      "repo": "pion/dtls",
      "upstream_pattern": "^v([0-9]+\\.[0-9]+\\.[0-9]+)$",
      "pull_request": {
        "id": "patched-pion-dtls-v3",
        "mode": "review"
      }
    },
    {
      "name": "Patched Pion ice/v4",
      "path": "server/go.mod",
      "pattern": "github.com/pion/ice/v4\\s+v([0-9.]+)",
      "kind": "github-tags",
      "repo": "pion/ice",
      "upstream_pattern": "^v([0-9]+\\.[0-9]+\\.[0-9]+)$",
      "pull_request": {
        "id": "patched-pion-ice-v4",
        "mode": "review"
      }
    },
    {
      "name": "Patched Pion srtp/v3",
      "path": "server/go.mod",
      "pattern": "github.com/pion/srtp/v3\\s+v([0-9.]+)",
      "kind": "github-tags",
      "repo": "pion/srtp",
      "upstream_pattern": "^v([0-9]+\\.[0-9]+\\.[0-9]+)$",
      "pull_request": {
        "id": "patched-pion-srtp-v3",
        "mode": "review"
      }
    },
    {
      "name": "OpenSBI",
      "lock_entry": "opensbi",
      "path": "platform/sources.lock",
      "pattern": "^opensbi\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-release-commit",
      "repo": "riscv-software-src/opensbi",
      "pull_request": {
        "id": "opensbi",
        "mode": "git-pin"
      }
    },
    {
      "name": "zlib-ng",
      "lock_entry": "zlib-ng",
      "path": "platform/sources.lock",
      "pattern": "^zlib-ng\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-release-commit",
      "repo": "zlib-ng/zlib-ng",
      "pull_request": {
        "id": "zlib-ng",
        "mode": "git-pin"
      }
    },
    {
      "name": "xz (liblzma)",
      "lock_entry": "xz",
      "path": "platform/sources.lock",
      "pattern": "^xz\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-release-commit",
      "repo": "tukaani-project/xz",
      "pull_request": {
        "id": "xz",
        "mode": "git-pin"
      }
    },
    {
      "name": "BusyBox devmem applet",
      "lock_entry": "busybox",
      "path": "platform/sources.lock",
      "pattern": "busybox-([0-9.]+)\\.tar",
      "kind": "index",
      "url": "https://busybox.net/downloads/",
      "upstream_pattern": "busybox-([0-9]+\\.[0-9]+\\.[0-9]+)\\.tar",
      "pull_request": {
        "id": "busybox-devmem-applet",
        "mode": "archive-pin"
      }
    },
    {
      "name": "wireless-regdb",
      "lock_entry": "regdb",
      "path": "platform/sources.lock",
      "pattern": "wireless-regdb-([0-9.]+)\\.tar",
      "kind": "index",
      "url": "https://mirrors.edge.kernel.org/pub/software/network/wireless-regdb/",
      "upstream_pattern": "wireless-regdb-([0-9]+\\.[0-9]+\\.[0-9]+)\\.tar",
      "pull_request": {
        "id": "wireless-regdb",
        "mode": "archive-pin"
      }
    },
    {
      "name": "Node (selected LTS)",
      "lock_entry": "node",
      "path": "platform/sources.lock",
      "pattern": "^node\\s+\\S*/node-v([0-9.]+)-linux",
      "kind": "index",
      "url": "https://nodejs.org/dist/index.json",
      "upstream_pattern": "\"version\"\\s*:\\s*\"v([0-9]+\\.[0-9]+\\.[0-9]+)\"",
      "same_major": true,
      "pull_request": {
        "id": "node-selected-lts",
        "mode": "archive-pin"
      }
    },
    {
      "name": "pnpm",
      "lock_entry": "pnpm",
      "path": "platform/sources.lock",
      "pattern": "exe\\.linux-x64-([0-9.]+)\\.tgz",
      "kind": "npm",
      "package": "@pnpm/exe.linux-x64",
      "pull_request": {
        "id": "pnpm",
        "mode": "archive-pin"
      }
    },
    {
      "name": "Alpine minirootfs",
      "lock_entry": "alpine",
      "path": "platform/sources.lock",
      "pattern": "alpine-minirootfs-([0-9.]+)-riscv64",
      "kind": "alpine-rootfs",
      "pull_request": {
        "id": "alpine-minirootfs",
        "mode": "archive-pin"
      }
    },
    {
      "name": "QEMU Ubuntu build helper",
      "lock_entry": "qemu",
      "path": "platform/sources.lock",
      "pattern": "qemu-user-static_([^/]+)_amd64\\.deb",
      "kind": "launchpad-binary",
      "package": "qemu-user-static",
      "series": "noble"
    },
    {
      "name": "RustDesk protocol reference",
      "path": "addons/rustdesk/upstream.json",
      "pattern": "\"rustdesk_version\":\\s*\"([0-9.]+)\"",
      "kind": "rustdesk-release-reference",
      "repo": "rustdesk/rustdesk",
      "pull_request": {
        "id": "rustdesk-protocol-reference",
        "mode": "review"
      }
    },
    {
      "name": "Go CORS nested module",
      "path": "server/go.mod",
      "pattern": "github.com/rs/cors/wrapper/gin\\s+(v[^\\s]+)",
      "kind": "go-proxy",
      "module": "github.com/rs/cors/wrapper/gin",
      "pull_request": {
        "id": "go-cors-nested-module",
        "mode": "review"
      }
    },
    {
      "name": "AES Bridge Go (test compatibility)",
      "path": "server/go.mod",
      "pattern": "github.com/mervick/aes-bridge-go\\s+(v[^\\s]+)",
      "kind": "go-proxy",
      "module": "github.com/mervick/aes-bridge-go",
      "pull_request": {
        "id": "aes-bridge-go-test-compatibility",
        "mode": "review"
      }
    },
    {
      "name": "GCC compiler",
      "path": "platform/build.sh",
      "pattern": "gcc\" -dumpfullversion\\)\" = ([0-9.]+)",
      "kind": "index",
      "url": "https://ftp.gnu.org/gnu/gcc/",
      "upstream_pattern": "href=\"gcc-([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
      "pull_request": {
        "id": "gcc-compiler",
        "mode": "review"
      }
    }
  ]
}
