CONFIG_RISCV=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
CONFIG_SYS_MALLOC_LEN=0x820000
CONFIG_SYS_MALLOC_F_LEN=0x8000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x82300000
CONFIG_DEFAULT_DEVICE_TREE="sg2002-licheerv-nano-b"
CONFIG_SYS_LOAD_ADDR=0x80080000
CONFIG_IDENT_STRING=" NanoKVM OS"
CONFIG_TARGET_LICHEERV_NANO=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_SMODE=y
# CONFIG_RISCV_ISA_F is not set
# CONFIG_RISCV_ISA_D is not set
CONFIG_FIT=y
# CONFIG_FIT_PRINT is not set
# CONFIG_BOOTSTD is not set
# CONFIG_EFI_LOADER is not set
CONFIG_SD_BOOT=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv bootargs root=/dev/mmcblk0p2 rootwait rw console=ttyS0,115200 earlycon=sbi riscv.fwsz=0x80000 release loglevel=0 mitigations=off ${extraargs}; setenv fdt_high 0x8cffffff; setenv initrd_high 0x8cffffff; for image in boot.sd boot.prev; do if fatload mmc 0:1 0x85000000 ${image}; then bootm 0x85000000#config-sg2002_licheervnano_sd_minimal; fi; done; reset"
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="if fatload mmc 0:1 0x85000000 uEnv.txt; then env import -t -r 0x85000000 ${filesize} bootdelay extraargs; fi"
CONFIG_HUSH_PARSER=y
CONFIG_SYS_CBSIZE=512
CONFIG_SYS_PBSIZE=544
CONFIG_BOARD_INIT=y
CONFIG_SYS_PROMPT="nanokvm# "
