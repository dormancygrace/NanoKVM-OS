+				pstMap->bMapped = ppack->u64PhyAddr && ppack->u32Len;
+				pstMap->pu8Single = NULL;
+				pstMap->s32Window = -1;
+				pstChn->u32Packs = i + 1;
+				if (pstMap->bMapped) {
+					pstMap->pu8KernelAddr = ppack->pu8Addr;
+					ppack->pu8Addr = vencMapPack(pstChn, ppack->u64PhyAddr, ppack->u32Len, pstMap);
 				}
 			}
 		}
@@ -253,16 +435,7 @@ CVI_S32 CVI_VENC_GetStream(VENC_CHN VeChn, VENC_STREAM_S *pstStream, CVI_S32 S32
