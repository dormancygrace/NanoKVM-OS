#!/bin/sh
# Persistent IPv6 policy per interface: Ethernet (eth0) and Wi-Fi (wlan0) each
# have their own setting; other interfaces (USB network, VPNs) have IPv6 when
# either of them has. Applied before interfaces are created and again for an
# interface udev adds later. Keep ::1 usable.
#
# The configuration file holds "eth0=1" and "wlan0=0" lines; an older "1" or
# "0" means both interfaces. A missing file means IPv6 is off.
#
#   S02ipv6 [start]            apply the saved configuration
#   S02ipv6 apply eth0=1 ...   apply the given setting (missing ones are off)
#   S02ipv6 interface NAME     apply the saved configuration to one interface
set -eu
: "${NANOKVM_IPV6_CONF:=/etc/kvm/network/ipv6}"
: "${NANOKVM_IPV6_SYSCTL:=/proc/sys/net/ipv6/conf}"

# Set the managed interfaces' values (1 = IPv6 on) from "name=value" words.
parse() {
    eth0=0 wlan0=0
    for item in "$@"; do
        case "$item" in
            0|1) eth0=$item wlan0=$item ;;
            eth0=0|eth0=1) eth0=${item#*=} ;;
            wlan0=0|wlan0=1) wlan0=${item#*=} ;;
            '') ;;
            *) echo "Invalid IPv6 configuration: $item" >&2; exit 1 ;;
        esac
    done
}

saved() {
    if [ -f "$NANOKVM_IPV6_CONF" ]; then
        # shellcheck disable=SC2046 # one word per line
        parse $(cat "$NANOKVM_IPV6_CONF")
    else
        parse
    fi
}

# disable_ipv6 value for an interface: its own setting, or "any" for others.
wanted() {
    case "$1" in
        lo) echo 0 ;;
        eth0) [ "$eth0" = 1 ] && echo 0 || echo 1 ;;
        wlan0) [ "$wlan0" = 1 ] && echo 0 || echo 1 ;;
        *) [ "$eth0" = 1 ] || [ "$wlan0" = 1 ] && echo 0 || echo 1 ;;
    esac
}

set_value() {
    file="$NANOKVM_IPV6_SYSCTL/$1/disable_ipv6"
    [ -f "$file" ] || return 0
    if [ "$(cat "$file")" != "$2" ]; then printf '%s\n' "$2" > "$file"; fi
}

case "${1:-start}" in
    start|restart) saved ;;
    apply) shift; parse "$@" ;;
    interface)
        name=${2:?Missing interface}
        saved
        [ -d "$NANOKVM_IPV6_SYSCTL" ] || exit 0
        set_value "$name" "$(wanted "$name")"
        exit 0
        ;;
    stop) exit 0 ;;
    *) exit 2 ;;
esac

others=$(wanted other)
# A kernel without IPv6 already satisfies a policy with IPv6 off.
if [ ! -d "$NANOKVM_IPV6_SYSCTL" ]; then [ "$others" = 1 ]; exit; fi
# "all" also rewrites every existing interface, so it comes first and the
# interfaces are reconciled after it; "default" is what new ones start with.
set_value all "$others"
set_value default "$others"
for dir in "$NANOKVM_IPV6_SYSCTL"/*/; do
    name=$(basename "$dir")
    case "$name" in all|default) continue ;; esac
    set_value "$name" "$(wanted "$name")"
done
