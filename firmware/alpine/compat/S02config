#!/bin/sh
# Import explicit boot-volume configuration. Board pinmux belongs to DT.
set -eu

: "${NANOKVM_CONFIG_BOOT:=/boot}"
: "${NANOKVM_CONFIG_ETC:=/etc}"
: "${NANOKVM_CONFIG_DATA:=/mnt/data}"

copy_config() (
    src=$1 destination=$2 mode=$3
    [ -f "$src" ] || return 0
    temporary=$(mktemp "${destination}.XXXXXX") || return 1
    trap 'rm -f "$temporary"' EXIT
    cat "$src" > "$temporary"
    chmod "$mode" "$temporary"
    mv -f "$temporary" "$destination"
)

case "${1:-}" in
    start)
        copy_config "$NANOKVM_CONFIG_BOOT/sshd_config" "$NANOKVM_CONFIG_ETC/ssh/sshd_config" 600
        copy_config "$NANOKVM_CONFIG_BOOT/resolv.conf" "$NANOKVM_CONFIG_ETC/resolv.conf" 644
        # NanoKVM OS is a NanoKVM receiver, not an Alpha/Beta camera.
        # Keep a populated sensor configuration, seed a missing/empty one from LT.
        if [ ! -s "$NANOKVM_CONFIG_DATA/sensor_cfg.ini" ]; then
            test -s "$NANOKVM_CONFIG_DATA/sensor_cfg.ini.LT"
            copy_config "$NANOKVM_CONFIG_DATA/sensor_cfg.ini.LT" "$NANOKVM_CONFIG_DATA/sensor_cfg.ini" 644
        fi
        echo 'NanoKVM boot configuration imported'
        ;;
    stop) ;;
    *) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac
