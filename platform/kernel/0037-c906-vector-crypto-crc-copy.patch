+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+	.option push
+	.option arch, rv64imac_zicsr_zifencei_xtheadvector
+	.text
+SYM_FUNC_START(__riscv_th_copy_csum)
+	li t0,0
+	li t1,1
+	th.vsetvli zero,t1,e32,m1
+	th.vmv.s.x v8,zero
+.Lcopy_loop:
+	li t1,2
+	bltu a2,t1,.Lcopy_tail
+	andi t1,a2,-2
+	th.vsetvli t2,t1,e8,m8
+	th.vlb.v v0,(a1)
+	th.vsb.v v0,(a0)
+	srli t1,t2,1
+	th.vsetvli zero,t1,e16,m8
+	th.vwredsumu.vs v8,v0,v8
+	add a0,a0,t2
+	add a1,a1,t2
+	sub a2,a2,t2
+	j .Lcopy_loop
+.Lcopy_tail:
+	beqz a2,.Lcopy_fold
+	lbu t0,0(a1)
+	sb t0,0(a0)
+.Lcopy_fold:
+	li t1,1
+	th.vsetvli zero,t1,e32,m1
+	th.vmv.x.s t1,v8
+	add t0,t0,t1
+	li t1,65535
+	and t2,t0,t1
+	srli t0,t0,16
+	add t0,t0,t2
+	and t2,t0,t1
+	srli t0,t0,16
+	add a0,t0,t2
+	ret
+SYM_FUNC_END(__riscv_th_copy_csum)
+	.option pop
