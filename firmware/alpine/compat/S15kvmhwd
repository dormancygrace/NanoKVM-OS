#!/bin/sh
# NanoKVM OS counterpart of the stock S15kvmhwd. Pinmux and board reset/enable
# ownership are in DT; do not export global GPIOs or reload i2c-gpio here.
#
# The selected DT owns the board. A saved receiver belongs to one chip UID.
# Runtime consumers share its validated model in /run/nanokvm/hdmi_version.
set -eu

: "${NANOKVM_KVM_ETC:=/etc/kvm}"
: "${NANOKVM_KVM_RUN:=/run/nanokvm}"
: "${NANOKVM_BOARD_REVISION:=/sys/firmware/devicetree/base/sipeed,board-revision}"
: "${NANOKVM_CHIP_UID:=/sys/class/cvi-base/base_uid}"
stamp=$NANOKVM_KVM_ETC/hdmi_uid
model=$NANOKVM_KVM_ETC/hdmi_version
live=$NANOKVM_KVM_RUN/hdmi_version
pending=$NANOKVM_KVM_ETC/hdmi-provision

die() { echo "S15kvmhwd: $*" >&2; exit 1; }

board_profile() {
    declared_board=$(tr -d '\000' < "$NANOKVM_BOARD_REVISION") ||
        die "board revision is missing from Device Tree"
    case "$declared_board" in
        alpha|beta|pcie) board=$declared_board ;;
        # Native OLED code keeps the beta name for base/Lite hardware.
        lite) board=beta ;;
        *) die "unselected or unknown boot profile: $declared_board" ;;
    esac
}

read_value() {
    value=
    if [ -r "$1" ]; then IFS= read -r value < "$1" || true; fi
}
publish() {
    read_value "$1"
    [ "$value" != "$2" ] || return 0
    tmp=$(mktemp "$1.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$2" > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$1"
    trap - EXIT
}

valid_model() { case "$1" in c|ux|d) return 0 ;; *) return 1 ;; esac; }

case "${1:-}" in
    stop) exit 0 ;;
    check) board_profile; echo "NanoKVM OS: detected board=$board"; exit 0 ;;
    re-detect)
        board_profile
        mkdir -p "$NANOKVM_KVM_ETC"
        : > "$pending"
        echo "HDMI receiver identification requested for the next boot"
        exit 0 ;;
    start|re-init|get_hdmi_version) ;;
    *) echo "Usage: $0 {start|stop|check|re-init|re-detect|get_hdmi_version}" >&2; exit 2 ;;
esac

if [ "$1" != get_hdmi_version ]; then
    board_profile
    [ -d "$NANOKVM_KVM_ETC" ] || mkdir -p "$NANOKVM_KVM_ETC"
    publish "$NANOKVM_KVM_ETC/hw" "$board"
    publish "$NANOKVM_KVM_ETC/board-profile" "$declared_board"
fi
[ -d "$NANOKVM_KVM_RUN" ] || mkdir -p "$NANOKVM_KVM_RUN"
read_value "$NANOKVM_CHIP_UID"
chip=$value
if [ -z "$chip" ]; then
    rm -f "$live"
    die "chip UID unavailable; HDMI receiver not enabled"
fi

if [ -e "$pending" ]; then
    rm -f "$live"
    [ "$1" = start ] || die "receiver provisioning pending until boot"
    identified=$(nanokvm_update_edid --identify) || die "HDMI identification failed; will retry provisioning"
    valid_model "$identified" || die "invalid HDMI receiver"
    # A power cut between these writes cannot associate an old model with a
    # new UID. An absent stamp has a different meaning on old installations.
    publish "$stamp" pending
    sync -f "$stamp"
    publish "$model" "$identified"
    sync -f "$model"
    publish "$stamp" "$chip"
    sync -f "$stamp"
    rm -f "$pending"
fi

read_value "$model"
identified=$value
read_value "$stamp"
if valid_model "$identified" && [ ! -e "$stamp" ]; then
    # Before 4.2 the receiver was recorded on this board without a UID.
    # Preserve that model, including a UXC whose second address is asleep.
    publish "$stamp" "$chip"
    value=$chip
fi
if ! valid_model "$identified" || [ "$value" != "$chip" ]; then
    rm -f "$live"
    die "receiver not provisioned for this chip; use re-detect and reboot"
fi
publish "$live" "$identified"
[ "$1" = get_hdmi_version ] || echo "NanoKVM OS: board=$board HDMI=$identified"
