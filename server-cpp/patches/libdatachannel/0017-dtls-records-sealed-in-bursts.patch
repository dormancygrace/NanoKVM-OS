+/**
+ * A sealer of DTLS 1.2 AES-128-GCM records, installed for the whole process: a crypto engine encrypts the records of
+ * a data channel's burst in one request instead of one each.
+ */
+
+#ifndef RTC_DTLS_RECORD_SEALER_H
+#define RTC_DTLS_RECORD_SEALER_H
+
+#include "common.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+namespace rtc {
+
+struct DtlsSealRecord {
+	uint8_t nonce[12];
+	uint8_t aad[13];
+	uint8_t *data; // length bytes encrypted in place, then the 16-byte tag written after them
+	size_t length;
+};
+
+class RTC_CPP_EXPORT DtlsRecordSealer {
+public:
+	virtual ~DtlsRecordSealer() = default;
+	// Seals records with the 16-byte key, in order, and returns how many it sealed; the data of the others is
+	// unchanged, and the transport seals them in software.
+	virtual size_t seal(const uint8_t *key, DtlsSealRecord *records, size_t count) = 0;
+};
+
+// With a sealer installed, a DTLS 1.2 connection that negotiated AES-128-GCM seals its own application records once
+// its keys are proven; nullptr leaves every record to OpenSSL.
+RTC_CPP_EXPORT void SetDtlsRecordSealer(std::shared_ptr<DtlsRecordSealer> sealer);
+
+} // namespace rtc
+
+#endif
