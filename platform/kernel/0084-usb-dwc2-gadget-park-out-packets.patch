 		dwc2_gadget_start_next_request(hs_ep);
 }
 
+/*
+ * Parking (descriptor DMA, non-isochronous OUT endpoints).
+ *
+ * All OUT endpoints share one RxFIFO. In descriptor DMA the core does not set
+ * NAK on an OUT endpoint when its last queued transfer completes, so the host's
+ * next packets for it are accepted into the RxFIFO while it has no buffer.
+ * Nothing moves them out until the function queues a request for this
+ * endpoint, and every other OUT endpoint waits behind them. NAK set from the
+ * completion interrupt comes too late for a host that keeps sending.
+ *
+ * So when an endpoint runs out of requests it is NAKed, and a timer tick later
+ * a packet of this endpoint at the RxFIFO head is moved by DMA into a small
+ * buffer of the endpoint, with NAK still set (nothing new comes in). The parked
+ * packets go first into the endpoint's next request: copied after it is
+ * unmapped, and the rest of the transfer by DMA behind them.
+ */
+#define DWC2_PARK_SIZE		2048	/* the RxFIFO holds no more */
+#define DWC2_PARK_PKTS		8
+
+static bool dwc2_gadget_parks(struct dwc2_hsotg_ep *hs_ep)
+{
+	return hs_ep->park_buf && hs_ep->index && !hs_ep->dir_in &&
+	       !hs_ep->isochronous;
+}
+
+static unsigned int dwc2_gadget_park_slot(struct dwc2_hsotg_ep *hs_ep)
+{
+	return ALIGN(hs_ep->ep.maxpacket, 4);
+}
+
+static bool dwc2_gadget_rxfifo_head_is(struct dwc2_hsotg *hsotg, int index)
+{
+	u32 sts;
+
+	if (!(dwc2_readl(hsotg, GINTSTS) & GINTSTS_RXFLVL))
+		return false;
+	sts = dwc2_readl(hsotg, GRXSTSR);	/* a peek, not a pop */
+	/* bit 20 of PktSts is seen set on this core: compare the low three */
+	return (sts & GRXSTS_EPNUM_MASK) == index &&
+	       (((sts & GRXSTS_PKTSTS_MASK) >> GRXSTS_PKTSTS_SHIFT) & 7) ==
+	       GRXSTS_PKTSTS_OUTRX;
+}
+
+static void dwc2_gadget_park_one(struct dwc2_hsotg *hsotg,
+				 struct dwc2_hsotg_ep *hs_ep)
+{
+	struct dwc2_dma_desc *desc = hs_ep->desc_list;
+	u32 mps = hs_ep->ep.maxpacket;
+
+	desc->buf = hs_ep->park_dma +
+		    hs_ep->park_cnt * dwc2_gadget_park_slot(hs_ep);
+	desc->status = (DEV_DMA_BUFF_STS_HREADY << DEV_DMA_BUFF_STS_SHIFT) |
+		       DEV_DMA_L | DEV_DMA_IOC |
+		       (mps & DEV_DMA_NBYTES_MASK);
+	hs_ep->desc_count = 1;
+	dma_wmb();
+	dwc2_writel(hsotg, hs_ep->desc_list_dma, DOEPDMA(hs_ep->index));
+	/* NAK stays set: only what already sits in the RxFIFO comes in */
+	dwc2_set_bit(hsotg, DOEPCTL(hs_ep->index),
+		     DXEPCTL_EPENA | DXEPCTL_SNAK);
+	hs_ep->parking = 1;
+}
+
+static void dwc2_gadget_park_check(struct dwc2_hsotg *hsotg,
+				   struct dwc2_hsotg_ep *hs_ep)
+{
+	if (!dwc2_gadget_parks(hs_ep) || hs_ep->parking || hs_ep->req ||
+	    !list_empty(&hs_ep->queue))
+		return;
+	if (!(dwc2_readl(hsotg, DOEPCTL(hs_ep->index)) & DXEPCTL_USBACTEP))
+		return;
+
+	if (dwc2_gadget_rxfifo_head_is(hsotg, hs_ep->index)) {
+		if (hs_ep->park_cnt >= min_t(unsigned int, DWC2_PARK_PKTS,
+				DWC2_PARK_SIZE / dwc2_gadget_park_slot(hs_ep))) {
+			dev_warn_ratelimited(hsotg->dev,
+				"%s: no room to park another packet\n",
+				hs_ep->name);
+			return;
+		}
+		dwc2_gadget_park_one(hsotg, hs_ep);
+		return;
+	}
+
+	/* a packet of another endpoint may still be ahead of ours */
+	if ((dwc2_readl(hsotg, GINTSTS) & GINTSTS_RXFLVL) &&
+	    hs_ep->park_tries++ < 25)
+		mod_timer(&hs_ep->park_timer, jiffies + 1);
+}
+
+/* The endpoint has no request left: NAK it and look at the RxFIFO later. */
+static void dwc2_gadget_park_idle(struct dwc2_hsotg_ep *hs_ep)
+{
+	struct dwc2_hsotg *hsotg = hs_ep->parent;
+	u32 reg = DOEPCTL(hs_ep->index);
+
+	if (!(dwc2_readl(hsotg, reg) & DXEPCTL_EPENA))
+		dwc2_set_bit(hsotg, reg, DXEPCTL_SNAK);
+	if (!dwc2_gadget_parks(hs_ep))
+		return;
+	hs_ep->park_tries = 0;
+	mod_timer(&hs_ep->park_timer, jiffies + 1);
+}
+
+/* XferCompl of a parking transfer: one packet is in park_buf. */
+static void dwc2_gadget_park_done(struct dwc2_hsotg *hsotg,
+				  struct dwc2_hsotg_ep *hs_ep)
+{
+	u32 status = hs_ep->desc_list->status;
+	u32 mps = hs_ep->ep.maxpacket;
+	u32 left = status & DEV_DMA_NBYTES_MASK;
+
+	/* as in dwc2_gadget_get_xfersize_ddma() */
+	if (usb_endpoint_xfer_int(hs_ep->ep.desc) && (mps % 4) &&
+	    left >= 4 - (mps % 4))
+		left -= 4 - (mps % 4);
+
+	hs_ep->parking = 0;
+	if (status & DEV_DMA_STS_MASK)
+		dev_warn(hsotg->dev, "%s: parking descriptor closed with %x\n",
+			 hs_ep->name, status & DEV_DMA_STS_MASK);
+	hs_ep->park_pkt[hs_ep->park_cnt++] = left < mps ? mps - left : 0;
+	dev_dbg(hsotg->dev, "%s: parked a %u byte packet\n", hs_ep->name,
+		hs_ep->park_pkt[hs_ep->park_cnt - 1]);
+
+	if (!list_empty(&hs_ep->queue)) {
+		dwc2_gadget_start_next_request(hs_ep);
+		return;
+	}
+	hs_ep->park_tries = 0;
+	dwc2_gadget_park_check(hsotg, hs_ep);
+}
+
+/*
+ * Which parked packets go to this request; sets its actual length. True when
+ * they complete it (it is full, or a short packet ended the transfer).
+ */
+static bool dwc2_gadget_park_take(struct dwc2_hsotg_ep *hs_ep,
+				  struct dwc2_hsotg_req *hs_req)
+{
+	struct usb_request *ureq = &hs_req->req;
+	unsigned int mps = hs_ep->ep.maxpacket;
+	unsigned int n = 0, k = 0, len = mps;
+
+	while (k < hs_ep->park_cnt && n < ureq->length) {
+		len = hs_ep->park_pkt[k++];
+		n += len;
+		if (len < mps)
+			break;
+	}
+	hs_req->park_take = k;
+	ureq->actual = min(n, ureq->length);
+	return n >= ureq->length || len < mps;
+}
+
+/* Copy the parked packets a request took into it (it is unmapped by now). */
+static void dwc2_gadget_park_copy(struct dwc2_hsotg_ep *hs_ep,
+				  struct dwc2_hsotg_req *hs_req)
+{
+	struct usb_request *ureq = &hs_req->req;
+	unsigned int slot = dwc2_gadget_park_slot(hs_ep);
+	unsigned int k = min(hs_req->park_take, hs_ep->park_cnt);
+	unsigned int i, n = 0, len;
+
+	for (i = 0; i < k; i++) {
+		len = min_t(unsigned int, hs_ep->park_pkt[i],
+			    ureq->length - n);
+		if (len < hs_ep->park_pkt[i])
+			dev_warn_ratelimited(hs_ep->parent->dev,
+				"%s: %u parked bytes do not fit the request\n",
+				hs_ep->name, hs_ep->park_pkt[i] - len);
+		memcpy(ureq->buf + n, hs_ep->park_buf + i * slot, len);
+		n += len;
+	}
+	memmove(hs_ep->park_buf, hs_ep->park_buf + k * slot,
+		(hs_ep->park_cnt - k) * slot);
+	memmove(hs_ep->park_pkt, hs_ep->park_pkt + k,
+		(hs_ep->park_cnt - k) * sizeof(hs_ep->park_pkt[0]));
+	hs_ep->park_cnt -= k;
+	hs_req->park_take = 0;
+}
+
+static void dwc2_gadget_park_clear(struct dwc2_hsotg_ep *hs_ep)
+{
+	timer_delete(&hs_ep->park_timer);
+	hs_ep->parking = 0;
+	hs_ep->park_cnt = 0;
+}
+
+static void dwc2_gadget_park_timer(struct timer_list *t)
+{
+	struct dwc2_hsotg_ep *hs_ep = timer_container_of(hs_ep, t, park_timer);
+	struct dwc2_hsotg *hsotg = hs_ep->parent;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	if (hs_ep->req && hs_ep->req->park_serve) {
+		hs_ep->req->park_serve = 0;
+		dwc2_hsotg_complete_request(hsotg, hs_ep, hs_ep->req, 0);
+	} else {
+		dwc2_gadget_park_check(hsotg, hs_ep);
+	}
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+}
+
 /*
  * dwc2_gadget_complete_isoc_request_ddma - complete an isoc request in DDMA
  * @hs_ep: The endpoint the request was on.
@@ -2397,6 +2634,11 @@ static void dwc2_hsotg_handle_outdone(struct dwc2_hsotg *hsotg, int epnum)
 	unsigned int size_left = DXEPTSIZ_XFERSIZE_GET(epsize);
 	int result = 0;
 
+	if (hs_ep->parking) {
+		dwc2_gadget_park_done(hsotg, hs_ep);
+		return;
+	}
+
 	if (!hs_req) {
 		dev_dbg(hsotg->dev, "%s: no request active\n", __func__);
 		return;
@@ -3298,6 +3540,9 @@ static void kill_all_requests(struct dwc2_hsotg *hsotg,
 		dwc2_hsotg_complete_request(hsotg, ep, req, result);
 	}
 
+	if (dwc2_gadget_parks(ep))
+		dwc2_gadget_park_clear(ep);
+
 	if (!hsotg->dedicated_fifos)
 		return;
 	size = (dwc2_readl(hsotg, DTXFSTS(ep->index)) & 0xffff) * 4;
@@ -4083,6 +4328,16 @@ static int dwc2_hsotg_ep_enable(struct usb_ep *ep,
 	else
 		desc_num = MAX_DMA_DESC_NUM_GENERIC;
 
+	/* Parking buffer of non-isochronous OUT endpoints */
+	if (using_desc_dma(hsotg) && !dir_in &&
+	    ep_type != USB_ENDPOINT_XFER_ISOC && !hs_ep->park_buf) {
+		hs_ep->park_buf = dmam_alloc_coherent(hsotg->dev,
+			DWC2_PARK_SIZE, &hs_ep->park_dma, GFP_ATOMIC);
+		if (!hs_ep->park_buf)
+			dev_warn(hsotg->dev, "%s: no parking buffer\n",
+				 hs_ep->name);
+	}
+
 	/* Allocate DMA descriptor chain for non-ctrl endpoints */
 	if (using_desc_dma(hsotg) && !hs_ep->desc_list) {
 		hs_ep->desc_list = dmam_alloc_coherent(hsotg->dev,
@@ -4355,7 +4610,7 @@ static int dwc2_hsotg_ep_dequeue(struct usb_ep *ep, struct usb_request *req)
 	}
 
 	/* Dequeue already started request */
-	if (req == &hs_ep->req->req)
+	if (req == &hs_ep->req->req && !hs_req->park_serve)
 		dwc2_hsotg_ep_stop_xfr(hs, hs_ep);
 
 	dwc2_hsotg_complete_request(hs, hs_ep, hs_req, -ECONNRESET);
@@ -4892,6 +5147,7 @@ static void dwc2_hsotg_initep(struct dwc2_hsotg *hsotg,
 
 	INIT_LIST_HEAD(&hs_ep->queue);
 	INIT_LIST_HEAD(&hs_ep->ep.ep_list);
+	timer_setup(&hs_ep->park_timer, dwc2_gadget_park_timer, 0);
 
 	/* add to the list of endpoints known by the gadget driver */
 	if (epnum)
@@ -5157,7 +5413,12 @@ int dwc2_gadget_init(struct dwc2_hsotg *hsotg)
  */
 int dwc2_hsotg_remove(struct dwc2_hsotg *hsotg)
 {
+	int epnum;
+
 	usb_del_gadget_udc(&hsotg->gadget);
+	for (epnum = 1; epnum < hsotg->num_of_eps; epnum++)
+		if (hsotg->eps_out[epnum])
+			timer_delete_sync(&hsotg->eps_out[epnum]->park_timer);
 	dwc2_hsotg_ep_free_request(&hsotg->eps_out[0]->ep, hsotg->ctrl_req);
 
 	return 0;
