#!/bin/sh

set_hid_wakeup(){
    # The extension is optional on upstream kernels; never create configfs files.
    [ -w "$1/wakeup_on_write" ] || return 0
    if [ -e /boot/usb.notwakeup ]; then
        echo 0 > "$1/wakeup_on_write"
    else
        echo 1 > "$1/wakeup_on_write"
    fi
}

# kvmhwd hid only

reset_usb_config_links(){
    _gadget=$1
    [ -d "$_gadget" ] || return 0
    # Linux returns ENODEV if an already-unbound gadget is unbound again.
    if [ -n "$(cat "$_gadget/UDC")" ]; then
        echo '' > "$_gadget/UDC" || return 1
    fi
    # Remove references and old optional functions before relinking the
    # selected profile; interface numbering must not depend on its history.
    for _link in "$_gadget"/configs/c.1/* "$_gadget"/os_desc/c.1
    do
        [ -L "$_link" ] || continue
        rm "$_link" || return 1
    done
}

start_usb_dev(){
    . /etc/profile
    reset_usb_config_links /sys/kernel/config/usb_gadget/g0 || return 1
    # HID-only has no network function; release unused netdev instances too.
    for unused in rndis.usb0 ncm.usb0; do
        if [ -d "/sys/kernel/config/usb_gadget/g0/functions/$unused" ]; then
            rmdir "/sys/kernel/config/usb_gadget/g0/functions/$unused" || return 1
        fi
    done
    echo "usb mode: device"
    cd /sys/kernel/config/usb_gadget

    mkdir -p g0
    cd g0

    echo 0x0101 > bcdUSB
    echo 0 > os_desc/use
    if [ -e /boot/usb.acm ]
    then
        # Use a distinct device revision so hosts do not reuse the cached
        # HID-only descriptor set after the CDC ACM interface is enabled.
        echo 0x0624 > bcdDevice
        echo 0xEF > bDeviceClass
        echo 0x02 > bDeviceSubClass
        echo 0x01 > bDeviceProtocol
    else
        echo 0x0623 > bcdDevice
        echo 0 > bDeviceClass
        echo 0 > bDeviceSubClass
        echo 0 > bDeviceProtocol
    fi
    # echo 0x3346 > idVendor
    # echo 0x1009 > idProduct
    if [ -e /boot/usb.vid ]
    then
        cat /boot/usb.vid > idVendor
    else
        echo 0x3346 > idVendor
    fi
    if [ -e /boot/usb.pid ]
    then
        cat /boot/usb.pid > idProduct
    else
        echo 0x1009 > idProduct
    fi
    mkdir -p strings/0x409
    if [ -e /boot/usb.acm ]
    then
        _serial='0123456789ABCDEF'
        if [ -f /sys/class/cvi-base/base_uid ]
        then
            _uid_serial=$(awk '{print $2}' /sys/class/cvi-base/base_uid | tr -d '_')
            if [ ${#_uid_serial} -ge 12 ]
            then
                _serial="$_uid_serial"
            fi
        fi
        echo "$_serial" > strings/0x409/serialnumber
    fi
    echo 'sipeed' > strings/0x409/manufacturer
    echo 'NanoKVM' > strings/0x409/product

    mkdir -p configs/c.1
    echo 0xA0 > configs/c.1/bmAttributes
    echo 200 > configs/c.1/MaxPower
    mkdir -p configs/c.1/strings/0x409
    echo "NanoKVM" >  configs/c.1/strings/0x409/configuration

    # keyboard
    mkdir -p functions/hid.GS0
    echo 1 > functions/hid.GS0/subclass
    set_hid_wakeup functions/hid.GS0 || return 1
    echo 1 > functions/hid.GS0/protocol
    echo 8 > functions/hid.GS0/report_length
    echo -ne \\x05\\x01\\x09\\x06\\xa1\\x01\\x05\\x07\\x19\\xe0\\x29\\xe7\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\x95\\x01\\x75\\x08\\x81\\x03\\x95\\x05\\x75\\x01\\x05\\x08\\x19\\x01\\x29\\x05\\x91\\x02\\x95\\x01\\x75\\x03\\x91\\x03\\x95\\x06\\x75\\x08\\x15\\x00\\x25\\x65\\x05\\x07\\x19\\x00\\x29\\x65\\x81\\x00\\xc0 > functions/hid.GS0/report_desc
    if [ ! -e /boot/disable_hid ] && [ ! -e /boot/usb.disable_keyboard ]; then
        ln -s functions/hid.GS0 configs/c.1
    fi

    # mouse
    mkdir -p functions/hid.GS1
    echo 1 > functions/hid.GS1/subclass
    set_hid_wakeup functions/hid.GS1 || return 1
    echo 2 > functions/hid.GS1/protocol
    echo 4 > functions/hid.GS1/report_length
    echo -ne \\x5\\x1\\x9\\x2\\xa1\\x1\\x9\\x1\\xa1\\x0\\x5\\x9\\x19\\x1\\x29\\x3\\x15\\x0\\x25\\x1\\x95\\x3\\x75\\x1\\x81\\x2\\x95\\x1\\x75\\x5\\x81\\x3\\x5\\x1\\x9\\x30\\x9\\x31\\x9\\x38\\x15\\x81\\x25\\x7f\\x75\\x8\\x95\\x3\\x81\\x6\\xc0\\xc0 > functions/hid.GS1/report_desc
    if [ ! -e /boot/disable_hid ] && [ ! -e /boot/usb.disable_relative ]; then
        ln -s functions/hid.GS1 configs/c.1
    fi

    # touchpad
    mkdir -p functions/hid.GS2
    echo 0 > functions/hid.GS2/subclass
    set_hid_wakeup functions/hid.GS2 || return 1
    echo 2 > functions/hid.GS2/protocol
    echo 6 > functions/hid.GS2/report_length
    echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x03\\x15\\x00\\x25\\x01\\x95\\x03\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x05\\x81\\x01\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x35\\x00\\x46\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x35\\x00\\x45\\x00\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0 > functions/hid.GS2/report_desc
    if [ ! -e /boot/disable_hid ] && [ ! -e /boot/usb.disable_absolute ]; then
        ln -s functions/hid.GS2 configs/c.1
    fi

    # Optional host-facing serial port. This profile allows up to three HID
    # interfaces but excludes USB network and mass storage: together
    # they use five IN endpoints, within SG2002's measured endpoint/FIFO budget.
    if [ -e /boot/usb.acm ]
    then
        mkdir -p functions/acm.GS0
        ln -s functions/acm.GS0 configs/c.1
    fi

    ls /sys/class/udc/ | cat > UDC
    echo device > /proc/cviusb/otg_role
}

start_usb_host(){
    if [ -n "$(cat /sys/kernel/config/usb_gadget/g0/UDC)" ]; then
        echo '' > /sys/kernel/config/usb_gadget/g0/UDC || return 1
    fi
    echo host > /proc/cviusb/otg_role
}

restart_usb_dev(){
    echo > /sys/kernel/config/usb_gadget/g0/UDC
    sleep 1
    ls /sys/class/udc/ | cat > /sys/kernel/config/usb_gadget/g0/UDC
    echo "USB Restart OK!"
}

case "$1" in
  start)
    start_usb_dev
  ;;
  restart)
    restart_usb_dev
  ;;
  stop)
    start_usb_host
  ;;
  stop_start)
    start_usb_host
    start_usb_dev
  ;;
   restart_phy)
    # Keep the legacy API action name, but preserve the controller device.
    # Removing DWC2 leaves retained NCM netdevs referring to its old gadget
    # parent on vendor kernels. Rebuild the composition via UDC detach/bind.
    start_usb_dev || exit 1
  ;;
esac
