pkgname=nanokvm-release
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="Tested NanoKVM Alpine package set"
url="https://github.com/sipeed/NanoKVM"
arch="riscv64"
license="GPL-3.0-only"
# Historic C906 packages provide this artificial revision at priority 100.
# Migrate explicit i2c-tools world entries to the Alpine package on upgrade.
depends="!i2c-tools=4.4-r100 alpine-base busybox-extras tzdata busybox-openrc !openvpn3 !openssl4-libs avahi avahi-openrc bash chrony chrony-openrc curl dbus dbus-openrc dnsmasq iproute2-tc nftables openresolv util-linux wireguard-tools ca-certificates coreutils eudev nanokvm-exfatprogs1>=${F_nanokvm_exfatprogs1:?missing selected exfatprogs version} f2fs-tools hostapd i2c-tools iproute2 iw kmod libgcc libstdc++ openssh nanokvm-openssl3>=${F_nanokvm_openssl3:?missing selected OpenSSL version} util-linux-misc wpa_supplicant nanokvm-keys>=${V_nanokvm_keys:-$pkgver}-r0 nanokvm-base>=${V_nanokvm_base:-$pkgver}-r0 nanokvm-kernel>=${F_nanokvm_kernel:?missing selected kernel version} nanokvm-kmod>=${F_nanokvm_kmod:?missing selected module version} nanokvm-firmware>=${V_nanokvm_firmware:-$pkgver}-r0 nanokvm-bootloader>=${V_nanokvm_bootloader:-$pkgver}-r0 nanokvm>=${V_nanokvm:-$pkgver}-r0 nanokvm-web>=${V_nanokvm_web:-$pkgver}-r0 nanokvm-zlib>=${V_nanokvm_zlib:-$pkgver}-r0 nanokvm-tpu>=${V_nanokvm_tpu:-$pkgver}-r0 nanokvm-rustdesk nanokvm-host-sensors nanokvm-model-screen"
# The last three are built and published on their own (scripts/addon_packages.py
# BASE) and come from the add-on repository, by name only: each keeps its own
# version and release, and a new one reaches devices without an OS release.
# They stay off until switched on.
source="$pkgname-$pkgver.tar.gz"
# /kvmapp/version moved here from nanokvm (3.3.0).
replaces="nanokvm"
# The installed OS release, for the minimum release of an add-on
# (addon.json "os"): an add-on depends on nanokvm-os>=VERSION. This package is
# rebuilt with the release version every release (scripts/package-versions.py).
# Keep old world selections valid without a separate compatibility APK.
provides="nanokvm-os=$pkgver nanokvm-app=$pkgver-r$pkgrel"
options="!check !strip !tracedeps"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
