+/* A trailing HEADERS block and an empty final DATA frame can both end a
+ * request with no Content-Length and no final body byte to consume. */
+static int
+lws_h2_finish_empty_end(struct lws *swsi)
+{
+	return swsi->h2.END_STREAM && lwsi_role_server(swsi) &&
+	       !swsi->h23_stream_carries_ws && !swsi->http.content_length_given &&
+	       (lwsi_state(swsi) == LRS_BODY || lwsi_state(swsi) == LRS_DISCARD_BODY) &&
+	       lws_read_h1(swsi, NULL, 0, 1) < 0;
+}
 
