# Debug kernel profile (NANOKVM_KERNEL_PROFILE=debug): kernel/config with these
# options on top. perf and its CPU counters, frame pointers for exact
# backtraces (on RISC-V perf forces them), tracefs events and probes.
CONFIG_LOCALVERSION="-nanokvm-os-r5-debug"
CONFIG_PERF_EVENTS=y
CONFIG_RISCV_PMU=y
CONFIG_RISCV_PMU_LEGACY=y
CONFIG_RISCV_PMU_SBI=y
CONFIG_ERRATA_THEAD_PMU=y
CONFIG_FRAME_POINTER=y
CONFIG_UPROBE_EVENTS=y
CONFIG_EPROBE_EVENTS=y
# The release kernel has no bpf() system call; tracing programs need it.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_CONTEXT_SWITCH_TRACER=y
CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED=y
# Function and syscall tracing, kprobes, block I/O and latency tracers.
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_STACK_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# Hangs: SysRq on the console, hung tasks, soft lockups, stuck workqueues.
CONFIG_MAGIC_SYSRQ=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_WQ_WATCHDOG=y
# pr_debug on demand, all symbols, /proc/config.gz, per-task accounting
# (pidstat -d), scheduler statistics.
CONFIG_DYNAMIC_DEBUG=y
CONFIG_KALLSYMS_ALL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_SCHEDSTATS=y
# DWARF for vmlinux on the build host (perf report, gdb, addr2line); the
# installed modules are stripped.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# debugfs (clocks, GPIO, dma-buf and CMA state) and a 128 KiB printk buffer:
# the release kernel has neither (debugfs held 1.3 MB of inodes, the buffer
# 576 KB with its records; 32 KiB holds a boot's log twice over).
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_LOG_BUF_SHIFT=17
# Also left out of the release kernel: slab debugging (slab_debug= at boot)
# and the F2FS statistics, which debugfs shows.
CONFIG_SLUB_DEBUG=y
CONFIG_F2FS_STAT_FS=y
