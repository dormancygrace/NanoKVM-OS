+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stddef.h>
+#include <stdint.h>
+#include "crypto/hwcrypto_transport.h"
+#include "cipher_aes_hwcrypto.h"
+static void aes_hwcrypto_gcm_ctr(const unsigned char *in, unsigned char *out,
+    size_t blocks, const void *key, const unsigned char ivec[16])
+{
+    const PROV_AES_GCM_CTX *a = (const PROV_AES_GCM_CTX *)
+        ((const unsigned char *)key - offsetof(PROV_AES_GCM_CTX, ks.ks));
+    unsigned char iv[16];
+    union { unsigned char c[16]; uint64_t u[2]; } stream;
+    uint32_t counter;
+    size_t n = 0;
+    memcpy(iv, ivec, sizeof(iv));
+    if (blocks >= HWCRYPTO_AES_CTR_MIN / 16)
+        n = ossl_hwcrypto_cipher(HWCRYPTO_ALG_AES, HWCRYPTO_MODE_CTR, 1,
+        a->plat.hwcrypto.key, a->base.keylen, iv, 4, in, out, blocks * 16,
+        HWCRYPTO_AES_CTR_MIN, HWCRYPTO_AES_CONTINUE_MIN, HWCRYPTO_MAX);
+    in += n; out += n; blocks -= n / 16;
+    /* Every GCM record comes here. Below the DMA threshold (or after a DMA
+     * failure) XOR whole 64-bit words; the C906 loads misaligned words in
+     * hardware. The big-endian 32-bit counter stays in a register. */
+    memcpy(&counter, iv + 12, sizeof(counter));
+    counter = __builtin_bswap32(counter);
+    while (blocks-- != 0) {
+        uint64_t x[2];
+        uint32_t be;
+        AES_encrypt(iv, stream.c, key);
+        memcpy(x, in, sizeof(x));
+        x[0] ^= stream.u[0];
+        x[1] ^= stream.u[1];
+        memcpy(out, x, sizeof(x));
+        be = __builtin_bswap32(++counter);
+        memcpy(iv + 12, &be, sizeof(be));
+        in += 16; out += 16;
+    }
+    OPENSSL_cleanse(&stream, sizeof(stream));
+    OPENSSL_cleanse(iv, sizeof(iv));
+}
+
+/* The whole blocks of an update through HWCRYPTO_GCM, where the driver runs
+ * the engine's AES-CTR and the C906 GHASH at the same time. As for
+ * AES_GCM_ASM, CRYPTO_gcm128 first finishes the associated data and any
+ * partial block, and keeps the lengths, the last partial block and the tag.
+ * Returns the prefix of in done; the caller's usual path does the rest.
+ */
+static size_t aes_hwcrypto_gcm_bulk(PROV_GCM_CTX *ctx, const unsigned char *in,
+    unsigned char *out, size_t len)
+{
+    const PROV_AES_GCM_CTX *a = (const PROV_AES_GCM_CTX *)ctx;
+    GCM128_CONTEXT *g = &ctx->gcm;
+    unsigned char h[16];
+    size_t res, bulk;
+    int i;
+
+    if (len < HWCRYPTO_AES_GCM_MIN)
+        return 0;
+    res = (16 - g->mres) % 16;
+    if ((ctx->enc ? CRYPTO_gcm128_encrypt_ctr32 : CRYPTO_gcm128_decrypt_ctr32)(
+            g, in, out, res, ctx->ctr))
+        return 0;
+    bulk = (len - res) & ~(size_t)15;
+    /* Over the message limit: CRYPTO_gcm128 refuses the rest. */
+    if (bulk > (((uint64_t)1 << 36) - 32) - g->len.u[1])
+        return res;
+    /* H is kept in host order. */
+    for (i = 0; i < 8; i++) {
+        h[i] = (unsigned char)(g->H.u[0] >> (56 - 8 * i));
+        h[8 + i] = (unsigned char)(g->H.u[1] >> (56 - 8 * i));
+    }
+    bulk = ossl_hwcrypto_gcm(ctx->enc, a->plat.hwcrypto.key, ctx->keylen, h,
+        g->Xi.c, g->Yi.c, in + res, out + res, bulk);
+    OPENSSL_cleanse(h, sizeof(h));
+    if (bulk == OSSL_HWCRYPTO_LOST)
+        return bulk;
+    g->len.u[1] += bulk;
+    return res + bulk;
+}
