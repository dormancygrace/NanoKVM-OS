From c029c1b2d8f78cc9987e4e6b4d37caf515b7817c Mon Sep 17 00:00:00 2001
From: dgrace <g.pesin@globalte.ru>
Date: Sat, 5 Sep 2026 19:06:14 +0300
Subject: [PATCH] Fix LT6911 mode indexing and preserve NanoKVM bus and MIPI
 configuration

---
 sensor/cv182x/lontium_lt6911/lt6911_cmos.c    | 22 +++++++++++++++----
 .../cv182x/lontium_lt6911/lt6911_cmos_param.h | 15 ++++++++++---
 .../cv182x/lontium_lt6911/lt6911_sensor_ctl.c | 11 +++++++---
 3 files changed, 38 insertions(+), 10 deletions(-)

diff --git a/sensor/cv182x/lontium_lt6911/lt6911_cmos.c b/sensor/cv182x/lontium_lt6911/lt6911_cmos.c
index b879490..9aaeaf4 100644
--- a/sensor/cv182x/lontium_lt6911/lt6911_cmos.c
+++ b/sensor/cv182x/lontium_lt6911/lt6911_cmos.c
@@ -34,7 +34,11 @@ ISP_SNS_STATE_S *g_pastLt6911[VI_MAX_PIPE_NUM] = {CVI_NULL};
 #define LT6911_SENSOR_RESET_CTX(dev)         (g_pastLt6911[dev] = CVI_NULL)
 
 ISP_SNS_COMMBUS_U g_aunLt6911_BusInfo[VI_MAX_PIPE_NUM] = {
+	#ifdef NANOKVM_ENHANCED
+	[0] = { .s8I2cDev = 4},
+#else
 	[0] = { .s8I2cDev = 0},
+#endif
 	[1 ... VI_MAX_PIPE_NUM - 1] = { .s8I2cDev = -1}
 };
 
@@ -169,7 +173,17 @@ static CVI_S32 cmos_set_image_mode(VI_PIPE ViPipe, ISP_CMOS_SENSOR_IMAGE_MODE_S
 	CMOS_CHECK_POINTER(pstSnsState);
 
 	u8SensorImageMode = LT6911_MODE_NORMAL;
-
+#ifdef NANOKVM_ENHANCED
+	if (!pstSensorImageMode->u16Width || !pstSensorImageMode->u16Height)
+		return CVI_FAILURE;
+	ISP_WDR_SIZE_S *image = &g_astLt6911_mode[u8SensorImageMode].astImg[0];
+	image->stSnsSize.u32Width = pstSensorImageMode->u16Width;
+	image->stSnsSize.u32Height = pstSensorImageMode->u16Height;
+	image->stWndRect.u32Width = pstSensorImageMode->u16Width;
+	image->stWndRect.u32Height = pstSensorImageMode->u16Height;
+	image->stMaxSize = image->stSnsSize;
+	pstSnsState->bSyncInit = CVI_FALSE;
+#endif
 	pstSnsState->u8ImgMode = u8SensorImageMode;
 
 	return CVI_SUCCESS;
@@ -197,8 +211,8 @@ static CVI_S32 sensor_rx_attr(VI_PIPE ViPipe, SNS_COMBO_DEV_ATTR_S *pstRxAttr)
 
 	memcpy(pstRxAttr, &lt6911_rx_attr, sizeof(*pstRxAttr));
 
-	pstRxAttr->img_size.width = g_astLt6911_mode[0].astImg[pstSnsState->u8ImgMode].stSnsSize.u32Width;
-	pstRxAttr->img_size.height = g_astLt6911_mode[0].astImg[pstSnsState->u8ImgMode].stSnsSize.u32Height;
+	pstRxAttr->img_size.width = g_astLt6911_mode[pstSnsState->u8ImgMode].astImg[0].stSnsSize.u32Width;
+	pstRxAttr->img_size.height = g_astLt6911_mode[pstSnsState->u8ImgMode].astImg[0].stSnsSize.u32Height;
 
 	return CVI_SUCCESS;
 }
@@ -413,4 +427,4 @@ ISP_SNS_OBJ_S stSnsLT6911_Obj = {
 	.pfnExpSensorCb         = cmos_init_sensor_exp_function,
 	.pfnExpAeCb             = cmos_init_ae_exp_function,
 	.pfnSnsProbe		= sensor_probe,
-};
\ No newline at end of file
+};
diff --git a/sensor/cv182x/lontium_lt6911/lt6911_cmos_param.h b/sensor/cv182x/lontium_lt6911/lt6911_cmos_param.h
index ef2d0ba..7475109 100644
--- a/sensor/cv182x/lontium_lt6911/lt6911_cmos_param.h
+++ b/sensor/cv182x/lontium_lt6911/lt6911_cmos_param.h
@@ -12,8 +12,8 @@ extern "C" {
 #include "lt6911_cmos_ex.h"
 
 // not real time resolution
-#define WIDTH   3840//3840 1920
-#define HEIGHT  2160//2160 1080
+#define WIDTH   1920
+#define HEIGHT  1080
 
 static LT6911_MODE_S g_astLt6911_mode[LT6911_MODE_NUM] = {
 	[LT6911_MODE_NORMAL] = {
@@ -42,8 +42,13 @@ struct combo_dev_attr_s lt6911_rx_attr = {
 	.mac_clk = RX_MAC_CLK_600M,
 	.mipi_attr = {
 		.raw_data_type = YUV422_8BIT,
-		.lane_id = {2, 0, 1, 3, 4}, //3, 0, 1, 2, 4  ;   1, 4, 3, 2, 0  2, 0, 1, 3, 4   3, 1, 2, 4, 0
+#ifdef NANOKVM_ENHANCED
+		.lane_id = {2, 4, 3, 1, 0},
+		.pn_swap = {0, 0, 0, 0, 0},
+#else
+		.lane_id = {2, 0, 1, 3, 4},
 		.pn_swap = {1, 1, 1, 1, 1},
+#endif
 		.wdr_mode = CVI_MIPI_WDR_MODE_NONE,
 		.dphy = {
 			.enable = 1,
@@ -54,7 +59,11 @@ struct combo_dev_attr_s lt6911_rx_attr = {
 		.cam = 0,
 		.freq = CAMPLL_FREQ_NONE,
 	},
+#ifdef NANOKVM_ENHANCED
+	.devno = 0,
+#else
 	.devno = 1,
+#endif
 };
 
 #ifdef __cplusplus
diff --git a/sensor/cv182x/lontium_lt6911/lt6911_sensor_ctl.c b/sensor/cv182x/lontium_lt6911/lt6911_sensor_ctl.c
index c364820..c88fb37 100644
--- a/sensor/cv182x/lontium_lt6911/lt6911_sensor_ctl.c
+++ b/sensor/cv182x/lontium_lt6911/lt6911_sensor_ctl.c
@@ -11,7 +11,7 @@
 #include "cvi_sns_ctrl.h"
 #include "lt6911_cmos_ex.h"
 
-#define LT6911_I2C_DEV 3
+extern ISP_SNS_COMMBUS_U g_aunLt6911_BusInfo[VI_MAX_PIPE_NUM];
 #define LT6911_I2C_BANK_ADDR 0xff
 
 CVI_U8 lt6911_i2c_addr = 0x2b;
@@ -23,16 +23,21 @@ int lt6911_i2c_init(VI_PIPE ViPipe)
 {
 	char acDevFile[16] = {0};
 
+	if (ViPipe < 0 || ViPipe >= VI_MAX_PIPE_NUM)
+		return CVI_FAILURE;
+	int bus = g_aunLt6911_BusInfo[ViPipe].s8I2cDev;
+	if (bus < 0)
+		return CVI_FAILURE;
 	if (g_fd[ViPipe] >= 0)
 		return CVI_SUCCESS;
 	int ret;
 
-	snprintf(acDevFile, sizeof(acDevFile),  "/dev/i2c-%u", LT6911_I2C_DEV);
+	snprintf(acDevFile, sizeof(acDevFile),  "/dev/i2c-%u", bus);
 
 	g_fd[ViPipe] = open(acDevFile, O_RDWR, 0600);
 
 	if (g_fd[ViPipe] < 0) {
-		CVI_TRACE_SNS(CVI_DBG_ERR, "Open /dev/i2c-%u error!\n", LT6911_I2C_DEV);
+		CVI_TRACE_SNS(CVI_DBG_ERR, "Open /dev/i2c-%u error!\n", bus);
 		return CVI_FAILURE;
 	}
 
-- 
2.43.0

