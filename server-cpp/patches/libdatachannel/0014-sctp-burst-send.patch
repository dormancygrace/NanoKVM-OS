+namespace {
+
+// What one thread has collected: runs of records, each of one transport, in the order they were collected. The
+// run objects are reused, so their vectors keep their capacity from burst to burst.
+struct Burst {
+	struct Run {
+		Transport *owner = nullptr;
+		message_vector messages;
+	};
+	int depth = 0;
+	std::vector<Run> runs;
+	size_t used = 0;
+};
+
+thread_local Burst tBurst;
+
+// A burst goes to the layer below this many records at a time: the largest batch the UDP send takes in one call is
+// bounded anyway (UDP_SEGMENT).
+constexpr size_t maxBurst = 32;
+// From the first time the socket did not take everything, a burst has this long. It is an absolute time: every
+// later call is made only before it, and is told how long it may still wait for the socket.
+constexpr auto burstRetry = std::chrono::seconds(1);
+
+} // namespace
+
+Transport::BurstScope::BurstScope() { ++tBurst.depth; }
+
+Transport::BurstScope::~BurstScope() {
+	if (--tBurst.depth == 0)
+		Transport::flushBurst();
+}
+
+bool Transport::collectBurst(message_ptr &message) {
+	if (tBurst.depth == 0 || !message)
+		return false;
+	// Always taken while a scope is open, however many there are already, and never sent from here: the caller
+	// may hold the SCTP and DTLS locks, where a send could wait for the socket, and a record sent now would
+	// overtake the ones collected before it. They are bounded by what the SCTP stack lets out in one scope.
+	if (tBurst.used == 0 || tBurst.runs[tBurst.used - 1].owner != this) {
+		if (tBurst.used == tBurst.runs.size())
+			tBurst.runs.emplace_back();
+		tBurst.runs[tBurst.used++].owner = this;
+	}
+	tBurst.runs[tBurst.used - 1].messages.push_back(std::move(message));
+	return true;
+}
+
+void Transport::flushBurst() noexcept {
+	// The layer below tells how many records, in order, the socket took. A run taken in part keeps the others:
+	// collectBurst() already told the SCTP stack they were sent, so dropping them here would turn a full socket
+	// buffer into packet loss. They are given again, without the ones already taken, until the burst's time is
+	// over. A transport that cannot send any more ends its run at once.
+	std::chrono::steady_clock::time_point giveUp{};
+	bool expired = false;
+	size_t used = std::exchange(tBurst.used, 0);
+	for (size_t r = 0; r < used; ++r) {
+		Transport *owner = std::exchange(tBurst.runs[r].owner, nullptr);
+		message_vector &messages = tBurst.runs[r].messages;
+		size_t sent = 0;
+		bool closed = false;
+		try {
+			while (owner && sent < messages.size() && !expired) {
+				int wait = -1; // the layer's own wait, while nothing has fallen short yet
+				if (giveUp != std::chrono::steady_clock::time_point{}) {
+					auto left = std::chrono::duration_cast<std::chrono::milliseconds>(giveUp - std::chrono::steady_clock::now());
+					if (left.count() <= 0) {
+						expired = true;
+						break;
+					}
+					wait = int(left.count());
+				}
+				size_t count = std::min(maxBurst, messages.size() - sent);
+				int took = owner->outgoingBatchPrefix(messages, sent, count, wait);
+				if (took < 0) {
+					closed = true;
+					break;
+				}
+				sent += size_t(took);
+				if (size_t(took) < count && giveUp == std::chrono::steady_clock::time_point{})
+					giveUp = std::chrono::steady_clock::now() + burstRetry;
+			}
+		} catch (const std::exception &e) {
+			PLOG_WARNING << "Burst send: " << e.what();
+		}
+		if (sent < messages.size()) {
+			// Given up, once: these are lost to the peer like packets lost on the way, and counted as not sent.
+			AddUnsentMediaDatagrams(messages.size() - sent);
+			PLOG_WARNING << "Burst send: " << (messages.size() - sent) << " of " << messages.size()
+			             << (closed ? " records dropped, the transport is closed" : " records dropped, the socket stayed full");
+		}
+		messages.clear();
+	}
+}
+
+int Transport::sendBatchPrefix(message_vector &messages, size_t from, size_t count, int /*waitMs*/) {
+	size_t taken = 0;
+	while (taken < count && send(messages[from + taken]))
+		++taken;
+	return int(taken);
+}
+
+int Transport::outgoingBatchPrefix(message_vector &messages, size_t from, size_t count, int waitMs) {
+	return mLower ? mLower->sendBatchPrefix(messages, from, count, waitMs) : -1;
+}
