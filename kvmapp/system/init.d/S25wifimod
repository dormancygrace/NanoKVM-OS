#!/bin/sh
# Load the Wi-Fi driver for the SDIO card on this board; fail at once without
# a supported card (S30wifi then does not wait for wlan0). udev does not load
# these drivers (modprobe.d/nanokvm-wifi.conf). The IDs follow the AIC8800
# (aicbsp_sdio_ids.h) and 8733bs drivers.
set -eu
[ "${1:-}" = start ] || exit 0
SDIO_DEVICES_DIR=${NANOKVM_SDIO_DEVICES_DIR:-/sys/bus/sdio/devices}
MODPROBE=${NANOKVM_MODPROBE:-modprobe}
for alias in "$SDIO_DEVICES_DIR"/*/modalias; do
    id=
    [ ! -r "$alias" ] || read -r id < "$alias" || true
    case "$id" in
        sdio:c*v5449d0145*|sdio:c*v5449d0146*|sdio:c*v544Ad0146*|\
        sdio:c*vC8A1dC08D*|sdio:c*vC8A1d0082*|sdio:c*vC8A1d0182*|\
        sdio:c*vC8A1d908[1-6]*|sdio:c*vC8A1d2082*)
            exec "$MODPROBE" aic8800_fdrv ;;
        sdio:c*v024CdB733*|sdio:c*v024CdB73A*)
            exec "$MODPROBE" 8733bs ;;
    esac
done
echo 'NanoKVM OS: supported SDIO Wi-Fi device not present' >&2
exit 1
