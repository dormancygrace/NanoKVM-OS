diff --git a/crypto/modes/gcm_c906.c b/crypto/modes/gcm_c906.c
--- /dev/null
+++ b/crypto/modes/gcm_c906.c
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * GHASH for the T-Head C906 (NanoKVM OS): 8-bit tables, see ghash-c906.S.
+ * The tables live in the GCM context, which CRYPTO_gcm128_init zeroes and
+ * clear_free cleanses.
+ */
+#include <stdint.h>
+#include <string.h>
+#include <openssl/crypto.h>
+#include "crypto/modes.h"
+
+#define GHASH_C906_TABLES 2
+
+void ossl_ghash_blocks_c906(u64 acc[2], const u64 *tables, const u8 *in,
+    size_t blocks);
+
+/* Multiply by x in the bit order of GHASH. */
+static void mulx(u64 *hi, u64 *lo)
+{
+    u64 carry = *lo & 1;
+
+    *lo = *hi << 63 | *lo >> 1;
+    *hi = *hi >> 1 ^ (carry ? 0xe100000000000000ULL : 0);
+}
+
+/*
+ * Table q, entry b: b * H * x^(128 q / GHASH_C906_TABLES), where bit 7 of b is
+ * the coefficient of the lowest power; u64 lo[256] then u64 hi[256].
+ * htable[8] is H.
+ */
+void ossl_gcm_c906_build(u64 *tables, const u128 *htable)
+{
+    u64 vh = htable[8].hi, vl = htable[8].lo;
+    int q, i, j;
+
+    for (q = 0; q < GHASH_C906_TABLES; q++) {
+        u64 *lo = tables + 512 * q, *hi = lo + 256;
+
+        lo[0] = 0;
+        hi[0] = 0;
+        for (i = 0x80; i != 0; i >>= 1) {
+            lo[i] = vl;
+            hi[i] = vh;
+            mulx(&vh, &vl);
+        }
+        for (i = 2; i < 256; i <<= 1) {
+            for (j = 1; j < i; j++) {
+                lo[i + j] = lo[i] ^ lo[j];
+                hi[i + j] = hi[i] ^ hi[j];
+            }
+        }
+        for (i = 8; i < 128 / GHASH_C906_TABLES; i++)
+            mulx(&vh, &vl);
+    }
+}
+
+/* len is a multiple of 16. */
+void ossl_gcm_c906_ghash(u64 xi[2], const u64 *tables, const u8 *in,
+    size_t len)
+{
+    u64 acc[2];
+
+    acc[0] = __builtin_bswap64(xi[1]);
+    acc[1] = __builtin_bswap64(xi[0]);
+    ossl_ghash_blocks_c906(acc, tables, in, len / 16);
+    xi[0] = __builtin_bswap64(acc[1]);
+    xi[1] = __builtin_bswap64(acc[0]);
+}
