+typedef struct lz4_110_stream_internal {
+    u32 hashTable[LZ4_110_HASH_SIZE_U32];
+    const u8 *dictionary;
+    const struct lz4_110_stream_internal *dictCtx;
+    u32 currentOffset;
+    u32 tableType;
+    u32 dictSize;
+} lz4_110_stream_internal;
+
+typedef union {
+    u64 align;
+    u8 storage[LZ4_110_HASHTABLESIZE + 32];
+    lz4_110_stream_internal internal_donotuse;
+} lz4_110_stream;
