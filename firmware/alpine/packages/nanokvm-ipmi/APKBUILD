# Optional add-on, published with the core packages but required by none:
# Software > Add-ons installs it. nanokvm-release does not depend on it.
pkgname=nanokvm-ipmi
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="NanoKVM IPMI add-on: IPMI over LAN power control of the host"
url="https://github.com/dormancygrace/NanoKVM-OS/blob/main/docs/BMC.md"
arch="riscv64"
license="GPL-3.0-only"
depends="openrc"
install="$pkgname.pre-deinstall"
source="$pkgname-$pkgver.tar.gz"
# A static Go program from build.sh (server step).
options="!check !strip !tracedeps"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
