From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] soc: sophgo: cv1800-rtcsys: restart before the watchdog

The RTC warm reset and the DesignWare watchdog's restart handler both
registered at the default restart priority, and the watchdog's ran first:
it resets the chip at once, so the warm reset never ran and
RTC_ST_ON_REASON reported a watchdog reset after every reboot, the same as
after a hang. Register the warm reset at SYS_OFF_PRIO_HIGH. Writing
RTC_CTRL0 starts the reset without stopping the CPU, so wait 100 ms
before handing over to the next handler, as before a failed sequence.

diff --git a/drivers/soc/sophgo/cv1800-rtcsys.c b/drivers/soc/sophgo/cv1800-rtcsys.c
--- a/drivers/soc/sophgo/cv1800-rtcsys.c
+++ b/drivers/soc/sophgo/cv1800-rtcsys.c
@@ -10,6 +10,7 @@
  *
  */
 
+#include <linux/delay.h>
 #include <linux/mfd/core.h>
 #include <linux/mfd/syscon.h>
 #include <linux/reboot.h>
@@ -50,8 +51,13 @@
 	if (ret)
 		goto failed;
 	ret = regmap_write(map, RTC_CTRL0, 0xffff0810);
-	if (!ret)
+	if (!ret) {
+		/* The reset takes effect within microseconds; past this the
+		 * next handler (the watchdog's) restarts the chip. */
+		mdelay(100);
+		dev_err(data->dev, "warm reset did not happen\n");
 		return NOTIFY_DONE;
+	}
 failed:
 	dev_err(data->dev, "warm reset failed: %d\n", ret);
 	return notifier_from_errno(ret);
@@ -77,7 +83,12 @@
 	map = syscon_node_to_regmap(pdev->dev.of_node);
 	if (IS_ERR(map))
 		return dev_err_probe(&pdev->dev, PTR_ERR(map), "missing RTC syscon\n");
-	ret = devm_register_restart_handler(&pdev->dev, cv1800_rtcsys_restart, map);
+	/* Ahead of the DesignWare watchdog's restart (priority 128), which
+	 * resets the chip at once and leaves RTC_ST_ON_REASON naming a
+	 * watchdog reset for every reboot. */
+	ret = devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART,
+					    SYS_OFF_PRIO_HIGH,
+					    cv1800_rtcsys_restart, map);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "restart registration failed\n");
 
