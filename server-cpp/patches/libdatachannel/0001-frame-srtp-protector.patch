+/**
+ * An outbound SRTP protector for RTP, installed for the whole process: a crypto engine protects the packets of a
+ * video frame in one request instead of one request per packet. RTCP stays with libsrtp.
+ */
+
+#ifndef RTC_SRTP_PROTECTOR_H
+#define RTC_SRTP_PROTECTOR_H
+
+#include "common.hpp"
+
+#include <functional>
+#include <memory>
+#include <string>
+
+namespace rtc {
+
+// Bytes a protector may write after a packet (the authentication tag, and scratch for its hash).
+inline constexpr size_t SrtpProtectorRoom = 128;
+
+class RTC_CPP_EXPORT SrtpProtector {
+public:
+	virtual ~SrtpProtector() = default;
+	// Protects count RTP packets in place (each has SrtpProtectorRoom bytes after sizes[i]) and sets their new
+	// sizes; false on failure (none of them is sent).
+	virtual bool protect(std::byte **packets, size_t *sizes, size_t count) = 0;
+};
+
+// Called once the DTLS handshake has given the outbound keys: the SRTP profile's name (as OpenSSL names it) and the
+// master key and salt. nullptr leaves the connection's RTP to libsrtp.
+using SrtpProtectorFactory = std::function<std::unique_ptr<SrtpProtector>(
+    const std::string &profile, const unsigned char *key, size_t keyLen, const unsigned char *salt, size_t saltLen)>;
+
+RTC_CPP_EXPORT void SetSrtpProtectorFactory(SrtpProtectorFactory factory);
+
+} // namespace rtc
+
+#endif
