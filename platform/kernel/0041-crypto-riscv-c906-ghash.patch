From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] crypto: riscv - GHASH for the T-Head C906

GHASH for lib/crypto on the T-Head C906 of the SG2002, which has no
carry-less multiply. The generic code multiplies 64-bit operands, about four
unpipelined cycles each on this core.

This is Shoup's 8-bit table method: per key, GHASH_C906_TABLES tables of
4 KiB hold b * H * x^(128 q / tables) for every byte b; a block is that many
interleaved Horner chains of 8-bit steps, one lookup per table and one in a
constant reduction table per step. ghash_preparekey() builds the tables in
struct ghash_key. The code is scalar (XTheadBb, XTheadMemIdx) and runs in any
context. It is not constant-time: lookups depend on the key and the data, as
in a 4-bit table GHASH.

The assembly is generated by firmware/cpu/go-crypto-c906/gen_ghash_table.py.

CRYPTO_LIB_GF128HASH_ARCH now also defaults to y with RISCV_ISA_XTHEADVECTOR;
the Zvkg backend keeps its previous conditions and takes precedence.

diff --git a/include/crypto/gf128hash.h b/include/crypto/gf128hash.h
index 41c557d..a1b9e9e 100644
--- a/include/crypto/gf128hash.h
+++ b/include/crypto/gf128hash.h
@@ -34,6 +34,12 @@ struct polyval_elem {
 	};
 };
 
+/*
+ * Tables per key of the T-Head C906 GHASH: 1, 2 or 4. More tables are faster
+ * while they stay in the L1 data cache.
+ */
+#define GHASH_C906_TABLES	2
+
 /**
  * struct ghash_key - Prepared key for GHASH
  *
@@ -47,6 +53,13 @@ struct ghash_key {
 	(defined(CONFIG_RISCV) || defined(CONFIG_S390))
 	/** @h_raw: The hash key H, in GHASH format */
 	u8 h_raw[GHASH_BLOCK_SIZE];
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	/**
+	 * @c906_tables: 8-bit multiplication tables for the T-Head C906 code,
+	 * 4 KiB each (lib/crypto/riscv/ghash-riscv64-c906.S)
+	 */
+	u64 c906_tables[GHASH_C906_TABLES * 512];
+#endif
 #endif
 	/** @h: The hash key H, in POLYVAL format */
 	struct polyval_elem h;
diff --git a/lib/crypto/Kconfig b/lib/crypto/Kconfig
index 9d8ba6f5c..976cd8495 100644
--- a/lib/crypto/Kconfig
+++ b/lib/crypto/Kconfig
@@ -122,6 +122,7 @@ config CRYPTO_LIB_GF128HASH_ARCH
 	default y if PPC64 && VSX
 	default y if RISCV && 64BIT && TOOLCHAIN_HAS_VECTOR_CRYPTO && \
 		     RISCV_EFFICIENT_VECTOR_UNALIGNED_ACCESS
+	default y if RISCV && 64BIT && RISCV_ISA_XTHEADVECTOR
 	default y if S390
 	default y if X86_64
 
