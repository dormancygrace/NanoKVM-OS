#!/bin/sh
# Internet sharing owns its flowtable together with its NAT/USB lifecycle.
# Retire only the wildcard table owned by earlier NanoKVM policy versions:
# broad offload could otherwise bypass the USB local-only guard and VPN rules.
case "${1:-}" in
    start|restart|reload|stop)
        if nft list table inet nkos_flow >/dev/null 2>&1; then
            nft delete table inet nkos_flow || exit 1
        fi
        ;;
    status) nft list table inet nkos_usb_internet ;;
    *) echo "Usage: $0 {start|stop|restart|reload|status}" >&2; exit 1 ;;
esac
