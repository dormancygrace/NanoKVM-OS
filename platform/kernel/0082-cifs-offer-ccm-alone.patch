From: NanoKVM OS
Subject: [PATCH] smb: client: offer AES-128-CCM alone for SMB 3.1.1 encryption

The client offers AES-128-GCM, AES-256-GCM and AES-128-CCM, and a server
chooses by its own preference: GCM. On the SG2002 the CryptoDMA engine runs
AES-CTR and CBC-MAC, so CCM is in hardware as a whole, while GCM leaves GHASH
to the CPU: reads of an encrypted share are about 15% faster with CCM. Offer
CCM alone; ccm_only=n restores the upstream offer for a server that has CCM
disabled. Such a server takes none of the offered ciphers; ccm_refused
records that, so that the caller of a failed mount knows to try again with
ccm_only=n. A session setup refused with anything but access denied (a wrong
password) clears it: that mount is not worth a second logon.

--- a/fs/smb/client/cifsfs.c
+++ b/fs/smb/client/cifsfs.c
@@ -69,6 +69,8 @@
 bool disable_legacy_dialects; /* false by default */
 bool enable_gcm_256 = true;
 bool require_gcm_256; /* false by default */
+bool ccm_only = true;
+bool ccm_refused;
 bool enable_negotiate_signing; /* false by default */
 unsigned int global_secflags = CIFSSEC_DEF;
 /* unsigned int ntlmv2_support = 0; */
@@ -143,6 +145,10 @@
 module_param(enable_gcm_256, bool, 0644);
 MODULE_PARM_DESC(enable_gcm_256, "Enable requesting strongest (256 bit) GCM encryption. Default: y/Y/1");
 
+module_param(ccm_only, bool, 0644);
+MODULE_PARM_DESC(ccm_only, "Offer AES-128-CCM alone for SMB 3.1.1 encryption (the SG2002 CryptoDMA engine runs all of CCM, GCM leaves GHASH to the CPU). Default: y; n restores the upstream offer");
+module_param(ccm_refused, bool, 0644);
+MODULE_PARM_DESC(ccm_refused, "Set when a server took none of the ciphers offered with ccm_only: the mount that needs encryption can be tried again with ccm_only=n");
 module_param(require_gcm_256, bool, 0644);
 MODULE_PARM_DESC(require_gcm_256, "Require strongest (256 bit) GCM encryption. Default: n/N/0");
 
--- a/fs/smb/client/cifsglob.h
+++ b/fs/smb/client/cifsglob.h
@@ -2123,6 +2123,8 @@
 extern unsigned int sign_CIFS_PDUs;  /* enable smb packet signing */
 extern bool enable_gcm_256; /* allow optional negotiate of strongest signing (aes-gcm-256) */
 extern bool require_gcm_256; /* require use of strongest signing (aes-gcm-256) */
+extern bool ccm_only; /* offer AES-128-CCM alone */
+extern bool ccm_refused; /* a server took no cipher of that offer */
 extern bool enable_negotiate_signing; /* request use of faster (GMAC) signing if available */
 extern bool linuxExtEnabled;/*enable Linux/Unix CIFS extensions*/
 extern unsigned int CIFSMaxBufSize;  /* max size not including hdr */
--- a/fs/smb/client/smb2pdu.c
+++ b/fs/smb/client/smb2pdu.c
@@ -679,6 +679,14 @@
 		pneg_ctxt->DataLength = cpu_to_le16(4); /* Cipher Count + 1 cipher */
 		pneg_ctxt->CipherCount = cpu_to_le16(1);
 		pneg_ctxt->Ciphers[0] = SMB2_ENCRYPTION_AES256_GCM;
+	} else if (ccm_only) {
+		/*
+		 * A server picks from the offer by its own preference, and
+		 * that is GCM wherever it is offered.
+		 */
+		pneg_ctxt->DataLength = cpu_to_le16(4); /* Cipher Count + 1 cipher */
+		pneg_ctxt->CipherCount = cpu_to_le16(1);
+		pneg_ctxt->Ciphers[0] = SMB2_ENCRYPTION_AES128_CCM;
 	} else if (enable_gcm_256) {
 		pneg_ctxt->DataLength = cpu_to_le16(8); /* Cipher Count + 3 ciphers */
 		pneg_ctxt->CipherCount = cpu_to_le16(3);
@@ -921,6 +929,8 @@
 		 * seal not requested by client, since server is allowed to
 		 * return 0 to indicate no supported cipher, we can't fail here
 		 */
+		if (ccm_only)
+			ccm_refused = true;
 		server->cipher_type = 0;
 		server->capabilities &= ~SMB2_GLOBAL_CAP_ENCRYPTION;
 		pr_warn_once("Server does not support requested encryption types\n");
@@ -1658,6 +1668,14 @@
 			    &sess_data->buf0_type,
 			    CIFS_LOG_ERROR | CIFS_SESS_OP, &rsp_iov);
 	cifs_small_buf_release(sess_data->iov[0].iov_base);
+	/* A refused logon is not a refused cipher offer: no second mount for it. */
+	if (rc && rsp_iov.iov_base) {
+		__le32 status = ((struct smb2_hdr *)rsp_iov.iov_base)->Status;
+
+		if (status != STATUS_ACCESS_DENIED &&
+		    status != STATUS_MORE_PROCESSING_REQUIRED)
+			ccm_refused = false;
+	}
 	if (rc == 0)
 		sess_data->ses->expired_pwd = false;
 	else if ((rc == -EACCES) || (rc == -EKEYEXPIRED) || (rc == -EKEYREVOKED)) {
