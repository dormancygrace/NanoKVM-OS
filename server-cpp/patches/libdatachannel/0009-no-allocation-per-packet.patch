+message_ptr RtpPacketizer::newPacket() {
+	// Enough for the NACK history (512 packets) and a frame in flight; beyond, new packets are not kept.
+	constexpr size_t maxPackets = 2048;
+	if (!mPackets.empty()) {
+		auto &oldest = mPackets[mPacketsNext];
+		if (oldest.use_count() == 1) {
+			mPacketsNext = (mPacketsNext + 1) % mPackets.size();
+			oldest->clear();
+			oldest->type = Message::Binary;
+			oldest->stream = 0;
+			oldest->dscp = 0;
+			oldest->reliability.reset();
+			oldest->frameInfo.reset();
+			return oldest;
+		}
+	}
+	auto packet = std::make_shared<Message>(binary{}, Message::Binary);
+	if (mPackets.size() < maxPackets) {
+		// The newest, just before the oldest in ring order.
+		mPackets.insert(mPackets.begin() + mPacketsNext, packet);
+		mPacketsNext = (mPacketsNext + 1) % mPackets.size();
+	}
+	return packet;
+}
