pkgname=nanokvm-kmod
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="NanoKVM kernel modules"
url="https://github.com/sipeed/NanoKVM"
arch="riscv64"
license="GPL-2.0-only"
depends="kmod"
# Named nanokvm-kmod-sg2002 before 3.7.0.
replaces="nanokvm-kmod-sg2002"
source="$pkgname-$pkgver.tar.gz"
options="!check !strip"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
