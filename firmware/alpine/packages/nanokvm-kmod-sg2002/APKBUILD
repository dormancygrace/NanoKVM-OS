pkgname=nanokvm-kmod-sg2002
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="NanoKVM SG2002 kernel modules"
url="https://github.com/sipeed/NanoKVM"
arch="riscv64"
license="GPL-2.0-only"
depends="kmod"
source="$pkgname-$pkgver.tar.gz"
options="!check"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
