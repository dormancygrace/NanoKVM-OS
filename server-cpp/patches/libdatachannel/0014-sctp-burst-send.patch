+namespace {
+
+struct Burst {
+	int depth = 0;
+	Transport *owner = nullptr;
+	message_vector messages;
+};
+
+thread_local Burst tBurst;
+
+// A burst goes to the layer below this many records at a time: the largest batch the UDP send takes in one call is
+// bounded anyway (UDP_SEGMENT).
+constexpr size_t maxBurst = 32;
+// One scope collects at most this many; beyond, a record is sent at once as without a scope. usrsctp emits what its
+// congestion window allows in one call, far fewer.
+constexpr size_t maxCollected = 512;
+// Records the socket did not take are given again until this long after the first shortfall of a burst. Each
+// attempt already waited in the layer below for the socket to drain.
+constexpr auto burstRetry = std::chrono::seconds(1);
+
+} // namespace
+
+Transport::BurstScope::BurstScope() { ++tBurst.depth; }
+
+Transport::BurstScope::~BurstScope() {
+	if (--tBurst.depth == 0)
+		Transport::flushBurst();
+}
+
+bool Transport::collectBurst(message_ptr &message) {
+	if (tBurst.depth == 0 || !message)
+		return false;
+	// Never sent from here: the caller may hold the SCTP and DTLS locks, and a send can wait for the socket.
+	if ((tBurst.owner && tBurst.owner != this) || tBurst.messages.size() >= maxCollected)
+		return false;
+	tBurst.owner = this;
+	tBurst.messages.push_back(std::move(message));
+	return true;
+}
+
+void Transport::flushBurst() noexcept {
+	Transport *owner = std::exchange(tBurst.owner, nullptr);
+	if (!owner || tBurst.messages.empty())
+		return;
+	message_vector messages;
+	messages.swap(tBurst.messages);
+	// The layer below tells how many records, in order, the socket took. A burst taken in part keeps the others:
+	// collectBurst() already told the SCTP stack they were sent, so dropping them here would turn a full socket
+	// buffer into packet loss. They are given again, without the ones already taken, until burstRetry has passed
+	// since the first shortfall. A transport that cannot send any more ends the burst at once.
+	size_t sent = 0;
+	bool closed = false;
+	try {
+		std::chrono::steady_clock::time_point giveUp{};
+		while (sent < messages.size()) {
+			size_t count = std::min(maxBurst, messages.size() - sent);
+			int took = owner->outgoingBatchPrefix(messages, sent, count);
+			if (took < 0) {
+				closed = true;
+				break;
+			}
+			sent += size_t(took);
+			if (size_t(took) == count)
+				continue;
+			auto now = std::chrono::steady_clock::now();
+			if (giveUp == std::chrono::steady_clock::time_point{})
+				giveUp = now + burstRetry;
+			else if (now >= giveUp)
+				break;
+		}
+	} catch (const std::exception &e) {
+		PLOG_WARNING << "Burst send: " << e.what();
+	}
+	if (sent < messages.size()) {
+		// Given up: these are lost to the peer like packets lost on the way, and counted as not sent.
+		AddUnsentMediaDatagrams(messages.size() - sent);
+		PLOG_WARNING << "Burst send: " << (messages.size() - sent) << " of " << messages.size()
+		             << (closed ? " records dropped, the transport is closed" : " records dropped, the socket stayed full");
+	}
+	messages.clear();
+	if (tBurst.messages.empty())
+		tBurst.messages.swap(messages); // keeps the capacity for the next burst
+}
+
+int Transport::sendBatchPrefix(message_vector &messages, size_t from, size_t count) {
+	size_t taken = 0;
+	while (taken < count && send(messages[from + taken]))
+		++taken;
+	return int(taken);
+}
+
+int Transport::outgoingBatchPrefix(message_vector &messages, size_t from, size_t count) {
+	return mLower ? mLower->sendBatchPrefix(messages, from, count) : -1;
+}
+
