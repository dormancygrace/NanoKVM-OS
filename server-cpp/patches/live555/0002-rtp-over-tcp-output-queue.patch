+unsigned RTPInterfaceMaxBacklogBytes = 2 << 20;
+void (*RTPInterfaceBacklogHook)(int socketNum, unsigned backlogBytes) = NULL;
+void (*RTPInterfaceClosedHook)(int socketNum) = NULL;
+void (*RTPInterfaceStreamRemovedHook)(int socketNum, unsigned char channelId) = NULL;
+
+namespace {
+struct TcpOutput {
+  std::string queue;
+  bool media = false; // carries RTP: its backlog is reported
+};
+std::map<int, TcpOutput>& tcpOutputs() {
+  static std::map<int, TcpOutput> outputs;
+  return outputs;
+}
+TaskScheduler* drainScheduler = NULL;
+TaskToken drainTask = NULL;
+int64_t const drainIntervalUs = 5000;
+
+void stopDrain() {
+  if (drainTask != NULL && drainScheduler != NULL) drainScheduler->unscheduleDelayedTask(drainTask);
+  drainTask = NULL;
+}
+
+void disconnect(int socketNum) {
+  shutdown(socketNum, SHUT_RDWR);
+  RTPInterfaceForgetSocket(socketNum);
+}
+
+// Sends what the socket takes of its queue. False on a failed socket.
+bool flush(int socketNum, TcpOutput& out) {
+  if (out.queue.empty()) return true;
+  ssize_t n = send(socketNum, out.queue.data(), out.queue.size(), MSG_NOSIGNAL);
+  if (n > 0) out.queue.erase(0, (size_t)n);
+  return n >= 0 || errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR;
+}
+
+void drain(void*);
+
+void scheduleDrain(TaskScheduler& scheduler) {
+  if (drainTask != NULL) return;
+  drainScheduler = &scheduler;
+  drainTask = scheduler.scheduleDelayedTask(drainIntervalUs, drain, NULL);
+}
+
+void drain(void*) {
+  drainTask = NULL;
+  std::vector<int> failed;
+  std::vector<std::pair<int, unsigned> > reports;
+  bool waiting = false;
+  for (std::map<int, TcpOutput>::iterator i = tcpOutputs().begin(); i != tcpOutputs().end(); ++i) {
+    if (i->second.queue.empty()) continue;
+    if (!flush(i->first, i->second)) { failed.push_back(i->first); continue; }
+    if (i->second.media) reports.push_back(std::make_pair(i->first, (unsigned)i->second.queue.size()));
+    if (!i->second.queue.empty()) waiting = true;
+  }
+  for (size_t i = 0; i < failed.size(); ++i) disconnect(failed[i]);
+  if (RTPInterfaceBacklogHook != NULL)
+    for (size_t i = 0; i < reports.size(); ++i) (*RTPInterfaceBacklogHook)(reports[i].first, reports[i].second);
+  if (waiting && drainScheduler != NULL) scheduleDrain(*drainScheduler);
+}
+
+// Writes the buffers behind the socket's queue; what the socket does not take is queued. False (and the client
+// disconnected) when the socket failed or the queue would pass the limit.
+bool writeOrdered(TaskScheduler& scheduler, int socketNum, struct iovec* iov, int count, bool media) {
+  TcpOutput& out = tcpOutputs()[socketNum];
+  if (media) out.media = true;
+  bool ok = flush(socketNum, out);
+  size_t total = 0, sent = 0;
+  for (int i = 0; i < count; ++i) total += iov[i].iov_len;
+  if (ok && out.queue.empty()) {
+    struct msghdr msg;
+    memset(&msg, 0, sizeof msg);
+    msg.msg_iov = iov; msg.msg_iovlen = count;
+    ssize_t n = sendmsg(socketNum, &msg, MSG_NOSIGNAL);
+    if (n > 0) sent = (size_t)n;
+    else if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) ok = false;
+  }
+  if (ok && sent < total) {
+    if (out.queue.size() + (total - sent) > RTPInterfaceMaxBacklogBytes) {
+      ok = false;
+    } else {
+      for (int i = 0; i < count; ++i) {
+        size_t len = iov[i].iov_len;
+        if (sent >= len) { sent -= len; continue; }
+        out.queue.append((char const*)iov[i].iov_base + sent, len - sent);
+        sent = 0;
+      }
+      scheduleDrain(scheduler);
+    }
+  }
+  if (!ok) {
+    // The client is gone, or too far behind: disconnect it. RTP and the RTSP connection share the socket, so the
+    // client sees the end at once and the connection closes.
+    disconnect(socketNum);
+    return false;
+  }
+  if (out.media && RTPInterfaceBacklogHook != NULL) (*RTPInterfaceBacklogHook)(socketNum, (unsigned)out.queue.size());
+  return true;
+}
+} // namespace
+
+bool RTPInterfaceWrite(TaskScheduler& scheduler, int socketNum, char const* data, unsigned size) {
+  struct iovec iov;
+  iov.iov_base = (void*)data; iov.iov_len = size;
+  return writeOrdered(scheduler, socketNum, &iov, 1, false);
+}
+
+void RTPInterfaceForgetSocket(int socketNum) {
+  if (socketNum < 0) return;
+  bool known = tcpOutputs().erase(socketNum) > 0;
+  if (tcpOutputs().empty()) stopDrain();
+  if (known && RTPInterfaceClosedHook != NULL) (*RTPInterfaceClosedHook)(socketNum);
+}
+
+void RTPInterfaceForgetAll() {
+  stopDrain();
+  tcpOutputs().clear();
+  drainScheduler = NULL;
+}
 
