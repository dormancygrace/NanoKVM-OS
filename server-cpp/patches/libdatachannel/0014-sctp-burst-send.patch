+int IceTransport::sendBatchPrefix(message_vector &messages, size_t from, size_t count) {
+	auto s = state();
+	if (s != State::Connected && s != State::Completed)
+		return -1;
+	if (count == 0)
+		return 0;
+	std::vector<const char *> data;
+	std::vector<size_t> sizes;
+	data.reserve(count);
+	sizes.reserve(count);
+	for (size_t i = 0; i < count; ++i) {
+		const auto &m = messages[from + i];
+		data.push_back(reinterpret_cast<const char *>(m->data()));
+		sizes.push_back(m->size());
+	}
+	int ds = int(messages[from]->dscp << 2);
+	// The datagrams the socket took, a prefix. JUICE_ERR_AGAIN: none, after the bounded wait for a full buffer.
+	// The caller keeps the others, so nothing is counted as unsent here.
+	int sent = juice_send_batch(mAgent.get(), data.data(), sizes.data(), int(count), ds);
+	if (sent >= 0)
+		return sent;
+	return sent == JUICE_ERR_AGAIN ? 0 : -1;
+}
