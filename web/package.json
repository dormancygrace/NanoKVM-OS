{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "mocked": "vite --mode mocked",
    "build": "tsc && vite build && node scripts/precompress.mjs",
    "test:usb": "node --experimental-strip-types --test tests/usb-composition.test.mjs",
    "test:direct": "node --import tsx --test tests/direct-playout.test.mjs tests/direct-worker.test.mjs",
    "test:i18n": "node --import tsx --test tests/i18n-keys.test.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@xterm/addon-attach": "0.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.8",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "crypto-js": "4.2.0",
    "i18next": "26.5.11",
    "jotai": "3.0.1",
    "lucide-react": "1.61.0",
    "mediabunny": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-draggable": "4.7.2",
    "react-error-boundary": "6.1.6",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.1.9",
    "react-markdown": "10.1.0",
    "react-responsive": "10.0.1",
    "react-router-dom": "7.18.4",
    "react-simple-keyboard": "3.8.288",
    "remark-gfm": "4.0.1",
    "vaul": "1.1.2",
    "yocto-queue": "1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/crypto-js": "4.2.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "msw": "3.0.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "msw"
    ]
  }
}
