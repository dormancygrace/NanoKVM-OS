+// SPDX-License-Identifier: BSD-2-Clause
+/* Kernel API wrappers for the LZ4 1.10.0 compression core. */
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/lz4.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include "lz4_110.h"
+
+/* Do not change the public LZ4 stream size/alignment or decoder layout. */
+static_assert(sizeof(lz4_110_stream) <= LZ4_MEM_COMPRESS);
+static_assert(__alignof__(lz4_110_stream) <= __alignof__(LZ4_stream_t));
+
+int LZ4_compress_fast(const char *src, char *dst, int src_size,
+                     int dst_capacity, int acceleration, void *workmem)
+{
+    return LZ4_compress_fast_extState(workmem, src, dst, src_size,
+                                     dst_capacity, acceleration);
+}
+EXPORT_SYMBOL(LZ4_compress_fast);
+
+int LZ4_compress_default(const char *src, char *dst, int src_size,
+                        int dst_capacity, void *workmem)
+{
+    return LZ4_compress_fast(src, dst, src_size, dst_capacity,
+                             LZ4_ACCELERATION_DEFAULT, workmem);
+}
+EXPORT_SYMBOL(LZ4_compress_default);
+
+int LZ4_compress_destSize(const char *src, char *dst, int *src_size,
+                         int dst_capacity, void *workmem)
+{
+    return LZ4_compress_destSize_extState_internal(workmem, src, dst,
+                src_size, dst_capacity, LZ4_ACCELERATION_DEFAULT);
+}
+EXPORT_SYMBOL(LZ4_compress_destSize);
+
+void LZ4_resetStream(LZ4_stream_t *stream)
+{
+    /* Preserve the kernel API's full-allocation initialization contract. */
+    memset(stream, 0, LZ4_MEM_COMPRESS);
+}
+
+int LZ4_loadDict(LZ4_stream_t *stream, const char *dictionary, int size)
+{
+    return lz4_110_loadDict((lz4_110_stream *)stream, dictionary, size);
+}
+EXPORT_SYMBOL(LZ4_loadDict);
+
+int LZ4_saveDict(LZ4_stream_t *stream, char *safe_buffer, int size)
+{
+    return lz4_110_saveDict((lz4_110_stream *)stream, safe_buffer, size);
+}
+EXPORT_SYMBOL(LZ4_saveDict);
+
+int LZ4_compress_fast_continue(LZ4_stream_t *stream, const char *src,
+                               char *dst, int src_size, int dst_capacity,
+                               int acceleration)
+{
+    return lz4_110_compress_fast_continue((lz4_110_stream *)stream,
+                src, dst, src_size, dst_capacity, acceleration);
+}
+EXPORT_SYMBOL(LZ4_compress_fast_continue);
