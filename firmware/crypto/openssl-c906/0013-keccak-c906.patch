+/*
+ * SHA3_squeeze for the C906 on top of keccak1600-c906.S, which has the permutation and SHA3_absorb (CRYPTOGAMS)
+ * but a squeeze without OpenSSL's `next` argument. This is keccak1600.c's SHA3_squeeze, little-endian and without
+ * bit interleaving, with the permutation of keccak1600-c906.S.
+ */
+
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+
+void ossl_keccakf1600_c906(uint64_t A[5][5], size_t rounds);
+void SHA3_squeeze(uint64_t A[5][5], unsigned char *out, size_t len, size_t r, int next);
+
+void SHA3_squeeze(uint64_t A[5][5], unsigned char *out, size_t len, size_t r, int next)
+{
+    uint64_t *A_flat = (uint64_t *)A;
+    size_t i, w = r / 8;
+
+    assert(r < (25 * sizeof(A[0][0])) && (r % 8) == 0);
+
+    while (len != 0) {
+        if (next)
+            ossl_keccakf1600_c906(A, 24);
+        next = 1;
+        for (i = 0; i < w && len != 0; i++) {
+            uint64_t Ai = A_flat[i];
+
+            if (len < 8) {
+                for (i = 0; i < len; i++) {
+                    *out++ = (unsigned char)Ai;
+                    Ai >>= 8;
+                }
+                return;
+            }
+
+            out[0] = (unsigned char)(Ai);
+            out[1] = (unsigned char)(Ai >> 8);
+            out[2] = (unsigned char)(Ai >> 16);
+            out[3] = (unsigned char)(Ai >> 24);
+            out[4] = (unsigned char)(Ai >> 32);
+            out[5] = (unsigned char)(Ai >> 40);
+            out[6] = (unsigned char)(Ai >> 48);
+            out[7] = (unsigned char)(Ai >> 56);
+            out += 8;
+            len -= 8;
+        }
+    }
+}
