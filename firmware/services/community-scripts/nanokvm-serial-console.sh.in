#!/usr/bin/env bash
# Copyright (c) 2021-2026 community-scripts ORG
# Author: Gleb Pesin (dormancygrace)
# License: MIT
# https://github.com/community-scripts/ProxmoxVE/raw/main/LICENSE
# Source: https://github.com/dormancygrace/NanoKVM-OS (firmware/services/nanokvm-serial-console.sh)

# NanoKVM USB serial console for the Proxmox VE host.
#
# A NanoKVM plugged into the host offers a USB serial port (CDC ACM, USB
# 3346:1009, /dev/ttyACMn). This sets up a login on it, so the host can be
# reached from the NanoKVM's browser terminal when its network is gone:
# a udev rule bound to the NanoKVM's serial number starts
# serial-getty@<port> whenever the port appears. Everything is additive,
# recorded with backups, and undone with "Undo".
#
# Usage: bash -c "$(curl -fsSL https://raw.githubusercontent.com/community-scripts/ProxmoxVE/main/tools/pve/nanokvm-serial-console.sh)"
#        bash nanokvm-serial-console.sh plan|status|apply|undo [--serial SERIAL]   (no dialogs)

set -euo pipefail

function header_info {
  clear
  cat <<"EOF"
    _   __                __ ___    ____  ___              _       __
   / | / /___ _____  ____/ //_/ |  / /  |/  /  _______  __(_)___ _/ /
  /  |/ / __ `/ __ \/ __  / ,<  | | / / /|_/ /  / ___/ _ \/ ___/ / __ `/ /
 / /|  / /_/ / / / / /_/ / /| | | |/ / /  / /  (__  )  __/ /  / / /_/ / /
/_/ |_/\__,_/_/ /_/\____/_/ |_| |___/_/  /_/  /____/\___/_/  /_/\__,_/_/
                                      USB serial console on this host
EOF
}

YW=$(echo "\033[33m")
GN=$(echo "\033[1;92m")
RD=$(echo "\033[01;31m")
CL=$(echo "\033[m")
BFR="\\r\\033[K"
HOLD="-"
CM="${GN}✓${CL}"
CROSS="${RD}✗${CL}"

msg_info() { echo -ne " ${HOLD} ${YW}$1..."; }
msg_ok() { echo -e "${BFR} ${CM} ${GN}$1${CL}"; }
msg_error() { echo -e "${BFR} ${CROSS} ${RD}$1${CL}"; }

if [[ $EUID -ne 0 ]]; then
  msg_error "Run this as root on the Proxmox VE host."
  exit 1
fi

# Proxmox VE 8 and 9 are what the project supports; 7 works too (Debian 11,
# systemd 247), so it only warns.
if command -v pveversion >/dev/null 2>&1; then
  PVE=$(pveversion | sed -n 's|^pve-manager/\([0-9]*\)\..*|\1|p')
  case "$PVE" in
  8 | 9) ;;
  7) echo -e "${YW}Proxmox VE 7 is past its support; the console setup still works on it.${CL}" ;;
  *)
    msg_error "Unsupported Proxmox VE version: $(pveversion)"
    exit 1
    ;;
  esac
fi

# The helper itself: POSIX sh, from the NanoKVM OS source tree. Written to a
# temporary file and run from there, so this script has no network access.
HELPER=$(mktemp /tmp/nanokvm-serial-console.XXXXXX)
trap 'rm -f "$HELPER"' EXIT
cat >"$HELPER" <<'NANOKVM_SERIAL_CONSOLE_HELPER'
__HELPER__
NANOKVM_SERIAL_CONSOLE_HELPER

run_helper() {
  # apply asks its own question on a terminal; the dialog already did
  local action=$1
  shift
  if [[ $action == apply ]]; then
    sh "$HELPER" apply --yes "$@"
  else
    sh "$HELPER" "$action" "$@"
  fi
}

# Arguments: no dialogs, the helper's own interface.
if [[ $# -gt 0 ]]; then
  case $1 in
  plan | status | apply | undo | --help | -h) run_helper "$@" ;;
  *)
    msg_error "Usage: $0 [plan|status|apply|undo] [--serial SERIAL]"
    exit 1
    ;;
  esac
  exit $?
fi

header_info
echo
sh "$HELPER" status || true
echo
while true; do
  CHOICE=$(whiptail --backtitle "Proxmox VE Helper Scripts" --title "NanoKVM USB serial console" --menu \
    "The report above says what this host has. What now?" 16 72 5 \
    "plan" "Show what Apply would change (changes nothing)" \
    "apply" "Set the login up (udev rule, serial-getty@<port>)" \
    "undo" "Remove what Apply added" \
    "serial" "Enter the NanoKVM's USB serial number (not plugged in yet)" \
    "quit" "Leave" 3>&1 1>&2 2>&3) || exit 0
  case $CHOICE in
  plan)
    echo
    run_helper plan ${SERIAL:+--serial "$SERIAL"} || true
    ;;
  apply)
    if whiptail --backtitle "Proxmox VE Helper Scripts" --title "Apply" --yesno \
      "Write the udev rule and start the login on the NanoKVM's port?\n\nBackups and a manifest go to /var/backups/nanokvm-serial-console; Undo reverts it." 12 72; then
      echo
      run_helper apply ${SERIAL:+--serial "$SERIAL"} || true
    fi
    ;;
  undo)
    echo
    run_helper undo || true
    ;;
  serial)
    SERIAL=$(whiptail --backtitle "Proxmox VE Helper Scripts" --title "NanoKVM serial number" --inputbox \
      "The USB serial number shown on the NanoKVM's USB settings page (Settings > USB), for a NanoKVM that is not plugged in now." 10 72 "${SERIAL:-}" 3>&1 1>&2 2>&3) || true
    ;;
  quit) exit 0 ;;
  esac
  echo
  read -r -p "Press Enter to return to the menu " _ || true
done
