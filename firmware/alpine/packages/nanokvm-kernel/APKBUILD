pkgname=nanokvm-kernel
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="NanoKVM kernel and automatic boot activation"
url="https://github.com/sipeed/NanoKVM"
arch="riscv64"
license="GPL-2.0-only"
depends="nanokvm-base>=2.0_beta2-r0 nanokvm-kmod=$pkgver-r$pkgrel"
triggers="$pkgname.trigger=/usr/lib/nanokvm/boot/*:/lib/modules/*"
# Named nanokvm-kernel-sg2002 before 3.7.0.
replaces="nanokvm-kernel-sg2002"
source="$pkgname-$pkgver.tar.gz"
options="!check !strip"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	# The trigger writes the selected board FIT after APK installs matching modules.
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
