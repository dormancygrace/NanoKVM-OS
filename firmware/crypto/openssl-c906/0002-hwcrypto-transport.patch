--- /dev/null
+++ b/crypto/sg2002.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <openssl/crypto.h>
+#include "crypto/sg2002.h"
+
+_Static_assert(sizeof(struct sg2002_crypto_request) == 144, "SG2002 request ABI");
+_Static_assert(sizeof(struct sg2002_crypto_info) == 160, "SG2002 info ABI");
+
+static _Atomic int failed;
+/* Capabilities are immutable for this ABI. Each DSO has its own cache.
+ * Descriptors remain operation-owned, including across fork/provider unload. */
+static _Atomic unsigned int cached_algorithms;
+static CRYPTO_ONCE once = CRYPTO_ONCE_STATIC_INIT;
+static int disabled;
+static void init_options(void)
+{
+    const char *v = secure_getenv("NANOKVM_OPENSSL_DMA");
+    disabled = v != NULL && strcmp(v, "off") == 0;
+}
+static void fault(int error)
+{
+    /* Retry transient resource failures/interruptions on a later operation.
+     * Availability, access and protocol failures disable this library image. */
+    if (error == EIO || error == ETIMEDOUT || error == ENODEV
+        || error == ENOENT || error == ENOTDIR || error == EACCES || error == EPERM
+        || error == ENOTTY || error == EINVAL || error == EMSGSIZE || error == EBADF)
+        atomic_store_explicit(&failed, 1, memory_order_relaxed);
+}
+int ossl_sg2002_begin(unsigned int algorithm)
+{
+    struct sg2002_crypto_info info;
+    struct stat st;
+    unsigned int algorithms;
+    int fd, error;
+    if (algorithm < 1 || algorithm >= SG2002_ALG_COUNT
+        || !CRYPTO_THREAD_run_once(&once, init_options) || disabled
+        || atomic_load_explicit(&failed, memory_order_relaxed))
+        return -1;
+    algorithms = atomic_load_explicit(&cached_algorithms, memory_order_acquire);
+    if (algorithms != 0 && !(algorithms & (1u << algorithm)))
+        return -1;
+    fd = open("/dev/sg2002-aes-probe", O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        fault(errno);
+        return -1;
+    }
+    if (fstat(fd, &st) != 0) {
+        error = errno;
+        goto unavailable;
+    }
+    if (!S_ISCHR(st.st_mode)) {
+        error = ENODEV;
+        goto unavailable;
+    }
+    if (algorithms == 0) {
+        memset(&info, 0, sizeof(info));
+        if (ioctl(fd, SG2002_CRYPTO_INFO, &info) != 0) {
+            error = errno;
+            goto unavailable;
+        }
+        if (info.version != SG2002_CRYPTO_ABI || info.poisoned
+            || info.algorithms == 0 || info.max_input < SG2002_CRYPTO_MAX
+            || info.max_output < SG2002_CRYPTO_OUT_MAX) {
+            error = info.poisoned ? EIO : EINVAL;
+            goto unavailable;
+        }
+        algorithms = info.algorithms;
+        atomic_store_explicit(&cached_algorithms, algorithms, memory_order_release);
+    }
+    if (!(algorithms & (1u << algorithm))) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+unavailable:
+    fault(error);
+    close(fd);
+    return -1;
+}
+static int transaction(int fd, struct sg2002_crypto_request *request,
+                       unsigned char *scratch)
+{
+    struct sg2002_crypto_request r = *request;
+    int hash = r.algorithm == SG2002_ALG_SHA1 || r.algorithm == SG2002_ALG_SHA256;
+    unsigned int capacity = r.output_length;
+    int ok = 0, error;
+
+    if (fd < 0 || atomic_load_explicit(&failed, memory_order_relaxed))
+        goto done;
+    if (r.version != SG2002_CRYPTO_ABI || r.algorithm < 1
+        || r.algorithm >= SG2002_ALG_COUNT || !r.input || !r.length
+        || r.length > SG2002_CRYPTO_MAX || capacity > SG2002_CRYPTO_OUT_MAX
+        || (hash && capacity) || (!hash && (!r.output || !scratch)))
+        goto done;
+    /* Commit neither chaining state nor in-place output on a syscall failure,
+     * including a late copy_to_user fault after hardware already completed.
+     */
+    r.output = hash ? 0 : (uintptr_t)scratch;
+    if (ioctl(fd, SG2002_CRYPTO_RUN, &r) != 0) {
+        error = errno;
+        fault(error);
+        goto done;
+    }
+    if (r.status != (hash ? 2u : 1u)
+        || r.output_length > capacity
+        || (hash && r.output_length != 0)
+        || (!hash && r.algorithm != SG2002_ALG_BASE64
+            && r.output_length != request->length)) {
+        fault(EIO);
+        goto done;
+    }
+    if (!hash)
+        memcpy((void *)(uintptr_t)request->output, scratch, r.output_length);
+    memcpy(request->state, r.state, sizeof(r.state));
+    request->output_length = r.output_length;
+    request->status = r.status;
+    ok = 1;
+done:
+    OPENSSL_cleanse(&r, sizeof(r));
+    return ok;
+}
+/* Keep the output scratch frame off the SHA path. */
+static __attribute__((noinline)) int output_transaction(
+    int fd, struct sg2002_crypto_request *request)
+{
+    unsigned char scratch[SG2002_CRYPTO_OUT_MAX];
+    size_t capacity = request->output_length;
+    int ok = transaction(fd, request, scratch);
+    if (capacity <= sizeof(scratch))
+        OPENSSL_cleanse(scratch, capacity);
+    return ok;
+}
+int ossl_sg2002_run(int fd, struct sg2002_crypto_request *request)
+{
+    if (request->algorithm == SG2002_ALG_SHA1 || request->algorithm == SG2002_ALG_SHA256)
+        return transaction(fd, request, NULL);
+    return output_transaction(fd, request);
+}
+void ossl_sg2002_end(int fd)
+{
+    if (fd >= 0)
+        close(fd);
+}
--- /dev/null
+++ b/include/crypto/sg2002.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef OSSL_NANOKVM_SG2002_TRANSPORT_H
+#define OSSL_NANOKVM_SG2002_TRANSPORT_H
+#include "crypto/sg2002_crypto.h"
+/* A call owns its fd. No shared request, key, buffer or userspace mutex. */
+int ossl_sg2002_begin(unsigned int algorithm);
+int ossl_sg2002_run(int fd, struct sg2002_crypto_request *request);
+void ossl_sg2002_end(int fd);
+#endif
--- /dev/null
+++ b/include/crypto/sg2002_crypto.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef SG2002_CRYPTO_H
+#define SG2002_CRYPTO_H
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+#define SG2002_CRYPTO_ABI 1
+#define SG2002_CRYPTO_MAX 4096
+#define SG2002_CRYPTO_OUT_MAX 8192
+enum sg2002_crypto_algorithm {
+ SG2002_ALG_AES = 1, SG2002_ALG_DES, SG2002_ALG_TDES, SG2002_ALG_SM4,
+ SG2002_ALG_SHA1, SG2002_ALG_SHA256, SG2002_ALG_BASE64,
+ SG2002_ALG_COUNT
+};
+enum sg2002_crypto_mode { SG2002_MODE_ECB, SG2002_MODE_CBC, SG2002_MODE_CTR };
+/* SHA requests transform complete 64-byte blocks. state contains/returns the
+ * canonical big-endian chaining state; callers handle initialization/padding.
+ * input/output are userspace virtual addresses, never physical/DMA addresses.
+ * output_length is capacity on input and actual length on successful return.
+ */
+struct sg2002_crypto_request {
+ __u32 version, algorithm, mode, encrypt;
+ __u32 key_length, length, output_length, status;
+ __u8 key[32], iv[16], state[32];
+ __aligned_u64 input, output;
+ __u32 reserved[4];
+};
+struct sg2002_crypto_info {
+ __u32 version, algorithms, max_input, max_output;
+ __u32 poisoned, reserved[3];
+ __aligned_u64 submitted[SG2002_ALG_COUNT];
+ __aligned_u64 completed[SG2002_ALG_COUNT];
+};
+#define SG2002_CRYPTO_RUN _IOWR('K', 0xc2, struct sg2002_crypto_request)
+#define SG2002_CRYPTO_INFO _IOR('K', 0xc3, struct sg2002_crypto_info)
+#endif
