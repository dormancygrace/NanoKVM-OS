From: dgrace <g.pesin@globalte.ru>
Date: Sun, 6 Sep 2026 19:20:47 +0300
Subject: [PATCH] riscv: dts: sophgo: describe NanoKVM VIP register clock

---
 arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts b/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts
index 7a1c27784..e8dd2d5dd 100644
--- a/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts
@@ -96,6 +96,8 @@ base@a0c8000 {
 		compatible = "cvitek,base";
 		reg = <0xa0c8000 0x20 >;
 		reg-names = "vip_sys";
+		clocks = <&clk CLK_CFG_REG_VIP>;
+		clock-names = "cfg_reg";
 	};
 
 	cif@a0c2000 {
