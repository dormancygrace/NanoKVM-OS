-
-        //Save frame length
-        frm_len = le32_to_cpu(hw_rxhdr->hwvect.len);
+        if (skb_monitor) {
+            skb_monitor->data += (msdu_offset + 2); //sdio/usb word allign
+
+            //Save frame length
+            frm_len = le32_to_cpu(hw_rxhdr->hwvect.len);
+        }
     #endif
+        }
+
+        if (!skb_monitor) {
+            if (status == RX_STAT_MONITOR) {
+                dev_kfree_skb(skb);
+                goto end;
+            }
+            goto check_len_update;
         }
 
         skb_reset_tail_pointer(skb_monitor);
