#!/bin/sh

RESERVE_INET="192.168.90.1/22"
: "${NANOKVM_HOSTNAME_FILE:=/etc/hostname}"
: "${NANOKVM_ETH_CONFIG:=/boot/eth.nodhcp}"
: "${NANOKVM_ETH_DISABLED:=/boot/eth.disabled}"
: "${NANOKVM_ETH_DHCP_PID:=/run/udhcpc.eth0.pid}"
: "${NANOKVM_ETH_VLAN:=/boot/eth.vlan}"
: "${NANOKVM_ETH_VLAN_STATE:=/run/nanokvm-eth-vlan}"
: "${NANOKVM_IP:=ip}"
: "${NANOKVM_MODPROBE:=modprobe}"
: "${NANOKVM_UDHCPC:=udhcpc}"
: "${NANOKVM_ARPING:=arping}"
: "${NANOKVM_DNS_MODE_FILE:=/etc/kvm/network/dns.mode}"
: "${NANOKVM_RESOLV_CONF:=/etc/resolv.conf}"
: "${NANOKVM_GATEWAY_PREFERENCE_FILE:=/etc/kvm/network/gateway.preferred}"

default_route_metric() {
    case "$(cat "$NANOKVM_GATEWAY_PREFERENCE_FILE" 2>/dev/null)" in
        ethernet) echo 10 ;;
        wifi) echo 200 ;;
        *) echo 100 ;;
    esac
}

clean_line() {
    echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g'
}

dhcp_hostname() {
    [ -r "$NANOKVM_HOSTNAME_FILE" ] || return 1
    value=$(sed -n '1{s/\r$//;p;}' "$NANOKVM_HOSTNAME_FILE") || return 1
    printf '%s\n' "$value" | awk '
        length($0) < 1 || length($0) > 253 { exit 1 }
        $0 !~ /^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$/ && $0 !~ /^[A-Za-z0-9]$/ { exit 1 }
        {
            count = split($0, labels, ".")
            for (i = 1; i <= count; i++)
                if (length(labels[i]) < 1 || length(labels[i]) > 63 || labels[i] ~ /^-/ || labels[i] ~ /-$/)
                    exit 1
        }
    ' || return 1
    printf '%s\n' "$value"
}

calc_gw() {
    addr="$1"
    netid="$2"
    IFS=. read a b c d <<EOF
$addr
EOF
    ipnum=$(( (a<<24) + (b<<16) + (c<<8) + d ))
    mask=$(( 0xFFFFFFFF << (32-netid) & 0xFFFFFFFF ))
    gwnum=$(( (ipnum & mask) | 1 ))
    if [ $gwnum -eq $ipnum ]; then
        broadcast=$(( (ipnum & mask) | (0xFFFFFFFF & ~mask) ))
        gwnum=$(( broadcast - 1 ))
    fi
    echo "$(( (gwnum>>24)&255 )).$(( (gwnum>>16)&255 )).$(( (gwnum>>8)&255 )).$(( gwnum&255 ))"
}

valid_vlan_id() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 4094 ] 2>/dev/null
}

ethernet_interface() {
    eth_iface=eth0
    [ -f "$NANOKVM_ETH_VLAN" ] || return 0
    id=$(sed -n '1{s/\r$//;p;}' "$NANOKVM_ETH_VLAN")
    if ! valid_vlan_id "$id"; then
        echo "Invalid Ethernet VLAN ID" >&2
        return 1
    fi
    eth_iface="eth0.$id"
    if ! "$NANOKVM_MODPROBE" 8021q; then
        echo "Could not load 8021Q kernel module" >&2
        return 1
    fi
    if ! "$NANOKVM_IP" link add link eth0 name "$eth_iface" type vlan id "$id"; then
        echo "Could not create Ethernet VLAN $id" >&2
        return 1
    fi
    printf '%s\n' "$eth_iface" > "$NANOKVM_ETH_VLAN_STATE"
    "$NANOKVM_IP" link set dev "$eth_iface" up
}

start() {
    if [ -e "$NANOKVM_ETH_DISABLED" ]; then
        stop
        return 0
    fi
    "$NANOKVM_IP" link set dev eth0 up
    ethernet_interface || return 1
    if [ -x /etc/init.d/S29qdisc ]; then
        /etc/init.d/S29qdisc eth0 || echo "Could not apply fq_codel to eth0" >&2
    fi
    "$NANOKVM_IP" addr flush dev "$eth_iface"
    if [ -e "$NANOKVM_ETH_CONFIG" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=${line%%#*}
            line=$(clean_line "$line")
            [ -z "$line" ] && continue
            set -- $line
            [ "$#" -gt 2 ] && continue
            inet="$1"
            gw="$2"
            [ -z "$inet" ] && continue
            # Check if inet contains a valid netmask, if not, add default /16
            case "$inet" in
                */*)
                    # Already has netmask, check if valid (1-32)
                    netid_check=${inet#*/}
                    if ! echo "$netid_check" | grep -qE '^[0-9]+$' || [ $netid_check -lt 1 ] 2>/dev/null || [ $netid_check -gt 32 ] 2>/dev/null; then
                        inet="${inet%/*}/16"
                    fi
                    ;;
                *)
                    # No netmask, add default /16
                    inet="$inet/16"
                    ;;
            esac
            addr=${inet%/*}
            netid=${inet#*/}
            [ -z "$gw" ] && gw=$(calc_gw "$addr" "$netid")
            "$NANOKVM_ARPING" -Dqc2 "-I$eth_iface" "$addr" || continue
            "$NANOKVM_IP" a add "$inet" brd + dev "$eth_iface"
            "$NANOKVM_IP" r add default via "$gw" dev "$eth_iface" metric "$(default_route_metric)"
            if [ "$(cat "$NANOKVM_DNS_MODE_FILE" 2>/dev/null)" != "manual" ]; then
                printf 'nameserver %s\n' "$gw" >> "$NANOKVM_RESOLV_CONF"
            fi
            break
        done < "$NANOKVM_ETH_CONFIG"

        "$NANOKVM_IP" a show dev "$eth_iface" | grep inet > /dev/null || {
            set -- -B -i "$eth_iface" -t 3 -T 1 -A 5 -b -O 121 -p "$NANOKVM_ETH_DHCP_PID"
            if value=$(dhcp_hostname); then
                set -- "$@" -x "hostname:$value" -F "$value"
            fi
            "$NANOKVM_UDHCPC" "$@" >/dev/null 2>&1
            "$NANOKVM_IP" a show dev "$eth_iface" | grep inet > /dev/null
        } || {
            inet=$RESERVE_INET
            addr=${inet%/*}
            "$NANOKVM_IP" a add "$inet" brd + dev "$eth_iface"
        } || exit 1
    else
        set -- -B -i "$eth_iface" -t 10 -T 1 -A 5 -b -O 121 -p "$NANOKVM_ETH_DHCP_PID"
        if value=$(dhcp_hostname); then
            set -- "$@" -x "hostname:$value" -F "$value"
        fi
        "$NANOKVM_UDHCPC" "$@" &
    fi
}

stop() {
    if [ -f "$NANOKVM_ETH_DHCP_PID" ]; then
        kill "$(cat "$NANOKVM_ETH_DHCP_PID")" 2>/dev/null || true
        rm -f "$NANOKVM_ETH_DHCP_PID"
    fi
    if [ -f "$NANOKVM_ETH_VLAN_STATE" ]; then
        vlan_iface=$(cat "$NANOKVM_ETH_VLAN_STATE")
        case "$vlan_iface" in
            eth0.*)
                id=${vlan_iface#eth0.}
                if valid_vlan_id "$id"; then
                    "$NANOKVM_IP" link delete dev "$vlan_iface" || true
                fi
                ;;
        esac
        rm -f "$NANOKVM_ETH_VLAN_STATE"
    fi
    "$NANOKVM_IP" addr flush dev eth0 || true
    "$NANOKVM_IP" link set dev eth0 down
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload)
        $0 stop
        $0 start
        ;;
    *) exit 1 ;;
esac
