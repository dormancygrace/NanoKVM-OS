+/* Preserve the vendor fixed-width, zero-padded copy semantics. Some callers
+ * intentionally copy non-NUL-terminated slices, so strscpy is not equivalent. */
+static inline char *rtw_strncpy(char *dst, const char *src, size_t count)
+{
+	size_t copied = 0;
+	while (copied < count && src[copied])
+		copied++;
+	memcpy(dst, src, copied);
+	if (copied < count)
+		memset(dst + copied, 0, count - copied);
+	return dst;
+}
