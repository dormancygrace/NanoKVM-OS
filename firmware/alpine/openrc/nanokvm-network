#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034,SC3043 # OpenRC reads description; its sh has local

description="NanoKVM Ethernet and Wi-Fi setup"

: "${NANOKVM_NETWORK_LEGACY_DIR:=/usr/libexec/nanokvm/legacy}"
: "${NANOKVM_BOARD_PROFILE:=/etc/kvm/board-profile}"
: "${NANOKVM_ETH_DISABLED:=/boot/eth.disabled}"
: "${NANOKVM_WIFI_ETC_DIR:=/etc/kvm}"
: "${NANOKVM_BLUETOOTH_CONF:=/etc/modprobe.d/nanokvm-bluetooth.conf}"
: "${NANOKVM_NETWORK_PENDING:=/run/nanokvm-network.pending}"

depend() {
    # /boot holds the interface settings. The board service only applies the
    # hostname and MAC first; a video, HDMI or module failure there must not
    # leave the device without a network.
    need localmount
    use nanokvm-board
    provide net
    before sshd
}

# The same package installs the scripts.
run_legacy() {
    "$NANOKVM_NETWORK_LEGACY_DIR/$1" start
}

stop_legacy() {
    "$NANOKVM_NETWORK_LEGACY_DIR/$1" stop
}

start_interfaces() {
    local started=0 profile=
    export NANOKVM_WPA_PASSPHRASE=/usr/libexec/nanokvm/wpa-passphrase-compat

    # Ethernet and Wi-Fi are independent. A failed optional interface must not
    # keep the OpenRC net provider (and chronyd) down when the other starts.
    # Every board has Ethernet.
    if run_legacy S30eth; then
        [ -e "$NANOKVM_ETH_DISABLED" ] || started=1
    else
        ewarn "Ethernet did not start"
    fi

    # udev does not load the SDIO Wi-Fi drivers (modprobe.d/nanokvm-wifi.conf):
    # S30wifi loads the one for the board's card (S25wifimod) only while
    # Wi-Fi is on. Turned off, the driver (with cfg80211, about 1.8 MB) and
    # its firmware upload (about 1.5 s of the one core) wait until S30wifi
    # turns Wi-Fi or the access point on. Bluetooth turned on rides on the
    # same driver (its module loads after it), so it loads the driver with
    # Wi-Fi off too; S30wifi then keeps Wi-Fi itself off.
    # The alpha board has no Wi-Fi slot (its DT disables SDIO); on other
    # boards the card is optional, and S25wifimod fails at once without one.
    [ ! -r "$NANOKVM_BOARD_PROFILE" ] || read -r profile < "$NANOKVM_BOARD_PROFILE" || true
    [ "$profile" != alpha ] || { [ "$started" -ne 0 ]; return; }
    if [ -e "$NANOKVM_WIFI_ETC_DIR/wifi.disabled" ]; then
        [ -e "$NANOKVM_BLUETOOTH_CONF" ] || { [ "$started" -ne 0 ]; return; }
        run_legacy S25wifimod || ewarn "Wi-Fi module initialization failed"
    fi
    if run_legacy S30wifi; then
        [ -e "$NANOKVM_WIFI_ETC_DIR/wifi.disabled" ] || started=1
    else
        ewarn "Wi-Fi did not start"
    fi

    [ "$started" -ne 0 ]
}

# The interfaces come up in the background: the services after this one, the
# application among them, do not wait for the Ethernet link, its duplicate
# address probe and Wi-Fi (about 5 s at boot). A failure goes to the log.
start() {
    if [ -e /var/lib/nanokvm-recovery/pending.json ]; then
        ewarn "Settings recovery is incomplete; starting networking for remote repair"
    fi
    ebegin "Starting NanoKVM network"
    : > "$NANOKVM_NETWORK_PENDING" || { eend 1; return 1; }
    (
        start_interfaces >/dev/null 2>&1 ||
            logger -t nanokvm-network "No NanoKVM network interface started"
        rm -f "$NANOKVM_NETWORK_PENDING"
    ) </dev/null >/dev/null 2>&1 &
    eend 0
}

stop() {
    local n=0
    ebegin "Stopping NanoKVM network"
    # A start still running in the background finishes first (at most 15 s).
    while [ -e "$NANOKVM_NETWORK_PENDING" ] && [ "$n" -lt 150 ]; do
        sleep 0.1
        n=$((n + 1))
    done
    # Never race a slow start (e.g. several duplicate static addresses).
    # Leave the marker with its worker and let OpenRC report a failed stop;
    # restart must not launch another worker over the first one.
    if [ -e "$NANOKVM_NETWORK_PENDING" ]; then
        eend 1 "Network setup is still running; retry stopping it later"
        return 1
    fi
    stop_legacy S30wifi || true
    stop_legacy S30eth || true
    eend 0
}
