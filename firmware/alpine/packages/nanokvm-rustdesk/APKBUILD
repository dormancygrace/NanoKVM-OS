# Optional package; deliberately absent from platform/packages.list.
pkgname=nanokvm-rustdesk
pkgver=0.5.4
pkgrel=0
pkgdesc="RustDesk endpoint for NanoKVM HDMI capture and USB HID"
url="https://github.com/onekvm/onekvm-extension-rustdesk"
arch="riscv64"
license="AGPL-3.0-only"
depends="nanokvm-rustdesk-bridge=1 nanokvm-rustdesk-webrtc=1 nanokvm-rustdesk-audio=1 nanokvm-rustdesk-auto-codec=1 nanokvm-rustdesk-usb-defaults=1 openrc"
makedepends="cargo rust"
install="$pkgname.pre-upgrade $pkgname.post-upgrade $pkgname.pre-deinstall"
sourceurl=https://github.com/dormancygrace/NanoKVM-OS/releases/download/nanokvm-rustdesk-0.5.4-r0/nanokvm-rustdesk-0.5.4-source.tar.gz
source="$sourceurl $pkgname.initd $pkgname-c906.toml"
builddir="$srcdir/$pkgname-$pkgver"
options="!strip !tracedeps"

build() {
    # The qualified C906 build, also for a source archive that predates it:
    # profile and target flags from the recipe, the native target explicit so
    # they reach only target code.
    cargo --config "$srcdir/$pkgname-c906.toml" build --locked --offline --release \
        --target riscv64-alpine-linux-musl
}
check() {
    # The same settings as build(); an explicit target keeps the static CRT
    # flag away from proc-macros, which cannot be linked statically.
    cargo --config "$srcdir/$pkgname-c906.toml" test --locked --offline \
        --target riscv64-alpine-linux-musl
}
package() {
    install -Dm755 target/riscv64-alpine-linux-musl/release/nanokvm-rustdesk "$pkgdir/usr/bin/nanokvm-rustdesk"
    install -Dm755 "$srcdir/$pkgname.initd" "$pkgdir/etc/init.d/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 upstream.json "$pkgdir/usr/share/$pkgname/upstream.json"
    local digest=$(sha256sum "$srcdir/$pkgname-$pkgver-source.tar.gz" | cut -d ' ' -f 1)
    printf '{"url":"%s","sha256":"%s","package_version":"%s-r%s"}\n' \
        "$sourceurl" "$digest" "$pkgver" "$pkgrel" > "$pkgdir/usr/share/$pkgname/source.json"
}

