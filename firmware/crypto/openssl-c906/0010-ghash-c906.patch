 }
 
+#if defined(__riscv_xtheadbb) && !defined(OPENSSL_NO_ASM) && !defined(FIPS_MODULE)
+void ossl_gcm_c906_build(u64 *tables, const u128 *htable);
+void ossl_gcm_c906_ghash(u64 xi[2], const u64 *tables, const u8 *in,
+    size_t len);
+/*
+ * Installed only by CRYPTO_gcm128_init: table is always ctx->Htable, and the
+ * C906 tables are in the same context. Building them costs about as much as
+ * hashing 300 bytes with the 4-bit table, so a key hashes its first 512 bytes
+ * with that one.
+ */
+#define GCM_C906_BUILD_AFTER 512
+static void gcm_ghash_c906(u64 xi[2], const u128 table[16],
+    const u8 *in, size_t len)
+{
+    GCM128_CONTEXT *ctx = (GCM128_CONTEXT *)((uintptr_t)table
+        - offsetof(GCM128_CONTEXT, Htable));
+
+    if (ctx->c906_bytes != ~(u64)0) {
+        if (ctx->c906_bytes + len < GCM_C906_BUILD_AFTER) {
+            ctx->c906_bytes += len;
+            gcm_ghash_4bit(xi, table, in, len);
+            return;
+        }
+        ossl_gcm_c906_build(ctx->c906_tables, table);
+        ctx->c906_bytes = ~(u64)0;
+    }
+    ossl_gcm_c906_ghash(xi, ctx->c906_tables, in, len);
+}
+
+static void gcm_gmult_c906(u64 xi[2], const u128 table[16])
+{
+    static const u8 zero[16];
+    GCM128_CONTEXT *ctx = (GCM128_CONTEXT *)((uintptr_t)table
+        - offsetof(GCM128_CONTEXT, Htable));
+
+    if (ctx->c906_bytes == ~(u64)0)
+        ossl_gcm_c906_ghash(xi, ctx->c906_tables, zero, sizeof(zero));
+    else
+        gcm_gmult_4bit(xi, table);
+}
+#endif
+
 void CRYPTO_gcm128_init(GCM128_CONTEXT *ctx, void *key, block128_f block)
 {
     DECLARE_IS_ENDIAN;
 
+#if defined(__riscv_xtheadbb) && !defined(OPENSSL_NO_ASM) && !defined(FIPS_MODULE)
+    /* The C906 tables are last and are built before they are read. */
+    memset(ctx, 0, offsetof(GCM128_CONTEXT, c906_tables));
+#else
     memset(ctx, 0, sizeof(*ctx));
+#endif
     ctx->block = block;
     ctx->key = key;
 
@@ -624,6 +671,11 @@
 
     gcm_get_funcs(&ctx->funcs);
     ctx->funcs.ginit(ctx->Htable, ctx->H.u);
+#if defined(__riscv_xtheadbb) && !defined(OPENSSL_NO_ASM) && !defined(FIPS_MODULE)
+    /* SG2002 has neither Zbc nor Zvkg: gcm_get_funcs chose the 4-bit table. */
+    ctx->funcs.ghash = gcm_ghash_c906;
+    ctx->funcs.gmult = gcm_gmult_c906;
+#endif
 }
 
 void CRYPTO_gcm128_setiv(GCM128_CONTEXT *ctx, const unsigned char *iv,
