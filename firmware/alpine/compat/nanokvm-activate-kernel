#!/bin/sh
# Internal APK trigger: activate the matched boot payload without replacing rootfs.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Serialize boot activations.
mkdir -p /run
exec 9>/run/nanokvm-boot.lock
flock -x 9
payload=/usr/lib/nanokvm/boot
profile=${1:-$(tr -d '\000' < /sys/firmware/devicetree/base/sipeed,board-revision)}
case "$profile" in alpha|beta|pcie|lite) ;; *) echo "Unsupported board profile: $profile" >&2; exit 1;; esac
# One boot image per board: a reusable CMA region holds the video buffers of
# every resolution. Earlier releases had an image per video memory mode,
# selected in /etc/kvm/video-memory-mode; every mode becomes this one.
name=$profile
release=$(cat "$payload/kernel.release")
case "$release" in ''|*[!a-zA-Z0-9._+-]*) echo 'Invalid kernel release' >&2; exit 1;; esac
[ -d "/lib/modules/$release" ] || { echo 'Matching kernel modules are missing' >&2; exit 1; }
[ -s "$payload/$name.dtb" ] && [ -s "$payload/fit-template.sd" ] || { echo 'Board boot image is missing' >&2; exit 1; }
find "/lib/modules/$release" -type f -name '*.ko*' | while IFS= read -r module; do
    vermagic=$(modinfo -F vermagic "$module")
    [ "${vermagic%% *}" = "$release" ] || { echo "Module ABI mismatch: $module" >&2; exit 1; }
done
# Generate the target module index even while the previous kernel is running.
depmod "$release"
mounted=0
mkdir -p /boot
if ! mountpoint -q /boot; then
    mount -t vfat /dev/mmcblk0p1 /boot
    mounted=1
fi
cleanup() { [ "$mounted" = 0 ] || umount /boot; }
trap cleanup EXIT
awk '$1 == "/dev/mmcblk0p1" && $2 == "/boot" && $3 == "vfat" { found=1 } END { exit !found }' /proc/mounts
[ ! -e /boot/rec ] || { echo 'Recovery is active; kernel activation refused' >&2; exit 1; }
# U-Boot tries boot.sd, then boot.prev (docs/BOOT.md); an older U-Boot tries
# only boot.sd. So boot.sd is never moved away: the new image is written
# beside it, checked on the card and renamed over it. boot.prev only ever
# receives a checked copy of an image known to be good: one whose hash, which
# this script records in NAME.sha256 when it installs it, matches the card.
# A boot.sd with no records at all is the image this device booted from
# before the fallback existed. Nothing is written when the card already
# holds the image (a kmod-only transaction).
want=$(cut -d ' ' -f 1 "$payload/$name.sha256")
# The card's own bytes, not the page cache.
oncard() { dd if="$1" bs=64k iflag=direct 2>/dev/null | sha256sum | cut -d ' ' -f 1; }
recorded() { [ -f "$1" ] && [ -f "$1.sha256" ] && [ "$(oncard "$1")" = "$(cat "$1.sha256")" ]; }
record() { printf '%s\n' "$2" > "$1.sha256.new" && mv "$1.sha256.new" "$1.sha256"; }
# Copy $1 to $2 through $2.new, checked on the card against hash $3. Every
# step is chained: callers test the result, which turns set -e off inside.
copy_checked() {
    rm -f "$2.new" && cp "$1" "$2.new" && sync "$2.new" &&
        [ "$(oncard "$2.new")" = "$3" ] && mv "$2.new" "$2" && record "$2" "$3" && sync /boot ||
        { rm -f "$2.new"; return 1; }
}
rm -f /boot/boot.new /boot/boot.new.compose.* /boot/boot.sd.new /boot/boot.prev.new /boot/*.sha256.new
current=
[ ! -f /boot/boot.sd ] || current=$(oncard /boot/boot.sd)
if [ "$current" != "$want" ]; then
    good=
    if [ -n "$current" ]; then
        if [ -f /boot/boot.sd.sha256 ]; then
            [ "$current" != "$(cat /boot/boot.sd.sha256)" ] || good=$current
        elif [ ! -e /boot/boot.prev ]; then
            good=$current
        fi
    fi
    # compose-fit writes only an image matching the build's hash.
    sh "$payload/compose-fit" "$payload" "$name" /boot/boot.new
    sync /boot/boot.new
    if [ "$(oncard /boot/boot.new)" != "$want" ]; then
        rm -f /boot/boot.new
        echo 'The boot image written to /boot does not match the build; boot.sd is unchanged.' >&2
        exit 1
    fi
    # The image being replaced becomes the fallback when it is known to be
    # good; otherwise the fallback already there stays.
    if [ -n "$good" ] && ! copy_checked /boot/boot.sd /boot/boot.prev "$good"; then
        rm -f /boot/boot.new
        echo 'The current boot.sd could not be kept as boot.prev; boot.sd is unchanged.' >&2
        exit 1
    fi
    mv /boot/boot.new /boot/boot.sd
    # The record names what boot.sd should hold, before it is checked: a
    # damaged image never looks like one this device booted from.
    record /boot/boot.sd "$want"
    sync /boot
    if [ "$(oncard /boot/boot.sd)" != "$want" ]; then
        if recorded /boot/boot.prev && copy_checked /boot/boot.prev /boot/boot.sd "$(cat /boot/boot.prev.sha256)"; then
            echo 'The installed boot image does not match the build; boot.sd is restored from boot.prev.' >&2
        else
            echo 'The installed boot image does not match the build; do not reboot before repairing /boot/boot.sd.' >&2
        fi
        exit 1
    fi
elif [ ! -f /boot/boot.sd.sha256 ] || [ "$(cat /boot/boot.sd.sha256)" != "$want" ]; then
    record /boot/boot.sd "$want"
    sync /boot
fi
printf '%s\n' "$release" > /boot/kernel.release
rm -f /etc/kvm/video-memory-mode /boot/video-memory-mode
sync /boot
mkdir -p /run
printf '%s\n' 'Kernel updated; reboot to use the installed kernel.' > /run/reboot-required
printf '%s\n' nanokvm-kernel >> /run/reboot-required.pkgs
rm -f /var/lib/nanokvm/firmware-activation-required
echo "NanoKVM kernel $release activated for $profile; reboot required."
