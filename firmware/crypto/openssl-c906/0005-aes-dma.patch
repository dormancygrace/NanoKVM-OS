--- /dev/null
+++ b/crypto/hwcrypto_cipher.c
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <openssl/crypto.h>
+#include "crypto/hwcrypto_transport.h"
+
+/* Advance just the chosen suffix. GCM uses 32 bits; ordinary CTR uses 128. */
+static void increment(unsigned char *iv, unsigned int bytes, unsigned int blocks)
+{
+    for (unsigned int i = bytes; i != 0 && blocks != 0; --i) {
+        blocks += iv[i-1];
+        iv[i-1] = (unsigned char)blocks;
+        blocks >>= 8;
+    }
+}
+
+size_t ossl_hwcrypto_cipher(unsigned int algorithm, unsigned int mode, int enc,
+    const unsigned char *key, size_t keylen, unsigned char *iv,
+    unsigned int counter_bytes, const unsigned char *in, unsigned char *out,
+    size_t len, size_t minimum, size_t continuation_minimum, size_t maximum)
+{
+    struct hwcrypto_request r;
+    unsigned char saved_iv[16];
+    const unsigned int block = 16;
+    size_t done = 0;
+    int fd;
+
+    if (len < minimum || minimum == 0 || minimum > HWCRYPTO_MAX
+        || continuation_minimum < block || continuation_minimum > minimum
+        || maximum < HWCRYPTO_MAX
+        || algorithm != HWCRYPTO_ALG_AES
+        || mode > HWCRYPTO_MODE_CTR || keylen > sizeof(r.key)
+        || (mode != HWCRYPTO_MODE_ECB && iv == NULL)
+        || (mode == HWCRYPTO_MODE_CTR && counter_bytes != 4 && counter_bytes != block))
+        return 0;
+    fd = ossl_hwcrypto_begin(algorithm);
+    if (fd < 0)
+        return 0;
+    memset(&r, 0, sizeof(r));
+    r.version = HWCRYPTO_ABI;
+    r.algorithm = algorithm;
+    r.mode = mode;
+    r.encrypt = mode == HWCRYPTO_MODE_CTR ? 1 : enc != 0;
+    r.key_length = (unsigned int)keylen;
+    memcpy(r.key, key, keylen);
+    /* Only the first submission pays descriptor acquisition. A later RUN
+     * still has a fixed cost, so the caller supplies a separate tail floor. */
+    while (len - done >= (done ? continuation_minimum : minimum)) {
+        size_t chunk = len - done;
+        if (chunk > maximum)
+            chunk = maximum;
+        chunk -= chunk % block;
+        if (mode == HWCRYPTO_MODE_CTR) {
+            uint32_t counter = (uint32_t)iv[block-4] << 24
+                | (uint32_t)iv[block-3] << 16 | (uint32_t)iv[block-2] << 8 | iv[block-1];
+            uint64_t remaining = (UINT64_C(1) << 32) - counter;
+            if (chunk / block > remaining)
+                chunk = (size_t)remaining * block;
+        }
+        if (chunk == 0)
+            break;
+        r.length = r.output_length = (unsigned int)chunk;
+        r.input = (uintptr_t)(in + done);
+        r.output = (uintptr_t)(out + done);
+        if (mode != HWCRYPTO_MODE_ECB)
+            memcpy(r.iv, iv, block);
+        if (mode == HWCRYPTO_MODE_CBC && !enc)
+            memcpy(saved_iv, in + done + chunk - block, block);
+        errno = 0;
+        if (!ossl_hwcrypto_run(fd, &r)) {
+            /* In place above the scratch of ossl_hwcrypto_run() a driver
+             * that works on the caller's pages has written part of the
+             * output when its engine is lost: software cannot take over. */
+            if (in == out && chunk > HWCRYPTO_MAX
+                && (errno == EIO || errno == ETIMEDOUT))
+                done = OSSL_HWCRYPTO_LOST;
+            break;
+        }
+        if (mode == HWCRYPTO_MODE_CBC)
+            memcpy(iv, enc ? out + done + chunk - block : saved_iv, block);
+        else if (mode == HWCRYPTO_MODE_CTR)
+            increment(iv + block - counter_bytes, counter_bytes, (unsigned int)(chunk / block));
+        done += chunk;
+    }
+    ossl_hwcrypto_end(fd);
+    OPENSSL_cleanse(&r, sizeof(r));
+    OPENSSL_cleanse(saved_iv, sizeof(saved_iv));
+    return done;
+}
+
+size_t ossl_hwcrypto_gcm(int enc, const unsigned char *key, size_t keylen,
+    const unsigned char h[16], unsigned char xi[16], unsigned char ctr[16],
+    const unsigned char *in, unsigned char *out, size_t len)
+{
+    struct hwcrypto_gcm_request r;
+    size_t done = 0;
+    int fd;
+
+    if (keylen > sizeof(r.key))
+        return 0;
+    fd = ossl_hwcrypto_begin(HWCRYPTO_ALG_AES);
+    if (fd < 0)
+        return 0;
+    memset(&r, 0, sizeof(r));
+    len -= len % 16;
+    while (len - done != 0) {
+        /* The kernel splits a call into engine chunks itself. */
+        size_t chunk = len - done < (1u << 30) ? len - done : (1u << 30);
+        r.version = HWCRYPTO_ABI;
+        r.encrypt = enc != 0;
+        r.key_length = (unsigned int)keylen;
+        r.length = (unsigned int)chunk;
+        memcpy(r.key, key, keylen);
+        memcpy(r.h, h, 16);
+        memcpy(r.xi, xi, 16);
+        memcpy(r.ctr, ctr, 16);
+        r.input = (uintptr_t)(in + done);
+        r.output = (uintptr_t)(out + done);
+        errno = 0;
+        if (!ossl_hwcrypto_run_gcm(fd, &r)) {
+            /* As in ossl_hwcrypto_cipher(). */
+            if (in == out && (errno == EIO || errno == ETIMEDOUT))
+                done = OSSL_HWCRYPTO_LOST;
+            break;
+        }
+        memcpy(xi, r.xi, 16);
+        memcpy(ctr, r.ctr, 16);
+        done += r.length;
+        if (r.length != chunk)
+            break;
+    }
+    ossl_hwcrypto_end(fd);
+    OPENSSL_cleanse(&r, sizeof(r));
+    return done;
+}
