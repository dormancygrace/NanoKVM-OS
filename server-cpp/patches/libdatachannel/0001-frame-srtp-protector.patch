+bool IceTransport::sendBatch(message_vector &messages) {
+	auto s = state();
+	if (messages.empty() || (s != State::Connected && s != State::Completed))
+		return false;
+	std::vector<const char *> data;
+	std::vector<size_t> sizes;
+	data.reserve(messages.size());
+	sizes.reserve(messages.size());
+	for (auto &m : messages)
+		if (m) {
+			data.push_back(reinterpret_cast<const char *>(m->data()));
+			sizes.push_back(m->size());
+		}
+	if (data.empty())
+		return false;
+	int ds = int(messages.front()->dscp << 2);
+	return juice_send_batch(mAgent.get(), data.data(), sizes.data(), int(data.size()), ds) >= 0;
 }
 
