From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] vpss: give a channel's buffers back only after the running job

A job writes into the output buffers it took from the channels' work
queues until its end of frame. Disabling a channel, giving it new
attributes or stopping its group released those buffers at once, while
the hardware could still be writing the frame. The caller destroys the
pool next; the shared video memory (reusable CMA) then goes to processes,
and the frame was written into their pages: the process on the CPU when
the frame ended crashed on a pointer made of pixel data. The end of frame
then found the channel's queue empty ("No more vb for dequeue", "can't
get vb-blk"), or took a buffer that was already free, which later
panicked in vb_dqbuf. The server parks the outputs right after the
capture starts and after the last viewer leaves, so both happened.

Wait, under the group's lock, until the running job no longer uses the
channel (bounded by the handler's end-of-frame timeout), then release.
The end of frame does not take that lock, and no new job can take the
channel meanwhile.
---
--- a/interdrv/vpss/common/vpss.c
+++ b/interdrv/vpss/common/vpss.c
@@ -105,6 +105,45 @@
 	CVI_U8 isr_evt[VPSS_ONLINE_NUM];
 	struct cvi_vpss_ctx vpssCtxWork[VPSS_ONLINE_NUM];
 } handler_ctx[VPSS_IP_NUM];
+
+/*
+ * A job writes into the output buffers it took from the channels' work queues
+ * until its end of frame, and the handler then dequeues them from those queues.
+ * A channel gives its buffers back (disabled, or new attributes) only after
+ * the running job stopped using it: the caller destroys the pool next, and the
+ * video memory (reusable CMA) then goes to processes, into whose pages the
+ * frame would still be written, and a frame done for an emptied queue finds
+ * no buffer or one that is already free. The waits hold the group's lock, so
+ * no new job takes the channel; the end of frame does not take that lock.
+ */
+static DECLARE_WAIT_QUEUE_HEAD(vpss_job_end_wait);
+
+static bool vpss_job_uses(VPSS_GRP VpssGrp, CVI_U8 mask)
+{
+	struct vpss_handler_ctx *ctx = &handler_ctx[vpssCtx[VpssGrp]->u8DevId];
+
+	return READ_ONCE(ctx->workingGrp) == VpssGrp && (READ_ONCE(ctx->workingMask) & mask);
+}
+
+static void vpss_job_ended(void)
+{
+	wake_up_all(&vpss_job_end_wait);
+}
+
+static void vpss_wait_job_end(VPSS_GRP VpssGrp, CVI_U8 mask)
+{
+	unsigned int waited = 0;
+
+	while (vpss_job_uses(VpssGrp, mask)) {
+		/* The handler resets a job without its end of frame after EOF_WAIT_TIMEOUT_MS. */
+		if (waited > EOF_WAIT_TIMEOUT_MS + 100) {
+			CVI_TRACE_VPSS(CVI_DBG_WARN, "Grp(%d) mask(0x%x) job did not end\n", VpssGrp, mask);
+			return;
+		}
+		wait_event_timeout(vpss_job_end_wait, !vpss_job_uses(VpssGrp, mask), msecs_to_jiffies(10));
+		waited += 10;
+	}
+}
 
 static struct cvi_gdc_mesh mesh[VPSS_MAX_GRP_NUM][VPSS_MAX_CHN_NUM];
 
@@ -3018,6 +3057,7 @@
 		workingMask = 0;
 
 	ctx->workingMask = workingMask;
+	vpss_job_ended();
 
 	ktime_get_ts64(&time);
 	duration = get_diff_in_us(ctx->time, time);
@@ -3070,6 +3110,7 @@
 		ctx->workingGrp = VPSS_MAX_GRP_NUM;
 		ctx->workingMask = 0;
 		atomic_set(&ctx->events, 0);
+		vpss_job_ended();
 		return;
 	}
 
@@ -3106,6 +3147,7 @@
 				ctx->workingMask = 0;
 				vpssExtCtx[workingGrp].grp_state = GRP_STATE_IDLE;
 				hw_reset(workingGrp, &ctx->vpssCtxWork[0]);
+				vpss_job_ended();
 			} else {
 				// keep waiting
 			}
@@ -3576,6 +3618,7 @@
 		handler_ctx[u8VpssDev].online_chkMask &= ~BIT(VpssGrp);
 
 	mutex_unlock(&vpssCtx[VpssGrp]->lock);
+	vpss_wait_job_end(VpssGrp, 0xff);
 
 	/* Only change state from run to stop */
 	enabled = vpss_enable_handler_ctx(&handler_ctx[u8VpssDev]);
@@ -3930,6 +3973,7 @@
 		, COMPRESS_MODE_NONE, DEFAULT_ALIGN, &stVbCalConfig);
 
 	mutex_lock(&vpssCtx[VpssGrp]->lock);
+	vpss_wait_job_end(VpssGrp, BIT(VpssChn));
 	_clean_chn_vb_jobs(VpssGrp, VpssChn, &vpssCtx[VpssGrp]->stChnCfgs[VpssChn].stChnAttr, pstChnAttr);
 	memcpy(&vpssCtx[VpssGrp]->stChnCfgs[VpssChn].stChnAttr, pstChnAttr,
 		sizeof(vpssCtx[VpssGrp]->stChnCfgs[VpssChn].stChnAttr));
@@ -4058,6 +4102,7 @@
 
 	mutex_lock(&vpssCtx[VpssGrp]->lock);
 	vpssCtx[VpssGrp]->stChnCfgs[VpssChn].isEnabled = CVI_FALSE;
+	vpss_wait_job_end(VpssGrp, BIT(VpssChn));
 	if (vpssCtx[VpssGrp]->stChnCfgs[VpssChn].bufWrapPhyAddr) {
 		sys_ion_free(vpssCtx[VpssGrp]->stChnCfgs[VpssChn].bufWrapPhyAddr);
 		vpssCtx[VpssGrp]->stChnCfgs[VpssChn].bufWrapPhyAddr = 0;
