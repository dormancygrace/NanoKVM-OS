 void Track::sendFrame(const byte *data, size_t size, FrameInfo info) {
-	sendFrame(binary(data, data + size), std::move(info));
+	// Lent, not copied: the media handler chain runs within this call (see impl::Track::outgoing).
+	info.borrowedData = data;
+	info.borrowedSize = size;
+	impl()->outgoing(make_message(binary{}, std::make_shared<FrameInfo>(std::move(info))));
 }
 
