# Optional add-on with a version of its own, released apart from the OS
# packages and required by none of them: Software > Add-ons installs it.
pkgname=nanokvm-ipmi
pkgver=0.1.0
pkgrel=0
pkgdesc="NanoKVM IPMI add-on: IPMI over LAN power control of the host"
url="https://github.com/dormancygrace/NanoKVM-OS/blob/main/docs/BMC.md"
arch="riscv64"
license="GPL-3.0-only"
depends="openrc"
install="$pkgname.pre-deinstall"
source="$pkgname-$pkgver.tar.gz"
# A static Go program (server/cmd/nkos-ipmi, CGO_ENABLED=0).
options="!check !strip !tracedeps"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
