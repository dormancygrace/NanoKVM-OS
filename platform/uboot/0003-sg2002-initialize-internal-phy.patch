From a5149dd2536c789d6d80343c5bf576951d0d76fb Mon Sep 17 00:00:00 2001
From: dgrace <g.pesin@globalte.ru>
Date: Mon, 7 Sep 2026 01:52:42 +0300
Subject: [PATCH] sophgo: initialize SG2002 internal PHY before Linux handoff

---
 board/sophgo/licheerv_nano/board.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/board/sophgo/licheerv_nano/board.c b/board/sophgo/licheerv_nano/board.c
index e6099d35..4f136766 100644
--- a/board/sophgo/licheerv_nano/board.c
+++ b/board/sophgo/licheerv_nano/board.c
@@ -3,3 +3,29 @@
  * Copyright (c) 2024, Kongyang Liu <seashell11234455@gmail.com>
  */
 
+
+#include <asm/io.h>
+
+int board_init(void)
+{
+	void __iomem *wrap = (void __iomem *)0x03009800;
+	void __iomem *phy = (void __iomem *)0x03009000;
+
+	/* SG2002 PHY power and ID setup from Sophgo CV181x board init.
+	 * FSBL does not do this. Linux needs a real ID before driver matching;
+	 * the Linux PHY driver performs the remaining analog calibration.
+	 */
+	writel(0x0001, wrap + 4); /* APB owns the PHY registers. */
+	writel(0x0900, wrap);     /* Release shutdown. */
+	writel(0x0904, wrap);     /* Release digital reset. */
+	writel(0x0500, phy + 0x7c);
+	writel(0x0c00, phy + 0x40);
+	writel(0x0c7e, phy + 0x40);
+	writel(0x0906, wrap);     /* Release analog reset. */
+	writel(0x0500, phy + 0x7c);
+	writel(0x0043, phy + 0x08);
+	writel(0x5649, phy + 0x0c);
+	writel(0x0000, wrap + 4); /* Return control to the MAC MDIO bus. */
+
+	return 0;
+}
