+/* SPDX-License-Identifier: Apache-2.0 */
+/* SG2002 SHA-256 compression only. OpenSSL owns buffering, padding and length. */
+#include <stdint.h>
+#include <openssl/crypto.h>
+#include <openssl/sha.h>
+#include "crypto/hwcrypto_transport.h"
+
+/* Requests of at most 64 KiB, the driver's buffers (one request of 64 KiB
+ * takes less than half the time of sixteen of 4 KiB); DMA from 1 KiB
+ * (wall-clock break-even with the scalar C906 compressor), descriptor reused
+ * for tails of at least 512 B. */
+#define DMA_BLOCKS (65536 / SHA256_CBLOCK)
+#define START_BLOCKS 16
+#define CONTINUE_BLOCKS 8
+
+size_t ossl_sha256_hwcrypto(SHA256_CTX *ctx, const unsigned char *in, size_t blocks)
+{
+    struct hwcrypto_request r = {
+        .version = HWCRYPTO_ABI, .algorithm = HWCRYPTO_ALG_SHA256
+    };
+    size_t completed = 0;
+    int fd;
+
+    if (blocks < START_BLOCKS)
+        return 0;
+    fd = ossl_hwcrypto_begin(HWCRYPTO_ALG_SHA256);
+    if (fd < 0)
+        return 0;
+    for (unsigned int i = 0; i < 8; ++i)
+        for (unsigned int j = 0; j < 4; ++j)
+            r.state[4*i+j] = (unsigned char)(ctx->h[i] >> (24-8*j));
+    while (blocks - completed >= (completed ? CONTINUE_BLOCKS : START_BLOCKS)) {
+        size_t n = blocks - completed < DMA_BLOCKS ? blocks - completed : DMA_BLOCKS;
+        r.length = (uint32_t)(n * SHA256_CBLOCK);
+        r.input = (uintptr_t)(in + completed * SHA256_CBLOCK);
+        if (!ossl_hwcrypto_run(fd, &r))
+            break;
+        completed += n;
+    }
+    ossl_hwcrypto_end(fd);
+    /* Commit only completed chunks. The caller hashes the rest in software,
+     * starting from this exact chaining state, including after a late fault.
+     */
+    if (completed != 0)
+        for (unsigned int i = 0; i < 8; ++i)
+            ctx->h[i] = (uint32_t)r.state[4*i] << 24
+                | (uint32_t)r.state[4*i+1] << 16
+                | (uint32_t)r.state[4*i+2] << 8 | r.state[4*i+3];
+    OPENSSL_cleanse(&r, sizeof(r));
+    return completed;
+}
