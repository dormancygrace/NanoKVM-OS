#!/bin/sh

# S01fs owns first-boot data provisioning.  The portable image intentionally
# contains only p1 (FAT boot) and p2 (ext4 root); an empty /boot/usb.disk0 file
# opts a larger physical card into creating p3 as exFAT.
set -eu

: "${NANOKVM_DISK:=/dev/mmcblk0}"
: "${NANOKVM_BOOT_PART:=/dev/mmcblk0p1}"
: "${NANOKVM_ROOT_PART:=/dev/mmcblk0p2}"
: "${NANOKVM_DATA_PART:=/dev/mmcblk0p3}"
: "${NANOKVM_BOOT_DIR:=/boot}"
: "${NANOKVM_DATA_DIR:=/data}"
: "${NANOKVM_DISK0_MARKER:=/etc/kvm.disk0}"
: "${NANOKVM_DATA_FORMAT_PENDING:=/etc/kvm.disk0.formatting}"
: "${NANOKVM_PROFILE:=/etc/profile}"
: "${NANOKVM_PARTED:=parted}"
: "${NANOKVM_MKFS_EXFAT:=mkfs.exfat}"
: "${NANOKVM_BLKID:=blkid}"
: "${NANOKVM_UDEVADM:=udevadm}"
: "${NANOKVM_SLEEP:=sleep}"
: "${NANOKVM_DATA_ALIGNMENT_SECTORS:=2048}"
# 32768 sectors = 16 MiB, enough for a useful exFAT volume and small enough
# not to reject normal 2 GiB cards after the fixed 1.5 GiB root.
: "${NANOKVM_DATA_MIN_SECTORS:=32768}"
: "${NANOKVM_DATA_NODE_ATTEMPTS:=10}"
: "${NANOKVM_DATA_NODE_DELAY:=1}"

root_name=${NANOKVM_ROOT_PART##*/}
data_name=${NANOKVM_DATA_PART##*/}
: "${NANOKVM_ROOT_START_FILE:=/sys/class/block/$root_name/start}"
: "${NANOKVM_ROOT_SIZE_FILE:=/sys/class/block/$root_name/size}"
: "${NANOKVM_DATA_START_FILE:=/sys/class/block/$data_name/start}"
: "${NANOKVM_DATA_SIZE_FILE:=/sys/class/block/$data_name/size}"

is_uint() {
        case "$1" in
                ''|*[!0-9]*) return 1 ;;
        esac
}

read_uint_file() {
        value=$(cat "$1" 2>/dev/null) || return 1
        is_uint "$value" || return 1
        printf '%s\n' "$value"
}

read_root_geometry() {
        root_start=$(read_uint_file "$NANOKVM_ROOT_START_FILE") || return 1
        root_size=$(read_uint_file "$NANOKVM_ROOT_SIZE_FILE") || return 1
        [ "$root_start" -gt 1 ] || return 1
        [ "$root_size" -gt 0 ] || return 1
        is_uint "$NANOKVM_DATA_ALIGNMENT_SECTORS" || return 1
        [ "$NANOKVM_DATA_ALIGNMENT_SECTORS" -gt 0 ] || return 1
}

data_partition_start_sector() {
        read_root_geometry || return 1
        next=$((root_start + root_size))
        alignment=$NANOKVM_DATA_ALIGNMENT_SECTORS
        remainder=$((next % alignment))
        [ "$remainder" -eq 0 ] || next=$((next + alignment - remainder))
        printf '%s\n' "$next"
}

create_default_data_partition() {
        expected_data_start=$(data_partition_start_sector) || return 1
        "$NANOKVM_PARTED" -s "$NANOKVM_DISK" unit s \
                mkpart primary ntfs "${expected_data_start}s" 100%
}

layout_disk_field() {
        field=$1
        printf '%s\n' "$layout" |
                awk -F: -v field="$field" '
                        $1 != "BYT;" && $2 ~ /^[0-9]+s$/ {
                                value = $field
                                if (value ~ /^[0-9]+s$/)
                                        sub(/s$/, "", value)
                                print value
                                exit
                        }'
}

layout_part_line() {
        number=$1
        printf '%s\n' "$layout" |
                awk -F: -v number="$number" '$1 == number { print; exit }'
}

layout_part_field() {
        number=$1
        field=$2
        printf '%s\n' "$layout" |
                awk -F: -v number="$number" -v field="$field" '
                        $1 == number {
                                value = $field
                                if (value ~ /^[0-9]+s$/)
                                        sub(/s$/, "", value)
                                print value
                                exit
                        }'
}

# Validate the DOS layout before any partition-table mutation.  The portable
# image uses p1 immediately followed by p2; expanded cards retain those starts
# while p2 may be larger.  No p3/p4 or logical partition may exist on create.
validate_dos_layout() {
        expected_data=${1:-absent}
        read_root_geometry || return 1
        layout=$("$NANOKVM_PARTED" -m -s "$NANOKVM_DISK" unit s print 2>/dev/null) || return 1

        disk_sectors=$(layout_disk_field 2 2>/dev/null)
        disk_table=$(layout_disk_field 6 2>/dev/null)
        is_uint "$disk_sectors" || return 1
        [ "$disk_sectors" -gt 0 ] || return 1
        [ "$disk_table" = msdos ] || return 1

        p1_line=$(layout_part_line 1)
        p2_line=$(layout_part_line 2)
        p3_line=$(layout_part_line 3)
        p4_line=$(layout_part_line 4)
        [ -n "$p1_line" ] && [ -n "$p2_line" ] || return 1
        max_partition=2
        [ "$expected_data" = present ] && max_partition=3
        if printf '%s\n' "$layout" |
                awk -F: -v max="$max_partition" '$1 ~ /^[0-9]+$/ && $1 > max { found = 1 } END { exit found }'
        then
                :
        else
                return 1
        fi

        p1_start=$(layout_part_field 1 2)
        p1_end=$(layout_part_field 1 3)
        p1_size=$(layout_part_field 1 4)
        p1_fs=$(layout_part_field 1 5)
        p1_flags=$(layout_part_field 1 7)
        p2_start=$(layout_part_field 2 2)
        p2_end=$(layout_part_field 2 3)
        p2_size=$(layout_part_field 2 4)
        p2_fs=$(layout_part_field 2 5)
        for value in "$p1_start" "$p1_end" "$p1_size" "$p2_start" "$p2_end" "$p2_size"; do
                is_uint "$value" || return 1
        done
        [ "$p1_start" -eq 1 ] || return 1
        [ "$p1_size" -eq $((root_start - 1)) ] || return 1
        [ "$p1_end" -eq $((root_start - 1)) ] || return 1
        [ "$p2_start" -eq "$root_start" ] || return 1
        [ "$p2_size" -eq "$root_size" ] || return 1
        [ "$p2_end" -eq $((root_start + root_size - 1)) ] || return 1
        [ "$p2_end" -lt "$disk_sectors" ] || return 1
        case "$p1_fs" in
                fat12|fat16|fat32|vfat) ;;
                *) return 1 ;;
        esac
        case "$p1_flags" in
                *boot*) ;;
                *) return 1 ;;
        esac
        case "$p2_fs" in
                ext2|ext3|ext4) ;;
                *) return 1 ;;
        esac

        if [ "$expected_data" = absent ]; then
                [ -z "$p3_line" ] && [ -z "$p4_line" ] || return 1
                return 0
        fi

        [ -n "$p3_line" ] && [ -z "$p4_line" ] || return 1
        [ -n "$expected_data_start" ] || return 1
        p3_start=$(layout_part_field 3 2)
        p3_end=$(layout_part_field 3 3)
        p3_size=$(layout_part_field 3 4)
        for value in "$p3_start" "$p3_end" "$p3_size"; do
                is_uint "$value" || return 1
        done
        [ "$p3_start" -eq "$expected_data_start" ] || return 1
        [ "$p3_end" -eq $((disk_sectors - 1)) ] || return 1
        expected_data_sectors=$((disk_sectors - expected_data_start))
        [ "$p3_size" -eq "$expected_data_sectors" ] || return 1
        [ "$p3_size" -ge "$NANOKVM_DATA_MIN_SECTORS" ] || return 1
        [ -b "$NANOKVM_DATA_PART" ] || return 1
        data_node_start=$(read_uint_file "$NANOKVM_DATA_START_FILE") || return 1
        data_node_size=$(read_uint_file "$NANOKVM_DATA_SIZE_FILE") || return 1
        [ "$data_node_start" -eq "$expected_data_start" ] || return 1
        [ "$data_node_size" -eq "$expected_data_sectors" ] || return 1
}

mount_data_partition() {
        mkdir -p "$NANOKVM_DATA_DIR"
        if mount "$NANOKVM_DATA_PART" "$NANOKVM_DATA_DIR"
        then
                touch "$NANOKVM_DISK0_MARKER"
                return 0
        fi

        rm -f "$NANOKVM_DISK0_MARKER"
        return 1
}

write_pending_marker() {
        pending_dir=$(dirname "$NANOKVM_DATA_FORMAT_PENDING")
        pending_tmp="$NANOKVM_DATA_FORMAT_PENDING.new.$$"
        mkdir -p "$pending_dir"
        umask 077
        printf 'create-v2 disk=%s p3-start=%s min-sectors=%s\n' \
                "$NANOKVM_DISK" "$expected_data_start" "$NANOKVM_DATA_MIN_SECTORS" > "$pending_tmp" || {
                rm -f "$pending_tmp"
                return 1
        }
        mv -f "$pending_tmp" "$NANOKVM_DATA_FORMAT_PENDING"
}

wait_for_created_data_partition() {
        attempt=1
        while [ "$attempt" -le "$NANOKVM_DATA_NODE_ATTEMPTS" ]; do
                if [ -b "$NANOKVM_DATA_PART" ] && validate_dos_layout present
                then
                        return 0
                fi
                if [ -n "$NANOKVM_UDEVADM" ]; then
                        # eudev supports --timeout; bound each settle call so
                        # a broken event queue cannot defeat our retry limit.
                        "$NANOKVM_UDEVADM" settle --timeout=1 2>/dev/null || true
                fi
                if [ "$attempt" -lt "$NANOKVM_DATA_NODE_ATTEMPTS" ]; then
                        "$NANOKVM_SLEEP" "$NANOKVM_DATA_NODE_DELAY" || true
                fi
                attempt=$((attempt + 1))
        done
        return 1
}

handle_existing_data_partition() {
        filesystem=$("$NANOKVM_BLKID" "$NANOKVM_DATA_PART" 2>/dev/null || true)
        if [ -n "$filesystem" ]
        then
                if mount_data_partition
                then
                        # A completed format may have been interrupted before
                        # its pending marker was removed. Mounting a recognized
                        # filesystem is safe; it never triggers mkfs.
                        rm -f "$NANOKVM_DATA_FORMAT_PENDING"
                        echo "Existing data filesystem mounted"
                        return 0
                fi
                echo "Existing data filesystem could not be mounted; preserved" >&2
                return 1
        fi

        rm -f "$NANOKVM_DISK0_MARKER"
        echo "Unknown data partition preserved; refusing automatic format" >&2
        return 1
}

create_and_format_data_partition() {
        [ ! -e "$NANOKVM_DATA_PART" ] && [ ! -L "$NANOKVM_DATA_PART" ] || return 1
        if ! validate_dos_layout absent
        then
                echo "Unsupported DOS layout or pre-existing partition; refusing data provisioning" >&2
                return 1
        fi
        expected_data_start=$(data_partition_start_sector) || {
                echo "Could not read root partition geometry; refusing data provisioning" >&2
                return 1
        }
        is_uint "$expected_data_start" || {
                echo "Invalid computed data partition start; refusing data provisioning" >&2
                return 1
        }
        if [ "$expected_data_start" -ge "$disk_sectors" ]
        then
                echo "No space remains after the root partition for data provisioning" >&2
                return 1
        fi
        expected_data_sectors=$((disk_sectors - expected_data_start))
        if [ "$expected_data_sectors" -lt "$NANOKVM_DATA_MIN_SECTORS" ]
        then
                echo "Data partition needs at least $NANOKVM_DATA_MIN_SECTORS sectors; refusing undersized card" >&2
                return 1
        fi

        write_pending_marker || {
                echo "Could not record pending data provisioning; refusing partition change" >&2
                return 1
        }
        if ! create_default_data_partition
        then
                echo "Could not create data partition; retry marker retained" >&2
                return 1
        fi

        # Formatting is reachable only after this invocation observed no p3,
        # parted succeeded, and the kernel/table readback agree on p3 geometry.
        if ! wait_for_created_data_partition
        then
                echo "Data partition node/layout did not appear; refusing format" >&2
                return 1
        fi
        if ! "$NANOKVM_MKFS_EXFAT" -L data "$NANOKVM_DATA_PART"
        then
                echo "Could not format newly-created data partition; preserved for manual recovery" >&2
                return 1
        fi
        if ! mount_data_partition
        then
                echo "New data filesystem was formatted but could not be mounted; preserved" >&2
                return 1
        fi
        rm -f "$NANOKVM_DATA_FORMAT_PENDING"
        echo "Created and mounted new exFAT data partition"
}

if [ "${1:-}" = start ]
then
        if [ -r "$NANOKVM_PROFILE" ]
        then
                # Distribution profile fragments may use unset optional
                # variables; they must not abort this service under -u.
                set +u
                # shellcheck disable=SC1090
                . "$NANOKVM_PROFILE"
                set -u
        fi

        if ! is_uint "$NANOKVM_DATA_ALIGNMENT_SECTORS" || [ "$NANOKVM_DATA_ALIGNMENT_SECTORS" -le 0 ] ||
                ! is_uint "$NANOKVM_DATA_MIN_SECTORS" || [ "$NANOKVM_DATA_MIN_SECTORS" -le 0 ] ||
                ! is_uint "$NANOKVM_DATA_NODE_ATTEMPTS" || [ "$NANOKVM_DATA_NODE_ATTEMPTS" -le 0 ] ||
                ! is_uint "$NANOKVM_DATA_NODE_DELAY"
        then
                echo "Invalid data provisioning retry settings" >&2
                exit 1
        fi
        [ -b "$NANOKVM_DISK" ] || { echo "Data provisioning requires a block disk" >&2; exit 1; }
        [ -b "$NANOKVM_BOOT_PART" ] || { echo "Data provisioning requires the boot partition" >&2; exit 1; }

        printf "mounting filesystem : "
        mkdir -p "$NANOKVM_BOOT_DIR"
        mount -t vfat "$NANOKVM_BOOT_PART" "$NANOKVM_BOOT_DIR"
        mount -t configfs configfs /sys/kernel/config
        mount -t debugfs debugfs /sys/kernel/debug

        if { [ -L "$NANOKVM_DATA_PART" ] || [ -e "$NANOKVM_DATA_PART" ]; } &&
                [ ! -b "$NANOKVM_DATA_PART" ]
        then
                echo "Data partition path exists but is not a block device; refusing" >&2
                exit 1
        fi
        if [ -b "$NANOKVM_DATA_PART" ]
        then
                handle_existing_data_partition
        elif [ -e "$NANOKVM_DATA_FORMAT_PENDING" ]
        then
                # A previous invocation may have changed the partition table
                # but did not prove ownership of a live p3. Never re-run mkfs
                # from this weak state; require manual inspection/repair.
                echo "Pending data provisioning has no verified p3; refusing automatic recovery" >&2
                exit 1
        elif [ -f "$NANOKVM_BOOT_DIR/usb.disk0" ]
        then
                create_and_format_data_partition || exit 1
        fi

        echo "OK"
fi
