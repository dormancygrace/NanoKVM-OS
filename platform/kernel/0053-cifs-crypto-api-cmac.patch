--- /dev/null
+++ b/fs/smb/client/smb3_cmac.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SMB3_CMAC_H
+#define _SMB3_CMAC_H
+
+#include <crypto/hash.h>
+#include <linux/overflow.h>
+#include <linux/uio.h>
+
+/* SG2002's measured crossover including per-message alloc/setkey/free is
+ * 304 bytes. Keep a margin, and avoid DMA even for key setup below 320 bytes.
+ * A synchronous CPU provider remains available when hardware AES is disabled.
+ */
+#define SMB3_CMAC_ASYNC_MIN_SIZE 320U
+
+static inline int smb3_cmac_length(const struct kvec *iov, unsigned int nvec,
+				 size_t datalen, size_t *headlen, size_t *total)
+{
+	size_t head = 0;
+	unsigned int i;
+
+	for (i = 0; i < nvec; i++)
+		if (check_add_overflow(head, iov[i].iov_len, &head))
+			return -EOVERFLOW;
+	if (head <= 4)
+		return -EINVAL;
+	if (check_add_overflow(head, datalen, total) || *total > UINT_MAX)
+		return -EOVERFLOW;
+	*headlen = head;
+	return 0;
+}
+
+static inline struct crypto_ahash *smb3_cmac_alloc(size_t total)
+{
+	/* Exclude async/DMA providers for short messages without pinning a CPU
+	 * implementation. Larger messages use the highest-priority provider. */
+	return crypto_alloc_ahash("cmac(aes)", 0,
+				total < SMB3_CMAC_ASYNC_MIN_SIZE ? CRYPTO_ALG_ASYNC : 0);
+}
+
+#endif
