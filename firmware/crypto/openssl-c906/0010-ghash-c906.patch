--- /dev/null
+++ b/crypto/modes/gcm_c906.c
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <openssl/crypto.h>
+#include "crypto/modes.h"
+#include "crypto/riscv_arch.h"
+
+#ifdef NKOS_GHASH_TEST
+#include <stdatomic.h>
+_Atomic unsigned long ossl_ghash_test_count;
+unsigned long nkos_ghash_test_hits(void)
+{
+    return atomic_load_explicit(&ossl_ghash_test_count, memory_order_relaxed);
+}
+#endif
+
+void ossl_ghash_blocks_c906(u64 acc[2], const void *kp, const u8 *in, size_t blocks);
+void ossl_ghash_blocks_c906_v(u64 acc[2], const void *kp, const u8 *in, size_t groups);
+
+static const u64 masks[4] = {
+    0x1111111111111111ULL, 0x2222222222222222ULL,
+    0x4444444444444444ULL, 0x8888888888888888ULL
+};
+static const u8 zero[16];
+static CRYPTO_ONCE once = CRYPTO_ONCE_STATIC_INIT;
+static int disabled;
+
+static void detect_override(void)
+{
+    const char *option = secure_getenv("NANOKVM_OPENSSL_GHASH");
+    /* A fatal seccomp rule cannot fall back after issuing prctl.
+     * Only qualified clients may opt into this syscall-bearing path. */
+    disabled = option == NULL || strcmp(option, "auto") != 0;
+}
+
+static void scalar_key(u64 kp[112], u64 lo, u64 hi)
+{
+    unsigned int pos = 4, p, q, j;
+    u64 parts[3] = { lo, hi, lo ^ hi };
+
+    for (j = 0; j < 4; ++j)
+        kp[j] = masks[j];
+    for (p = 0; p < 3; ++p) {
+        u64 op[3] = { (u32)parts[p], parts[p] >> 32,
+                     (u32)parts[p] ^ (parts[p] >> 32) };
+        for (q = 0; q < 3; ++q)
+            for (j = 0; j < 4; ++j)
+                kp[pos++] = op[q] & masks[j];
+    }
+}
+
+/* Keep the expanded key and its powers on a temporary stack frame, reached
+ * only for a 3 KiB or larger input. No context growth or persistent key cache.
+ */
+static __attribute__((noinline)) size_t vector_prefix(
+    u64 xi[2], const u128 *table, const u8 *in, size_t len)
+{
+    u64 kp[112], powers[5][2], acc[2];
+    unsigned int pos = 320, i, q, j, lane;
+    size_t groups = len / 80, blocks = len % 80 / 16;
+
+    u64 h0 = table[8].hi, h1 = table[8].lo, carry = h0 >> 63;
+    u64 lo = (h1 << 1) ^ carry;
+    u64 hi = ((h0 << 1) | (h1 >> 63))
+        ^ ((0 - carry) & 0xc200000000000000ULL);
+    scalar_key(kp, lo, hi);
+    powers[0][0] = lo;
+    powers[0][1] = hi;
+    for (i = 1; i < 5; ++i) {
+        memcpy(powers[i], powers[i-1], 16);
+        ossl_ghash_blocks_c906(powers[i], kp, zero, 1);
+    }
+    /* Vector lane l uses H^(5-l), represented by 32-bit hole operands. */
+    for (q = 0; q < 9; ++q)
+        for (j = 0; j < 4; ++j)
+            for (lane = 0; lane < 4; ++lane) {
+                unsigned int p = q / 3, vq = q % 3;
+                u64 lo = powers[4-lane][0], hi = powers[4-lane][1];
+                u64 part = p == 0 ? lo : p == 1 ? hi : lo ^ hi;
+                u32 op = vq == 0 ? (u32)part : vq == 1 ? (u32)(part >> 32)
+                    : (u32)part ^ (u32)(part >> 32);
+                op &= (u32)masks[j];
+                memcpy((u8 *)kp + pos, &op, sizeof(op));
+                pos += sizeof(op);
+            }
+    acc[0] = __builtin_bswap64(xi[1]);
+    acc[1] = __builtin_bswap64(xi[0]);
+    ossl_ghash_blocks_c906_v(acc, kp, in, groups);
+    /* Reuse the expanded scalar key for all remaining whole blocks. */
+    if (blocks != 0)
+        ossl_ghash_blocks_c906(acc, kp, in + groups * 80, blocks);
+    xi[0] = __builtin_bswap64(acc[1]);
+    xi[1] = __builtin_bswap64(acc[0]);
+    OPENSSL_cleanse(kp, sizeof(kp));
+    OPENSSL_cleanse(powers, sizeof(powers));
+    OPENSSL_cleanse(acc, sizeof(acc));
+    return groups * 80 + blocks * 16;
+}
+
+size_t ossl_gcm_c906_prefix(u64 xi[2], const u128 *table,
+    const u8 *in, size_t len)
+{
+    int control;
+    if (len < 3072 || !ossl_riscv_has_xtheadvector
+        || !CRYPTO_THREAD_run_once(&once, detect_override) || disabled)
+        return 0;
+    /* The current thread may disable vectors or inherit different control.
+     * Query on every eligible call, including after an EVP context is copied.
+     */
+    control = prctl(70, 0L, 0L, 0L, 0L);
+    if (control < 0 || (control & 3) != 2)
+        return 0;
+    return vector_prefix(xi, table, in, len);
+}
