From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] RISC-V: a measured pipeline model and costs for thead-c906

-mtune=thead-c906 used GCC's generic pipeline (mul 10, div 34/66 cycles) and
costs that do not match the core. This adds a thead-c906 pipeline with
latencies measured on a SG2002 (C906 at 1 GHz) in November 2026, with
dependent and independent chains of each instruction:

- ALU 1; load 2 (fld 3); an ALU result reaches a load address in 2; store
  data is read late;
- mul 3 (<= 32-bit operands) to 6 (64-bit) to the next mul, one more to the
  ALU; div/rem about 5 + quotient bits / 2 (4 to 37), not pipelined;
- fadd/fmul 4 (SF) / 5 (DF), fmadd 4; fdiv/fsqrt 19 / 34, not pipelined;
  integer to FP 5, FP to integer 2; AMO 7; frm read 4, write 6.

Data-dependent latencies use the middle of the measured range. Costs follow
the same numbers (int_div 13/21: dividing by a constant stays a multiply).
Instruction types the C906 does not have (vector) get one catch-all
reservation, because riscv_sched_variable_issue asserts that every insn has
one.

Measured with Linux 7.3 on a NanoKVM: against stock -mtune=thead-c906, the
kernel is within noise on system call microbenchmarks; earlier C906 models
that used optimistic or pessimistic numbers were 3-6% slower.
---
--- a/gcc/config/riscv/riscv-opts.h
+++ b/gcc/config/riscv/riscv-opts.h
@@ -65,6 +65,7 @@
   andes_23_series,
   andes_45_series,
   spacemit_x60,
+  thead_c906,
 };
 extern enum riscv_microarchitecture_type riscv_microarchitecture;
 
--- a/gcc/config/riscv/riscv.md
+++ b/gcc/config/riscv/riscv.md
@@ -674,7 +674,7 @@
 ;; Keep this in sync with enum riscv_microarchitecture.
 (define_attr "tune"
   "generic,sifive_7,sifive_p400,sifive_p600,xiangshan,generic_ooo,mips_p8700,
-   tt_ascalon_d8,andes_25_series,andes_23_series,andes_45_series,spacemit_x60"
+   tt_ascalon_d8,andes_25_series,andes_23_series,andes_45_series,spacemit_x60,thead_c906"
   (const (symbol_ref "((enum attr_tune) riscv_microarchitecture)")))
 
 ;; Describe a user's asm statement.
@@ -5011,3 +5011,4 @@
 (include "andes-25-series.md")
 (include "andes-45-series.md")
 (include "spacemit-x60.md")
+(include "thead-c906.md")
--- a/gcc/config/riscv/riscv-cores.def
+++ b/gcc/config/riscv/riscv-cores.def
@@ -42,7 +42,7 @@
 RISCV_TUNE("sifive-p600-series", sifive_p600, sifive_p600_tune_info)
 RISCV_TUNE("tt-ascalon-x", tt_ascalon_d8, tt_ascalon_d8_tune_info)
 RISCV_TUNE("tt-ascalon-d8", tt_ascalon_d8, tt_ascalon_d8_tune_info)
-RISCV_TUNE("thead-c906", generic, thead_c906_tune_info)
+RISCV_TUNE("thead-c906", thead_c906, thead_c906_tune_info)
 RISCV_TUNE("xt-c908", generic, generic_ooo_tune_info)
 RISCV_TUNE("xt-c908v", generic, generic_ooo_tune_info)
 RISCV_TUNE("xt-c910", generic, generic_ooo_tune_info)
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -592,9 +592,9 @@
 static const struct riscv_tune_param thead_c906_tune_info = {
   {COSTS_N_INSNS (4), COSTS_N_INSNS (5)}, /* fp_add */
   {COSTS_N_INSNS (4), COSTS_N_INSNS (5)}, /* fp_mul */
-  {COSTS_N_INSNS (20), COSTS_N_INSNS (20)}, /* fp_div */
-  {COSTS_N_INSNS (4), COSTS_N_INSNS (4)}, /* int_mul */
-  {COSTS_N_INSNS (18), COSTS_N_INSNS (34)}, /* int_div */
+  {COSTS_N_INSNS (19), COSTS_N_INSNS (34)}, /* fp_div */
+  {COSTS_N_INSNS (4), COSTS_N_INSNS (5)}, /* int_mul */
+  {COSTS_N_INSNS (13), COSTS_N_INSNS (21)}, /* int_div */
   1,            /* issue_rate */
   3,            /* branch_cost */
   5,            /* memory_cost */
--- /dev/null
+++ b/gcc/config/riscv/thead-c906.md
@@ -0,0 +1,181 @@
+;; Scheduling description for the T-Head C906.
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+;;
