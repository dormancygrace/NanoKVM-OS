 #define CFG_USER_PWROFST_COVER_CALIB_EN     (1)
-#define CFG_USER_CHAN_MAX_TXPWR_EN          (defined(CONFIG_POWER_LIMIT))
+#define CFG_USER_CHAN_MAX_TXPWR_EN          IS_ENABLED(CONFIG_POWER_LIMIT)
 #define CFG_USER_TX_USE_ANA_F_EN            (0)
-#define CFG_USER_APM_PRBRSP_OFFLOAD_DISABLE (defined(CONFIG_PRBREQ_REPORT))
+#define CFG_USER_APM_PRBRSP_OFFLOAD_DISABLE IS_ENABLED(CONFIG_PRBREQ_REPORT)
 #define CFG_USER_HE_MU_EDCA_UPDATE_DISABLE  (0)
 #define CFG_USER_LOFT_CALIB_DISABLE_DISABLE (0)
 #define CFG_USER_CAPA_CALIB_DISABLE_DISABLE (0)
diff --git a/aic8800_bsp/aic8800d80x2_compat.c b/aic8800_bsp/aic8800d80x2_compat.c
index 95a3768..a527e83 100644
--- a/aic8800_bsp/aic8800d80x2_compat.c
+++ b/aic8800_bsp/aic8800d80x2_compat.c
@@ -18,8 +18,8 @@
      USER_SETCH_LOFT_CALIB_EN_FLAG)
 
 #define CFG_USER_PWROFST_COVER_CALIB_EN     (1)
-#define CFG_USER_CHAN_MAX_TXPWR_EN          (defined(CONFIG_POWER_LIMIT))
-#define CFG_USER_APM_PRBRSP_OFFLOAD_DISABLE (defined(CONFIG_PRBREQ_REPORT))
+#define CFG_USER_CHAN_MAX_TXPWR_EN          IS_ENABLED(CONFIG_POWER_LIMIT)
+#define CFG_USER_APM_PRBRSP_OFFLOAD_DISABLE IS_ENABLED(CONFIG_PRBREQ_REPORT)
 #define CFG_USER_HE_MU_EDCA_UPDATE_DISABLE  (0)
 #define CFG_USER_RF_WITH_SAW_EN             (0)
 #define CFG_USER_SETCH_LOFT_CALIB_EN        (1)
diff --git a/aic8800_fdrv/Makefile b/aic8800_fdrv/Makefile
index c74d8f1..24d5ca9 100644
--- a/aic8800_fdrv/Makefile
+++ b/aic8800_fdrv/Makefile
@@ -1,5 +1,5 @@
-EXTRA_CFLAGS += $(USER_EXTRA_CFLAGS)
-EXTRA_CFLAGS += -Wno-implicit-fallthrough
+# Vendor functions are shared between files without header declarations.
+ccflags-y += -Wno-missing-prototypes -Wno-missing-declarations
 #EXTRA_CFLAGS += -Wno-unused-function
 #EXTRA_CFLAGS += -Wno-maybe-uninitialized
 #EXTRA_CFLAGS += -Wno-unused-variable
