diff -ru a/liveMedia/include/RTPInterface.hh b/liveMedia/include/RTPInterface.hh
--- a/liveMedia/include/RTPInterface.hh
+++ b/liveMedia/include/RTPInterface.hh
@@ -23,6 +23,26 @@
 #ifndef _RTP_INTERFACE_HH
 #define _RTP_INTERFACE_HH
 
+class TaskScheduler;
+
+// Everything a TCP socket carries (RTP and RTCP over TCP, and the RTSP replies on the same connection) goes through
+// one output queue per socket, in order: what the socket does not take at once waits there, goes out before anything
+// later, and is drained by a timer when nothing new comes. A slow client never blocks the event loop and the other
+// clients. A client whose queue would grow past RTPInterfaceMaxBacklogBytes is disconnected (its socket shut down).
+extern unsigned RTPInterfaceMaxBacklogBytes;
+// For a socket that carries RTP: called after each packet and each drain with the bytes still queued (0: all out).
+extern void (*RTPInterfaceBacklogHook)(int socketNum, unsigned backlogBytes);
+// Called when the queue of a socket is dropped: the connection closed, or the client was disconnected.
+extern void (*RTPInterfaceClosedHook)(int socketNum);
+// Called when a track stops streaming over a socket (its TEARDOWN, or the connection's end), for each channel.
+extern void (*RTPInterfaceStreamRemovedHook)(int socketNum, unsigned char channelId);
+// Writes bytes to a TCP socket behind what is queued for it. False when the client was disconnected.
+bool RTPInterfaceWrite(TaskScheduler& scheduler, int socketNum, char const* data, unsigned size);
+// Drops the queue of a socket (the connection closes; a new connection may reuse the number).
+void RTPInterfaceForgetSocket(int socketNum);
+// Drops every queue and the drain timer (the scheduler goes away).
+void RTPInterfaceForgetAll();
+
 #ifndef _MEDIA_HH
 #include "Media.hh"
 #endif
