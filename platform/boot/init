#!/busybox sh

export PATH=/
# Preserve the stock boot/recovery flow; Linux DT sets USB peripheral mode.

# The root is F2FS on every NanoKVM OS card: the SD image, a stock migration
# and a root reinstalled by recovery all create it so.
rootfs=f2fs

msc() {
	echo mmc0 > /sys/devices/platform/leds/leds/led-user/trigger
	cd /sys/kernel/config/usb_gadget
	mkdir g0
	cd g0
	if [ -e /boot/usb.idVendor ]
	then
		cat /boot/usb.idVendor > idVendor
	else
		echo 0x3346 > idVendor
	fi
	if [ -e /boot/usb.idProduct ]
	then
		cat /boot/usb.idProduct > idProduct
	else
		echo 0x1009 > idProduct
	fi
	mkdir strings/0x409
	if [ -e /boot/usb.serialnumber ]
	then
		cat /boot/usb.serialnumber > strings/0x409/serialnumber
	else
		echo '0123456789ABCDEF' > strings/0x409/serialnumber
	fi
	if [ -e /boot/usb.manufacturer ]
	then
		cat /boot/usb.manufacturer > strings/0x409/manufacturer
	else
		echo 'sipeed' > strings/0x409/manufacturer
	fi
	if [ -e /boot/usb.product ]
	then
		cat /boot/usb.product > strings/0x409/product
	else
		echo 'licheervnano' > strings/0x409/product
	fi
	mkdir configs/c.1/
	mkdir functions/mass_storage.disk0
	ln -s functions/mass_storage.disk0 configs/c.1/
	echo 1 > functions/mass_storage.disk0/lun.0/removable
	# Release local mounts before exporting the entire card to the USB host.
	# Abort this path if a mounted partition could not be released.
	if grep -q ' /boot ' /proc/mounts; then
		umount /boot || return 1
	fi
	if grep -q ' /realroot ' /proc/mounts; then
		umount /realroot || return 1
	fi
	echo /dev/mmcblk0 > functions/mass_storage.disk0/lun.0/file
	ls /sys/class/udc/ | cat > UDC
	# Mainline DWC2 uses dr_mode = "peripheral" from the board DT.
	while true
	do
		sleep 1
		busybox uptime
		busybox uname
		sync
	done
}

set -x

mkdir -p /dev
mount -t devtmpfs devtmpfs /dev
mkdir -p /proc
mount -t proc proc /proc
mkdir -p /sys
mount -t sysfs sysfs /sys
mount -t configfs configfs /sys/kernel/config

# The FSBL sets 1000 MHz (an older FIP leaves 850 MHz), and the server applied
# the saved clock only some 12 s later. The boot runs at 1000 MHz, the default; a user
# who chose 850 MHz gets it back once the root is mounted (below).
# Overclocking stays with the server, which guards it.
cpufreq=/sys/devices/system/cpu/cpufreq/policy0
if [ -w "$cpufreq/scaling_governor" ]; then
	echo userspace > "$cpufreq/scaling_governor" &&
		echo 1000000 > "$cpufreq/scaling_max_freq" &&
		echo 1000000 > "$cpufreq/scaling_setspeed"
fi 2>/dev/null || true

mkdir -p /boot
# The card's partitions appear some 50 ms after /init starts, and probe-only
# DTs expose MMC a little later still. Poll in 20 ms steps for up to 10 s: a
# one-second step cost a whole second whenever /init got here first.
attempt=0
while [ ! -b /dev/mmcblk0p2 ] && [ "$attempt" -lt 500 ]; do
	sleep 0.02
	attempt=$((attempt + 1))
done
mount -o ro /dev/mmcblk0p1 /boot

msc=0
if [ -e /boot/rec ]
then
	msc
fi

# The User Key held down across half a second exports the card over USB. Only
# a key already down at the first look is worth the wait. The key is line 30
# of the GPIO controller at 0x03020000 on every board, low while pressed; its
# input register is read directly (the release kernel has no debugfs, where
# /sys/kernel/debug/gpio showed it).
user_key_down() {
	value=$(devmem 0x03020050 32) || return 1
	case "$value" in 0x*) ;; *) return 1 ;; esac
	[ $(( value >> 30 & 1 )) -eq 0 ]
}
if user_key_down
then
	sleep 0.5
	if user_key_down
	then
		msc
	fi
fi

umount /boot

mkdir /realroot
# parted -s /dev/mmcblk0 "resizepart 2 -0"
# echo "yes
# 100%
# " | parted ---pretend-input-tty /dev/mmcblk0 "resizepart 2 100%"

mount -t "$rootfs" -o rw /dev/mmcblk0p2 /realroot
mfail="$?"

if [ "${mfail}" -ne 0 ]
then
	# Keep the stock retry behavior: fsck.f2fs may return a nonzero status
	# after repairing a filesystem, so the remount is the authority.
	if ! fsck.f2fs -f -p /dev/mmcblk0p2; then
		echo "${rootfs} recovery check failed on /dev/mmcblk0p2" >&2
	fi
	mount -t "$rootfs" -o rw /dev/mmcblk0p2 /realroot
	mfail="$?"
	if [ "${mfail}" -ne 0 ]
	then
		msc
	fi
fi

# The saved clock (service/vm/cpufreq.go): only 850 MHz is below the boot's.
if [ -w "$cpufreq/scaling_setspeed" ] && read -r mhz < /realroot/etc/kvm/cpufreq 2>/dev/null &&
	[ "$mhz" = 850 ]; then
	echo 850000 > "$cpufreq/scaling_setspeed"
	echo 850000 > "$cpufreq/scaling_max_freq"
fi 2>/dev/null || true

mount -t proc proc /realroot/proc
mount -t sysfs sysfs /realroot/sys
mount -t devtmpfs devtmpfs /realroot/dev
if [ "$(busybox tr -d '\000' < /sys/firmware/devicetree/base/sipeed,board-revision)" = detect ]; then
	# Hardware discovery runs before networking, video, GPIO buttons or Wi-Fi.
	# A successful selection replaces boot.sd and reboots with the selected DT.
	busybox chroot /realroot /usr/sbin/nkos-board-select
	echo 'NanoKVM board selection failed; normal services were not started'
	exec busybox sh </dev/console >/dev/console 2>&1
fi
exec switch_root /realroot /sbin/init
