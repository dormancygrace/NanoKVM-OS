 #include <asm/simd.h>
 #include <asm/vector.h>
+#include <linux/linkage.h>
+#include <linux/unaligned.h>
+
+/* Zvkg under the same conditions as before the C906 backend. */
+#if defined(CONFIG_TOOLCHAIN_HAS_VECTOR_CRYPTO) && \
+	defined(CONFIG_RISCV_EFFICIENT_VECTOR_UNALIGNED_ACCESS)
+#define GHASH_RISCV_ZVKG
+#endif
 
+#ifdef GHASH_RISCV_ZVKG
 static __ro_after_init DEFINE_STATIC_KEY_FALSE(have_zvkg);
 
 asmlinkage void ghash_zvkg(u8 accumulator[GHASH_BLOCK_SIZE],
 			   const u8 key[GHASH_BLOCK_SIZE],
 			   const u8 *data, size_t nblocks);
+#endif
+
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+/*
+ * The kernel is built for the T-Head C906 (XTheadBb, XTheadMemIdx): GHASH
+ * with 8-bit tables, see ghash-riscv64-c906.S. Scalar code, usable in any
+ * context.
+ */
+asmlinkage void ghash_blocks_c906(struct polyval_elem *acc, const u64 *tables,
+				  const u8 *data, size_t nblocks);
+
+/* Divide by x in the bit order of GHASH: H * x in the field. */
+static __always_inline void ghash_c906_mulx(u64 *hi, u64 *lo)
+{
+	u64 carry = *lo & 1;
+
+	*lo = *hi << 63 | *lo >> 1;
+	*hi = *hi >> 1 ^ (carry ? 0xe100000000000000ULL : 0);
+}
+
+/*
+ * Table q, entry b: b * H * x^(128 q / GHASH_C906_TABLES), where bit 7 of b is
+ * the coefficient of the lowest power; u64 lo[256] then u64 hi[256].
+ */
+static void ghash_c906_preparekey(u64 *tables, const u8 raw_key[GHASH_BLOCK_SIZE])
+{
+	u64 vh = get_unaligned_be64(raw_key);
+	u64 vl = get_unaligned_be64(raw_key + 8);
+	int q, i, j;
+
+	for (q = 0; q < GHASH_C906_TABLES; q++) {
+		u64 *lo = tables + 512 * q, *hi = lo + 256;
+
+		lo[0] = 0;
+		hi[0] = 0;
+		for (i = 0x80; i; i >>= 1) {
+			lo[i] = vl;
+			hi[i] = vh;
+			ghash_c906_mulx(&vh, &vl);
+		}
+		for (i = 2; i < 256; i <<= 1) {
+			for (j = 1; j < i; j++) {
+				lo[i + j] = lo[i] ^ lo[j];
+				hi[i + j] = hi[i] ^ hi[j];
+			}
+		}
+		for (i = 8; i < 128 / GHASH_C906_TABLES; i++)
+			ghash_c906_mulx(&vh, &vl);
+	}
+}
+#endif
 
 #define ghash_preparekey_arch ghash_preparekey_arch
 static void ghash_preparekey_arch(struct ghash_key *key,
@@ -25,6 +87,10 @@ static void ghash_preparekey_arch(struct ghash_key *key,
 
 	/* Save key in GHASH format for zvkg */
 	memcpy(key->h_raw, raw_key, GHASH_BLOCK_SIZE);
+
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	ghash_c906_preparekey(key->c906_tables, raw_key);
+#endif
 }
 
 #define ghash_blocks_arch ghash_blocks_arch
@@ -32,6 +98,7 @@ static void ghash_blocks_arch(struct polyval_elem *acc,
 			      const struct ghash_key *key,
 			      const u8 *data, size_t nblocks)
 {
+#ifdef GHASH_RISCV_ZVKG
 	if (static_branch_likely(&have_zvkg) && likely(may_use_simd())) {
 		u8 ghash_acc[GHASH_BLOCK_SIZE];
 
@@ -43,11 +110,17 @@ static void ghash_blocks_arch(struct polyval_elem *acc,
 
 		ghash_acc_to_polyval(ghash_acc, acc);
 		memzero_explicit(ghash_acc, sizeof(ghash_acc));
-	} else {
-		ghash_blocks_generic(acc, &key->h, data, nblocks);
+		return;
 	}
+#endif
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR
+	ghash_blocks_c906(acc, key->c906_tables, data, nblocks);
+#else
+	ghash_blocks_generic(acc, &key->h, data, nblocks);
+#endif
 }
 
+#ifdef GHASH_RISCV_ZVKG
 #define gf128hash_mod_init_arch gf128hash_mod_init_arch
 static void gf128hash_mod_init_arch(void)
 {
@@ -55,3 +128,4 @@ static void gf128hash_mod_init_arch(void)
 	    riscv_vector_vlen() >= 128)
 		static_branch_enable(&have_zvkg);
 }
+#endif
