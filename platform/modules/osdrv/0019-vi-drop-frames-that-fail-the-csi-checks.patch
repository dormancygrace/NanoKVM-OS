From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] vi: do not publish frames that fail the CSI bridge checks

isp_err_chk finds a frame whose line or frame size differs from the
setting, or a CSI bridge FIFO overflow. It counts the error and wakes the
error handler thread, which resets and restarts the pipe. The interrupt
handler ignored that, and the frame's end queued the frame as a good one:
a frame damaged on the receiver's MIPI link reached the encoders.

Each wake of the error handler now marks the pipe's frame as damaged:
these errors, and an ISP reset another module asks for (VI_CB_RESET_ISP),
which aborts the frame as well. The YUV bypass
frame end, in the same interrupt or a later one, does all its bookkeeping
(idle state, the next DMA trigger) but does not publish the buffer; the
buffer stays first in the ready queue and takes the next frame. Its
trigger counted it out of qbuf_num and the next trigger counts it again,
so the frame end gives that count back, as _vi_err_retrig_preraw does.
The error handler clears the mark after its reset, for a frame the reset
aborted, and stream off clears it for the next stream.

From the wake of the error handler thread to its reset, the handler owns
restarting the pipe: its retrigger counts the armed buffer back and
triggers after the reset. A frame end in that time used to trigger as
well; the reset wiped that DMA, the state stayed running, the retrigger's
trigger was refused and its count was one too many, so capture stopped
until the server restarted it. Such a frame end now only notes its
channel. If the handler returns before its reset (a wait or the abort
failed), it restarts the noted channels as their frame ends would have.
A wake that finds the handler flag already set (an earlier handler that
returned early, or VI_CB_RESET_ISP) starts no handler and holds nothing
back.

DMA and over-maximum errors, which wake nothing, are unchanged. The YUV
online and RAW paths are unchanged (NanoKVM captures YUV bypass offline).
The mark is per pipe: with two muxed channels on one pipe only the first
frame end after the error is held back (NanoKVM captures one channel).

Sipeed's driver for the same SoC returns from the interrupt handler on
any isp_err_chk failure, which also skips that interrupt's bookkeeping and
misses an error and a frame end that arrive in separate interrupts.

---
diff --git a/interdrv/vi/chip/cv181x/vi.c b/interdrv/vi/chip/cv181x/vi.c
--- a/interdrv/vi/chip/cv181x/vi.c
+++ b/interdrv/vi/chip/cv181x/vi.c
@@ -314,6 +314,27 @@
 	spin_unlock_irqrestore(&raw_num_lock, flags);
 }
 
+/*
+ * A frame the error handler is woken for: it failed the CSI bridge checks
+ * (a short or long line or frame, a FIFO overflow; isp_err_chk) or another
+ * module asked for an ISP reset (VI_CB_RESET_ISP). The frame's end, in the
+ * same interrupt or a later one, does all its bookkeeping but does not
+ * publish the buffer, which takes the next frame instead. The error handler
+ * clears the mark after its reset, for a frame it aborted, and stream off
+ * clears it for the next stream. Indexed like pre_fe_frm_num.
+ */
+static atomic_t nk_frame_damaged[ISP_PRERAW_VIRT_MAX];
+/*
+ * From the wake of the error handler thread to its reset (step 7), the
+ * handler owns restarting the pipe: its retrigger counts the armed buffer
+ * back and triggers once after the reset. A frame end in that time neither
+ * publishes, counts back nor triggers; it only notes its channel in
+ * nk_eof_held. If the handler returns before step 7 (a wait or the abort
+ * failed), nk_err_recovery_abandon restarts the noted channels instead.
+ */
+static atomic_t nk_err_recovering[ISP_PRERAW_VIRT_MAX];
+static atomic_t nk_eof_held[ISP_PRERAW_VIRT_MAX][ISP_FE_CHN_MAX];
+
 static void cvi_isp_buf_queue(struct cvi_vi_dev *vdev, struct cvi_isp_buf *b)
 {
 	unsigned long flags;
@@ -3263,6 +3284,14 @@
 		INIT_LIST_HEAD(&vdev->qbuf_list[i]);
 		spin_unlock_irqrestore(&vdev->qbuf_lock, flags);
 	}
+	for (i = 0; i < ISP_PRERAW_VIRT_MAX; i++) {
+		int j;
+
+		atomic_set(&nk_frame_damaged[i], 0);
+		atomic_set(&nk_err_recovering[i], 0);
+		for (j = 0; j < ISP_FE_CHN_MAX; j++)
+			atomic_set(&nk_eof_held[i][j], 0);
+	}
 
 	spin_lock_irqsave(&dq_lock, flags);
 	while (!list_empty(&dqbuf_q.list)) {
@@ -7026,6 +7055,44 @@
 	gOverflowInfo = NULL;
 }
 
+static void nk_err_recovery_clear(const enum cvi_isp_raw raw_num)
+{
+	int i;
+
+	atomic_set(&nk_frame_damaged[raw_num], 0);
+	atomic_set(&nk_err_recovering[raw_num], 0);
+	for (i = 0; i < ISP_FE_CHN_MAX; i++)
+		atomic_set(&nk_eof_held[raw_num][i], 0);
+}
+
+/*
+ * The error handler returns before its reset: restart each channel whose
+ * frame end it held back, as that frame end would have (the buffer counted
+ * back, then the trigger).
+ */
+static void nk_err_recovery_abandon(struct cvi_vi_dev *vdev, const enum cvi_isp_raw raw_num)
+{
+	u8 hw_chn_num;
+
+	atomic_set(&nk_err_recovering[raw_num], 0);
+
+	for (hw_chn_num = 0; hw_chn_num < ISP_FE_CHN_MAX; hw_chn_num++) {
+		u8 buf_chn = (raw_num == ISP_PRERAW_A) ? hw_chn_num : vdev->ctx.rawb_chnstr_num + hw_chn_num;
+		unsigned long flags;
+
+		if (!atomic_xchg(&nk_eof_held[raw_num][hw_chn_num], 0))
+			continue;
+		if (atomic_read(&vdev->pre_fe_state[raw_num][hw_chn_num]) != ISP_PRERAW_IDLE ||
+			cvi_isp_rdy_buf_empty(vdev, buf_chn))
+			continue;
+
+		spin_lock_irqsave(&vdev->qbuf_lock, flags);
+		vdev->qbuf_num[buf_chn]++;
+		spin_unlock_irqrestore(&vdev->qbuf_lock, flags);
+		_isp_yuv_bypass_trigger(vdev, raw_num, hw_chn_num);
+	}
+}
+
 static void _vi_err_retrig_preraw(struct cvi_vi_dev *vdev, const enum cvi_isp_raw err_raw_num)
 {
 	struct isp_ctx *ctx = &vdev->ctx;
@@ -7160,12 +7227,15 @@
 		} else {
 			vi_pr(VI_ERR, "isp status post(%d)\n", atomic_read(&vdev->postraw_state));
 		}
+		nk_err_recovery_abandon(vdev, err_raw_num);
 		return;
 	}
 
 	//step 3 : set csibdg sw abort and wait abort done
-	if (isp_frm_err_handler(ctx, err_raw_num, 3) < 0)
+	if (isp_frm_err_handler(ctx, err_raw_num, 3) < 0) {
+		nk_err_recovery_abandon(vdev, err_raw_num);
 		return;
+	}
 
 	//step 4 : isp sw reset and vip reset pull up
 	isp_frm_err_handler(ctx, err_raw_num, 4);
@@ -7186,10 +7256,15 @@
 	isp_frm_err_handler(ctx, err_raw_num, 5);
 
 	//step 6 : wait ISP idle
-	if (isp_frm_err_handler(ctx, err_raw_num, 6) < 0)
+	if (isp_frm_err_handler(ctx, err_raw_num, 6) < 0) {
+		nk_err_recovery_abandon(vdev, err_raw_num);
 		return;
+	}
 
 	//step 7 : reset sw state to idle
+	/* The pipe is idle: the retrigger below restarts it and counts its
+	 * buffer back, for a frame end held back meanwhile too. */
+	nk_err_recovery_clear(err_raw_num);
 	if (_is_be_post_online(ctx)) {
 		atomic_set(&vdev->pre_fe_state[err_raw_num][ISP_FE_CH0], ISP_PRERAW_IDLE);
 		atomic_set(&vdev->pre_fe_state[err_raw_num][ISP_FE_CH1], ISP_PRERAW_IDLE);
@@ -7271,6 +7346,7 @@
 
 static inline void vi_err_wake_up_th(struct cvi_vi_dev *vdev, enum cvi_isp_raw err_raw)
 {
+	atomic_set(&nk_frame_damaged[err_raw], 1);
 	if (atomic_read(&vdev->isp_err_handle_flag) == 1) {
 		vi_pr(VI_WARN, "work on err_handler\n");
 		if (vdev->vi_th[E_VI_TH_ERR_HANDLER].flag != err_raw + 1) {
@@ -7283,6 +7359,7 @@
 	//Stop pre/postraw trigger go
 	atomic_set(&vdev->isp_err_handle_flag, 1);
 
+	atomic_set(&nk_err_recovering[err_raw], 1);
 	vdev->vi_th[E_VI_TH_ERR_HANDLER].flag = err_raw + 1;
 
 	wake_up(&vdev->vi_th[E_VI_TH_ERR_HANDLER].wq);
@@ -7845,13 +7922,35 @@
 
 	atomic_set(&vdev->pre_fe_state[raw_num][hw_chn_num], ISP_PRERAW_IDLE);
 
-	cvi_isp_rdy_buf_remove(vdev, buf_chn);
+	if (atomic_read(&nk_err_recovering[raw_num])) {
+		/* The error handler restarts the pipe after its reset; a trigger
+		 * here would be wiped by it and leave the state running. The
+		 * buffer stays first in the ready queue, and the mark stays. */
+		atomic_set(&nk_eof_held[raw_num][hw_chn_num], 1);
+		vi_pr(VI_DBG, "fe_%d chn_num_%d frame end during error recovery\n", raw_num, buf_chn);
+		return;
+	}
 
-	cvi_isp_dqbuf_list(vdev, vdev->pre_fe_frm_num[raw_num][hw_chn_num], raw_num, buf_chn);
+	if (atomic_xchg(&nk_frame_damaged[raw_num], 0)) {
+		unsigned long flags;
 
-	vdev->vi_th[E_VI_TH_EVENT_HANDLER].flag = raw_num + 1;
+		/* Failed the CSI checks: the buffer stays first in the ready
+		 * queue and takes the next frame. Its trigger counted it out
+		 * of qbuf_num, and the trigger below counts it again: give
+		 * that count back, as _vi_err_retrig_preraw does. */
+		spin_lock_irqsave(&vdev->qbuf_lock, flags);
+		vdev->qbuf_num[buf_chn]++;
+		spin_unlock_irqrestore(&vdev->qbuf_lock, flags);
+		vi_pr(VI_DBG, "fe_%d chn_num_%d damaged frame not published\n", raw_num, buf_chn);
+	} else {
+		cvi_isp_rdy_buf_remove(vdev, buf_chn);
+
+		cvi_isp_dqbuf_list(vdev, vdev->pre_fe_frm_num[raw_num][hw_chn_num], raw_num, buf_chn);
 
-	wake_up(&vdev->vi_th[E_VI_TH_EVENT_HANDLER].wq);
+		vdev->vi_th[E_VI_TH_EVENT_HANDLER].flag = raw_num + 1;
+
+		wake_up(&vdev->vi_th[E_VI_TH_EVENT_HANDLER].wq);
+	}
 
 	if (cvi_isp_rdy_buf_empty(vdev, buf_chn))
 		vi_pr(VI_INFO, "fe_%d chn_num_%d yuv bypass outbuf is empty\n", raw_num, buf_chn);
