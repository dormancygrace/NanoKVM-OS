// SPDX-License-Identifier: (GPL-2.0 OR MIT)
// Shared SG2002 resources and serial Full/PCIe wiring. Variant DTS owns identity.
#include "sg2002-licheerv-nano-b.dts"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Sipeed NanoKVM SG2002";
	compatible = "sipeed,nanokvm", "sophgo,sg2002";
	aliases {
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
		gpio4 = &gpio4;
		ethernet0 = &gmac0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &oled_i2c;
	};
	chosen {
		bootargs = "root=/dev/mmcblk0p2 rootwait rw console=ttyS0,115200 earlycon=sbi";
	};
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&nanokvm_boot_key_cfg>;
		key-user {
			label = "User Key";
			linux,code = <KEY_DISPLAYTOGGLE>;
			debounce-interval = <1>;
			gpios = <&porta 30 GPIO_ACTIVE_LOW>;
		};
	};
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&nanokvm_user_led_cfg>;
		led-user {
			label = "led-user";
			gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "activity";
		};
	};
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		// Match the actual OpenSBI PMP range copied by the installed U-Boot.
		// Equal ranges are deduplicated; a larger no-map node overlaps and fails.
		mmode_resv0@80000000 { reg = <0x80000000 0x40000>; no-map; };
		// Preserve the reservation used by the unchanged installed FIP.
		c906l@8d000000 { reg = <0x8d000000 0x200000>; no-map; };
		ion_region: ion {
			compatible = "shared-dma-pool";
			size = <0x04000000>;
			alignment = <0x00400000>;
			reusable;
		};
	};
	cvitek-ion {
		compatible = "cvitek,cvitek-ion";
		heap-carveout {
			compatible = "cvitek,carveout";
			memory-region = <&ion_region>;
			nanokvm,cma-backend;
		};
	};
	hdmi-reset {
		compatible = "sipeed,nanokvm-hdmi-reset";
		pinctrl-names = "default";
		pinctrl-0 = <&nanokvm_hdmi_reset_cfg>;
		reset-gpios = <&portb 3 GPIO_ACTIVE_LOW>;
	};
	oled_i2c: i2c-oled {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&nanokvm_oled_i2c_cfg>;
		scl-gpios = <&porta 15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&porta 27 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
	};
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&nanokvm_wifi_enable_cfg>;
		reset-gpios = <&porta 26 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};
	sys {
		compatible = "cvitek,sys";
	};

	base@a0c8000 {
		compatible = "cvitek,base";
		reg = <0xa0c8000 0x20 >;
		reg-names = "vip_sys";
		clocks = <&clk CLK_CFG_REG_VIP>;
		clock-names = "cfg_reg";
	};

	cif@a0c2000 {
		compatible = "cvitek,cif";
		pinctrl-names = "default";
		pinctrl-0 = <&nanokvm_csi_cfg>;
		reg = <0xa0c2000 0x2000 0xa0d0000 0x1000 0xa0c4000 0x2000 0xa0c6000 0x2000 0x3001c30 0x30 >;
		reg-names = "csi_mac0", "csi_wrap0", "csi_mac1", "csi_mac2", "pad_ctrl";
		// PCIe HDMI reset is GPIOB3, owned by hdmi-reset above. No CSI sensor
		// reset is wired to GPIOE1; do not claim the legacy LT interrupt pin.
		resets = <&rst 0x46 &rst 0x48 &rst 0x47 &rst 0x49>;
		reset-names = "phy0", "phy1", "phy-apb0", "phy-apb1";
		clocks = <&clk CLK_CAM0>, <&clk CLK_CAM1>, <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_MIPIMPLL>, <&clk CLK_DISPPLL>, <&clk CLK_FPLL>, <&clk CLK_CSI0_RX_VIP>;
		clock-names = "clk_cam0", "clk_cam1", "clk_sys_2", "clk_mipimpll", "clk_disppll", "clk_fpll", "csi0_rx";
		interrupts = <0x1a 0x04 0x1b 0x04>;
		interrupt-names = "csi0", "csi1";
		interrupt-parent = <&plic>;
	};

	vi@a000000 {
		compatible = "cvitek,vi";
		reg = <0xa000000 0x80000 >;
		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>, <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_SRC_VIP_SYS_3>, <&clk CLK_AXI_VIP>, <&clk CLK_CSI_BE_VIP>, <&clk CLK_RAW_VIP>, <&clk CLK_ISP_TOP_VIP>, <&clk CLK_CSI_MAC0_VIP>, <&clk CLK_CSI_MAC1_VIP>, <&clk CLK_CSI_MAC2_VIP>;
		clock-names = "clk_sys_0", "clk_sys_1", "clk_sys_2", "clk_sys_3", "clk_axi", "clk_csi_be", "clk_raw", "clk_isp_top", "clk_csi_mac0", "clk_csi_mac1", "clk_csi_mac2";
		clock-freq-vip-sys1 = <0x11e1a300>;
		interrupts = <0x18 0x04>;
		interrupt-parent = <&plic>;
		interrupt-names = "isp";
	};

	vpss@a080000 {
		compatible = "cvitek,vpss";
		reg = <0xa080000 0x10000 0xa0d1000 0x100 >;
		reg-names = "sc";
		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>, <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_IMG_D_VIP>, <&clk CLK_IMG_V_VIP>, <&clk CLK_SC_TOP_VIP>, <&clk CLK_SC_D_VIP>, <&clk CLK_SC_V1_VIP>, <&clk CLK_SC_V2_VIP>, <&clk CLK_SC_V3_VIP>;
		clock-names = "clk_sys_0", "clk_sys_1", "clk_sys_2", "clk_img_d", "clk_img_v", "clk_sc_top", "clk_sc_d", "clk_sc_v1", "clk_sc_v2", "clk_sc_v3";
		clock-freq-vip-sys1 = <0x11e1a300>;
		interrupts = <0x19 0x04>;
		interrupt-names = "sc";
		interrupt-parent = <&plic>;
	};

	rgn {
		compatible = "cvitek,rgn";
	};

	vcodec@b020000 {
		compatible = "cvitek,asic-vcodec";
		reg = <0xb020000 0x10000 0xb010000 0x10000 0xb030000 0x100 0xb058000 0x100 0xb050000 0x400 >;
		reg-names = "h265", "h264", "vc_ctrl", "vc_sbm", "vc_addr_remap";
		clocks = <&clk CLK_AXI_VIDEO_CODEC>, <&clk CLK_H264C>, <&clk CLK_APB_H264C>, <&clk CLK_H265C>, <&clk CLK_APB_H265C>, <&clk CLK_VC_SRC0>, <&clk CLK_VC_SRC1>, <&clk CLK_VC_SRC2>, <&clk CLK_CFG_REG_VC>;
		clock-names = "clk_axi_video_codec", "clk_h264c", "clk_apb_h264c", "clk_h265c", "clk_apb_h265c", "clk_vc_src0", "clk_vc_src1", "clk_vc_src2", "clk_cfg_reg_vc";
		interrupts = <0x16 0x04 0x15 0x04 0x17 0x04>;
		interrupt-names = "h265", "h264", "sbm";
		interrupt-parent = <&plic>;
	};

	jpu@b000000 {
		compatible = "cvitek,asic-jpeg";
		reg = <0xb000000 0x300 0xb030000 0x100 0xb058000 0x100 >;
		reg-names = "jpeg", "vc_ctrl", "vc_sbm";
		clocks = <&clk CLK_AXI_VIDEO_CODEC>, <&clk CLK_JPEG>, <&clk CLK_APB_JPEG>, <&clk CLK_VC_SRC0>, <&clk CLK_VC_SRC1>, <&clk CLK_VC_SRC2>, <&clk CLK_CFG_REG_VC>;
		clock-names = "clk_axi_video_codec", "clk_jpeg", "clk_apb_jpeg", "clk_vc_src0", "clk_vc_src1", "clk_vc_src2", "clk_cfg_reg_vc";
		resets = <&rst 0x04>;
		reset-names = "jpeg";
		interrupts = <0x14 0x04>;
		interrupt-names = "jpeg";
		interrupt-parent = <&plic>;
	};

	cvi-vc-drv@b030000 {
		compatible = "cvitek,cvi_vc_drv";
		reg = <0xb030000 0x100 0xb058000 0x100 0xb050000 0x400 >;
		reg-names = "vc_ctrl", "vc_sbm", "vc_addr_remap";
	};

	ive@a0a0000 {
		compatible = "cvitek,ive";
		reg = <0xa0a0000 0x3100 >;
		reg-names = "ive_base";
		clocks = <&clk CLK_CFG_REG_VIP>, <&clk CLK_IVE_VIP>,
			 <&clk CLK_SRC_VIP_SYS_1>;
		clock-names = "cfg_reg", "ive", "core";
		interrupt-names = "ive_irq";
		interrupt-parent = <&plic>;
		interrupts = <0x61 0x04>;
	};

	dwa@a0c0000 {
		compatible = "cvitek,dwa";
		reg = <0xa0c0000 0x1000 >;
		reg-names = "dwa";
		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>, <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_SRC_VIP_SYS_3>, <&clk CLK_SRC_VIP_SYS_4>, <&clk CLK_DWA_VIP>;
		clock-names = "clk_sys_0", "clk_sys_1", "clk_sys_2", "clk_sys_3", "clk_sys_4", "clk_dwa";
		clock-freq-vip-sys1 = <0x11e1a300>;
		interrupts = <0x1c 0x04>;
		interrupt-names = "dwa";
		interrupt-parent = <&plic>;
	};

	vo@a080000 {
		compatible = "cvitek,vo";
		reg = <0xa080000 0x10000 0xa0c8000 0xa0 0xa0d1000 0x100 >;
		reg-names = "sc", "vip_sys", "dphy";
		clocks = <&clk CLK_DISP_VIP>, <&clk CLK_DSI_MAC_VIP>, <&clk CLK_BT_VIP>;
		clock-names = "clk_disp", "clk_dsi", "clk_bt";
	};

	fast-image {
		compatible = "cvitek,rtos_image";
		ion-size = <0x1600000>;
	};
};

&cpu0 {
	#cooling-cells = <2>;
	// C906 has the pre-ratification T-Head vector ISA, not standard RVV 1.0.
	riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicntr", "zicsr",
			       "zifencei", "zihpm", "xtheadvector";
};
&{/soc} {
	soc_temp: temperature-sensor@30e0000 {
		compatible = "sophgo,sg2002-tempsen";
		reg = <0x030e0000 0x1000>;
		clocks = <&clk CLK_TEMPSEN>;
		#thermal-sensor-cells = <0>;
	};
	gpio4: gpio@5021000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x05021000 0x1000>;
		#address-cells = <1>;
		#size-cells = <0>;
		porte: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			reg = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			snps,nr-gpios = <32>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <70 IRQ_TYPE_LEVEL_HIGH>;
		};
	};
	efuse@3050000 {
		compatible = "sophgo,sg2002-efuse";
		reg = <0x03050000 0x1000>;
		clocks = <&clk CLK_EFUSE>;
	};
};
&pinctrl {
	sdhci1_cfg: sdhci1-cfg {
		sdio-clock-pins {
			power-source = <3300>;
			pinmux = <PINMUX(PIN_SD1_CLK, 0)>;
		};
		sdio-command-data-pins {
			power-source = <3300>;
			bias-pull-up;
			pinmux = <PINMUX(PIN_SD1_CMD, 0)>,
				 <PINMUX(PIN_SD1_D0, 0)>, <PINMUX(PIN_SD1_D1, 0)>,
				 <PINMUX(PIN_SD1_D2, 0)>, <PINMUX(PIN_SD1_D3, 0)>;
		};
	};
};
&sdhci1 {
	// Module VDDIO is tied to VDD3V3_SYS; no 1.8 V switching circuitry.
	no-1-8-v;
	pinctrl-0 = <&sdhci1_cfg>;
	pinctrl-names = "default";
	bus-width = <4>;
	max-frequency = <50000000>;
	non-removable;
	no-mmc;
	no-sd;
	keep-power-in-suspend;
	mmc-pwrseq = <&wifi_pwrseq>;
	status = "okay";
};
&mdio { status = "okay"; };
&gmac0 { status = "okay"; };
&i2c0 { status = "okay"; };
&i2c1 { status = "okay"; };
&i2c2 { status = "okay"; };
&i2c3 { status = "okay"; };
&usb {
	dr_mode = "peripheral";
	// Working device's FIFO partition, required for composite gadgets.
	g-rx-fifo-size = <536>;
	g-np-tx-fifo-size = <32>;
	g-tx-fifo-size = <768 512 512 384 128 128>;
	status = "okay";
};

&pinctrl {
	nanokvm_boot_key_cfg: nanokvm-boot-key-cfg {
		boot-key-pins {
			pinmux = <PINMUX(PIN_AUX0, 3)>;
			bias-pull-up;
			power-source = <3300>;
		};
	};
	nanokvm_user_led_cfg: nanokvm-user-led-cfg {
		user-led-pins {
			pinmux = <PINMUX(PIN_SD0_PWR_EN, 3)>;
			bias-disable;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};
};

// GPIO hogs hold only board enable/reset lines. ATX lines remain available
// to the server's exclusive GPIO-v2 requests; these are not ATX buttons.
&gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&nanokvm_board_outputs_cfg &nanokvm_atx_cfg>;
};

&porta {
	oled-reset-hog {
		gpio-hog;
		gpios = <22 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "nanokvm-oled-reset";
	};
};
&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&nanokvm_hdmi_i2c_cfg>;
	clock-frequency = <400000>;
	status = "okay";
};
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&nanokvm_uart1_cfg>;
	status = "okay";
};
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&nanokvm_uart2_cfg>;
	status = "okay";
};
&pinctrl {
	nanokvm_oled_i2c_cfg: nanokvm-oled-i2c-cfg {
		oled-pins {
			pinmux = <PINMUX(PIN_SPK_EN, 3)>, <PINMUX(PIN_EMMC_DAT3, 3)>;
			power-source = <3300>;
		};
	};
	nanokvm_board_outputs_cfg: nanokvm-board-outputs-cfg {
		board-pins {
			pinmux = <PINMUX(PIN_EMMC_CLK, 3)>;
			power-source = <3300>;
		};
	};
	nanokvm_wifi_enable_cfg: nanokvm-wifi-enable-cfg {
		wifi-enable-pins {
			pinmux = <PINMUX(PIN_EMMC_DAT2, 3)>;
			power-source = <3300>;
		};
	};
	nanokvm_atx_cfg: nanokvm-atx-cfg {
		atx-pins {
			pinmux = <PINMUX(PIN_EMMC_CMD, 3)>, <PINMUX(PIN_EMMC_DAT0, 3)>,
				 <PINMUX(PIN_EMMC_DAT1, 3)>;
			power-source = <3300>;
		};
	};
	nanokvm_hdd_led_cfg: nanokvm-hdd-led-cfg {
		hdd-led-pins {
			// PWR_SEQ1 is wired through U46 to the host HDD LED, active low.
			pinmux = <PINMUX(PIN_PWR_SEQ1, 3)>;
			power-source = <1800>;
			bias-disable;
		};
	};
	nanokvm_hdmi_reset_cfg: nanokvm-hdmi-reset-cfg {
		hdmi-reset-pins {
			pinmux = <PINMUX(PIN_ADC1, 3)>;
			power-source = <1800>;
		};
	};
	nanokvm_hdmi_i2c_cfg: nanokvm-hdmi-i2c-cfg {
		hdmi-i2c-pins {
			// Actual PCIe CAM_SCL/CAM_SDA, not legacy ADC3/ADC2 recovery pads.
			pinmux = <PINMUX(PIN_PWR_WAKEUP0, 5)>, <PINMUX(PIN_PWR_BUTTON1, 5)>;
			power-source = <1800>;
		};
	};
	nanokvm_uart1_cfg: nanokvm-uart1-cfg {
		uart1-pins {
			pinmux = <PINMUX(PIN_JTAG_CPU_TMS, 6)>, <PINMUX(PIN_JTAG_CPU_TCK, 6)>;
			power-source = <3300>;
		};
	};
	nanokvm_uart2_cfg: nanokvm-uart2-cfg {
		uart2-pins {
			pinmux = <PINMUX(PIN_IIC0_SCL, 2)>, <PINMUX(PIN_IIC0_SDA, 2)>;
			power-source = <3300>;
		};
	};
};

&pinctrl {
	nanokvm_csi_cfg: nanokvm-csi-cfg {
		csi-pins {
			/* LT6911UXC: one clock pair and four data pairs. */
			pinmux = <PINMUX(PIN_MIPIRX0P, 3)>, <PINMUX(PIN_MIPIRX0N, 3)>,
				 <PINMUX(PIN_MIPIRX1P, 3)>, <PINMUX(PIN_MIPIRX1N, 3)>,
				 <PINMUX(PIN_MIPIRX2P, 3)>, <PINMUX(PIN_MIPIRX2N, 3)>,
				 <PINMUX(PIN_MIPIRX3P, 3)>, <PINMUX(PIN_MIPIRX3N, 3)>,
				 <PINMUX(PIN_MIPIRX4P, 3)>, <PINMUX(PIN_MIPIRX4N, 3)>;
			power-source = <1800>;
			bias-disable;
		};
	};
};

// Reset mode; no pretimeout interrupt. Clock and reset IDs match qualified DT.
&{/soc} {
    watchdog@3010000 {
        compatible = "snps,dw-wdt";
        reg = <0x03010000 0x1000>;
        clocks = <&clk 58>;
        resets = <&rst 48>;
        timeout-sec = <30>;
        status = "okay";
    };
};

/* The cooling state 6 is the 850 MHz entry in sg2002-cpufreq.
 * The user-selected frequency remains the userspace governor's target.
 */
/ {
	thermal-zones {
		sg2002-cpu {
			polling-delay = <1000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&soc_temp>;
			trips {
				cpu_hot: cpu-hot {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
				};
			};
			cooling-maps {
				cpu-cooling {
					trip = <&cpu_hot>;
					cooling-device = <&cpu0 6 6>;
				};
			};
		};
	};
};
