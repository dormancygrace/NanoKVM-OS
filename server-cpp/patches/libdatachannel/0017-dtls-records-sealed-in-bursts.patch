+void DtlsTransport::setupSealer() {
+	// Called with mSslMutex held.
+	if (!currentRecordSealer() || SSL_version(mSsl) != DTLS1_2_VERSION)
+		return;
+	const SSL_CIPHER *cipher = SSL_get_current_cipher(mSsl);
+	// TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 and TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
+	uint32_t id = cipher ? (SSL_CIPHER_get_id(cipher) & 0xFFFF) : 0;
+	if (id != 0xC02B && id != 0xC02F)
+		return;
+
+	// RFC 5246 6.3: key_block = PRF(master_secret, "key expansion", server_random + client_random), for this suite
+	// client_write_key[16], server_write_key[16], client_write_IV[4], server_write_IV[4].
+	uint8_t master[SSL_MAX_MASTER_KEY_LENGTH], seed[13 + 64], block[40];
+	size_t masterLength = SSL_SESSION_get_master_key(SSL_get_session(mSsl), master, sizeof(master));
+	std::memcpy(seed, "key expansion", 13);
+	if (masterLength == 0 || SSL_get_server_random(mSsl, seed + 13, 32) != 32 ||
+	    SSL_get_client_random(mSsl, seed + 45, 32) != 32)
+		return;
+	EVP_KDF *kdf = EVP_KDF_fetch(nullptr, "TLS1-PRF", nullptr);
+	EVP_KDF_CTX *kctx = kdf ? EVP_KDF_CTX_new(kdf) : nullptr;
+	char digest[] = "SHA256";
+	OSSL_PARAM params[] = {
+	    OSSL_PARAM_construct_utf8_string(OSSL_KDF_PARAM_DIGEST, digest, 0),
+	    OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_SECRET, master, masterLength),
+	    OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_SEED, seed, sizeof(seed)),
+	    OSSL_PARAM_construct_end()};
+	bool ok = kctx && EVP_KDF_derive(kctx, block, sizeof(block), params) == 1;
+	EVP_KDF_CTX_free(kctx);
+	EVP_KDF_free(kdf);
+	OPENSSL_cleanse(master, sizeof(master));
+	if (!ok)
+		return;
+
+	bool server = SSL_is_server(mSsl) == 1;
+	std::lock_guard lock(mSealMutex);
+	std::memcpy(mSealKey, block + (server ? 16 : 0), 16);
+	std::memcpy(mSealSalt, block + 32 + (server ? 4 : 0), 4);
+	OPENSSL_cleanse(block, sizeof(block));
+	mSealState = SealState::Proving;
+	PLOG_DEBUG << "DTLS records: keys derived, waiting for proof";
+}
+
+bool DtlsTransport::watchOutgoing(const byte *data, size_t size) {
+	// Called with mSslMutex held, for every datagram OpenSSL writes.
+	std::lock_guard lock(mSealMutex);
+	if (mSealState == SealState::Active) {
+		// A record of OpenSSL's in the epoch the transport numbers now (its close_notify) would repeat a sequence
+		// number: it is not sent. Records of another epoch go out.
+		return size >= RecordHeader && uint16_t((uint8_t(data[3]) << 8) | uint8_t(data[4])) == mSealEpoch;
+	}
+	if (mSealState != SealState::Proving && mSealState != SealState::Proven)
+		return false;
+	auto p = reinterpret_cast<const uint8_t *>(data);
+	for (size_t offset = 0; offset + RecordHeader <= size;) {
+		const uint8_t *r = p + offset;
+		size_t length = (size_t(r[11]) << 8) | r[12];
+		if (offset + RecordHeader + length > size)
+			break;
+		uint16_t epoch = uint16_t((r[3] << 8) | r[4]);
+		uint64_t seq = loadBe48(r + 5);
+		if (r[0] == 23 && !mSealEpochKnown) { // the first application record fixes the epoch
+			mSealEpoch = epoch;
+			mSealEpochKnown = true;
+		}
+		if (mSealEpochKnown && epoch == mSealEpoch) {
+			mSealLastSeq = std::max(mSealLastSeq, seq);
+			if (mSealState == SealState::Proving && r[0] == 23 && length > ExplicitNonce + GcmTag) {
+				// The proof: this record opens with the derived key.
+				size_t plain = length - ExplicitNonce - GcmTag;
+				std::vector<uint8_t> copy(r + RecordHeader + ExplicitNonce, r + RecordHeader + length);
+				uint8_t nonce[12], aad[13], tag[GcmTag];
+				std::memcpy(nonce, mSealSalt, 4);
+				std::memcpy(nonce + 4, r + RecordHeader, ExplicitNonce);
+				std::memcpy(aad, r + 3, 8);
+				aad[8] = r[0];
+				aad[9] = r[1];
+				aad[10] = r[2];
+				aad[11] = uint8_t(plain >> 8);
+				aad[12] = uint8_t(plain);
+				std::memcpy(tag, copy.data() + plain, GcmTag);
+				if (gcm128(false, mSealKey, nonce, aad, sizeof(aad), copy.data(), plain, tag)) {
+					mSealState = SealState::Proven;
+					PLOG_DEBUG << "DTLS records: keys proven";
+				} else {
+					mSealState = SealState::Off;
+					PLOG_WARNING << "DTLS records: derived keys do not open OpenSSL's record, left to OpenSSL";
+				}
+			}
+		}
+		offset += RecordHeader + length;
+	}
+	return false;
+}
+
+bool DtlsTransport::sealTakeover() {
+	// Called with mSslMutex held.
+	std::lock_guard lock(mSealMutex);
+	if (mSealState == SealState::Proven && mPeerApplicationData && mSealEpochKnown) {
+		mSealNextSeq = mSealLastSeq + 1;
+		mSealState = SealState::Active;
+		PLOG_DEBUG << "DTLS records: sealed here from sequence number " << mSealNextSeq;
+	}
+	return mSealState == SealState::Active;
+}
+
+bool DtlsTransport::sendSealed(const message_ptr &message) {
+	if (message->size() > 16384)
+		return false; // larger than a DTLS record; SCTP never sends one
+	std::unique_lock lock(mSealMutex);
+
+	// The record, its sequence number and seal still to come: type, version, epoch, length; the plaintext after the
+	// explicit nonce, room for the tag.
+	auto record = spareMessage(RecordHeader + ExplicitNonce + message->size() + GcmTag);
+	auto r = reinterpret_cast<uint8_t *>(record->data());
+	size_t length = ExplicitNonce + message->size() + GcmTag;
+	r[0] = 23;
+	r[1] = 0xFE;
+	r[2] = 0xFD;
+	r[3] = uint8_t(mSealEpoch >> 8);
+	r[4] = uint8_t(mSealEpoch);
+	r[11] = uint8_t(length >> 8);
+	r[12] = uint8_t(length);
+	std::memcpy(r + RecordHeader + ExplicitNonce, message->data(), message->size());
+	record->dscp = message->dscp;
+	record->stream = UnsealedRecord;
+	lock.unlock();
+
+	if (collectBurst(record)) // sealed and sent with its burst
+		return true;
+	message_vector one{std::move(record)};
+	return flushBurstMessages(one);
+}
+
+void DtlsTransport::sealRecords(message_vector &messages) {
+	// Called with mSealMutex held: numbers the unsealed records in their order and seals them together.
+	auto &records = mSealRecords;
+	records.clear();
+	for (auto &m : messages) {
+		if (!m || m->stream != UnsealedRecord)
+			continue;
+		auto r = reinterpret_cast<uint8_t *>(m->data());
+		size_t plain = m->size() - RecordHeader - ExplicitNonce - GcmTag;
+		uint64_t seq = mSealNextSeq++;
+		storeBe48(r + 5, seq);
+		std::memcpy(r + RecordHeader, r + 3, 8); // explicit nonce: epoch and sequence number
+		DtlsSealRecord s;
+		std::memcpy(s.nonce, mSealSalt, 4);
+		std::memcpy(s.nonce + 4, r + 3, 8);
+		std::memcpy(s.aad, r + 3, 8);
+		s.aad[8] = r[0];
+		s.aad[9] = r[1];
+		s.aad[10] = r[2];
+		s.aad[11] = uint8_t(plain >> 8);
+		s.aad[12] = uint8_t(plain);
+		s.data = r + RecordHeader + ExplicitNonce;
+		s.length = plain;
+		records.push_back(s);
+		m->stream = 0;
+	}
+	if (records.empty())
+		return;
+	auto sealer = currentRecordSealer();
+	size_t sealed = sealer ? std::min(sealer->seal(mSealKey, records.data(), records.size()), records.size()) : 0;
+	for (size_t i = sealed; i < records.size(); i++) {
+		auto &s = records[i];
+		if (!gcm128(true, mSealKey, s.nonce, s.aad, sizeof(s.aad), s.data, s.length, s.data + s.length))
+			throw std::runtime_error("DTLS record sealing failed");
+	}
+}
+
+bool DtlsTransport::flushBurstMessages(message_vector &messages) {
+	std::lock_guard lock(mSealMutex);
+	sealRecords(messages);
+	return outgoingBatch(messages);
+}
