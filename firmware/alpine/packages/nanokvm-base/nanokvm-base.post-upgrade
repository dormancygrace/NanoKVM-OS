#!/bin/sh
set -eu
# Alpine's standard loopback service is needed by local applications.
rc-update add loopback boot
if [ -e /run/openrc/softlevel ] && ! rc-service loopback status >/dev/null 2>&1; then
    rc-service loopback start
fi

tmpfs_entry='tmpfs /tmp tmpfs rw,nosuid,nodev,mode=1777,size=64M 0 0'
if ! grep -qE '^[^#]+[[:space:]]+/tmp[[:space:]]' /etc/fstab 2>/dev/null; then
    printf '%s\n' "$tmpfs_entry" >> /etc/fstab
fi
unset tmpfs_entry

# Move the legacy package greeting to the interactive profile script. Do not
# replace a MOTD that differs from the two texts managed by NanoKVM/Alpine.
if [ ! -s /etc/motd ] || grep -qx 'Welcome to Alpine!' /etc/motd || \
   [ "$(cat /etc/motd)" = 'Welcome to NanoKVM OS!

Manage your device through its web interface.
System and package updates are available through apk.' ]; then
    : > /etc/motd
fi

# Remove only the one-line root profile generated by older NanoKVM app init
# scripts. A custom profile must continue to override the system prompt.
legacy_root_profile='export PS1="\u@\h:\w# "'
if [ -f /root/.profile ] && [ "$(cat /root/.profile)" = "$legacy_root_profile" ]; then
    rm -f /root/.profile
fi
unset legacy_root_profile
