/dts-v1/;
/ {
    // One description for every board: images differ only in the device tree.
    description = "NanoKVM OS";
    #address-cells = <1>;
    images {
        kernel-1 {
            description = "NanoKVM OS Linux";
            data = /incbin/("Image.lz4");
            type = "kernel";
            arch = "riscv";
            os = "linux";
            compression = "lz4";
            load = <0x80200000>;
            entry = <0x80200000>;
            // U-Boot checks this on every boot. sha256 runs at about 14.5 MB/s
            // there, 0.6 s for the kernel and initramfs; crc32 detects the
            // same read errors. The device tree keeps sha256, which
            // compose-fit substitutes per board.
            hash-1 { algo = "crc32"; };
        };
        ramdisk-1 {
            description = "NanoKVM OS initramfs";
            data = /incbin/("initramfs.cpio.zst");
            type = "ramdisk";
            arch = "riscv";
            os = "linux";
            // Linux unpacks the zstd cpio; U-Boot passes these bytes unchanged.
            compression = "none";
            hash-1 { algo = "crc32"; };
        };
        fdt-sg2002_licheervnano_sd_minimal {
            description = "NanoKVM OS SG2002 board";
            data = /incbin/("board.dtb");
            type = "flat_dt";
            arch = "riscv";
            compression = "none";
            hash-1 { algo = "sha256"; };
        };
    };
    configurations {
        default = "config-sg2002_licheervnano_sd_minimal";
        config-sg2002_licheervnano_sd_minimal {
            description = "NanoKVM OS with installed loader selection";
            kernel = "kernel-1";
            ramdisk = "ramdisk-1";
            fdt = "fdt-sg2002_licheervnano_sd_minimal";
        };
    };
};
