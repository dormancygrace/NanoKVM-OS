      "pull_request": {
        "id": "wireless-regdb",
        "mode": "archive-pin"
      }
    },
    {
      "name": "Node (selected LTS)",
      "lock_entry": "node",
      "path": "platform/sources.lock",
      "pattern": "^node\\s+\\S*/node-v([0-9.]+)-linux",
      "kind": "index",
      "url": "https://nodejs.org/dist/index.json",
      "upstream_pattern": "\"version\"\\s*:\\s*\"v([0-9]+\\.[0-9]+\\.[0-9]+)\"",
      "same_major": true,
      "pull_request": {
        "id": "node-selected-lts",
        "mode": "archive-pin"
      }
    },
    {
      "name": "pnpm",
      "lock_entry": "pnpm",
      "path": "platform/sources.lock",
      "pattern": "exe\\.linux-x64-([0-9.]+)\\.tgz",
      "kind": "npm",
      "package": "@pnpm/exe.linux-x64",
      "pull_request": {
        "id": "pnpm",
        "mode": "archive-pin"
      }
    },
    {
      "name": "Alpine minirootfs",
      "lock_entry": "alpine",
      "path": "platform/sources.lock",
      "pattern": "alpine-minirootfs-([0-9.]+)-riscv64",
      "kind": "alpine-rootfs",
      "pull_request": {
        "id": "alpine-minirootfs",
        "mode": "archive-pin"
      }
    },
    {
      "name": "Alpine signing minirootfs",
      "lock_entry": "alpine-signer",
      "path": "platform/sources.lock",
      "pattern": "(?m)^alpine-signer\\s+\\S*/alpine-minirootfs-([0-9.]+)-x86_64",
      "kind": "alpine-rootfs",
      "pull_request": {
        "id": "alpine-signing-minirootfs",
        "mode": "archive-pin"
      },
      "arch": "x86_64"
    },
    {
      "name": "RustDesk protocol reference",
      "path": "addons/rustdesk/upstream.json",
      "pattern": "\"rustdesk_version\":\\s*\"([0-9.]+)\"",
      "kind": "rustdesk-release-reference",
      "repo": "rustdesk/rustdesk",
      "pull_request": {
        "id": "rustdesk-protocol-reference",
        "mode": "review"
      }
    },
    {
      "name": "GCC compiler",
      "path": "platform/build.sh",
      "pattern": "gcc\" -dumpfullversion\\)\" = ([0-9.]+)",
      "kind": "index",
      "url": "https://ftp.gnu.org/gnu/gcc/",
      "upstream_pattern": "href=\"gcc-([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
      "pull_request": {
        "id": "gcc-compiler",
        "mode": "review"
      }
    },
    {
      "name": "OpenSSL 3.5 LTS",
      "lock_entry": "openssl",
      "path": "platform/sources.lock",
      "pattern": "^openssl\\s+\\S*/openssl-([0-9.]+)\\.tar\\.gz",
      "kind": "index",
      "url": "https://openssl-library.org/source/",
      "upstream_pattern": "openssl-(3\\.5\\.[0-9]+)\\.tar\\.gz",
      "pull_request": {
        "id": "openssl-35-lts",
        "mode": "archive-pin"
      }
    },
    {
      "name": "OCR models: PaddleX model list",
      "path": "tpu/models/sources.txt",
      "pattern": "PP-OCRv([0-9]+)_medium_det_infer",
      "kind": "index",
      "url": "https://raw.githubusercontent.com/PaddlePaddle/PaddleX/develop/paddlex/inference/utils/official_models.py",
      "upstream_pattern": "\"PP-OCRv([0-9]+)_",
      "pull_request": {
        "id": "ocr-models-paddlex",
        "mode": "review"
      }
    },
    {
      "name": "OCR models: PaddlePaddle on Hugging Face",
      "path": "tpu/models/sources.txt",
      "pattern": "PP-OCRv([0-9]+)_medium_det_infer",
      "kind": "index",
      "url": "https://huggingface.co/api/models?author=PaddlePaddle&search=PP-OCRv&limit=500",
      "upstream_pattern": "\"PaddlePaddle/PP-OCRv([0-9]+)_",
      "pull_request": {
        "id": "ocr-models-huggingface",
        "mode": "review"
      }
    },
    {
      "name": "OCR converter: tpu-mlir",
      "path": "tpu/models/convert.sh",
      "pattern": "tpu_mlir==([0-9.]+)",
      "kind": "github-tags",
      "repo": "sophgo/tpu-mlir",
      "upstream_pattern": "^v([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$",
      "pull_request": {
        "id": "tpu-mlir",
        "mode": "review"
      }
    },
    {
      "name": "TPU runtime (cviruntime dma-buf port)",
      "path": "platform/sources.lock",
      "pattern": "^tpu-runtime\\s+\\S+\\s+([0-9a-f]{40})",
      "kind": "github-commit",
      "repo": "leafpmpmp/duo-buildroot-sdk-v2",
      "branch": "mainline-tpu",
      "lock_entry": "tpu-runtime",
      "pull_request": {
        "id": "tpu-runtime",
        "mode": "review"
      }
    }
  ]
}
