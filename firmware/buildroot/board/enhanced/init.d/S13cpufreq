#!/bin/sh
# The qualified driver loads without raising frequency. The server applies
# the verified saved preference after startup (850 MHz when absent).
case "${1:-start}" in
  start|restart) modprobe sg2002-cpufreq || echo "SG2002 CPU frequency driver unavailable" >&2 ;;
  stop) ;;
  *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
exit 0
