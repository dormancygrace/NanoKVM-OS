diff --git a/package/util-linux/util-linux-libs/0001-libmount-resolve-flags-header.patch b/package/util-linux/util-linux-libs/0001-libmount-resolve-flags-header.patch
new file mode 100644
index 00000000..41964285
--- /dev/null
+++ b/package/util-linux/util-linux-libs/0001-libmount-resolve-flags-header.patch
@@ -0,0 +1,30 @@
+From: NanoKVM OS maintainers <maintainers@nanokvm.local>
+Subject: [PATCH] libmount: include resolve flags and correct symlink fallback
+
+The idmap hook references RESOLVE_NO_SYMLINKS without including its header.
+Linux UAPI defines this flag as 0x04; 0x02 is RESOLVE_NO_MAGICLINKS. Keep
+the fallback identical to the kernel ABI so restricted mounts reject symlinks.
+
+Upstream: Not submitted
+
+--- a/libmount/src/hook_idmap.c
++++ b/libmount/src/hook_idmap.c
+@@ -22,6 +22,7 @@
+ #include <sys/mount.h>
+ 
+ #include "strutils.h"
++#include "fileutils.h"
+ #include "all-io.h"
+ #include "namespace.h"
+ 
+--- a/include/fileutils.h
++++ b/include/fileutils.h
+@@ -66,7 +66,7 @@
+ 			     mode_t mode, unsigned long long resolve);
+ 
+ #ifndef RESOLVE_NO_SYMLINKS
+-# define RESOLVE_NO_SYMLINKS	0x02
++# define RESOLVE_NO_SYMLINKS	0x04
+ #endif
+ #ifndef RESOLVE_BENEATH
+ # define RESOLVE_BENEATH	0x08
