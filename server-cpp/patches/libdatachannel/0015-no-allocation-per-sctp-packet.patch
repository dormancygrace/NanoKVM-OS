  * Zones from which we allocate.
  */
 sctp_zone_t	zone_mbuf;
+
+/* Freed mbufs are kept for the next ones as well (up to 512): two or three for each packet. */
+static pthread_mutex_t mbuf_cache_mtx = PTHREAD_MUTEX_INITIALIZER;
+static struct mbuf *mbuf_cache[512];
+static int mbuf_cache_len;
+
+static struct mbuf *
+mbuf_get(void)
+{
+	struct mbuf *m = NULL;
+
+	pthread_mutex_lock(&mbuf_cache_mtx);
+	if (mbuf_cache_len > 0)
+		m = mbuf_cache[--mbuf_cache_len];
+	pthread_mutex_unlock(&mbuf_cache_mtx);
+	return m != NULL ? m : SCTP_ZONE_GET(zone_mbuf, struct mbuf);
+}
+
+static void
+mbuf_put(struct mbuf *m)
+{
+	pthread_mutex_lock(&mbuf_cache_mtx);
+	if (mbuf_cache_len < (int)(sizeof(mbuf_cache) / sizeof(mbuf_cache[0]))) {
+		mbuf_cache[mbuf_cache_len++] = m;
+		pthread_mutex_unlock(&mbuf_cache_mtx);
+		return;
+	}
+	pthread_mutex_unlock(&mbuf_cache_mtx);
+	SCTP_ZONE_FREE(zone_mbuf, m);
+}
 sctp_zone_t	zone_clust;
+
+/* Freed clusters are kept for the next ones (up to 256) instead of going back to malloc: a data channel at full rate
+ * takes and frees one for each packet, and musl's allocator unmaps and maps their groups again each time. */
+static pthread_mutex_t clust_cache_mtx = PTHREAD_MUTEX_INITIALIZER;
+static char *clust_cache[256];
+static int clust_cache_len;
+
+static char *
+clust_get(void)
+{
+	char *c = NULL;
+
+	pthread_mutex_lock(&clust_cache_mtx);
+	if (clust_cache_len > 0)
+		c = clust_cache[--clust_cache_len];
+	pthread_mutex_unlock(&clust_cache_mtx);
+	return c != NULL ? c : SCTP_ZONE_GET(zone_clust, char);
+}
+
+static void
+clust_put(char *c)
+{
+	pthread_mutex_lock(&clust_cache_mtx);
+	if (clust_cache_len < (int)(sizeof(clust_cache) / sizeof(clust_cache[0]))) {
+		clust_cache[clust_cache_len++] = c;
+		pthread_mutex_unlock(&clust_cache_mtx);
+		return;
+	}
+	pthread_mutex_unlock(&clust_cache_mtx);
+	SCTP_ZONE_FREE(zone_clust, c);
+}
 sctp_zone_t	zone_ext_refcnt;
 
