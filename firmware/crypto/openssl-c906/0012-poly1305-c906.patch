@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef OSSL_POLY1305_C906_H
+#define OSSL_POLY1305_C906_H
+#include <stddef.h>
+
+/* Whole groups of five blocks per vector call. Shorter runs stay with
+ * Cryptogams: the vector call computes r^2..r^5 each time, and on the C906
+ * it overtakes Cryptogams from about 640 bytes (EVP_MAC, fresh key). */
+#define OSSL_POLY1305_C906_GROUP_BYTES 80
+#define OSSL_POLY1305_C906_MIN_GROUPS 8
+
+void ossl_poly1305_blocks_c906(void *ctx, const unsigned char *inp, size_t len,
+    unsigned int padbit);
+#endif
diff --git a/crypto/poly1305/poly1305_c906.c b/crypto/poly1305/poly1305_c906.c
--- /dev/null
+++ b/crypto/poly1305/poly1305_c906.c
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* NanoKVM OS: the C906 vector Poly1305 (generated by
+ * firmware/cpu/go-crypto-c906/gen_poly1305_vector.py, the same kernel as
+ * NanoKVM's Go runtime and Linux lib/crypto) for runs of whole five-block
+ * groups; Cryptogams poly1305_blocks keeps everything else. h and r are
+ * converted between the Cryptogams context (h0, h1, h2, r0, r1, s1) and
+ * 26-bit limbs around each call. The kernel keeps the vector unit on for every
+ * user thread (kernel patch 0078): no run-time check.
+ */
+#include <stdint.h>
+#include <string.h>
+#include <openssl/crypto.h>
+#include "poly1305_c906.h"
+
+void poly1305_blocks(void *ctx, const unsigned char *inp, size_t len,
+    unsigned int padbit);
+void ossl_poly1305_blocks_c906v(const uint64_t r[5], const unsigned char *inp,
+    size_t groups, uint64_t h[5]);
+
+#define MASK26 ((1ULL << 26) - 1)
+
+void ossl_poly1305_blocks_c906(void *ctx, const unsigned char *inp, size_t len,
+    unsigned int padbit)
+{
+    size_t groups = len / OSSL_POLY1305_C906_GROUP_BYTES;
+
+    if (padbit != 0 && groups >= OSSL_POLY1305_C906_MIN_GROUPS) {
+        uint64_t st[5], r[5], l[5], c;
+
+        memcpy(st, ctx, sizeof(st));    /* the context is double[], 8-aligned */
+        /* Cryptogams leaves h2 unreduced; fold it as poly1305_emit does. */
+        c = (st[2] >> 2) * 5;
+        st[2] &= 3;
+        st[0] += c;
+        c = st[0] < c;
+        st[1] += c;
+        st[2] += st[1] < c;
+        r[0] = st[3] & MASK26;
+        r[1] = (st[3] >> 26) & MASK26;
+        r[2] = ((st[3] >> 52) | (st[4] << 12)) & MASK26;
+        r[3] = (st[4] >> 14) & MASK26;
+        r[4] = st[4] >> 40;
+        l[0] = st[0] & MASK26;
+        l[1] = (st[0] >> 26) & MASK26;
+        l[2] = ((st[0] >> 52) | (st[1] << 12)) & MASK26;
+        l[3] = (st[1] >> 14) & MASK26;
+        l[4] = (st[1] >> 40) | (st[2] << 24);    /* below 5 * 2^24 */
+        ossl_poly1305_blocks_c906v(r, inp, groups, l);
+        /* l[1] may exceed 2^26 slightly: carry, then back to radix 2^64. */
+        l[2] += l[1] >> 26;
+        l[1] &= MASK26;
+        l[3] += l[2] >> 26;
+        l[2] &= MASK26;
+        l[4] += l[3] >> 26;
+        l[3] &= MASK26;
+        st[0] = l[0] | (l[1] << 26) | (l[2] << 52);
+        st[1] = (l[2] >> 12) | (l[3] << 14) | (l[4] << 40);
+        st[2] = l[4] >> 24;
+        memcpy(ctx, st, 3 * sizeof(st[0]));
+        OPENSSL_cleanse(st, sizeof(st));
+        OPENSSL_cleanse(r, sizeof(r));
+        OPENSSL_cleanse(l, sizeof(l));
+        inp += groups * OSSL_POLY1305_C906_GROUP_BYTES;
+        len -= groups * OSSL_POLY1305_C906_GROUP_BYTES;
+    }
+    if (len != 0)
+        poly1305_blocks(ctx, inp, len, padbit);
+}
