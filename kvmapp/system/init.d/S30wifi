#!/bin/sh

. /etc/profile

: "${NANOKVM_WIFI_BOOT_DIR:=/boot}"
: "${NANOKVM_WIFI_ETC_DIR:=/etc/kvm}"
: "${NANOKVM_WIFI_KVM_DIR:=/kvmapp/kvm}"
: "${NANOKVM_WIFI_RUN_DIR:=/run/nanokvm-wifi}"
: "${NANOKVM_WIFI_AP_FLAG:=/tmp/wifiap}"
: "${NANOKVM_WIFI_UID_FILE:=/sys/class/cvi-base/base_uid}"
: "${NANOKVM_WPA_PASSPHRASE:=wpa_passphrase}"
: "${NANOKVM_WPA_SUPPLICANT:=wpa_supplicant}"
: "${NANOKVM_WPA_CLI:=wpa_cli}"
: "${NANOKVM_UDHCPC:=udhcpc}"
: "${NANOKVM_HOSTAPD:=hostapd}"
: "${NANOKVM_UDHCPD:=udhcpd}"
: "${NANOKVM_IFCONFIG:=ifconfig}"
: "${NANOKVM_IP:=ip}"
: "${NANOKVM_IPV6_INIT:=/etc/init.d/S02ipv6}"
: "${NANOKVM_KILLALL:=killall}"
: "${NANOKVM_PIDOF:=pidof}"
: "${NANOKVM_WPA_CTRL_DIR:=/var/run/wpa_supplicant}"
: "${NANOKVM_HOSTAPD_CTRL_DIR:=/var/run/hostapd}"
: "${NANOKVM_CHOWN:=chown}"
: "${NANOKVM_IW:=iw}"
: "${NANOKVM_WIFI_PHY_LINK:=/sys/class/net/wlan0/phy80211}"
: "${NANOKVM_WIFI_NET_DIR:=/sys/class/net/wlan0}"
: "${NANOKVM_WIFI_DRIVER_LOADER:=/usr/libexec/nanokvm/legacy/S25wifimod}"
: "${NANOKVM_WIFI_DRIVER_WAIT:=50}"
: "${NANOKVM_WIFI_DHCP_PID:=/run/udhcpc.wlan0.pid}"
: "${NANOKVM_HOSTNAME_FILE:=/etc/hostname}"
: "${NANOKVM_NFT:=nft}"
: "${NANOKVM_RESOLV_CONF:=/etc/resolv.conf}"
: "${NANOKVM_IPV4_CONF_DIR:=/proc/sys/net/ipv4/conf}"

# Alpine's wpa_passphrase reads the password from its controlling TTY when no
# argument is supplied. Keep the legacy stdin API used by this script when
# the compatibility helper is installed; custom command overrides remain honored.
if [ "$NANOKVM_WPA_PASSPHRASE" = wpa_passphrase ] &&
    [ -x /usr/libexec/nanokvm/wpa-passphrase-compat ]; then
    NANOKVM_WPA_PASSPHRASE=/usr/libexec/nanokvm/wpa-passphrase-compat
fi

WIFI_SSID_FILE=$NANOKVM_WIFI_ETC_DIR/wifi.ssid
WIFI_PASS_FILE=$NANOKVM_WIFI_ETC_DIR/wifi.pass
BOOT_SSID_FILE=$NANOKVM_WIFI_BOOT_DIR/wifi.ssid
BOOT_PASS_FILE=$NANOKVM_WIFI_BOOT_DIR/wifi.pass
WPA_CONFIG=$NANOKVM_WIFI_RUN_DIR/wpa_supplicant.conf
# Every network the device has joined: one directory per network named by the
# hex of its SSID (ssid, pass, security, hidden, auto). The top-level wifi.*
# files are the last chosen network.
SAVED_DIR=$NANOKVM_WIFI_ETC_DIR/wifi.saved
# The network chosen in this boot; joined even when it does not connect
# automatically. /run starts empty, so after a reboot only those that do.
SELECTED_FILE=$NANOKVM_WIFI_RUN_DIR/selected
FALLBACK_BGSCAN=simple:30:-70:120
HOSTAPD_CONFIG=$NANOKVM_WIFI_RUN_DIR/hostapd.conf
# The access point the administrator turns on instead of joining a network
# (the server writes one file per setting). Unlike the setup access point of
# the button, it leaves /tmp/wifiap alone: that flag opens the setup page.
AP_PREFIX=$NANOKVM_WIFI_ETC_DIR/wifi.ap
USER_AP_FLAG=$NANOKVM_WIFI_RUN_DIR/ap-user
# Internet for its clients (wifi.ap.internet): the interfaces whose IPv4
# forwarding it switched on, to switch off again.
AP_FORWARDING=$NANOKVM_WIFI_RUN_DIR/ap-forwarding
AP_NAT_TABLE=nkos_wifi_ap
UDHCPD_CONFIG=$NANOKVM_WIFI_RUN_DIR/udhcpd.conf
UDHCPD_PID=$NANOKVM_WIFI_RUN_DIR/udhcpd.pid
UDHCPD_LEASES=$NANOKVM_WIFI_RUN_DIR/udhcpd.leases
WLAN_DHCP_PID=$NANOKVM_WIFI_DHCP_PID
# wpa_cli runs this script on association events. It keeps the saved network
# (hex of its SSID, the id_str of its blocks) last associated in this start.
WPA_CLI_PID=$NANOKVM_WIFI_RUN_DIR/wpa_cli.pid
ASSOCIATED_FILE=$NANOKVM_WIFI_RUN_DIR/associated

prepare_run_dir() {
    mkdir -p "$NANOKVM_WIFI_RUN_DIR" || return 1
    chmod 700 "$NANOKVM_WIFI_RUN_DIR" || return 1
}

dhcp_hostname() {
    [ -r "$NANOKVM_HOSTNAME_FILE" ] || return 1
    value=$(sed -n '1{s/\r$//;p;}' "$NANOKVM_HOSTNAME_FILE") || return 1
    printf '%s\n' "$value" | awk '
        length($0) < 1 || length($0) > 253 { exit 1 }
        $0 !~ /^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$/ && $0 !~ /^[A-Za-z0-9]$/ { exit 1 }
        {
            count = split($0, labels, ".")
            for (i = 1; i <= count; i++)
                if (length(labels[i]) < 1 || length(labels[i]) > 63 || labels[i] ~ /^-/ || labels[i] ~ /-$/)
                    exit 1
        }
    ' || return 1
    printf '%s\n' "$value"
}

# gen_hostapd_conf SSID PASS [BAND CHANNEL HIDDEN]: the SSID goes as hex, so
# none of its bytes is read as configuration.
gen_hostapd_conf() {
    ssid=$1
    pass=$2
    hp_band=${3:-2.4}
    hp_channel=${4:-1}
    hp_hidden=${5:-0}
    echo "ctrl_interface=/var/run/hostapd"
    echo "ctrl_interface_group=0"
    echo "ssid2=$(hex_of "$ssid")"
    if [ "$hp_band" = 5 ]; then
        echo "hw_mode=a"
    else
        echo "hw_mode=g"
    fi
    echo "channel=${hp_channel}"
    [ "$hp_hidden" != 1 ] || echo "ignore_broadcast_ssid=1"
    echo "beacon_int=100"
    echo "dtim_period=2"
    echo "max_num_sta=255"
    echo "rts_threshold=-1"
    echo "fragm_threshold=-1"
    echo "macaddr_acl=0"
    echo "auth_algs=3"
    echo "wpa=2"
    echo "wpa_passphrase=${pass}"
    # Without CCMP named, hostapd turns 802.11n off.
    echo "wpa_key_mgmt=WPA-PSK"
    echo "rsn_pairwise=CCMP"
    echo "ieee80211n=1"
}

# pick_channel BAND: the channel with the fewest networks in a scan, among
# those without radar detection (the driver chooses none well itself: it
# took channel 14 for 2.4 GHz). On 2.4 GHz neighbours within two channels
# count, as they overlap. Without a scan: 6, or 36.
pick_channel() {
    case "$1" in
        5) candidates="36 40 44 48" ;;
        *) candidates="6 1 11" ;;
    esac
    freqs=$("$NANOKVM_IW" dev wlan0 scan 2>/dev/null | sed -n 's/^[[:space:]]*freq: \([0-9]*\).*/\1/p')
    best=
    best_count=
    for candidate in $candidates; do
        count=$(printf '%s\n' "$freqs" | awk -v c="$candidate" -v b="$1" '
            $1 != "" {
                ch = (b == "5") ? ($1 - 5000) / 5 : ($1 - 2407) / 5
                d = ch - c; if (d < 0) d = -d
                if ((b == "5" && d == 0) || (b != "5" && d <= 2)) n++
            }
            END { print n + 0 }')
        if [ -z "$best_count" ] || [ "$count" -lt "$best_count" ]; then
            best=$candidate
            best_count=$count
        fi
    done
    echo "$best"
}

# gen_udhcpd_conf INTERFACE PREFIX [internet [DNS...]]: with internet, the
# device is the clients' router and hands them the DNS servers given, else
# its own, on short leases so that they follow a change of those.
gen_udhcpd_conf() {
    interface=$1
    ipv4_prefix=$2
    echo "start ${ipv4_prefix}.100"
    echo "end ${ipv4_prefix}.200"
    echo "interface ${interface}"
    echo "pidfile ${UDHCPD_PID}"
    echo "lease_file ${UDHCPD_LEASES}"
    # In /run: fresh enough for the server's list of connected devices.
    echo "auto_time 10"
    echo "option subnet 255.255.255.0"
    if [ "$3" = internet ]; then
        echo "option router ${ipv4_prefix}.1"
        dns=$4
        [ -n "$dns" ] || dns=$(sed -n 's/^nameserver[[:space:]]*\([0-9.]*\)[[:space:]]*$/\1/p' "$NANOKVM_RESOLV_CONF" 2>/dev/null |
            grep -v '^127\.' | head -3 | tr '\n' ' ')
        [ -z "$dns" ] || echo "option dns ${dns% }"
        echo "option lease 3600"
    else
        echo "option lease 864000"
    fi
}

# The access point's subnet goes out masqueraded through any other
# interface. IPv4 forwarding is decided on the receiving interface, so it is
# switched on for wlan0 and the interfaces of the default routes (replies
# come in there), never globally: net.ipv4.ip_forward resets every
# interface's settings.
ap_internet_start() {
    ipv4_prefix=$1
    "$NANOKVM_NFT" -f - <<EOF || return 1
add table inet $AP_NAT_TABLE
delete table inet $AP_NAT_TABLE
table inet $AP_NAT_TABLE {
 comment "NanoKVM Wi-Fi access point internet"
 chain forward { type filter hook forward priority 30000; policy accept;
  iifname "wlan0" meta nfproto ipv6 counter drop
  oifname "wlan0" meta nfproto ipv6 counter drop
  iifname "wlan0" ct state invalid counter drop
  iifname "wlan0" oifname != "wlan0" ip saddr $ipv4_prefix.0/24 tcp flags syn tcp option maxseg size set rt mtu
  iifname "wlan0" oifname != "wlan0" ip saddr $ipv4_prefix.0/24 counter accept
  iifname != "wlan0" oifname "wlan0" ip daddr $ipv4_prefix.0/24 ct state { established, related } counter accept
  iifname "wlan0" counter drop
  oifname "wlan0" counter drop
 }
 chain nat { type nat hook postrouting priority srcnat; policy accept;
  iifname "wlan0" oifname != "wlan0" ip saddr $ipv4_prefix.0/24 counter masquerade
 }
}
EOF
    : > "$AP_FORWARDING"
    # Ethernet also when its lease comes after the access point.
    for dev in wlan0 eth0 $("$NANOKVM_IP" -4 route show default | sed -n 's/.* dev \([^ ]*\).*/\1/p'); do
        forwarding=$NANOKVM_IPV4_CONF_DIR/$dev/forwarding
        if [ "$(cat "$forwarding" 2>/dev/null)" = 0 ] && echo 1 > "$forwarding"; then
            echo "$dev" >> "$AP_FORWARDING"
        fi
    done
}

ap_internet_stop() {
    if "$NANOKVM_NFT" list table inet "$AP_NAT_TABLE" >/dev/null 2>&1; then
        "$NANOKVM_NFT" delete table inet "$AP_NAT_TABLE" || true
    fi
    [ -r "$AP_FORWARDING" ] || return 0
    # USB internet sharing forwards through the same uplinks; leave them on
    # while it runs.
    usb_sharing=
    "$NANOKVM_NFT" list table inet nkos_usb_internet >/dev/null 2>&1 && usb_sharing=1
    while read -r dev; do
        if [ "$dev" = wlan0 ] || [ -z "$usb_sharing" ]; then
            echo 0 > "$NANOKVM_IPV4_CONF_DIR/$dev/forwarding" 2>/dev/null || true
        fi
    done < "$AP_FORWARDING"
    rm -f "$AP_FORWARDING"
}

import_boot_credentials() {
    [ -e "$BOOT_SSID_FILE" ] && [ -e "$BOOT_PASS_FILE" ] || return 0

    echo "Updating WiFi credentials from /boot to /etc/kvm/"
    mkdir -p "$NANOKVM_WIFI_ETC_DIR" || return 1
    rm -f "$WIFI_SSID_FILE" "$WIFI_PASS_FILE"
    mv "$BOOT_SSID_FILE" "$WIFI_SSID_FILE" || return 1
    mv "$BOOT_PASS_FILE" "$WIFI_PASS_FILE" || return 1
    "$NANOKVM_CHOWN" root:root "$WIFI_SSID_FILE" "$WIFI_PASS_FILE" || return 1
    chmod 600 "$WIFI_SSID_FILE" "$WIFI_PASS_FILE" || return 1
    # Boot provisioning uses the original personal/automatic profile.
    rm -f "$NANOKVM_WIFI_ETC_DIR/wifi.security" "$NANOKVM_WIFI_ETC_DIR/wifi.hidden" \
        "$NANOKVM_WIFI_ETC_DIR/wifi.freq_list" "$NANOKVM_WIFI_ETC_DIR/wifi.freq_list_2.4" \
        "$NANOKVM_WIFI_ETC_DIR/wifi.freq_list_5" "$NANOKVM_WIFI_ETC_DIR/wifi.band_preference"
    save_current_network replace
}

hex_of() {
    printf '%s' "$1" | od -An -tx1 | tr -d ' \n'
}

# Store the last chosen network as a saved one that connects automatically:
# once for an installation from a release with one network, and with
# "replace" for credentials provisioned through /boot.
save_current_network() {
    [ -s "$WIFI_SSID_FILE" ] || return 0
    current_ssid=$(cat "$WIFI_SSID_FILE") || return 1
    name=$(hex_of "$current_ssid")
    [ "${1:-}" = replace ] || [ ! -d "$SAVED_DIR/$name" ] || return 0
    # A network without a password that is not open was never usable.
    current_pass=$(cat "$WIFI_PASS_FILE" 2>/dev/null || true)
    current_security=$(cat "$NANOKVM_WIFI_ETC_DIR/wifi.security" 2>/dev/null || true)
    [ -n "$current_security" ] || current_security=personal
    [ -n "$current_pass" ] || [ "$current_security" = open ] || return 0
    mkdir -p "$SAVED_DIR" && chmod 700 "$SAVED_DIR" || return 1
    tmp=$SAVED_DIR/.$name.tmp
    rm -rf "$tmp" && mkdir -m 700 "$tmp" || return 1
    (
        umask 077
        # Values without the line break a file written with an editor ends with.
        printf '%s' "$current_ssid" > "$tmp/ssid" || exit 1
        printf '%s' "$current_pass" > "$tmp/pass" || exit 1
        printf '%s' "$current_security" > "$tmp/security" || exit 1
        hidden=$(cat "$NANOKVM_WIFI_ETC_DIR/wifi.hidden" 2>/dev/null || true)
        [ "$hidden" = true ] || hidden=false
        printf '%s' "$hidden" > "$tmp/hidden" || exit 1
        printf 1 > "$tmp/auto"
    ) || {
        rm -rf "$tmp"
        return 1
    }
    rm -rf "$SAVED_DIR/.$name.old"
    if [ -d "$SAVED_DIR/$name" ]; then
        mv "$SAVED_DIR/$name" "$SAVED_DIR/.$name.old" || return 1
    fi
    mv "$tmp" "$SAVED_DIR/$name" || return 1
    rm -rf "$SAVED_DIR/.$name.old"
}

valid_frequencies() {
    case "$1" in *[!0-9\ ]*) return 1 ;; esac
    return 0
}

# New profiles store the exact frequencies advertised by the adapter. For an
# installation upgrading from a profile without those files, discover them at
# boot so that the missing preference still defaults to 5 GHz. If discovery is
# unavailable, the unrestricted fallback keeps the legacy profile usable.
adapter_frequencies() {
    requested_band=$1
    phy=$(basename "$(readlink -f "$NANOKVM_WIFI_PHY_LINK" 2>/dev/null)")
    [ -n "$phy" ] || return 0
    "$NANOKVM_IW" phy "$phy" info 2>/dev/null | awk -v requested_band="$requested_band" '
        /\*[[:space:]]+[0-9]+(\.0+)?[[:space:]]+MHz/ {
            frequency = $2
            sub(/\.0+$/, "", frequency)
            if ((requested_band == "2.4" && frequency >= 2400 && frequency < 2500) ||
                (requested_band == "5" && frequency >= 4900 && frequency < 5925))
                printf "%s ", frequency
        }
    ' | sed 's/[[:space:]]*$//'
}

band_frequencies() {
    requested_band=$1
    frequency_file="$NANOKVM_WIFI_ETC_DIR/wifi.freq_list_$requested_band"
    if [ -r "$frequency_file" ]; then
        value=$(cat "$frequency_file")
        valid_frequencies "$value" || return 1
        printf '%s\n' "$value"
        return 0
    fi

    # A former single-band profile can still seed its matching preferred band.
    legacy=$(cat "$NANOKVM_WIFI_ETC_DIR/wifi.freq_list" 2>/dev/null || true)
    valid_frequencies "$legacy" || return 1
    for frequency in $legacy; do
        case "$requested_band:$frequency" in
            2.4:24[0-9][0-9]|5:49[0-9][0-9]|5:5[0-8][0-9][0-9])
                printf '%s\n' "$legacy"
                return 0
                ;;
        esac
    done
    adapter_frequencies "$requested_band"
}

emit_network() {
    frequencies=$1
    priority=$2
    background_scan=${3:-}
    echo 'network={'
    # Hex encoding prevents quotes/backslashes in SSIDs becoming config. The
    # same hex, the saved network's name, is the block's id_str: STATUS,
    # GET_NETWORK and association events name the saved network by it without
    # wpa_supplicant's escaped SSID text.
    printf '    ssid=%s\n' "$(hex_of "$ssid")"
    printf '    id_str="%s"\n' "$(hex_of "$ssid")"
    if [ "$security" = open ]; then
        echo '    key_mgmt=NONE'
    else
        if [ "$security" != wpa3 ]; then
            printf '%s\n' "$psk_config" | sed -n '/^[[:space:]]*psk=/p'
        fi
        case "$security" in
            wpa)
                echo '    proto=WPA'
                echo '    key_mgmt=WPA-PSK'
                echo '    ieee80211w=0'
                ;;
            wpa-wpa2|wpa2)
                if [ "$security" = wpa2 ]; then echo '    proto=RSN'; else echo '    proto=WPA RSN'; fi
                echo '    key_mgmt=WPA-PSK'
                echo '    ieee80211w=1'
                ;;
            wpa3)
                echo '    proto=RSN'
                echo '    key_mgmt=SAE'
                echo '    ieee80211w=2'
                echo "    sae_password=$sae_password"
                ;;
            personal|wpa2-wpa3)
                echo '    proto=RSN'
                echo '    key_mgmt=WPA-PSK SAE'
                echo '    ieee80211w=1'
                echo "    sae_password=$sae_password"
                ;;
        esac
    fi
    if [ "$hidden" = true ]; then
        echo '    scan_ssid=1'
    fi
    [ -z "$frequencies" ] || echo "    freq_list=$frequencies"
    [ -z "$background_scan" ] || echo "    bgscan=\"$background_scan\""
    echo "    priority=$priority"
    echo '}'
}

# A saved network that connects automatically, or the one chosen in this boot.
network_wanted() {
    [ "$(cat "$1/auto" 2>/dev/null)" = 1 ] && return 0
    [ "$(cat "$SELECTED_FILE" 2>/dev/null)" = "$(basename "$1")" ]
}

# Read one saved network into the variables emit_network uses. An entry that
# cannot be configured (no SSID, a name that is not its SSID, a password
# wpa_passphrase rejects, unknown security) returns 1 and is skipped.
load_network() {
    entry=$1
    ssid=$(cat "$entry/ssid" 2>/dev/null) || return 1
    [ -n "$ssid" ] && [ "$(hex_of "$ssid")" = "$(basename "$entry")" ] || return 1
    pass=$(cat "$entry/pass" 2>/dev/null || true)
    security=$(cat "$entry/security" 2>/dev/null || true)
    [ -n "$security" ] || security=personal
    hidden=$(cat "$entry/hidden" 2>/dev/null || true)
    case "$security" in
        personal|wpa|wpa-wpa2|wpa2|wpa3|wpa2-wpa3)
            [ -n "$pass" ] || return 1
            # Password stays off argv; discard the plaintext comment.
            psk_config=$(printf '%s\n' "$pass" | "$NANOKVM_WPA_PASSPHRASE" "$ssid") || return 1
            sae_password=$(hex_of "$pass") || return 1
            ;;
        open) ;;
        *) return 1 ;;
    esac
}

write_wpa_config() {
    config_tmp=$WPA_CONFIG.tmp.$$
    current=
    if [ -s "$WIFI_SSID_FILE" ]; then
        current=$SAVED_DIR/$(hex_of "$(cat "$WIFI_SSID_FILE")")
    fi
    preferred_band=$(cat "$NANOKVM_WIFI_ETC_DIR/wifi.band_preference" 2>/dev/null || printf 5)
    case "$preferred_band" in 2.4|5) ;; *) preferred_band=5 ;; esac
    preferred_frequencies=$(band_frequencies "$preferred_band") || return 1

    skipped=0
    umask 077
    {
        echo "ctrl_interface=/var/run/wpa_supplicant"
        # The last chosen network first: wpa_supplicant selects the
        # higher-priority block when both match. The unrestricted
        # lower-priority block preserves a usable fallback on another band
        # (and on a 2.4 GHz-only adapter).
        if [ -n "$current" ] && [ -d "$current" ] && network_wanted "$current"; then
            if load_network "$current"; then
                if [ -n "$preferred_frequencies" ]; then
                    emit_network "$preferred_frequencies" 2
                    # A connected station never reselects by itself, so a
                    # fallback taken while the preferred band was away (a
                    # router restart, one failed SAE exchange) would last until
                    # the next reconnect. Only the fallback scans in the
                    # background: every 30 s below -70 dBm, otherwise every
                    # 120 s. The preferred block never scans.
                    emit_network "" 1 "$FALLBACK_BGSCAN"
                else
                    emit_network "" 1
                fi
            else
                echo "Skipping saved WiFi network $(basename "$current"): it cannot be configured" >&2
                skipped=$((skipped + 1))
            fi
        fi
        # Every other saved network that connects automatically, below it: the
        # device joins a known network wherever it is.
        for entry in "$SAVED_DIR"/*; do
            [ -d "$entry" ] && [ "$entry" != "$current" ] || continue
            network_wanted "$entry" || continue
            if load_network "$entry"; then
                emit_network "" 0
            else
                echo "Skipping saved WiFi network $(basename "$entry"): it cannot be configured" >&2
                skipped=$((skipped + 1))
            fi
        done
    } > "$config_tmp" || {
        rm -f "$config_tmp"
        return 1
    }
    # Nothing that could be configured: fail as with one bad network before.
    if [ "$skipped" -gt 0 ] && ! grep -q '^network={' "$config_tmp"; then
        rm -f "$config_tmp"
        return 1
    fi
    mv "$config_tmp" "$WPA_CONFIG" || return 1
}

# The driver is loaded at boot only while Wi-Fi is on (nanokvm-network):
# turning Wi-Fi on, or the access point for provisioning, loads it here.
# wlan0 appears once the driver has uploaded the chip's firmware (about
# 1.5 s); NANOKVM_WIFI_DRIVER_WAIT counts 0.2 s steps.
load_driver() {
    [ ! -d "$NANOKVM_WIFI_NET_DIR" ] || return 0
    "$NANOKVM_WIFI_DRIVER_LOADER" start || return 1
    waited=0
    while [ ! -d "$NANOKVM_WIFI_NET_DIR" ]; do
        if [ "$waited" -ge "$NANOKVM_WIFI_DRIVER_WAIT" ]; then
            echo "wlan0 did not appear after loading the Wi-Fi driver" >&2
            return 1
        fi
        sleep 0.2
        waited=$((waited + 1))
    done
}

start() {
    if [ -e "$NANOKVM_WIFI_ETC_DIR/wifi.disabled" ]; then
        # Off: the driver is not loaded at boot, and nothing to set down.
        [ -d "$NANOKVM_WIFI_NET_DIR" ] || return 0
    else
        load_driver || return 1
    fi
    if [ -x /etc/init.d/S29qdisc ]; then
        /etc/init.d/S29qdisc wlan0 || echo "Could not apply fq_codel to wlan0" >&2
    fi
    if [ -e "$NANOKVM_WIFI_ETC_DIR/wifi.disabled" ]; then
        echo "wifi mode: sta"
        "$NANOKVM_IP" link set dev wlan0 down || return 1
        return 0
    fi
    # The administrator's access point, instead of joining a network.
    if [ -e "$AP_PREFIX.enabled" ]; then
        ap_start user
        return
    fi
    echo "wifi mode: sta"
    import_boot_credentials || return 1
    "$NANOKVM_IP" link set dev wlan0 up || return 1
    if [ -x "$NANOKVM_IPV6_INIT" ]; then
        "$NANOKVM_IPV6_INIT" interface wlan0 || return 1
    fi

    # Credentials created by older releases were world-readable. Tighten them
    # on every start so upgrading fixes existing installations immediately.
    for credential in "$WIFI_SSID_FILE" "$WIFI_PASS_FILE"; do
        [ -e "$credential" ] || continue
        "$NANOKVM_CHOWN" root:root "$credential" || return 1
        chmod 600 "$credential" || return 1
    done
    save_current_network || echo "Could not store the configured WiFi network as a saved one" >&2
    wanted=
    for entry in "$SAVED_DIR"/*; do
        [ -d "$entry" ] && network_wanted "$entry" && wanted=1 && break
    done
    if [ -z "$wanted" ]; then
        echo "No saved WiFi network connects automatically; leaving wlan0 idle"
        return 0
    fi

    prepare_run_dir || return 1
    write_wpa_config || {
        echo "Could not generate WiFi configuration" >&2
        return 1
    }
    if ! grep -q '^network={' "$WPA_CONFIG"; then
        echo "No saved WiFi network to join; leaving wlan0 idle"
        return 0
    fi

    "$NANOKVM_WPA_SUPPLICANT" -B -i wlan0 -c "$WPA_CONFIG" || return 1
    start_event_handler
    start_dhcp
}

start_dhcp() {
    [ ! -e "$NANOKVM_WIFI_BOOT_DIR/wifi.nodhcp" ] || return 0
    set -- -S -B -O 121 -i wlan0 -t 10 -T 1 -A 5 -b -p "$WLAN_DHCP_PID"
    if value=$(dhcp_hostname); then
        set -- "$@" -x "hostname:$value" -F "$value"
    fi
    "$NANOKVM_UDHCPC" "$@" >/dev/null 2>&1 &
}

# end_process FILE NAME ends the process NAME whose pid FILE holds and waits
# until it has exited: SIGTERM, then SIGKILL after 3 s. udhcpc and wpa_cli
# remove their pid file as they exit, so one still exiting would remove the
# file of the one started after it, which S30wifi then no longer finds.
# Returns 1, keeping FILE, when the process is still there.
end_process() {
    [ -e "$1" ] || return 0
    pid=$(cat "$1" 2>/dev/null || true)
    case "$pid" in
        ''|*[!0-9]*) ;;
        *)
            if [ "$pid" -gt 1 ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "$2" ]; then
                kill "$pid" 2>/dev/null || true
                if ! process_exited "$pid" 30; then
                    echo "$2 $pid did not exit; killing it" >&2
                    kill -9 "$pid" 2>/dev/null || true
                    process_exited "$pid" 10 || {
                        echo "$2 $pid is still running" >&2
                        return 1
                    }
                fi
            fi
            ;;
    esac
    rm -f "$1"
}

# process_exited PID TENTHS: whether PID is gone within TENTHS of a second.
process_exited() {
    tries=0
    while [ -e "/proc/$1" ]; do
        [ "$tries" -lt "$2" ] || return 1
        tries=$((tries + 1))
        sleep 0.1
    done
}

stop_dhcp() {
    end_process "$WLAN_DHCP_PID" udhcpc
}

# With several saved networks wpa_supplicant moves between them by itself
# when one goes out of range. udhcpc does not watch the link: it would keep
# the old network's address, routes and DNS until its lease ran out. wpa_cli
# runs this script on every association; a change of saved network starts
# DHCP again, while moving between bands of the same network does not.
start_event_handler() {
    if ! command -v "$NANOKVM_WPA_CLI" >/dev/null 2>&1; then
        echo "wpa_cli is missing; the address is not renewed when WiFi moves to another network" >&2
        return 0
    fi
    rm -f "$ASSOCIATED_FILE"
    self=$(readlink -f "$0") || self=$0
    "$NANOKVM_WPA_CLI" -B -i wlan0 -p "$NANOKVM_WPA_CTRL_DIR" -P "$WPA_CLI_PID" -a "$self" ||
        echo "Could not start the WiFi event handler" >&2
}

stop_event_handler() {
    end_process "$WPA_CLI_PID" wpa_cli
    ended=$?
    rm -f "$ASSOCIATED_FILE"
    return "$ended"
}

# wpa_cli -a: "<script> wlan0 CONNECTED|DISCONNECTED", the block's id_str in
# WPA_ID_STR. A block without one (written by an older S30wifi) is ignored.
wifi_event() {
    [ "$1" = CONNECTED ] || return 0
    network=${WPA_ID_STR:-}
    case "$network" in ''|*[!0-9a-f]*) return 0 ;; esac
    # Stopped meanwhile: S30wifi stop removes the handler's pid file first.
    [ -e "$WPA_CLI_PID" ] || return 0
    previous=$(cat "$ASSOCIATED_FILE" 2>/dev/null || true)
    (umask 077 && printf '%s' "$network" > "$ASSOCIATED_FILE") || return 1
    [ -n "$previous" ] && [ "$previous" != "$network" ] || return 0
    [ -e "$WLAN_DHCP_PID" ] || return 0
    echo "WiFi moved to another saved network; requesting a new address"
    # Never two clients for one pid file: the old one must be gone first.
    stop_dhcp || {
        echo "The previous DHCP client did not exit; not starting another one" >&2
        return 1
    }
    # Its deconfig removes the previous network's address before DISCOVER.
    start_dhcp
}

# ap_start [user]: the setup access point of the button (ap.ssid and ap.pass
# from kvm_system, /tmp/wifiap), or with "user" the administrator's, from
# the wifi.ap.* settings.
ap_start() {
    mode=${1:-setup}
    if [ -x /etc/init.d/S29qdisc ]; then
        /etc/init.d/S29qdisc wlan0 || echo "Could not apply fq_codel to wlan0" >&2
    fi
    echo "wifi mode: ap ($mode)"
    prepare_run_dir || return 1

    id2=$(printf "%d" "0x$(sha512sum "$NANOKVM_WIFI_UID_FILE" | head -c 2)")
    id3=$(printf "%d" "0x$(sha512sum "$NANOKVM_WIFI_UID_FILE" | head -c 4 | tail -c 2)")
    if [ "$id2" = "$id3" ]; then
        id2=$((id2 + 1))
    fi
    if [ "$id2" -ge 255 ]; then
        id2=253
    fi
    if [ "$id3" -ge 255 ]; then
        id3=254
    fi

    ssid=
    pass=
    ap_band=2.4
    ap_channel=1
    ap_hidden=0
    ap_internet=
    ap_dns=
    ipv4_prefix=10.$id3.$id2
    if [ "$mode" = user ]; then
        ssid=$(cat "$AP_PREFIX.ssid" 2>/dev/null)
        pass=$(cat "$AP_PREFIX.pass" 2>/dev/null)
        [ "$(cat "$AP_PREFIX.band" 2>/dev/null)" != 5 ] || ap_band=5
        ap_channel=$(cat "$AP_PREFIX.channel" 2>/dev/null)
        [ ! -e "$AP_PREFIX.hidden" ] || ap_hidden=1
        # Never for the setup access point.
        [ ! -e "$AP_PREFIX.internet" ] || ap_internet=internet
        # IPv4 addresses, which the server checked.
        ap_dns=$(tr -cd '0-9. ' < "$AP_PREFIX.dns" 2>/dev/null)
        # Three octets of a private network, which the server checked.
        subnet=$(cat "$AP_PREFIX.subnet" 2>/dev/null)
        case "$subnet" in
            ''|*[!0-9.]*) ;;
            *) ipv4_prefix=$subnet ;;
        esac
        if [ -z "$ssid" ] || [ -z "$pass" ]; then
            echo "The access point has no name or password" >&2
            return 1
        fi
        # A client lease of before leaves its source rule (98-nanokvm-wifi-source).
        while "$NANOKVM_IP" -4 rule del pref 1000 2>/dev/null; do :; done
        "$NANOKVM_IP" -4 route flush table 200 2>/dev/null || true
    else
        if [ -e "$NANOKVM_WIFI_KVM_DIR/ap.ssid" ]; then
            ssid=$(cat "$NANOKVM_WIFI_KVM_DIR/ap.ssid")
        fi
        if [ -e "$NANOKVM_WIFI_KVM_DIR/ap.pass" ]; then
            pass=$(cat "$NANOKVM_WIFI_KVM_DIR/ap.pass")
        fi
    fi

    "$NANOKVM_IFCONFIG" wlan0 up || return 1
    case "$ap_channel" in
        ''|0|*[!0-9]*) ap_channel=$(pick_channel "$ap_band") ;;
    esac

    umask 077
    gen_hostapd_conf "$ssid" "$pass" "$ap_band" "$ap_channel" "$ap_hidden" > "$HOSTAPD_CONFIG" || return 1
    gen_udhcpd_conf wlan0 "$ipv4_prefix" "$ap_internet" "$ap_dns" > "$UDHCPD_CONFIG" || return 1

    "$NANOKVM_IP" route del default dev wlan0 2>/dev/null || true
    "$NANOKVM_IP" addr flush dev wlan0 || return 1
    "$NANOKVM_IP" addr add "$ipv4_prefix.1/24" dev wlan0 || return 1
    if [ -x "$NANOKVM_IPV6_INIT" ]; then
        "$NANOKVM_IPV6_INIT" interface wlan0 || return 1
    fi
    "$NANOKVM_HOSTAPD" -B -i wlan0 "$HOSTAPD_CONFIG" || return 1
    "$NANOKVM_UDHCPD" -S "$UDHCPD_CONFIG" || return 1
    if [ -n "$ap_internet" ]; then
        ap_internet_start "$ipv4_prefix" ||
            echo "Could not share the internet with the access point's clients" >&2
    fi

    if [ "$mode" = user ]; then
        touch "$USER_AP_FLAG"
    else
        touch "$NANOKVM_WIFI_AP_FLAG"
    fi
}

# The USB network runs a separate udhcpd. Stop only our AP instance; with
# wait, until it has exited (and written its leases).
stop_ap_udhcpd() {
    [ -r "$UDHCPD_PID" ] || return 0
    ap_pid=$(cat "$UDHCPD_PID")
    case "$ap_pid" in
        ''|*[!0-9]*) return 0 ;;
    esac
    if [ "$ap_pid" -gt 1 ] &&
        [ "$(cat "/proc/$ap_pid/comm" 2>/dev/null)" = udhcpd ] &&
        tr '\000' '\n' < "/proc/$ap_pid/cmdline" 2>/dev/null | grep -Fqx -- "$UDHCPD_CONFIG"; then
        kill "$ap_pid" 2>/dev/null || true
        if [ "$1" = wait ]; then
            tries=0
            while [ -d "/proc/$ap_pid" ] && [ "$tries" -lt 30 ]; do
                tries=$((tries + 1))
                sleep 0.1
            done
        fi
    fi
}

# ap-internet: a change of only internet or DNS servers, applied to the
# running access point without restarting Wi-Fi. Its DHCP server restarts
# with the new router and DNS options; the leases stay.
ap_internet_apply() {
    [ -e "$USER_AP_FLAG" ] || return 0
    ipv4_prefix=$(sed -n 's/^start \(.*\)\.100$/\1/p' "$UDHCPD_CONFIG" 2>/dev/null)
    [ -n "$ipv4_prefix" ] || return 1
    ap_internet=
    [ ! -e "$AP_PREFIX.internet" ] || ap_internet=internet
    ap_dns=$(tr -cd '0-9. ' < "$AP_PREFIX.dns" 2>/dev/null)
    ap_internet_stop
    stop_ap_udhcpd wait
    umask 077
    gen_udhcpd_conf wlan0 "$ipv4_prefix" "$ap_internet" "$ap_dns" > "$UDHCPD_CONFIG" || return 1
    "$NANOKVM_UDHCPD" -S "$UDHCPD_CONFIG" || return 1
    if [ -n "$ap_internet" ]; then
        ap_internet_start "$ipv4_prefix" || return 1
    fi
}

# wpa_supplicant and hostapd deauthenticate through the SDIO driver before
# they exit, which can take a few seconds. One started meanwhile finds the
# control socket in use and fails, and Wi-Fi stays down. Wait for the old
# one, up to 5 s, then kill it, and only then remove its socket.
wait_for_exit() {
    name=$1
    socket=$2
    tries=0
    while "$NANOKVM_PIDOF" "$name" >/dev/null 2>&1; do
        tries=$((tries + 1))
        if [ "$tries" -gt 50 ]; then
            echo "$name did not exit; killing it" >&2
            "$NANOKVM_KILLALL" -9 "$name" 2>/dev/null || true
            sleep 0.2
            break
        fi
        sleep 0.1
    done
    if ! "$NANOKVM_PIDOF" "$name" >/dev/null 2>&1; then
        rm -f "$socket"
    fi
}

stop() {
    if [ -x "$NANOKVM_IPV6_INIT" ]; then
        "$NANOKVM_IPV6_INIT" down wlan0 || return 1
    fi
    ap_internet_stop
    "$NANOKVM_KILLALL" hostapd 2>/dev/null || true
    stop_ap_udhcpd
    # Before wpa_supplicant: its last events must not start DHCP again.
    stop_event_handler || true
    "$NANOKVM_KILLALL" wpa_supplicant 2>/dev/null || true
    wait_for_exit wpa_supplicant "$NANOKVM_WPA_CTRL_DIR/wlan0"
    wait_for_exit hostapd "$NANOKVM_HOSTAPD_CTRL_DIR/wlan0"

    stop_dhcp || true

    rm -f "$UDHCPD_PID" "$UDHCPD_LEASES" "$WPA_CONFIG" \
        "$HOSTAPD_CONFIG" "$UDHCPD_CONFIG" "$NANOKVM_WIFI_AP_FLAG" "$USER_AP_FLAG"

    if [ -e /sys/class/net/wlan0mon ] && command -v airmon-ng >/dev/null 2>&1; then
        airmon-ng stop wlan0mon || true
    fi
}

restart() {
    [ ! -d "$NANOKVM_WIFI_NET_DIR" ] || stop
    start
}

case "${1:-}" in
    start) start ;;
    stop)
        # Without wlan0 (driver not loaded) nothing of Wi-Fi runs.
        [ -d "$NANOKVM_WIFI_NET_DIR" ] || exit 0
        stop
        ;;
    disable)
        [ -d "$NANOKVM_WIFI_NET_DIR" ] || exit 0
        stop
        "$NANOKVM_IP" addr flush dev wlan0 || exit 1
        "$NANOKVM_IP" link set dev wlan0 down
        ;;
    ap)
        load_driver || exit 1
        stop
        ap_start
        ;;
    restart) restart ;;
    ap-internet) ap_internet_apply ;;
    # Run by wpa_cli -a (start_event_handler).
    wlan0) wifi_event "${2:-}" ;;
esac
