pkgname=nanokvm-kernel-sg2002
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="NanoKVM SG2002 kernel and automatic boot activation"
url="https://github.com/sipeed/NanoKVM"
arch="riscv64"
license="GPL-2.0-only"
depends="nanokvm-base>=2.0_beta2-r0 nanokvm-kmod-sg2002=2.0_alpha2-r0"
triggers="$pkgname.trigger=/usr/lib/nanokvm/boot/*:/lib/modules/*"
source="$pkgname-$pkgver.tar.gz"
options="!check"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	# The trigger writes the selected board FIT after APK installs matching modules.
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
