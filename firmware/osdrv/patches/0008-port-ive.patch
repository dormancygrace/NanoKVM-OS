+static long cvi_ive_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+    struct cvi_ive_device *ndev = filp->private_data;
+    long ret;
+    if (mutex_lock_interruptible(&ndev->ioctl_lock)) return -ERESTARTSYS;
+    ret = cvi_ive_dispatch(filp, cmd, arg);
+    mutex_unlock(&ndev->ioctl_lock);
+    return ret;
+}
