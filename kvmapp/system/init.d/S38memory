#!/bin/sh
# Manage only NanoKVM's own swap devices. Settings apply now and at boot.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=/etc/kvm/memory.conf
mkdir -p /run
exec 9>/run/nanokvm-memory.lock
# Recompression (zstd) is gone; a server from before still runs this.
[ "${1:-}" != recompress ] || exit 0
if ! flock -n 9; then
    echo 'Another memory operation is in progress.' >&2; exit 1
fi
ZRAM_ENABLED=0 ZRAM_SIZE=64 SD_ENABLED=0 SD_SIZE=256
# While 2160p capture runs, Linux keeps about 130 MiB: with the shared video
# region of the current boot images, and with the UHD carveout (104 MiB) of
# earlier ones. Default to zram there.
case "$(tr -d '\000' < /proc/device-tree/nanokvm,video-memory-mode 2>/dev/null)" in
    shared|uhd) ZRAM_ENABLED=1 ZRAM_SIZE=auto ;;
esac
active() { awk -v path="$1" 'NR > 1 && $1 == path { found=1 } END { exit !found }' /proc/swaps; }
fail() { echo "$*" >&2; exit 1; }
if [ -f "$CONFIG" ]; then
    while IFS='=' read -r key value; do
        case "$key:$value" in
            ZRAM_ENABLED:0|ZRAM_ENABLED:1) ZRAM_ENABLED=$value ;;
            SD_ENABLED:0|SD_ENABLED:1) SD_ENABLED=$value ;;
            ZRAM_SIZE:32|ZRAM_SIZE:64|ZRAM_SIZE:128|ZRAM_SIZE:162|ZRAM_SIZE:auto) ZRAM_SIZE=$value ;;
            SD_SIZE:128|SD_SIZE:256|SD_SIZE:512) SD_SIZE=$value ;;
        esac
    done < "$CONFIG"
elif active /swapfile; then
    # Retain an already-enabled legacy SD swap until explicitly changed.
    SD_ENABLED=1
    SD_SIZE=$(awk '$1 == "/swapfile" {print int(($3+1023)/1024)}' /proc/swaps)
fi

disable_device() {
    if active "$1"; then
        # Do not start a large swap-in when RAM is already exhausted.
        used=$(awk -v path="$1" '$1 == path {print $4}' /proc/swaps)
        available=$(awk '$1 == "MemAvailable:" {print $2}' /proc/meminfo)
        [ "$used" -le "$available" ] || fail 'Not enough available RAM to disable this swap. Stop memory-heavy applications and retry.'
        swapoff "$1" || fail "Could not disable $1; it has been left enabled."
    fi
}

apply_zram() {
    if [ "$ZRAM_ENABLED" = 0 ]; then
        disable_device /dev/zram0
        if [ -e /sys/block/zram0/reset ]; then echo 1 > /sys/block/zram0/reset; fi
        return
    fi
    modprobe zram num_devices=1 || fail 'ZRAM is unavailable in this kernel.'
    if [ "$ZRAM_SIZE" = auto ]; then
        # Half of the memory Linux keeps while video holds its largest buffer
        # set, in whole MiB: MemTotal outside a CMA region, plus what 2160p
        # capture (104 MiB) leaves of the shared video region.
        target=$(awk '$1 == "MemTotal:" {t = $2} $1 == "CmaTotal:" {c = $2}
            END {if (c > t) c = t; l = t - c; if (c > 106496) l += c - 106496; print int(l / 2048) * 1048576}' /proc/meminfo)
    else
        target=$((ZRAM_SIZE * 1024 * 1024))
    fi
    if active /dev/zram0 && [ "$(cat /sys/block/zram0/disksize)" = "$target" ]; then return; fi
    disable_device /dev/zram0
    echo 1 > /sys/block/zram0/reset
    echo lz4 > /sys/block/zram0/comp_algorithm
    echo "$target" > /sys/block/zram0/disksize
    mkswap /dev/zram0 >/dev/null
    swapon -p 100 /dev/zram0 || fail 'Could not activate ZRAM.'
}

# Reclaim for the swap set up here. With ZRAM alone, a swapped page comes back
# by decompression in RAM, while an evicted file page, the server's own code
# among them, comes back from the SD card at about 22 MB/s: prefer swapping,
# and read one page per fault, since ZRAM has no seek to save. On the stand,
# 130 MiB held under a live stream refaulted 3.5-4.8 times fewer file pages.
# With SD swap the kernel defaults stay: swapping more would wear the card.
VM_SYSCTL=${NANOKVM_VM_SYSCTL:-/proc/sys/vm}
SWAPS=${NANOKVM_PROC_SWAPS:-/proc/swaps}
apply_reclaim() {
    # Foreign swap is deliberately left untouched by this service. Inspect
    # the active set, not memory.conf, before selecting the ZRAM-only policy.
    if awk 'NR > 1 { if ($1 == "/dev/zram0") zram=1; else other=1 }
        END { exit !(zram && !other) }' "$SWAPS" 2>/dev/null; then
        swappiness=100 page_cluster=0
    else
        swappiness=60 page_cluster=3
    fi
    # A policy the kernel refuses must not fail the swap setup itself.
    { echo "$swappiness" > "$VM_SYSCTL/swappiness"; } 2>/dev/null || true
    { echo "$page_cluster" > "$VM_SYSCTL/page-cluster"; } 2>/dev/null || true
    # No extra reclaim after a fragmentation event (the kernel boosts it by
    # default). With video and the TPU taking tens of MiB from the CMA region
    # such events come often, and the boost evicted page cache still in use.
    # On the stand with a live stream, eight text reads with and without:
    # kswapd reclaimed about a fifth less, direct reclaim (which stalls the
    # reader) fell from 500-1500 pages to 0-650, the reads 0.2-0.4 s faster.
    { echo 0 > "$VM_SYSCTL/watermark_boost_factor"; } 2>/dev/null || true
}

apply_sd() {
    [ ! -L /swapfile ] || fail '/swapfile must not be a symbolic link.'
    if [ "$SD_ENABLED" = 0 ]; then
        disable_device /swapfile
        rm -f /swapfile
        return
    fi
    if active /swapfile; then
        current=$(awk '$1 == "/swapfile" {print int(($3+1023)/1024)}' /proc/swaps)
        [ "$current" = "$SD_SIZE" ] && return
    fi
    disable_device /swapfile
    [ ! -e /swapfile ] || [ -f /swapfile ] || fail '/swapfile is not a regular file.'
    rm -f /swapfile
    umask 077
    fallocate -l "${SD_SIZE}M" /swapfile || { rm -f /swapfile; fail 'Could not allocate SD swap. Check free disk space.'; }
    chmod 600 /swapfile
    mkswap /swapfile >/dev/null || { rm -f /swapfile; fail 'Could not format SD swap.'; }
    swapon -p 10 /swapfile || { rm -f /swapfile; fail 'Could not activate SD swap.'; }
}

save_settings() {
    mkdir -p /etc/kvm
    umask 077
    printf 'ZRAM_ENABLED=%s\nZRAM_SIZE=%s\nSD_ENABLED=%s\nSD_SIZE=%s\n' "$ZRAM_ENABLED" "$ZRAM_SIZE" "$SD_ENABLED" "$SD_SIZE" > "$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
    # Replace legacy inittab startup with this service, without touching other swap.
    if grep -q '^si11::sysinit:/sbin/swapon /swapfile$' /etc/inittab; then
        sed '\|^si11::sysinit:/sbin/swapon /swapfile$|d' /etc/inittab > /etc/.inittab.memory.tmp
        chmod 644 /etc/.inittab.memory.tmp
        mv /etc/.inittab.memory.tmp /etc/inittab
    fi
}

case "${1:-}" in
    start) apply_zram; apply_sd; apply_reclaim ;;
    stop) disable_device /swapfile; disable_device /dev/zram0; apply_reclaim ;;
    configure)
        # A fifth argument (recompression, gone) from a server from before.
        [ "$#" = 4 ] || [ "$#" = 5 ] || fail 'Expected: configure zram|sd 0|1 SIZE_MIB'
        case "$2:$3:$4" in
            zram:0:32|zram:0:64|zram:0:128|zram:0:162|zram:0:auto|zram:1:32|zram:1:64|zram:1:128|zram:1:162|zram:1:auto)
                ZRAM_ENABLED=$3 ZRAM_SIZE=$4; apply_zram ;;
            sd:0:128|sd:0:256|sd:0:512|sd:1:128|sd:1:256|sd:1:512)
                SD_ENABLED=$3 SD_SIZE=$4; apply_sd ;;
            *) fail 'Invalid swap type, state or size.' ;;
        esac
        apply_reclaim
        save_settings
        ;;
    *) fail 'Usage: S38memory start|stop|configure zram|sd 0|1 SIZE_MIB' ;;
esac
