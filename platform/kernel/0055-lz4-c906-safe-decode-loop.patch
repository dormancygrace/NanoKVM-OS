+#define FASTLOOP_SAFE_DISTANCE 64
+
+static const unsigned int inc32table[8] = { 0, 1, 2, 1, 0, 4, 4, 4 };
+static const int dec64table[8] = { 0, 0, 0, -1, -4, 1, 2, 3 };
+
+/* Copy in scalar words; the caller reserves up to seven extra bytes. */
+static FORCE_INLINE void LZ4_wildCopy8(void *dstPtr, const void *srcPtr,
+				       void *dstEnd)
+{
+	BYTE *d = (BYTE *)dstPtr;
+	const BYTE *s = (const BYTE *)srcPtr;
+	BYTE *const e = (BYTE *)dstEnd;
+
+	do {
+		LZ4_memcpy(d, s, 8);
+		d += 8;
+		s += 8;
+	} while (d < e);
+}
+
+static FORCE_INLINE void
+LZ4_memcpy_using_offset_base(BYTE *dstPtr,
+			     const BYTE *srcPtr, BYTE *dstEnd, size_t offset)
+{
+	if (offset < 8) {
+		/* Initialize output even for malformed offset-zero sequences. */
+		LZ4_write32(dstPtr, 0);
+		dstPtr[0] = srcPtr[0];
+		dstPtr[1] = srcPtr[1];
+		dstPtr[2] = srcPtr[2];
+		dstPtr[3] = srcPtr[3];
+		srcPtr += inc32table[offset];
+		LZ4_memcpy(dstPtr + 4, srcPtr, 4);
+		srcPtr -= dec64table[offset];
+		dstPtr += 8;
+	} else {
+		LZ4_memcpy(dstPtr, srcPtr, 8);
+		dstPtr += 8;
+		srcPtr += 8;
+	}
+	LZ4_wildCopy8(dstPtr, srcPtr, dstEnd);
+}
+
+/* Keep short repeated patterns in a register, without a stack byte array. */
+static FORCE_INLINE void
+LZ4_memcpy_using_offset(BYTE *dstPtr,
+			const BYTE *srcPtr, BYTE *dstEnd, size_t offset)
+{
+	U64 v;
+
+	switch (offset) {
+	case 1:
+		v = (U64)*srcPtr * 0x0101010101010101ULL;
+		break;
+	case 2:
+		v = (U64)LZ4_read16(srcPtr) * 0x0001000100010001ULL;
+		break;
+	case 4:
+		v = (U64)LZ4_read32(srcPtr) * 0x0000000100000001ULL;
+		break;
+	default:
+		LZ4_memcpy_using_offset_base(dstPtr, srcPtr, dstEnd, offset);
+		return;
+	}
+	LZ4_memcpy(dstPtr, &v, 8);
+	dstPtr += 8;
+	while (dstPtr < dstEnd) {
+		LZ4_memcpy(dstPtr, &v, 8);
+		dstPtr += 8;
+	}
+}
+
+static const size_t rvl_error = (size_t)-1;
+
+/* Bounds-check each length byte; the common single-byte length exits early. */
+static FORCE_INLINE size_t read_variable_length(const BYTE **ip,
+						const BYTE *ilimit, int initial_check)
+{
+	size_t s, length = 0;
+
+	if (initial_check && unlikely(*ip >= ilimit))
+		return rvl_error;
+	s = **ip;
+	(*ip)++;
+	length += s;
+	if (unlikely(*ip > ilimit))
+		return rvl_error;
+	if (likely(s != 255))
+		return length;
+	do {
+		s = **ip;
+		(*ip)++;
+		length += s;
+		if (unlikely(*ip > ilimit))
+			return rvl_error;
+	} while (s == 255);
+	return length;
+}
+
+/*
+ * Full-block decoder adapted from LZ4 1.10.0 for C906.
+ * Keep partial, dictionary and unsafe APIs in the existing generic decoder.
+ * Eight-byte literal and match copies avoid the upstream 32-byte copy cost.
+ */
+static FORCE_INLINE int LZ4_decompress_safe_generic(const char *const src,
+						    char *const dst, int srcSize, int outputSize)
+{
+	if (!src || srcSize < 0 || outputSize < 0)
+		return -1;
+
+	{
+		const BYTE *ip = (const BYTE *)src;
+		const BYTE *const iend = ip + srcSize;
+		BYTE *op = (BYTE *)dst;
+		BYTE *const oend = op + outputSize;
+		BYTE *cpy;
+		const BYTE *const lowPrefix = (const BYTE *)dst;
+		const BYTE *const shortiend = iend - 14 - 2;
+		const BYTE *const shortoend = oend - 14 - 18;
+		const BYTE *match;
+		size_t offset, length;
+		unsigned int token;
+
+		if (unlikely(outputSize == 0))
+			return ((srcSize == 1) && (*ip == 0)) ? 0 : -1;
+		if (unlikely(srcSize == 0))
+			return -1;
+		if (oend - op < FASTLOOP_SAFE_DISTANCE)
+			goto safe_decode;
+
+		/* Each iteration starts with at least 64 output bytes available. */
+		while (1) {
+			token = *ip++;
+			length = token >> ML_BITS;
+			if (length == RUN_MASK) {
+				size_t const addl = read_variable_length(&ip,
+							     iend - RUN_MASK, 1);
+
+				if (addl == rvl_error)
+					goto _output_error;
+				length += addl;
+				if (unlikely((uptrval)op + length < (uptrval)op))
+					goto _output_error;
+				if (unlikely((uptrval)ip + length < (uptrval)ip))
+					goto _output_error;
+				if (op + length > oend - 32 || ip + length > iend - 32)
+					goto safe_literal_copy;
+				LZ4_wildCopy8(op, ip, op + length);
+				ip += length;
+				op += length;
+			} else if (ip <= iend - 17) {
+				/* At most 14 literals, plus offset and the next token. */
+				LZ4_memcpy(op, ip, 16);
+				ip += length;
+				op += length;
+			} else {
+				goto safe_literal_copy;
+			}
+
+			offset = LZ4_readLE16(ip);
+			ip += 2;
+			match = op - offset;
+			length = token & ML_MASK;
+			if (length == ML_MASK) {
+				size_t const addl = read_variable_length(&ip,
+							     iend - LASTLITERALS + 1, 0);
+
+				if (addl == rvl_error)
+					goto _output_error;
+				length += addl;
+				length += MINMATCH;
+				if (unlikely((uptrval)op + length < (uptrval)op))
+					goto _output_error;
+				if (op + length >= oend - FASTLOOP_SAFE_DISTANCE)
+					goto safe_match_copy;
+			} else {
+				length += MINMATCH;
+				if (op + length >= oend - FASTLOOP_SAFE_DISTANCE)
+					goto safe_match_copy;
+				if (match >= lowPrefix) {
+					if (offset >= 8) {
+						LZ4_memcpy(op, match, 8);
+						LZ4_memcpy(op + 8, match + 8, 8);
+						LZ4_memcpy(op + 16, match + 16, 2);
+						op += length;
+						continue;
+					}
+				}
+			}
+			if (unlikely(match < lowPrefix))
+				goto _output_error;
+			cpy = op + length;
+			if (unlikely(offset < 16))
+				LZ4_memcpy_using_offset(op, match, cpy, offset);
+			else
+				LZ4_wildCopy8(op, match, cpy);
+			op = cpy;
+		}
+
+safe_decode:
+		/* Bounded tail loop, including the short literal/match shortcut. */
+		while (1) {
+			token = *ip++;
+			length = token >> ML_BITS;
+			if (length != RUN_MASK &&
+			    likely((ip < shortiend) & (op <= shortoend))) {
+				LZ4_memcpy(op, ip, 16);
+				op += length;
+				ip += length;
+				length = token & ML_MASK;
+				offset = LZ4_readLE16(ip);
+				ip += 2;
+				match = op - offset;
+				if (length != ML_MASK && offset >= 8 && match >= lowPrefix) {
+					LZ4_memcpy(op, match, 8);
+					LZ4_memcpy(op + 8, match + 8, 8);
+					LZ4_memcpy(op + 16, match + 16, 2);
+					op += length + MINMATCH;
+					continue;
+				}
+				goto _copy_match;
+			}
+			if (length == RUN_MASK) {
+				size_t const addl = read_variable_length(&ip,
+							     iend - RUN_MASK, 1);
+
+				if (addl == rvl_error)
+					goto _output_error;
+				length += addl;
+				if (unlikely((uptrval)op + length < (uptrval)op))
+					goto _output_error;
+				if (unlikely((uptrval)ip + length < (uptrval)ip))
+					goto _output_error;
+			}
+safe_literal_copy:
+			cpy = op + length;
+			if (cpy > oend - MFLIMIT || ip + length > iend - (2 + 1 + LASTLITERALS)) {
+				/* The last sequence must consume exactly the remaining input. */
+				if (ip + length != iend || cpy > oend)
+					goto _output_error;
+				/* Preserve overlap support for in-place decoding. */
+				LZ4_memmove(op, ip, length);
+				ip += length;
+				op += length;
+				break;
+			}
+			LZ4_wildCopy8(op, ip, cpy);
+			ip += length;
+			op = cpy;
+			offset = LZ4_readLE16(ip);
+			ip += 2;
+			match = op - offset;
+			length = token & ML_MASK;
+_copy_match:
+			if (length == ML_MASK) {
+				size_t const addl = read_variable_length(&ip,
+							     iend - LASTLITERALS + 1, 0);
+
+				if (addl == rvl_error)
+					goto _output_error;
+				length += addl;
+				if (unlikely((uptrval)op + length < (uptrval)op))
+					goto _output_error;
+			}
+			length += MINMATCH;
+safe_match_copy:
+			if (unlikely(match < lowPrefix))
+				goto _output_error;
+			cpy = op + length;
+			if (unlikely(offset < 8)) {
+				LZ4_write32(op, 0);
+				op[0] = match[0];
+				op[1] = match[1];
+				op[2] = match[2];
+				op[3] = match[3];
+				match += inc32table[offset];
+				LZ4_memcpy(op + 4, match, 4);
+				match -= dec64table[offset];
+			} else {
+				LZ4_memcpy(op, match, 8);
+				match += 8;
+			}
+			op += 8;
+			if (unlikely(cpy > oend - MATCH_SAFEGUARD_DISTANCE)) {
+				BYTE *const oCopyLimit = oend - (WILDCOPYLENGTH - 1);
+
+				if (cpy > oend - LASTLITERALS)
+					goto _output_error;
+				if (op < oCopyLimit) {
+					LZ4_wildCopy8(op, match, oCopyLimit);
+					match += oCopyLimit - op;
+					op = oCopyLimit;
+				}
+				while (op < cpy)
+					*op++ = *match++;
+			} else {
+				LZ4_memcpy(op, match, 8);
+				if (length > 16)
+					LZ4_wildCopy8(op + 8, match + 8, cpy);
+			}
+			op = cpy;
+		}
+		return (int)((char *)op - dst);
+_output_error:
+		return (int)(-((const char *)ip - src)) - 1;
+	}
+}
