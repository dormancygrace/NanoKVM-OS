#!/sbin/openrc-run

description="NanoKVM boot, data and compatibility mounts"

depend() {
    need localmount
    before nanokvm-modules
}

# The device /etc/fstab mounts at a mount point.
fstab_device() {
    awk -v point="$1" '$1 !~ /^#/ && $2 == point { print $1; exit }' /etc/fstab
}

# /boot, left dirty by a power loss, is checked before it is mounted: it is
# small. /data is mounted at once, because a check takes up to a minute with
# many small files; it is checked at the next shutdown, once it is free.
data_check=/run/nanokvm/check-data

check_boot() {
    local dev
    dev=$(fstab_device /boot)
    [ -n "$dev" ] || return 0
    /usr/libexec/nanokvm/check-volume "$dev" ||
        ewarn "/boot has errors the check could not repair"
}

note_dirty_data() {
    local dev
    dev=$(fstab_device /data)
    [ -n "$dev" ] && /usr/libexec/nanokvm/check-volume --dirty "$dev" || return 0
    mkdir -p "${data_check%/*}" && printf '%s\n' "$dev" > "$data_check"
    ewarn "/data was not unmounted cleanly; it is checked at the next shutdown"
}

# Apply to the mounted filesystems, including older installations whose fstab
# predates this policy. Do not remount the read-only unavailable-data tmpfs.
# noatime includes directory access times. Keep discard and barriers unchanged.
apply_mount_policy() {
    awk '
        $2 == "/" && $3 == "f2fs" {
            opts = "," $4 ","
            if (opts !~ /,noatime,/ || opts !~ /,background_gc=off,/)
                print $2, "noatime,background_gc=off"
        }
        ($2 == "/boot" && $3 == "vfat") || ($2 == "/data" && $3 == "exfat") {
            if ("," $4 "," !~ /,noatime,/) print $2, "noatime"
        }
    ' /proc/mounts | while read -r point options; do
        mount -o "remount,$options" "$point" || ewarn "Cannot apply storage mount policy to $point"
    done
}

start() {
    ebegin "Preparing NanoKVM storage"
    mkdir -p /boot /data /mnt /sys/kernel/config
    # First: the board identity lives on /boot, the USB flags an older release
    # left there move from it (nanokvm-usb), and the data
    # steps below may give up.
    mountpoint -q /boot || { check_boot; mount /boot; }
    # A previous failed start may have installed the read-only placeholder.
    if grep -q '^nanokvm-data-unavailable /data tmpfs ' /proc/mounts; then
        umount /data || { eend 1 "Cannot release unavailable data placeholder"; return 1; }
    fi
    # Keep booting on failure, but do not expose data still due for formatting.
    data_ready=0
    if /usr/libexec/nanokvm/firstboot-storage; then
        if mountpoint -q /data || { note_dirty_data; mount /data; }; then
            data_ready=1
        fi
    else
        ewarn "SD data partition not ready; retrying at the next boot"
    fi
    # Only a completed stock migration puts this marker in the new root.
    # Remove its bounded transport files, including after power loss just
    # after the MBR commit; never remove arbitrary contents of /data.
    if [ "$data_ready" = 1 ] && [ -f /etc/nanokvm-stock-migration ]; then
        migration=/data/.nanokvm-stock-install
        if [ ! -L "$migration" ]; then
            for file in boot.img.gz alpine-rootfs.tar.gz recovery.sd mbr.old stock-boot.sd \
                        root.shadow ssh-state settings.tar transaction.sha256 status formatting; do
                rm -f "$migration/$file" || break
            done
            if [ ! -e "$migration" ] || rmdir "$migration"; then
                rm -f /etc/nanokvm-stock-migration
            else
                ewarn "Stock migration staging cleanup needs attention"
            fi
        fi
    fi
    compatibility_data=/data
    if [ "$data_ready" = 0 ]; then
        # The web upload probe checks writability. An ordinary /data directory
        # would expose the small root filesystem as usable image storage.
        mount -t tmpfs -o ro,nosuid,nodev,noexec,size=4k,mode=0555 nanokvm-data-unavailable /data || {
            eend 1 "Cannot protect unavailable data storage"
            return 1
        }
        # Board initialization and capture still need writable sensor defaults.
        # Keep these small runtime files separate from unavailable image storage.
        compatibility_data=/run/nanokvm/board-data
        mkdir -p "$compatibility_data" || { eend 1; return 1; }
    fi
    mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
    # f2fs background GC compacts the root partition whenever the device is
    # idle, and wrote the SD card by megabytes per minute on an idle stand.
    # Foreground GC still reclaims space when free sections run low. Root is
    # mounted from the kernel command line, and OpenRC's root service is
    # not enabled, so an /etc/fstab entry would not apply.
    apply_mount_policy

    # APK index cache in RAM: every index refresh rewrote about 4.5 MB of the
    # SD card. apk fetches missing indexes again on first use after a boot.
    if ! mountpoint -q /var/cache/apk; then
        mkdir -p /var/cache/apk
        # Once: the copies that earlier releases kept on the SD card.
        rm -f /var/cache/apk/APKINDEX.*.tar.gz
        mount -t tmpfs -o nosuid,nodev,noexec,size=16m,mode=0755 apk-cache /var/cache/apk ||
            ewarn "APK indexes stay on the SD card"
    fi

    rm -rf /mnt/data
    ln -s "$compatibility_data" /mnt/data
    for source in /usr/share/nanokvm/board-defaults/*; do
        [ -f "$source" ] || continue
        [ -e "$compatibility_data/${source##*/}" ] ||
            cp "$source" "$compatibility_data/${source##*/}" || { eend 1; return 1; }
    done
    mkdir -p /mnt/system
    rm -rf /mnt/system/ko
    ln -s "/lib/modules/$(uname -r)/extra" /mnt/system/ko
    eend $?
}

# At shutdown the services using /data have stopped (they depend on this one):
# release it and check it when the boot found it dirty.
# The kernel sets the clock from the RTC at boot and writes it back only every
# 11 minutes, and the RTC drifts in between: keep the time of a synchronised
# clock for the next boot. An unsynchronised clock is left alone.
save_rtc() {
    local status
    [ -e /dev/rtc0 ] || return 0
    status=$(adjtimex 2>/dev/null | awk '$1 == "status:" { print $2 }')
    [ -n "$status" ] && [ $((status & 64)) -eq 0 ] || return 0
    hwclock -w -u 2>/dev/null || ewarn "Could not save the time to the RTC"
}

stop() {
    local dev
    yesno "$RC_GOINGDOWN" || return 0
    save_rtc
    [ -s "$data_check" ] || return 0
    dev=$(cat "$data_check")
    ebegin "Checking $dev, left dirty by a power loss"
    if mountpoint -q /data && ! umount /data; then
        eend 0 "/data is busy; checked at a later shutdown"
        return 0
    fi
    /usr/libexec/nanokvm/check-volume "$dev" && rm -f "$data_check"
    eend 0
}
