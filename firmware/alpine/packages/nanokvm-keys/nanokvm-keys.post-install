#!/bin/sh
# Points the NanoKVM repository line at GitHub Pages, where NanoKVM OS releases
# are published from 3.3 on, once this package has installed the release keys.
# The two earlier official lines move: the v2 index that devices from before
# nanokvm-keys read (only the RSA key signs it) and the v3 index, both on
# nkos.pesin.pro. Alpine's repositories and any other line, including tagged
# ones, stay as they are; a failure leaves the working line in place. The same
# script runs after an install and after an upgrade.
repositories=/etc/apk/repositories
old_v2=https://nkos.pesin.pro/repos/nanokvm
old_v3=https://nkos.pesin.pro/repos/nanokvm/riscv64/Packages.adb
new=https://dormancygrace.github.io/NanoKVM-OS/alpine/v3.24/riscv64/Packages.adb

[ -f "$repositories" ] || exit 0
# Compare a line without surrounding blanks and a trailing slash.
awk -v a="$old_v2" -v b="$old_v3" '{ sub(/^[ \t]+/, ""); sub(/[ \t]+$/, ""); sub(/\/$/, "") }
	$0 == a || $0 == b { found = 1 } END { exit !found }' "$repositories" || exit 0
tmp=$(mktemp "$repositories.XXXXXX") || exit 0
# The new line once, where the first official line was.
if awk -v a="$old_v2" -v b="$old_v3" -v new="$new" '{ line = $0; sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
	sub(/\/$/, "", line) }
	line == a || line == b || line == new { if (!seen) print new; seen = 1; next }
	{ print }' "$repositories" > "$tmp" &&
	chmod 0644 "$tmp" && mv "$tmp" "$repositories"; then
	echo "NanoKVM repository: now $new" >&2
else
	rm -f "$tmp"
fi
exit 0
