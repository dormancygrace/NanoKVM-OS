From: NanoKVM OS maintainers
Subject: [PATCH] generic: preserve SG2002 C906 draft vector VS handoff

The vendor 0.9 firmware defines MSTATUS_VS as 0x01800000. Ratified
OpenSBI uses 0x600 and resets the C906 draft field to Off. A RAM boot
on SG2002 with the installed 7.2.9 kernel faults at CSR_VLENB in
riscv_v_setup_vsize. Restore the prior VS handoff only for SG2002,
after generic hart initialization, including warm-hart startup.

--- a/platform/generic/thead/thead-generic.c
+++ b/platform/generic/thead/thead-generic.c
@@ -9,6 +9,7 @@
 #include <platform_override.h>
 #include <thead/c9xx_errata.h>
 #include <thead/c9xx_pmu.h>
+#include <sbi/riscv_asm.h>
 #include <sbi/sbi_const.h>
 #include <sbi/sbi_platform.h>
 #include <sbi/sbi_scratch.h>
@@ -17,6 +18,7 @@
 
 struct thead_generic_quirks {
 	u64	errata;
+	bool	sg2002_draft_vs;
 };
 
 static int thead_tlb_flush_early_init(bool cold_boot)
@@ -39,6 +41,26 @@
 	return 0;
 }
 
+/*
+ * SG2002 C906 implements vector 0.7.1 VS in mstatus[24:23], not the
+ * ratified mstatus[10:9] field. Upstream mstatus_init() clears the
+ * vendor field. Restore the vendor 0.9 handoff after hart setup so
+ * existing C906 kernels can read vector CSRs. Keep firmware scalar
+ * and do not change the standard VS definition or other T-Head SoCs.
+ */
+static int sg2002_final_init(bool cold_boot)
+{
+	int rc = generic_final_init(cold_boot);
+
+	if (rc)
+		return rc;
+
+	if (misa_extension('V'))
+		csr_set(CSR_MSTATUS, _UL(0x01800000));
+
+	return 0;
+}
+
 static int thead_generic_platform_init(const void *fdt, int nodeoff,
 				       const struct fdt_match *match)
 {
@@ -48,6 +70,8 @@
 		generic_platform_ops.early_init = thead_tlb_flush_early_init;
 	if (quirks->errata & THEAD_QUIRK_ERRATA_THEAD_PMU)
 		generic_platform_ops.extensions_init = thead_pmu_extensions_init;
+	if (quirks->sg2002_draft_vs)
+		generic_platform_ops.final_init = sg2002_final_init;
 
 	return 0;
 }
@@ -60,12 +84,17 @@
 	.errata = THEAD_QUIRK_ERRATA_THEAD_PMU,
 };
 
+static const struct thead_generic_quirks sg2002_quirks = {
+	.errata = THEAD_QUIRK_ERRATA_THEAD_PMU,
+	.sg2002_draft_vs = true,
+};
+
 static const struct fdt_match thead_generic_match[] = {
 	{ .compatible = "canaan,kendryte-k230", .data = &thead_pmu_quirks },
 	{ .compatible = "sophgo,cv1800b", .data = &thead_pmu_quirks },
 	{ .compatible = "sophgo,cv1812h", .data = &thead_pmu_quirks },
 	{ .compatible = "sophgo,sg2000", .data = &thead_pmu_quirks },
-	{ .compatible = "sophgo,sg2002", .data = &thead_pmu_quirks },
+	{ .compatible = "sophgo,sg2002", .data = &sg2002_quirks },
 	{ .compatible = "sophgo,sg2044", .data = &thead_pmu_quirks },
 	{ .compatible = "thead,th1520", .data = &thead_th1520_quirks },
 	{ },
