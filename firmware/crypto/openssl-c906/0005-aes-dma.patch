+++ b/providers/implementations/ciphers/cipher_aes_hwcrypto.inc
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "crypto/hwcrypto_transport.h"
+#include "cipher_aes_hwcrypto.h"
+static size_t aes_hwcrypto_prefix(PROV_CIPHER_CTX *ctx, unsigned int mode,
+    unsigned char *out, const unsigned char *in, size_t len)
+{
+    PROV_AES_CTX *a = (PROV_AES_CTX *)ctx;
+    size_t minimum = mode == HWCRYPTO_MODE_CTR
+        ? HWCRYPTO_AES_CTR_MIN : HWCRYPTO_AES_BLOCK_MIN;
+    if (len < minimum)
+        return 0;
+    return ossl_hwcrypto_cipher(HWCRYPTO_ALG_AES, mode, ctx->enc,
+        a->plat.hwcrypto.key, ctx->keylen, ctx->iv, 16, in, out, len,
+        minimum, HWCRYPTO_AES_CONTINUE_MIN, HWCRYPTO_AES_RUN_MAX);
+}
+static int cipher_hwcrypto_aes_cbc(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    const unsigned char *in, size_t len)
+{
+    size_t n = aes_hwcrypto_prefix(ctx, HWCRYPTO_MODE_CBC, out, in, len);
+    if (n == OSSL_HWCRYPTO_LOST) return 0;
+    return n == len || ossl_cipher_hw_generic_cbc(ctx, out + n, in + n, len - n);
+}
+static int cipher_hwcrypto_aes_ecb(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    const unsigned char *in, size_t len)
+{
+    size_t n = aes_hwcrypto_prefix(ctx, HWCRYPTO_MODE_ECB, out, in, len);
+    if (n == OSSL_HWCRYPTO_LOST) return 0;
+    return n == len || ossl_cipher_hw_generic_ecb(ctx, out + n, in + n, len - n);
+}
+static int cipher_hwcrypto_aes_ctr(PROV_CIPHER_CTX *ctx, unsigned char *out,
+    const unsigned char *in, size_t len)
+{
+    size_t n;
+    if (len == 0) return 1;
+    if (ctx->num >= 16) return ossl_cipher_hw_generic_ctr(ctx, out, in, len);
+    if (ctx->num != 0) {
+        n = 16 - ctx->num;
+        if (n > len) n = len;
+        if (!ossl_cipher_hw_generic_ctr(ctx, out, in, n)) return 0;
+        out += n; in += n; len -= n;
+    }
+    n = aes_hwcrypto_prefix(ctx, HWCRYPTO_MODE_CTR, out, in, len);
+    if (n == OSSL_HWCRYPTO_LOST) return 0;
+    return n == len || ossl_cipher_hw_generic_ctr(ctx, out + n, in + n, len - n);
+}
+#define cipher_hwcrypto_aes_ofb128 ossl_cipher_hw_generic_ofb128
+#define cipher_hwcrypto_aes_cfb128 ossl_cipher_hw_generic_cfb128
+#define cipher_hwcrypto_aes_cfb1 ossl_cipher_hw_generic_cfb1
+#define cipher_hwcrypto_aes_cfb8 ossl_cipher_hw_generic_cfb8
+#define AES_GENERIC_CIPHER(mode) cipher_hwcrypto_aes_##mode
