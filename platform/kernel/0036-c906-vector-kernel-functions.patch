diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index f7028caae..728073aa7 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -648,6 +648,73 @@ config RISCV_ISA_V_UCOPY_THRESHOLD
 	  Prefer using vectorized copy_to_user()/copy_from_user() when the
 	  workload size exceeds this value.
 
+config RISCV_ISA_XTHEADVECTOR_UCOPY
+	bool "Experimental T-Head vector user copies"
+	depends on 64BIT && RISCV_ISA_V && RISCV_ISA_XTHEADVECTOR && MMU
+	default n
+	help
+	  Enable an explicit legacy RVV 0.7.1 copy_to_user()/copy_from_user()
+	  backend. This does not enable compiler autovectorization. Scalar
+	  copies remain available in contexts where SIMD cannot be used.
+	  Only copies with different word alignment enter the vector backend.
+
+config RISCV_ISA_XTHEADVECTOR_UCOPY_THRESHOLD
+	int "Threshold for legacy T-Head vector user copies"
+	depends on RISCV_ISA_XTHEADVECTOR_UCOPY
+	range 1 2147483647
+	default 16384
+	help
+	  Minimum copy size before entering kernel vector context. Select
+	  this value from complete wrapper timings on the target hardware.
+
+config RISCV_ISA_XTHEADVECTOR_CSUM
+	bool "Experimental T-Head vector checksums"
+	depends on 64BIT && RISCV_ISA_V && RISCV_ISA_XTHEADVECTOR && MMU
+	default n
+	help
+	  Enable an explicit legacy RVV 0.7.1 backend for large Internet
+	  checksums. Smaller buffers and contexts where SIMD cannot be
+	  used retain the scalar implementation. This option does not
+	  enable compiler autovectorization.
+
+config RISCV_ISA_XTHEADVECTOR_CSUM_THRESHOLD
+	int "Threshold for legacy T-Head vector checksums"
+	depends on RISCV_ISA_XTHEADVECTOR_CSUM
+	range 1 2147483647
+	default 8192
+	help
+	  Minimum buffer size before entering kernel vector context.
+	  Include active user vector state when measuring this threshold.
+
+config RISCV_ISA_XTHEADVECTOR_CHACHA
+	bool "Experimental T-Head vector ChaCha library"
+	depends on 64BIT && RISCV_ISA_V && RISCV_ISA_XTHEADVECTOR && MMU
+	depends on CRYPTO_LIB_CHACHA && !KMSAN
+	default n
+	help
+	  Explicit legacy RVV 0.7.1 ChaCha20/12 backend. This covers the
+	  library path used by WireGuard. Short calls and unsuitable SIMD
+	  contexts retain the existing backend. Compiler vectorization is
+	  not enabled. HChaCha and Poly1305 keep their existing backends.
+
+config RISCV_ISA_XTHEADVECTOR_CRC
+	bool "Experimental T-Head vector and slicing-by-8 CRC"
+	depends on 64BIT && RISCV_ISA_V && RISCV_ISA_XTHEADVECTOR && MMU
+	depends on CRC32 && CRC32_ARCH
+	default n
+	help
+	  CRC32 and CRC32C use scalar slicing-by-8 for medium buffers and
+	  legacy vector lanes for large buffers. Early boot, short buffers
+	  and CPUs without T-Head vectors retain their existing backends.
+
+config RISCV_ISA_XTHEADVECTOR_COPY_CSUM
+	bool "Experimental T-Head vector RAM copy and checksum"
+	depends on 64BIT && RISCV_ISA_V && RISCV_ISA_XTHEADVECTOR && MMU
+	default n
+	help
+	  Fuse csum_partial_copy_nocheck() for large kernel RAM buffers.
+	  Faulting userspace copies keep their existing implementations.
+
 config RISCV_ISA_V_PREEMPTIVE
 	bool "Run kernel-mode Vector with kernel preemption"
 	depends on PREEMPTION
