#!/sbin/openrc-run

description="NanoKVM SG2002 media and telemetry modules"

depend() {
    need nanokvm-storage
    before nanokvm-board nanokvm-network nanokvm-app
}

start() {
    ebegin "Loading NanoKVM media modules"
    # No snsr_i2c: the receivers are driven from user space over /dev/i2c.
    # The accelerators (IVE, TPU, DWA, RGN, AXI monitors) are built but
    # load only when something uses them: /etc/modprobe.d/nanokvm-accelerators.conf.
    # One modprobe loads them in this order, the dependencies first; it loads
    # every module it can and fails if any is missing. Each run reads the
    # module indexes again (about 50 ms on the C906).
    # Options of cvi_vc_driver in /etc/modprobe.d/nanokvm-media.conf: udev may
    # load it first.
    modprobe -a cv181x_sys cv181x_base cvi_mipi_rx cv181x_vi \
        cv181x_vpss cv181x_vcodec cv181x_jpeg cvi_vc_driver || return 1
    modprobe -a sg2002-temp sg2002-cpufreq 2>/dev/null || true
    # The server's executable is 24 MB, and the server read it from the SD
    # card page by page as it started: about 2 s of its 3.6 s from start to
    # listening, at 22 MB/s while other services read the card too. Read it
    # now in the background, once the modules are in, so that the server and
    # the hardware daemon start from the page cache.
    # Then, also in the background (modprobe -r takes about 90 ms): the TRNG
    # seeds the kernel's random pool early (modules-load.d, nanokvm-trng.conf)
    # and nothing reads it after. Once the pool is ready (/dev/random no
    # longer blocks), unload it: the driver zeroizes the generator and its
    # clocks stop. modprobe loads it again for /dev/hwrng.
    (
        cat /kvmapp/server/NanoKVM-Server /kvmapp/kvm_system/kvm_system             /kvmapp/server/dl_lib/*.so
        if [ -d /sys/module/cv181x_trng ] && timeout 2 head -c 1 /dev/random; then
            modprobe -r cv181x_trng
        fi
    ) </dev/null >/dev/null 2>&1 &
    eend 0
}
