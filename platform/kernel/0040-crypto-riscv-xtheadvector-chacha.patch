+/*
+ * Five blocks per group: four in vector lanes, one in scalar registers.
+ * Advances state->x[12] by five per group.
+ */
+#define CHACHA_XTHEADVECTOR_GROUP	(5 * CHACHA_BLOCK_SIZE)
+
+/*
+ * Shorter messages stay generic: a group computes five blocks, and entering
+ * kernel-mode vector costs a vector state save.
+ */
+#define CHACHA_XTHEADVECTOR_MIN_BYTES	(2 * CHACHA_BLOCK_SIZE + 1)
+
+asmlinkage void chacha_xtheadvector(struct chacha_state *state, const u8 *in,
+				    u8 *out, size_t ngroups, int nrounds);
+
+static void chacha_crypt_xtheadvector(struct chacha_state *state, u8 *dst,
+				      const u8 *src, unsigned int bytes,
+				      int nrounds)
+{
+	u8 buffer[CHACHA_XTHEADVECTOR_GROUP];
+	unsigned int groups = bytes / CHACHA_XTHEADVECTOR_GROUP;
+	unsigned int tail = bytes % CHACHA_XTHEADVECTOR_GROUP;
+
+	kernel_vector_begin();
+	if (groups) {
+		chacha_xtheadvector(state, src, dst, groups, nrounds);
+		src += groups * CHACHA_XTHEADVECTOR_GROUP;
+		dst += groups * CHACHA_XTHEADVECTOR_GROUP;
+	}
+	if (tail) {
+		/* One more group; the counter advances by the blocks used. */
+		u32 counter = state->x[12];
+
+		memcpy(buffer, src, tail);
+		chacha_xtheadvector(state, buffer, buffer, 1, nrounds);
+		memcpy(dst, buffer, tail);
+		state->x[12] = counter + DIV_ROUND_UP(tail, CHACHA_BLOCK_SIZE);
+		/* The rest of the group is key stream for blocks not yet used. */
+		memzero_explicit(buffer, sizeof(buffer));
+	}
+	kernel_vector_end();
+}
