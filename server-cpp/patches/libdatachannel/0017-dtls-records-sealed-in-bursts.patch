+
+void DtlsTransport::setupSealer() {
+	// Called with mSslMutex held.
+	if (!currentRecordSealer() || SSL_version(mSsl) != DTLS1_2_VERSION)
+		return;
+	const SSL_CIPHER *cipher = SSL_get_current_cipher(mSsl);
+	// TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 and TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
+	uint32_t id = cipher ? (SSL_CIPHER_get_id(cipher) & 0xFFFF) : 0;
+	if (id != 0xC02B && id != 0xC02F)
+		return;
+
+	// RFC 5246 6.3: key_block = PRF(master_secret, "key expansion", server_random + client_random), for this suite
+	// client_write_key[16], server_write_key[16], client_write_IV[4], server_write_IV[4].
+	uint8_t master[SSL_MAX_MASTER_KEY_LENGTH], seed[13 + 64], block[40];
+	size_t masterLength = SSL_SESSION_get_master_key(SSL_get_session(mSsl), master, sizeof(master));
+	std::memcpy(seed, "key expansion", 13);
+	if (masterLength == 0 || SSL_get_server_random(mSsl, seed + 13, 32) != 32 ||
+	    SSL_get_client_random(mSsl, seed + 45, 32) != 32)
+		return;
+	EVP_KDF *kdf = EVP_KDF_fetch(nullptr, "TLS1-PRF", nullptr);
+	EVP_KDF_CTX *kctx = kdf ? EVP_KDF_CTX_new(kdf) : nullptr;
+	char digest[] = "SHA256";
+	OSSL_PARAM params[] = {
+	    OSSL_PARAM_construct_utf8_string(OSSL_KDF_PARAM_DIGEST, digest, 0),
+	    OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_SECRET, master, masterLength),
+	    OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_SEED, seed, sizeof(seed)),
+	    OSSL_PARAM_construct_end()};
+	bool ok = kctx && EVP_KDF_derive(kctx, block, sizeof(block), params) == 1;
+	EVP_KDF_CTX_free(kctx);
+	EVP_KDF_free(kdf);
+	OPENSSL_cleanse(master, sizeof(master));
+	if (!ok)
+		return;
+
+	bool server = SSL_is_server(mSsl) == 1;
+	std::lock_guard lock(mSealMutex);
+	std::memcpy(mSealKey, block + (server ? 16 : 0), 16);
+	std::memcpy(mSealSalt, block + 32 + (server ? 4 : 0), 4);
+	OPENSSL_cleanse(block, sizeof(block));
+	mSealState = SealState::Proving;
+	PLOG_DEBUG << "DTLS records: keys derived, waiting for proof";
+}
+
+bool DtlsTransport::watchOutgoing(const byte *data, size_t size) {
+	// Called with mSslMutex held, for every datagram OpenSSL writes.
+	auto p = reinterpret_cast<const uint8_t *>(data);
+	std::unique_lock lock(mSealMutex);
+	if (mSealState == SealState::Active) {
+		// OpenSSL still numbers its records from where it stopped: a record of its own in the epoch the transport
+		// seals (an alert: its close_notify) repeats a sequence number given here. It is not sent as it is: it is
+		// opened and sealed again as the transport's next record, so the peer still gets an authenticated alert.
+		// Its nonce is from the range left to OpenSSL at the takeover, which no nonce of the transport is in.
+		// Records of another epoch go out as they are.
+		uint16_t sealed = mSealEpoch;
+		uint64_t first = mSealNonceDelta + mSealFirstSeq; // OpenSSL's next nonce at the takeover
+		lock.unlock();
+		bool own = false;
+		for (size_t offset = 0; offset + RecordHeader <= size;) {
+			size_t length = (size_t(p[offset + 11]) << 8) | p[offset + 12];
+			if (offset + RecordHeader + length > size)
+				break;
+			own = own || uint16_t((p[offset + 3] << 8) | p[offset + 4]) == sealed;
+			offset += RecordHeader + length;
+		}
+		if (!own)
+			return false;
+		for (size_t offset = 0; offset + RecordHeader <= size;) {
+			const uint8_t *r = p + offset;
+			size_t length = (size_t(r[11]) << 8) | r[12];
+			if (offset + RecordHeader + length > size)
+				break;
+			try {
+				if (uint16_t((r[3] << 8) | r[4]) == sealed) {
+					// How far OpenSSL's counter has come; outside its range nothing of it is used.
+					uint64_t used = length >= ExplicitNonce ? loadBe64(r + RecordHeader) - first : SealNonceReserve;
+					if (used + SealNonceMargin >= SealNonceReserve)
+						mSealSpent = true;
+					if (used < SealNonceReserve)
+						resealRecord(r, length);
+				} else
+					outgoing(spareMessage(data + offset, RecordHeader + length));
+			} catch (const std::exception &e) { // not through OpenSSL's frames
+				PLOG_WARNING << "DTLS records: " << e.what();
+			}
+			offset += RecordHeader + length;
+		}
+		return true;
+	}
+	if (mSealState != SealState::Proving && mSealState != SealState::Proven)
+		return false;
+	for (size_t offset = 0; offset + RecordHeader <= size;) {
+		const uint8_t *r = p + offset;
+		size_t length = (size_t(r[11]) << 8) | r[12];
+		if (offset + RecordHeader + length > size)
+			break;
+		uint16_t epoch = uint16_t((r[3] << 8) | r[4]);
+		uint64_t seq = loadBe48(r + 5);
+		if (r[0] == 23 && !mSealEpochKnown) { // the first application record fixes the epoch
+			mSealEpoch = epoch;
+			mSealEpochKnown = true;
+		}
+		if (mSealEpochKnown && epoch == mSealEpoch && length >= ExplicitNonce + GcmTag) {
+			mSealLastSeq = std::max(mSealLastSeq, seq);
+			// OpenSSL takes the explicit nonce of a record from a counter that it starts at a random value and
+			// advances by one with every record of the key, as it does the sequence number: their difference is
+			// one number for the whole epoch. The transport goes on with the same counter (sealRecords), so one
+			// rule gives every nonce of the key. A record that does not follow it leaves all records to OpenSSL.
+			uint64_t delta = loadBe64(r + RecordHeader) - seq;
+			if (!mSealNonceKnown) {
+				mSealNonceDelta = delta;
+				mSealNonceKnown = true;
+			} else if (delta != mSealNonceDelta) {
+				mSealState = SealState::Off;
+				PLOG_WARNING << "DTLS records: OpenSSL's nonces do not follow its sequence numbers, left to OpenSSL";
+				return false;
+			}
+			if (mSealState == SealState::Proving && r[0] == 23 && length > ExplicitNonce + GcmTag) {
+				// The proof: this record opens with the derived key.
+				std::vector<uint8_t> plain;
+				if (openRecord(r, length, plain)) {
+					mSealState = SealState::Proven;
+					PLOG_DEBUG << "DTLS records: keys proven";
+				} else {
+					mSealState = SealState::Off;
+					PLOG_WARNING << "DTLS records: derived keys do not open OpenSSL's record, left to OpenSSL";
+				}
+			}
+		}
+		offset += RecordHeader + length;
+	}
+	return false;
+}
+
+bool DtlsTransport::openRecord(const uint8_t *r, size_t length, std::vector<uint8_t> &plain) {
+	// One of this side's own records, with its header: opened with the write key. The key and salt do not change
+	// once they are derived.
+	if (length < ExplicitNonce + GcmTag)
+		return false;
+	size_t size = length - ExplicitNonce - GcmTag;
+	plain.assign(r + RecordHeader + ExplicitNonce, r + RecordHeader + ExplicitNonce + size);
+	uint8_t nonce[12], aad[13], tag[GcmTag];
+	std::memcpy(nonce, mSealSalt, 4);
+	std::memcpy(nonce + 4, r + RecordHeader, ExplicitNonce);
+	std::memcpy(aad, r + 3, 8);
+	aad[8] = r[0];
+	aad[9] = r[1];
+	aad[10] = r[2];
+	aad[11] = uint8_t(size >> 8);
+	aad[12] = uint8_t(size);
+	std::memcpy(tag, r + RecordHeader + ExplicitNonce + size, GcmTag);
+	return gcm128(false, mSealKey, nonce, aad, sizeof(aad), plain.data(), size, tag);
+}
+
+void DtlsTransport::resealRecord(const uint8_t *r, size_t length) {
+	// A record OpenSSL wrote after the takeover, under a nonce of its own range: the same content as the
+	// transport's next record, under the transport's next sequence number and nonce.
+	std::vector<uint8_t> plain;
+	if (!openRecord(r, length, plain)) {
+		PLOG_WARNING << "DTLS records: a record of OpenSSL's after the takeover does not open, dropped";
+		return;
+	}
+	sendSealed(r[0], reinterpret_cast<const byte *>(plain.data()), plain.size(), mCurrentDscp);
+}
+
+bool DtlsTransport::sealTakeover() {
+	// Called with mSslMutex held.
+	std::lock_guard lock(mSealMutex);
+	if (mSealState == SealState::Proven && mPeerApplicationData && mSealEpochKnown && mSealNonceKnown) {
+		mSealFirstSeq = mSealNextSeq = mSealLastSeq + 1;
+		mSealState = SealState::Active;
+		PLOG_DEBUG << "DTLS records: sealed here from sequence number " << mSealNextSeq;
+	}
+	return mSealState == SealState::Active;
+}
+
+bool DtlsTransport::sendSealed(uint8_t type, const byte *data, size_t size, unsigned int dscp) {
+	if (size > 16384)
+		return false; // larger than a DTLS record; SCTP never sends one
+
+	// The record, its sequence number, nonce and seal still to come: type, version, epoch, length; the plaintext
+	// after the explicit nonce, room for the tag. It is numbered and sealed by the thread that sends it, when it
+	// is that record's turn (outgoing, prepareBurst), so the numbers follow the order on the wire.
+	auto record = spareMessage(RecordHeader + ExplicitNonce + size + GcmTag);
+	auto r = reinterpret_cast<uint8_t *>(record->data());
+	size_t length = ExplicitNonce + size + GcmTag;
+	r[0] = type;
+	r[1] = 0xFE;
+	r[2] = 0xFD;
+	r[3] = uint8_t(mSealEpoch >> 8); // fixed before the takeover
+	r[4] = uint8_t(mSealEpoch);
+	r[11] = uint8_t(length >> 8);
+	r[12] = uint8_t(length);
+	std::memcpy(r + RecordHeader + ExplicitNonce, data, size);
+	record->dscp = dscp;
+	record->stream = UnsealedRecord;
+	return outgoing(std::move(record));
+}
+
+void DtlsTransport::sealRecords(message_vector &messages) {
+	// Called with mSealMutex held, by the one thread that sends this transport's records: numbers the unsealed
+	// records in their order and seals them together.
+	auto &records = mSealRecords;
+	records.clear();
+	for (auto &m : messages) {
+		if (!m || m->stream != UnsealedRecord)
+			continue;
+		// A sequence number has 48 bits. The one after the last is never used: the record is not sealed.
+		if (mSealNextSeq > LastSequenceNumber)
+			throw std::runtime_error("DTLS sequence numbers are used up");
+		auto r = reinterpret_cast<uint8_t *>(m->data());
+		size_t plain = m->size() - RecordHeader - ExplicitNonce - GcmTag;
+		uint64_t seq = mSealNextSeq++;
+		storeBe48(r + 5, seq);
+		// OpenSSL's nonce counter, continued past the nonces left to OpenSSL itself.
+		storeBe64(r + RecordHeader, mSealNonceDelta + SealNonceReserve + seq);
+		DtlsSealRecord s;
+		std::memcpy(s.nonce, mSealSalt, 4);
+		std::memcpy(s.nonce + 4, r + RecordHeader, ExplicitNonce);
+		std::memcpy(s.aad, r + 3, 8);
+		s.aad[8] = r[0];
+		s.aad[9] = r[1];
+		s.aad[10] = r[2];
+		s.aad[11] = uint8_t(plain >> 8);
+		s.aad[12] = uint8_t(plain);
+		s.data = r + RecordHeader + ExplicitNonce;
+		s.length = plain;
+		records.push_back(s);
+		m->stream = 0;
+	}
