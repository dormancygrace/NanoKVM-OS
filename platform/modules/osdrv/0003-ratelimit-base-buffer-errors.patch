From 24c73bc539ee1576b75a3e403faae356ef62db5f Mon Sep 17 00:00:00 2001
From: scpcom <scpcom@gmx.de>
Date: Sat, 10 Oct 2026 02:22:56 +0200
Subject: [PATCH] interdrv: base: ratelimitbase_get_chn_buffer trace

---
 interdrv/base/base_context.c |  2 +-
 interdrv/base/base_debug.h   | 16 ++++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/interdrv/base/base_context.c b/interdrv/base/base_context.c
index 250e5f16..bda820c9 100644
--- a/interdrv/base/base_context.c
+++ b/interdrv/base/base_context.c
@@ -259,7 +259,7 @@ CVI_S32 base_get_chn_buffer(MMF_CHN_S chn, VB_BLK *blk, CVI_S32 timeout_ms)
 			vb_release_block(s->blk);
 		TAILQ_REMOVE(&jobs->snap_jobs, s, tailq);
 		mutex_unlock(&jobs->dlock);
-		CVI_TRACE_BASE(CVI_BASE_DBG_ERR, "Mod(%s) Grp(%d) Chn(%d), jobs wait(%d) work(%d) done(%d)\n"
+		CVI_TRACE_BASE_RATELIMITED(CVI_BASE_DBG_ERR, "Mod(%s) Grp(%d) Chn(%d), jobs wait(%d) work(%d) done(%d)\n"
 			, sys_get_modname(chn.enModId), chn.s32DevId, chn.s32ChnId
 			, FIFO_SIZE(&jobs->waitq), FIFO_SIZE(&jobs->workq), FIFO_SIZE(&jobs->doneq));
 	}
diff --git a/interdrv/base/base_debug.h b/interdrv/base/base_debug.h
index 660871eb..162daef0 100644
--- a/interdrv/base/base_debug.h
+++ b/interdrv/base/base_debug.h
@@ -29,5 +29,21 @@ extern u32 base_log_lv;
 		} \
 	} while (0)
 
+#define CVI_TRACE_BASE_RATELIMITED(level, fmt, ...) \
+	do { \
+		if (level <= base_log_lv) { \
+			if (level == CVI_BASE_DBG_ERR) \
+				pr_err_ratelimited("%s:%d(): " fmt, __func__, __LINE__, ##__VA_ARGS__); \
+			else if (level == CVI_BASE_DBG_WARN) \
+				pr_warn_ratelimited("%s:%d(): " fmt, __func__, __LINE__, ##__VA_ARGS__); \
+			else if (level == CVI_BASE_DBG_NOTICE) \
+				pr_notice_ratelimited("%s:%d(): " fmt, __func__, __LINE__, ##__VA_ARGS__); \
+			else if (level == CVI_BASE_DBG_INFO) \
+				pr_info_ratelimited("%s:%d(): " fmt, __func__, __LINE__, ##__VA_ARGS__); \
+			else if (level == CVI_BASE_DBG_DEBUG) \
+				printk(KERN_DEBUG "%s:%d(): " fmt, __func__, __LINE__, ##__VA_ARGS__); \
+		} \
+	} while (0)
+
 #endif /* _BASE_DEBUG_H_ */
 
