From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] venc: a failed core keeps the buffers of its channels

When the reset after a stalled frame fails (patch 0029), the core may
still read or write the buffers of any instance on it. 0029 keeps the VB
pools and refuses new channels on the core, but:

- destroying a channel still closed its instance and freed the buffers
  the encoder allocates itself: the instance's work buffer
  (VPU_EncClose), the bitstream and report buffers, ROI, CTU QP and SEI
  buffers, and source and reconstruction frames outside the common VB;
- CVI_VENC_DestroyChn then released the channel's VB frames (FrmArray)
  and destroyed a private pool;
- a channel opened on that core before it failed could still start an
  instance or send it a frame.

Another user could then be given that memory while the core writes it,
or the core be handed new buffers.

Now cviVEncClose leaves the instance open and every buffer allocated when
the instance's core is marked failed and returns TE_ERR_ENC_CORE_FAILED;
the channel layer gets CVI_ERR_VENC_CORE_FAILED from close, keeps the VB
frames and the private pool, frees the rest of the channel (CPU memory
only) and reports success. Starting an instance and encoding a frame
check the mark under the codec lock, where the reset path sets it, and
fail before the core sees anything: CVI_VENC_StartRecvFrame as on any
start failure, CVI_VENC_SendFrame with CVI_ERR_VENC_CORE_FAILED. What
is kept stays until the system restarts; a channel on a healthy core
works and closes as before.

A channel whose start was refused, or failed, has no instance: only a
successful start sets pTestEnc->coreIdx and takes a reference to the
core, and a failed one releases what it took. Closing such a channel
made VPU calls on core 0, the zero-initialized index, whatever its
codec, down to VPU_DeInit(0) without owning a reference, which could
take the HEVC core from a running channel. cviVEncClose now frees only
the CPU memory of a channel without an instance, and a failed start
clears the handle once it has released its resources.

---
--- a/interdrv/cvi_vc_drv/module/src/cvi_venc.c
+++ b/interdrv/cvi_vc_drv/module/src/cvi_venc.c
@@ -3739,6 +3739,7 @@
 	venc_sbm_context *pSbmHandle = NULL;
 	venc_enc_ctx *pEncCtx = NULL;
 	venc_chn_vars *pChnVars = NULL;
+	CVI_BOOL bKeepFrames;
 	MMF_CHN_S chn = { .enModId = CVI_ID_VENC,
 			  .s32DevId = 0,
 			  .s32ChnId = 0};
@@ -3788,11 +3789,18 @@
 	}
 
 	s32Ret = pEncCtx->base.close(pEncCtx);
+	/* The instance stayed open on a core whose reset failed: the core may
+	 * still use the frames it was given, so their VB blocks are not
+	 * released and a private pool is not destroyed. The rest of the
+	 * channel, CPU memory only, goes as usual. */
+	bKeepFrames = s32Ret == CVI_ERR_VENC_CORE_FAILED;
+	if (bKeepFrames)
+		s32Ret = CVI_SUCCESS;
 
 	SEMA_DESTROY(&pChnVars->sem_send);
 	SEMA_DESTROY(&pChnVars->sem_release);
 
-	if (pChnVars->bHasVbPool == CVI_TRUE &&
+	if (pChnVars->bHasVbPool == CVI_TRUE && !bKeepFrames &&
 		(pChnHandle->pChnAttr->stVencAttr.enType == PT_H264 ||
 		pChnHandle->pChnAttr->stVencAttr.enType == PT_H265)) {
 		CVI_U32 i = 0;
--- a/interdrv/cvi_vc_drv/module/src/enc_ctx.c
+++ b/interdrv/cvi_vc_drv/module/src/enc_ctx.c
@@ -1054,6 +1054,10 @@
 
 	if (pEncCtx->ext.vid.pHandle) {
 		status = cviVEncClose(pEncCtx->ext.vid.pHandle);
+		/* The instance stays on its failed core: CVI_VENC_DestroyChn
+		 * keeps its VB frames and finishes the rest. */
+		if (status == ENC_CORE_FAILED)
+			return CVI_ERR_VENC_CORE_FAILED;
 		if (status < 0) {
 			CVI_VENC_ERR("cviVEncClose, status = %d\n", status);
 			return status;
@@ -1145,6 +1149,8 @@
 
 	if (status == ENC_TIMEOUT)
 		return CVI_ERR_VENC_BUSY;
+	if (status == ENC_CORE_FAILED)
+		return CVI_ERR_VENC_CORE_FAILED;
 
 	return status;
 }
--- a/interdrv/cvi_vc_drv/vcodec/sample/main_enc_cvitest.c
+++ b/interdrv/cvi_vc_drv/vcodec/sample/main_enc_cvitest.c
@@ -2905,6 +2905,8 @@
 	cviCloseVpuEnc(pTestEnc);
 INIT_ERR_ENC_INIT:
 	cviDeInitVpuEnc(pTestEnc);
+	/* Released: the channel's close must not release it again. */
+	pTestEnc->handle = NULL;
 	return NULL;
 }
 
@@ -3029,6 +3031,12 @@
 		}
 	}
 
+	/* A channel opened before its core failed sends it no frame. */
+	if (venc_core_failed[pTestEnc->coreIdx]) {
+		LeaveVcodecLock(pTestEnc->coreIdx);
+		return TE_ERR_ENC_CORE_FAILED;
+	}
+
 	pTestEnc->yuvAddr.addrY = pPicCfg->addrY;
 	pTestEnc->yuvAddr.addrCb = pPicCfg->addrCb;
 	pTestEnc->yuvAddr.addrCr = pPicCfg->addrCr;
@@ -5140,6 +5148,13 @@
 	CVI_VC_IF("\n");
 
 	EnterVcodecLock(core_idx);
+	/* A channel opened before its core failed must not give it an
+	 * instance now; the flag is set under this lock. */
+	if (venc_core_failed[core_idx]) {
+		LeaveVcodecLock(core_idx);
+		vfree(pEncConfig);
+		return TE_ERR_ENC_CORE_FAILED;
+	}
 	memcpy(pEncConfig, &pTestEnc->encConfig, sizeof(TestEncConfig));
 
 	if (cviInitEncoder(pTestEnc, pEncConfig) == NULL) {
@@ -5773,6 +5788,7 @@
 	stTestEncoder *pTestEnc = NULL;
 	UserDataList *userdataNode = NULL;
 	UserDataList *n;
+	bool hasInstance;
 
 	if (handle == NULL)
 		return -1;
@@ -5780,6 +5796,15 @@
 
 	CVI_VC_IF("\n");
 
+	/* An instance exists only after a successful start, which also sets
+	 * pTestEnc->coreIdx and takes a reference to that core; a start that
+	 * failed released what it took and cleared the handle. A channel
+	 * without one (its start refused or failed) owns nothing of the VPU:
+	 * only its CPU memory goes. */
+	hasInstance = pTestEnc->handle != NULL;
+	if (!hasInstance)
+		goto FREE_CHANNEL;
+
 	EnterVcodecLock(pTestEnc->coreIdx);
 
 	ret = cviCheckAndCompareBitstream(pTestEnc);
@@ -5789,6 +5814,21 @@
 		return ret;
 	}
 
+	/* A core whose reset failed may still read or write any buffer of an
+	 * instance on it: the work buffer VPU_EncClose would free, the
+	 * bitstream, report, ROI, QP and SEI buffers, the source and
+	 * reconstruction frames. The instance stays open and every buffer
+	 * allocated, with pTestEnc holding them, until the system restarts;
+	 * TE_ERR_ENC_CORE_FAILED tells the channel layer to keep the VB frames
+	 * it gave the instance too. Nothing frees them later: the core takes
+	 * no new instance. */
+	if (venc_core_failed[pTestEnc->coreIdx]) {
+		CVI_VC_ERR("encoder: core %d did not reset; the channel's buffers stay until restart\n",
+			   pTestEnc->coreIdx);
+		LeaveVcodecLock(pTestEnc->coreIdx);
+		return TE_ERR_ENC_CORE_FAILED;
+	}
+
 #if CACHE_ENCODE_HEADER
 	if (pTestEnc->bEncHeader) {
 		for (i = 0; i < ARRAY_SIZE(pTestEnc->headerBackup); i++) {
@@ -5801,6 +5841,7 @@
 	cviCloseVpuEnc(pTestEnc);
 	cviDeInitVpuEnc(pTestEnc);
 
+FREE_CHANNEL:
 	if (pTestEnc->encConfig.pusBitCode) {
 #ifndef FIRMWARE_H
 		osal_free(pTestEnc->encConfig.pusBitCode);
@@ -5818,7 +5859,8 @@
 	}
 	pTestEnc->encConfig.userDataBufSize = 0;
 
-	LeaveVcodecLock(pTestEnc->coreIdx);
+	if (hasInstance)
+		LeaveVcodecLock(pTestEnc->coreIdx);
 
 	if (pTestEnc)
 		osal_free(pTestEnc);
