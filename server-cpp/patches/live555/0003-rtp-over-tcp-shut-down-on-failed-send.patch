RTPInterface: shut down a stream socket whose blocking send failed, so the client sees the end.

diff -ru a/liveMedia/RTPInterface.cpp b/liveMedia/RTPInterface.cpp
--- a/liveMedia/RTPInterface.cpp
+++ b/liveMedia/RTPInterface.cpp
@@ -408,6 +408,9 @@
 #ifdef DEBUG_SEND
 	fprintf(stderr, "sendDataOverTCP: blocking send() failed (delivering %d bytes out of %d); closing socket %d\n", sendResult, numBytesRemainingToSend, socketNum); fflush(stderr);
 #endif
+	// The RTSP connection shares the socket: without this the client keeps an open connection that
+	// carries no more data, and waits for it.
+	shutdown(socketNum, SHUT_RDWR);
 	removeStreamSocket(socketNum, 0xFF);
 	return False;
       }
