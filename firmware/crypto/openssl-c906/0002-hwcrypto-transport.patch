--- /dev/null
+++ b/crypto/hwcrypto.c
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <openssl/crypto.h>
+#include "crypto/hwcrypto_transport.h"
+
+_Static_assert(sizeof(struct hwcrypto_request) == 144, "SG2002 request ABI");
+_Static_assert(sizeof(struct hwcrypto_gcm_request) == 128, "SG2002 GCM ABI");
+
+/* The module ships in the same image as this library: no ABI, capability or
+ * device-type probe. The driver keeps no per-open state and serialises every
+ * RUN under one mutex, so a process shares one close-on-exec descriptor across
+ * threads. The owner pid is kept with it: a forked child (an OpenSSH preauth
+ * sandbox, say) drops the inherited descriptor and opens its own.
+ */
+static _Atomic int failed;
+static _Atomic int no_gcm;                 /* the driver has no HWCRYPTO_GCM */
+static _Atomic uint64_t shared;            /* pid << 32 | (fd + 1); 0: none */
+
+static void fault(int error)
+{
+    /* EIO/ETIMEDOUT: the driver poisoned the engine until reboot. Absence or
+     * permission (a non-root or sandboxed process) holds for the process.
+     * Interrupted, faulting or resource-limited calls retry on a later one. */
+    if (error == EIO || error == ETIMEDOUT || error == ENOENT || error == ENODEV
+        || error == ENXIO || error == EACCES || error == EPERM
+        || error == EINVAL || error == EMSGSIZE)
+        atomic_store_explicit(&failed, 1, memory_order_relaxed);
+}
+int ossl_hwcrypto_begin(unsigned int algorithm)
+{
+    uint64_t pid, current, mine;
+    int fd;
+
+    (void)algorithm;
+    if (atomic_load_explicit(&failed, memory_order_relaxed))
+        return -1;
+    pid = (uint32_t)getpid();
+    current = atomic_load_explicit(&shared, memory_order_acquire);
+    if (current != 0 && current >> 32 == pid)
+        return (int)(uint32_t)current - 1;
+    /* Inherited across fork: this copy of the descriptor is the child's own. */
+    if (current != 0 && atomic_compare_exchange_strong(&shared, &current, 0))
+        close((int)(uint32_t)current - 1);
+    fd = open("/dev/nanokvm-hwcrypto", O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        fault(errno);
+        return -1;
+    }
+    mine = pid << 32 | (uint32_t)(fd + 1);
+    current = 0;
+    if (atomic_compare_exchange_strong(&shared, &current, mine))
+        return fd;
+    close(fd);                              /* another thread opened first */
+    return current >> 32 == pid ? (int)(uint32_t)current - 1 : -1;
+}
+static int run(int fd, unsigned long command, void *request)
+{
+    uint64_t current;
+    int error;
+
+    if (atomic_load_explicit(&failed, memory_order_relaxed))
+        return 0;
+    /* On any error the driver copies nothing back into the request. */
+    if (ioctl(fd, command, request) == 0)
+        return 1;
+    error = errno;
+    if (error == ENOTTY && command == HWCRYPTO_GCM) {
+        /* The module of the running kernel is from before HWCRYPTO_GCM: after
+         * an update, until the reboot. The callers keep the AES-CTR path. */
+        atomic_store_explicit(&no_gcm, 1, memory_order_relaxed);
+        return 0;
+    }
+    if (error == EBADF || error == ENOTTY) {
+        /* The application closed the descriptor (closefrom, daemonising).
+         * Forget it without closing: the number may now be another file. */
+        current = atomic_load_explicit(&shared, memory_order_relaxed);
+        if ((uint32_t)current == (uint32_t)(fd + 1))
+            atomic_compare_exchange_strong(&shared, &current, 0);
+        return 0;
+    }
+    fault(error);
+    return 0;
+}
+/* In place, the driver could write the output before a late failure; keep the
+ * input intact for the software fallback. Off the SHA and out-of-place paths.
+ * A request above the scratch goes to the driver as it is: a caller that
+ * makes one fails its operation if the engine is lost in it
+ * (ossl_hwcrypto_cipher()). */
+static __attribute__((noinline)) int run_in_place(
+    int fd, struct hwcrypto_request *request)
+{
+    unsigned char scratch[HWCRYPTO_OUT_MAX];
+    uint64_t output = request->output;
+    size_t capacity = request->output_length;
+    int ok;
+
+    request->output = (uintptr_t)scratch;
+    ok = run(fd, HWCRYPTO_RUN, request);
+    request->output = output;
+    if (ok)
+        memcpy((void *)(uintptr_t)output, scratch, request->output_length);
+    OPENSSL_cleanse(scratch, capacity < sizeof(scratch) ? capacity : sizeof(scratch));
+    return ok;
+}
+int ossl_hwcrypto_run(int fd, struct hwcrypto_request *request)
+{
+    if (request->algorithm == HWCRYPTO_ALG_SHA1
+        || request->algorithm == HWCRYPTO_ALG_SHA256
+        || request->input != request->output
+        || request->length > HWCRYPTO_MAX)
+        return run(fd, HWCRYPTO_RUN, request);
+    return run_in_place(fd, request);
+}
+/* The driver writes a chunk's output only after the engine finished it and
+ * reports the completed prefix: in place needs no scratch. */
+int ossl_hwcrypto_run_gcm(int fd, struct hwcrypto_gcm_request *request)
+{
+    if (atomic_load_explicit(&no_gcm, memory_order_relaxed))
+        return 0;
+    return run(fd, HWCRYPTO_GCM, request);
+}
+void ossl_hwcrypto_end(int fd)
+{
+    (void)fd;                               /* the process keeps it */
+}
+
--- /dev/null
+++ b/include/crypto/hwcrypto_transport.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef OSSL_NANOKVM_HWCRYPTO_TRANSPORT_H
+#define OSSL_NANOKVM_HWCRYPTO_TRANSPORT_H
+#include "crypto/hwcrypto.h"
+/* A call owns its fd. No shared request, key, buffer or userspace mutex. */
+int ossl_hwcrypto_begin(unsigned int algorithm);
+int ossl_hwcrypto_run(int fd, struct hwcrypto_request *request);
+void ossl_hwcrypto_end(int fd);
+#endif
--- /dev/null
+++ b/include/crypto/hwcrypto.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef HWCRYPTO_H
+#define HWCRYPTO_H
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+#define HWCRYPTO_ABI 1
+#define HWCRYPTO_MAX 4096
+#define HWCRYPTO_OUT_MAX 8192
+enum hwcrypto_algorithm {
+ HWCRYPTO_ALG_AES = 1, HWCRYPTO_ALG_DES, HWCRYPTO_ALG_TDES, HWCRYPTO_ALG_SM4,
+ HWCRYPTO_ALG_SHA1, HWCRYPTO_ALG_SHA256, HWCRYPTO_ALG_BASE64,
+ HWCRYPTO_ALG_COUNT
+};
+enum hwcrypto_mode { HWCRYPTO_MODE_ECB, HWCRYPTO_MODE_CBC, HWCRYPTO_MODE_CTR };
+/* SHA requests transform complete 64-byte blocks. state contains/returns the
+ * canonical big-endian chaining state; callers handle initialization/padding.
+ * input/output are userspace virtual addresses, never physical/DMA addresses.
+ * output_length is capacity on input and actual length on successful return.
+ */
+struct hwcrypto_request {
+ __u32 version, algorithm, mode, encrypt;
+ __u32 key_length, length, output_length, status;
+ __u8 key[32], iv[16], state[32];
+ __aligned_u64 input, output;
+ __u32 reserved[4];
+};
+struct hwcrypto_info {
+ __u32 version, algorithms, max_input, max_output;
+ __u32 poisoned, reserved[3];
+ __aligned_u64 submitted[HWCRYPTO_ALG_COUNT];
+ __aligned_u64 completed[HWCRYPTO_ALG_COUNT];
+};
+/* AES-GCM bulk data: AES-CTR with GCM's 32-bit counter on the engine and, while
+ * it runs, GHASH of the ciphertext on the CPU. length is a nonzero multiple of
+ * 16. h is the hash key E_K(0^128); xi (GHASH accumulator) and ctr (counter
+ * block, big-endian 32-bit counter in the last word) are in GCM byte order and
+ * come back advanced over the returned length. If a chunk after the first
+ * fails, the call succeeds with the completed prefix in length. Associated
+ * data, partial blocks, lengths and the tag stay with the caller.
+ */
+struct hwcrypto_gcm_request {
+ __u32 version, encrypt, key_length, length;
+ __u8 key[32], h[16], xi[16], ctr[16];
+ __aligned_u64 input, output;
+ __u32 reserved[4];
+};
+#define HWCRYPTO_RUN _IOWR('K', 0xc2, struct hwcrypto_request)
+#define HWCRYPTO_INFO _IOR('K', 0xc3, struct hwcrypto_info)
+#define HWCRYPTO_GCM _IOWR('K', 0xc4, struct hwcrypto_gcm_request)
+#endif
