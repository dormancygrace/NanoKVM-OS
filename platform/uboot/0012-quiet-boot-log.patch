 boot/bootm.c                      |  2 +-
 boot/image-board.c                |  4 ++--
 boot/image-fdt.c                  |  6 +++---
 boot/image-fit.c                  | 24 +++++++++++++-----------
 boot/image.c                      |  4 ++++
 cmd/fdt.c                         |  2 +-
 common/board_f.c                  | 17 ++++++++++-------
 common/board_r.c                  |  4 ++--
 drivers/mmc/mmc.c                 |  3 ++-
 env/env.c                         |  4 ++--
 fs/fs.c                           | 14 ++++++++------
 12 files changed, 49 insertions(+), 37 deletions(-)
