From cd718c6ff717794f67705f63f4fd6676597174c6 Mon Sep 17 00:00:00 2001
From: dgrace <g.pesin@globalte.ru>
Date: Sat, 5 Sep 2026 22:17:02 +0300
Subject: [PATCH] riscv: preserve NanoKVM boot key and user LED pinmux

---
 .../dts/sophgo/sg2002-nanokvm-enhanced.dts    | 41 +++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts b/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts
index 4f95312be..97d63f919 100644
--- a/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2002-nanokvm-enhanced.dts
@@ -2,6 +2,8 @@
 // NanoKVM Enhanced port: board qualification is still pending.
 /dts-v1/;
 #include "sg2002-licheerv-nano-b.dts"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
 
 / {
 	model = "Sipeed NanoKVM Enhanced";
@@ -15,6 +17,27 @@ aliases {
 	chosen {
 		bootargs = "root=/dev/mmcblk0p2 rootwait rw console=ttyS0,115200 earlycon=sbi";
 	};
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&nanokvm_boot_key_cfg>;
+		key-user {
+			label = "User Key";
+			linux,code = <KEY_DISPLAYTOGGLE>;
+			debounce-interval = <1>;
+			gpios = <&porta 30 GPIO_ACTIVE_LOW>;
+		};
+	};
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&nanokvm_user_led_cfg>;
+		led-user {
+			label = "led-user";
+			gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "activity";
+		};
+	};
 	reserved-memory {
 		#address-cells = <1>;
 		#size-cells = <1>;
@@ -218,3 +241,21 @@ &usb {
 	g-tx-fifo-size = <768 512 512 384 128 128>;
 	status = "okay";
 };
+
+&pinctrl {
+	nanokvm_boot_key_cfg: nanokvm-boot-key-cfg {
+		boot-key-pins {
+			pinmux = <PINMUX(PIN_AUX0, 3)>;
+			bias-pull-up;
+			power-source = <3300>;
+		};
+	};
+	nanokvm_user_led_cfg: nanokvm-user-led-cfg {
+		user-led-pins {
+			pinmux = <PINMUX(PIN_SD0_PWR_EN, 3)>;
+			bias-disable;
+			drive-strength-microamp = <10800>;
+			power-source = <3300>;
+		};
+	};
+};
-- 
2.43.0
