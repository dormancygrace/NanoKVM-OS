+bool Transport::takeBurst(message_vector &batch) noexcept {
+	// With mBurstMutex held: the records that may leave, off the front of the queue.
+	if (mBurstReady == 0)
+		return false;
+	if (mBurstReady == mBurstQueue.size()) {
+		batch.swap(mBurstQueue);
+	} else {
+		try {
+			batch.assign(std::make_move_iterator(mBurstQueue.begin()),
+			             std::make_move_iterator(mBurstQueue.begin() + mBurstReady));
+		} catch (const std::exception &) {
+			return false; // no memory for the batch: they stay queued for the next scope
+		}
+		mBurstQueue.erase(mBurstQueue.begin(), mBurstQueue.begin() + mBurstReady);
+	}
+	mBurstReady = 0;
+	return true;
+}
+
+void Transport::sendBurstBatch(message_vector &messages, std::chrono::steady_clock::time_point &giveUp) noexcept {
+	// The layer below tells how many records, in order, the socket took. A batch taken in part keeps the others:
+	// collectBurst() already told the SCTP stack they were sent, so dropping them here would turn a full socket
+	// buffer into packet loss. They are given again, without the ones already taken, until giveUp, which the
+	// first shortfall sets. A batch that begins after that time is offered once more without a wait, and
+	// goes on for as long as the socket takes all it is given. A transport that cannot send any more ends its
+	// batch at once.
+	const std::chrono::steady_clock::time_point unset{};
+	size_t sent = 0;
+	bool closed = false, tried = false;
+	try {
+		while (sent < messages.size()) {
+			int wait = -1; // the layer's own wait, while nothing has fallen short yet
+			bool late = false;
+			if (giveUp != unset) {
+				auto left = std::chrono::duration_cast<std::chrono::milliseconds>(giveUp - std::chrono::steady_clock::now());
+				late = left.count() <= 0;
+				if (late && tried)
+					break;
+				wait = late ? 0 : int(left.count());
+			}
+			size_t count = std::min(maxBurst, messages.size() - sent);
+			int took = outgoingBatchPrefix(messages, sent, count, wait);
+			if (took < 0) {
+				closed = true;
+				break;
+			}
+			sent += size_t(took);
+			if (size_t(took) == count)
+				continue; // also past the time: the socket takes them
+			tried = true;
+			if (giveUp == unset)
+				giveUp = std::chrono::steady_clock::now() + burstRetry;
+		}
+		if (sent == messages.size())
+			giveUp = unset; // the socket has room again
+	} catch (const std::exception &e) {
+		PLOG_WARNING << "Burst send: " << e.what();
+	}
+	if (sent < messages.size()) {
+		// Given up, once: these are lost to the peer like packets lost on the way, and counted as not sent.
+		AddUnsentMediaDatagrams(messages.size() - sent);
+		PLOG_WARNING << "Burst send: " << (messages.size() - sent) << " of " << messages.size()
+		             << (closed ? " records dropped, the transport is closed" : " records dropped, the socket stayed full");
+	}
+}
+
+int Transport::sendBatchPrefix(message_vector &messages, size_t from, size_t count, int /*waitMs*/) {
+	size_t taken = 0;
+	while (taken < count && send(messages[from + taken]))
+		++taken;
+	return int(taken);
+}
+
+int Transport::outgoingBatchPrefix(message_vector &messages, size_t from, size_t count, int waitMs) {
+	return mLower ? mLower->sendBatchPrefix(messages, from, count, waitMs) : -1;
+}
