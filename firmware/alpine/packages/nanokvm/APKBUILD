pkgname=nanokvm
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="NanoKVM server and native runtime libraries"
url="https://github.com/dormancygrace/NanoKVM-OS"
arch="riscv64"
license="GPL-3.0-only"
# IPMI is served by this server; nanokvm-base frees its port from the daemon
# of earlier releases (nanokvm-ipmi-handover), and requires this server.
depends="nanokvm-base>=3.0_alpha1-r1 nanokvm-usb-flags-layout=1 nanokvm-standby=1 nanokvm-ipmi-handover=1 libgcc libstdc++"
replaces="nanokvm-app"
provides="nanokvm-ipmi-server=1 nanokvm-web-api=3 nanokvm-rustdesk-bridge=2 nanokvm-rustdesk-webrtc=1 nanokvm-rustdesk-audio=1 nanokvm-rustdesk-auto-codec=1 nanokvm-rustdesk-usb-defaults=1"
source="$pkgname-$pkgver.tar.gz"
options="!check !strip !tracedeps"
install="$pkgname.post-upgrade"
triggers="$pkgname.trigger=/kvmapp/server:/kvmapp/server/dl_lib:/kvmapp/kvm_system:/kvmapp/system/init.d"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
