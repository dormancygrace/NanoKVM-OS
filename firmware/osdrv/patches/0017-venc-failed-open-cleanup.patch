From ace4d2c1691cc42d378e1a8a1ba2efdf21bbc70c Mon Sep 17 00:00:00 2001
From: dgrace <g.pesin@globalte.ru>
Date: Sun, 6 Sep 2026 20:06:40 +0300
Subject: [PATCH] venc: destroy initialized channel context when backend open
 fails

---
 interdrv/cvi_vc_drv/module/src/cvi_venc.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/interdrv/cvi_vc_drv/module/src/cvi_venc.c b/interdrv/cvi_vc_drv/module/src/cvi_venc.c
index bca979d..ee54c4c 100644
--- a/interdrv/cvi_vc_drv/module/src/cvi_venc.c
+++ b/interdrv/cvi_vc_drv/module/src/cvi_venc.c
@@ -1058,14 +1058,19 @@ CVI_S32 CVI_VENC_CreateChn(VENC_CHN VeChn, const VENC_CHN_ATTR_S *pstAttr)
 	pChnHandle = handle->chn_handle[VeChn];
 	pEncCtx = &pChnHandle->encCtx;
 
+	pChnHandle->bSbSkipFrm = false;
+	pChnHandle->sbm_state = VENC_SBM_STATE_IDLE;
+
 	s32Ret = pEncCtx->base.open(handle, pChnHandle);
 	if (s32Ret != CVI_SUCCESS) {
 		CVI_VENC_ERR("venc_init_encoder\n");
+		/* Context initialization already owns jobs, semaphores and channel
+		 * memory. A failed hardware/firmware open must release them too.
+		 * The backend close tolerates an unopened handle.
+		 */
+		CVI_VENC_DestroyChn(VeChn);
 		return s32Ret;
 	}
-
-	pChnHandle->bSbSkipFrm = false;
-	pChnHandle->sbm_state = VENC_SBM_STATE_IDLE;
 	handle->chn_status[VeChn] = VENC_CHN_STATE_INIT;
 
 	CVI_VENC_TRACE("\n");
-- 
2.43.0

