+/* Keep short repeated patterns in a register, without a stack byte array. */
+static FORCE_INLINE void LZ4_repeatCopy(BYTE *dst, const BYTE *src,
+					BYTE *end, size_t offset)
+{
+	U64 pattern;
+
+	if (offset == 1)
+		pattern = (U64)*src * 0x0101010101010101ULL;
+	else if (offset == 2)
+		pattern = (U64)LZ4_read16(src) * 0x0001000100010001ULL;
+	else
+		pattern = (U64)LZ4_read32(src) * 0x0000000100000001ULL;
+
+	do {
+		put_unaligned(pattern, (U64 *)dst);
+		dst += 8;
+	} while (dst < end);
+}
