diff --git a/package/libopenssl/libopenssl.mk b/package/libopenssl/libopenssl.mk
--- a/package/libopenssl/libopenssl.mk
+++ b/package/libopenssl/libopenssl.mk
@@ -4,7 +4,7 @@
 #
 ################################################################################
 
-LIBOPENSSL_VERSION = 3.6.4
+LIBOPENSSL_VERSION = 4.0.2
 LIBOPENSSL_SITE = https://github.com/openssl/openssl/releases/download/openssl-$(LIBOPENSSL_VERSION)
 LIBOPENSSL_SOURCE = openssl-$(LIBOPENSSL_VERSION).tar.gz
 LIBOPENSSL_LICENSE = Apache-2.0
@@ -150,6 +150,8 @@
 
 define HOST_LIBOPENSSL_INSTALL_CMDS
 	$(HOST_MAKE_ENV) $(MAKE) -C $(@D) install
+	# OpenSSL 4 removed c_rehash; Buildroot CA finalization still invokes it.
+	if [ ! -e $(HOST_DIR)/bin/c_rehash ]; then printf '%s\n' '#!/bin/sh' 'exec "$(HOST_DIR)/bin/openssl" rehash "$$@"' >$(HOST_DIR)/bin/c_rehash; chmod 0755 $(HOST_DIR)/bin/c_rehash; fi
 endef
 
 define LIBOPENSSL_INSTALL_TARGET_CMDS
