diff --git a/arch/riscv/lib/copy_csum_xtheadvector.S b/arch/riscv/lib/copy_csum_xtheadvector.S
new file mode 100644
index 000000000..b2fb99747
--- /dev/null
+++ b/arch/riscv/lib/copy_csum_xtheadvector.S
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+	.option push
+	.option arch, rv64imac_zicsr_zifencei_xtheadvector
+	.text
+SYM_FUNC_START(__riscv_th_copy_csum)
+	li t0,0
+	li t1,1
+	th.vsetvli zero,t1,e32,m1
+	th.vmv.s.x v8,zero
+.Lcopy_loop:
+	li t1,2
+	bltu a2,t1,.Lcopy_tail
+	andi t1,a2,-2
+	th.vsetvli t2,t1,e8,m8
+	th.vlb.v v0,(a1)
+	th.vsb.v v0,(a0)
+	srli t1,t2,1
+	th.vsetvli zero,t1,e16,m8
+	th.vwredsumu.vs v8,v0,v8
+	add a0,a0,t2
+	add a1,a1,t2
+	sub a2,a2,t2
+	j .Lcopy_loop
+.Lcopy_tail:
+	beqz a2,.Lcopy_fold
+	lbu t0,0(a1)
+	sb t0,0(a0)
+.Lcopy_fold:
+	li t1,1
+	th.vsetvli zero,t1,e32,m1
+	th.vmv.x.s t1,v8
+	add t0,t0,t1
+	li t1,65535
+	and t2,t0,t1
+	srli t0,t0,16
+	add t0,t0,t2
+	and t2,t0,t1
+	srli t0,t0,16
+	add a0,t0,t2
+	ret
+SYM_FUNC_END(__riscv_th_copy_csum)
+	.option pop
diff --git a/arch/riscv/lib/csum.c b/arch/riscv/lib/csum.c
index 5d4379768..cf9cd844f 100644
--- a/arch/riscv/lib/csum.c
+++ b/arch/riscv/lib/csum.c
@@ -12,6 +12,17 @@
 #include <linux/kernel.h>
 
 #include <asm/cpufeature.h>
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_COPY_CSUM
+#include <asm/simd.h>
+#include <asm/vector.h>
+#include <linux/export.h>
+#include <net/checksum.h>
+#endif
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_CSUM
+#include <asm/xtheadvector_kernel.h>
+
+unsigned int __riscv_xtheadvector_csum(const void *buffer, size_t len);
+#endif
 
 #include <net/checksum.h>
 
@@ -263,6 +274,16 @@ unsigned int do_csum(const unsigned char *buff, int len)
 {
 	if (unlikely(len <= 0))
 		return 0;
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_CSUM
+	if (xtheadvector_kernel_usable(len, CONFIG_RISCV_ISA_XTHEADVECTOR_CSUM_THRESHOLD)) {
+		unsigned int sum;
+
+		kernel_vector_begin();
+		sum = __riscv_xtheadvector_csum(buff, len);
+		kernel_vector_end();
+		return sum;
+	}
+#endif
 
 	/*
 	 * Significant performance gains can be seen by not doing alignment
@@ -279,3 +300,31 @@ unsigned int do_csum(const unsigned char *buff, int len)
 
 	return do_csum_with_alignment(buff, len);
 }
+
+#ifdef CONFIG_RISCV_ISA_XTHEADVECTOR_COPY_CSUM
+/* Only kernel RAM. Each even-size chunk bounds the widening reduction. */
+unsigned int __riscv_th_copy_csum(void *, const void *, size_t);
+__wsum csum_partial_copy_nocheck(const void *src, void *dst, int len)
+{
+	const u8 *p = src;
+	u8 *q = dst;
+	u32 sum = 0;
+	if (!xtheadvector_kernel_usable(len, 4096)) {
+		memcpy(dst, src, len);
+		return csum_partial(dst, len, 0);
+	}
+	kasan_check_read(src, len);
+	kasan_check_write(dst, len);
+	kernel_vector_begin();
+	while (len) {
+		size_t n = min_t(size_t, len, 65536);
+		sum += __riscv_th_copy_csum(q, p, n);
+		p += n; q += n; len -= n;
+	}
+	kernel_vector_end();
+	sum = (sum & 0xffff) + (sum >> 16);
+	sum = (sum & 0xffff) + (sum >> 16);
+	return (__force __wsum)sum;
+}
+EXPORT_SYMBOL(csum_partial_copy_nocheck);
+#endif
diff --git a/arch/riscv/lib/csum_xtheadvector.S b/arch/riscv/lib/csum_xtheadvector.S
new file mode 100644
index 000000000..82826e74a
--- /dev/null
+++ b/arch/riscv/lib/csum_xtheadvector.S
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/asm.h>
+	.option push
+	.option arch, rv64imac_zicsr_zifencei_xtheadvector
+/* Return do_csum's uncomplemented 16-bit little-endian sum.
+ * Aligned halfword loads; odd first-byte alignment is handled explicitly.
+ * Each widening reduction batch <=32768 halfwords, so its 32-bit seed
+ * cannot overflow or set the sign bit even for all-0xffff input.
+ */
+SYM_FUNC_START(__riscv_xtheadvector_csum)
+	li	t0, 0
+	andi	t1, a0, 1
+	beqz	a1, .Lcsum_zero
+	beqz	t1, .Lcsum_blocks
+	lbu	t0, 0(a0)
+	slli	t0, t0, 8
+	addi	a0, a0, 1
+	addi	a1, a1, -1
+.Lcsum_blocks:
+	srli	t2, a1, 1
+	beqz	t2, .Lcsum_tail
+	li	t3, 32768
+	bleu	t2, t3, .Lcsum_batch
+	mv	t2, t3
+.Lcsum_batch:
+	li	t3, 1
+	th.vsetvli zero, t3, e32, m1
+	th.vmv.s.x v8, zero
+	slli	t4, t2, 1
+	sub	a1, a1, t4
+.Lcsum_loop:
+	th.vsetvli t3, t2, e16, m8
+	th.vlh.v v0, (a0)
+	th.vwredsumu.vs v8, v0, v8
+	slli	t4, t3, 1
+	add	a0, a0, t4
+	sub	t2, t2, t3
+	bnez	t2, .Lcsum_loop
+	li	t3, 1
+	th.vsetvli zero, t3, e32, m1
+	th.vmv.x.s t3, v8
+	add	t0, t0, t3
+	li	t3, 2
+	bgeu	a1, t3, .Lcsum_blocks
+.Lcsum_tail:
+	beqz	a1, .Lcsum_fold
+	lbu	t3, 0(a0)
+	add	t0, t0, t3
+.Lcsum_fold:
+	li	t3, 65535
+	and	t4, t0, t3
+	srli	t0, t0, 16
+	add	t0, t0, t4
+	and	t4, t0, t3
+	srli	t0, t0, 16
+	add	t0, t0, t4
+	and	t4, t0, t3
+	srli	t0, t0, 16
+	add	t0, t0, t4
+	beqz	t1, .Lcsum_zero
+	srli	t4, t0, 8
+	slli	t0, t0, 8
+	or	t0, t0, t4
+	and	t0, t0, t3
+.Lcsum_zero:
+	mv	a0, t0
+	ret
+SYM_FUNC_END(__riscv_xtheadvector_csum)
+	.option pop
