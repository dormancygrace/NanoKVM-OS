@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <stdint.h>
+#include <openssl/crypto.h>
+#include "internal/sm3.h"
+#include "crypto/sg2002.h"
+/* Initial candidate: qualify crossover on the physical C906. */
+#define DMA_BLOCKS (SG2002_CRYPTO_MAX / SM3_CBLOCK)
+size_t ossl_sm3_sg2002(SM3_CTX *ctx, const unsigned char *in, size_t blocks)
+{
+    struct sg2002_crypto_request r = {
+        .version = SG2002_CRYPTO_ABI, .algorithm = SG2002_ALG_SM3,
+        .length = SG2002_CRYPTO_MAX
+    };
+    uint32_t words[8];
+    size_t done = 0;
+    int fd;
+    if (blocks < DMA_BLOCKS) return 0;
+    fd = ossl_sg2002_begin(SG2002_ALG_SM3);
+    if (fd < 0) return 0;
+    words[0]=ctx->A; words[1]=ctx->B; words[2]=ctx->C; words[3]=ctx->D;
+    words[4]=ctx->E; words[5]=ctx->F; words[6]=ctx->G; words[7]=ctx->H;
+    for (unsigned int i=0; i<8; ++i)
+        for (unsigned int j=0; j<4; ++j)
+            r.state[4*i+j]=(unsigned char)(words[i] >> (24-8*j));
+    while (blocks-done >= DMA_BLOCKS) {
+        r.input=(uintptr_t)(in + done*SM3_CBLOCK);
+        if (!ossl_sg2002_run(fd,&r)) break;
+        done += DMA_BLOCKS;
+    }
+    ossl_sg2002_end(fd);
+    if (done != 0) {
+        for (unsigned int i=0; i<8; ++i)
+            words[i]=(uint32_t)r.state[4*i]<<24 | (uint32_t)r.state[4*i+1]<<16
+                | (uint32_t)r.state[4*i+2]<<8 | r.state[4*i+3];
+        ctx->A=words[0]; ctx->B=words[1]; ctx->C=words[2]; ctx->D=words[3];
+        ctx->E=words[4]; ctx->F=words[5]; ctx->G=words[6]; ctx->H=words[7];
+    }
+    OPENSSL_cleanse(words,sizeof(words));
+    OPENSSL_cleanse(&r,sizeof(r));
+    return done;
+}
