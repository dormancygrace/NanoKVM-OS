#!/bin/sh
# NanoKVM OS counterpart of the stock S15kvmhwd. Pinmux and board reset/enable
# ownership are in DT; do not export global GPIOs or reload i2c-gpio here.
#
# The board is the DT profile that first boot selected (firmware/boards). The
# HDMI receiver is fixed hardware: it is probed on I2C4 once for this chip and
# kept; `re-detect` probes it again.
set -eu

: "${NANOKVM_KVM_ETC:=/etc/kvm}"
: "${NANOKVM_BOARD_REVISION:=/sys/firmware/devicetree/base/sipeed,board-revision}"
: "${NANOKVM_CHIP_UID:=/sys/class/cvi-base/base_uid}"

die() { echo "S15kvmhwd: $*" >&2; exit 1; }

board_profile() {
    declared_board=$(tr -d '\000' < "$NANOKVM_BOARD_REVISION") ||
        die "board revision is missing from Device Tree"
    case "$declared_board" in
        alpha|beta|pcie) board=$declared_board ;;
        # Native OLED code keeps the beta name for base/Lite hardware.
        lite) board=beta ;;
        *) die "unselected or unknown boot profile: $declared_board" ;;
    esac
}

# The stock targeted SMBus-read probe. No response is a normal negative
# result; a failed `i2cdetect` is an I2C error and stops the detection.
responds() {
    result=$(i2cdetect -ry 4 "$1" "$1") || die "I2C4 probe failed at $1"
    case " $result " in
        *[[:space:]]"${1#0x}"[[:space:]]*) return 0 ;;
    esac
    return 1
}
detect_hdmi() {
    if responds 0x2c; then
        hdmi=c
    elif responds 0x2b; then
        if responds 0x44; then hdmi=ux; else hdmi=d; fi
    else
        die "HDMI receiver not identified; keeping previous configuration"
    fi
}

# read_file NAME: the first line of /etc/kvm/NAME, or nothing.
read_file() {
    value=
    [ ! -r "$NANOKVM_KVM_ETC/$1" ] || read -r value < "$NANOKVM_KVM_ETC/$1" || true
}
publish() {
    read_file "$1"
    [ "$value" != "$2" ] || return 0
    mkdir -p "$NANOKVM_KVM_ETC"
    temporary=$(mktemp "$NANOKVM_KVM_ETC/.$1.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    printf '%s\n' "$2" > "$temporary"
    chmod 644 "$temporary"
    mv -f "$temporary" "$NANOKVM_KVM_ETC/$1"
    trap - EXIT
}

# The model probed on this chip before: a card moved to another board probes
# its receiver again (the D EDID writer must never reach a UXC).
chip=
[ ! -r "$NANOKVM_CHIP_UID" ] || read -r chip < "$NANOKVM_CHIP_UID" || true
cached_model() {
    read_file hdmi_version
    case "$value" in c|ux|d) hdmi=$value ;; *) return 1 ;; esac
    read_file hdmi_uid
    [ -n "$chip" ] && [ "$value" = "$chip" ]
}
probe_and_publish() {
    detect_hdmi
    publish hdmi_version "$hdmi"
    [ -z "$chip" ] || publish hdmi_uid "$chip"
}

case "${1:-}" in
    stop) exit 0 ;;
    check)
        board_profile
        echo "NanoKVM OS: detected board=$board"
        ;;
    start|re-init|re-detect)
        board_profile
        # The board is known now: publish it before the receiver, so a receiver
        # that does not answer never costs ATX and the board-dependent paths.
        publish hw "$board"
        publish board-profile "$declared_board"
        if [ "$1" != start ] || ! cached_model; then
            probe_and_publish
        fi
        echo "NanoKVM OS: board=$board HDMI=$hdmi"
        ;;
    get_hdmi_version)
        # Native initialization calls this more than once, also while the
        # detector may use the I2C bus: a published model stands.
        read_file hdmi_version
        case "$value" in c|ux|d) exit 0 ;; esac
        probe_and_publish
        ;;
    *) echo "Usage: $0 {start|stop|check|re-init|re-detect|get_hdmi_version}" >&2; exit 2 ;;
esac
