diff --git a/interdrv/base/base.c b/interdrv/base/base.c
index 58a8e84..9c6df57 100644
--- a/interdrv/base/base.c
+++ b/interdrv/base/base.c
@@ -28,6 +28,7 @@
 #include "cvi_sys_proc.h"
 #include <linux/cvi_base_ctx.h>
 #include <linux/semaphore.h>
+#include <linux/rwsem.h>
 #include <base_cb.h>
 #include <sys_k.h>
 #include <vip_common.h>
@@ -1010,42 +1011,69 @@ struct vip_sys_cmm_dev {
 static struct vip_sys_cmm_dev cmm_ssp;
 static struct vip_sys_cmm_dev cmm_i2c;
 
+/* CMM callbacks may sleep during I2C/SPI transfers. Unregister waits for
+ * outstanding callers before the provider frees its state or unloads. */
+static DECLARE_RWSEM(cmm_lock);
+
 int vip_sys_register_cmm_cb(unsigned long cmm, void *hdlr, void *cb)
 {
-	struct vip_sys_cmm_dev *cmm_dev;
-
-	if ((cmm >= VIP_CMM_BUTT) || !hdlr || !cb)
-		return -1;
+    struct vip_sys_cmm_dev *entry;
+    int ret = 0;
+
+    if (cmm >= VIP_CMM_BUTT || !hdlr || !cb) return -EINVAL;
+    entry = cmm == VIP_CMM_I2C ? &cmm_i2c : &cmm_ssp;
+    down_write(&cmm_lock);
+    if (entry->ops.cb) {
+        ret = -EBUSY;
+    } else {
+        entry->cmm_type = cmm;
+        entry->hdlr = hdlr;
+        entry->ops.cb = cb;
+    }
+    up_write(&cmm_lock);
+    return ret;
+}
+EXPORT_SYMBOL_GPL(vip_sys_register_cmm_cb);
 
-	cmm_dev = (cmm == VIP_CMM_I2C) ? &cmm_i2c : &cmm_ssp;
+int vip_sys_unregister_cmm_cb(unsigned long cmm, void *hdlr)
+{
+    struct vip_sys_cmm_dev *entry;
+    int ret = 0;
+
+    if (cmm >= VIP_CMM_BUTT || !hdlr) return -EINVAL;
+    entry = cmm == VIP_CMM_I2C ? &cmm_i2c : &cmm_ssp;
+    down_write(&cmm_lock);
+    if (entry->hdlr != hdlr) {
+        ret = -ENOENT;
+    } else {
+        entry->ops.cb = NULL;
+        entry->hdlr = NULL;
+    }
+    up_write(&cmm_lock);
+    return ret;
+}
+EXPORT_SYMBOL_GPL(vip_sys_unregister_cmm_cb);
 
-	cmm_dev->cmm_type = cmm;
-	cmm_dev->hdlr = hdlr;
-	cmm_dev->ops.cb = cb;
+static int vip_sys_cmm_call(struct vip_sys_cmm_dev *entry,
+                            unsigned int cmd, void *arg)
+{
+    int ret;
 
-	return 0;
+    down_read(&cmm_lock);
+    ret = entry->ops.cb ? entry->ops.cb(entry->hdlr, cmd, arg) : -ENODEV;
+    up_read(&cmm_lock);
+    return ret;
 }
-EXPORT_SYMBOL_GPL(vip_sys_register_cmm_cb);
 
 int vip_sys_cmm_cb_i2c(unsigned int cmd, void *arg)
 {
-	struct vip_sys_cmm_dev *cmm_dev = &cmm_i2c;
-
-	if (cmm_dev->cmm_type != VIP_CMM_I2C)
-		return -1;
-
-	return (cmm_dev->ops.cb) ? cmm_dev->ops.cb(cmm_dev->hdlr, cmd, arg) : (-1);
+    return vip_sys_cmm_call(&cmm_i2c, cmd, arg);
 }
 EXPORT_SYMBOL_GPL(vip_sys_cmm_cb_i2c);
 
 int vip_sys_cmm_cb_ssp(unsigned int cmd, void *arg)
 {
-	struct vip_sys_cmm_dev *cmm_dev = &cmm_ssp;
-
-	if (cmm_dev->cmm_type != VIP_CMM_SSP)
-		return -1;
-
-	return (cmm_dev->ops.cb) ? cmm_dev->ops.cb(cmm_dev->hdlr, cmd, arg) : (-1);
+    return vip_sys_cmm_call(&cmm_ssp, cmd, arg);
 }
 EXPORT_SYMBOL_GPL(vip_sys_cmm_cb_ssp);
 
