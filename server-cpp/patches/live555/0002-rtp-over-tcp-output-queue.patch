diff -ru a/liveMedia/include/RTPInterface.hh b/liveMedia/include/RTPInterface.hh
--- a/liveMedia/include/RTPInterface.hh
+++ b/liveMedia/include/RTPInterface.hh
@@ -23,6 +23,15 @@
 #ifndef _RTP_INTERFACE_HH
 #define _RTP_INTERFACE_HH
 
+// RTP and RTCP over TCP go through an output queue per socket: what the socket does not take at once waits there and
+// goes out before the next packet, so a slow client never blocks the event loop and the other clients. A client whose
+// queue would grow past RTPInterfaceMaxBacklogBytes is disconnected (its socket shut down).
+extern unsigned RTPInterfaceMaxBacklogBytes;
+// Called after each packet with the bytes still queued for that socket (0 when it is all out).
+extern void (*RTPInterfaceBacklogHook)(int socketNum, unsigned backlogBytes);
+// Drops the queue of a socket number (a new connection may reuse the number of a closed one).
+void RTPInterfaceForgetSocket(int socketNum);
+
 #ifndef _MEDIA_HH
 #include "Media.hh"
 #endif
