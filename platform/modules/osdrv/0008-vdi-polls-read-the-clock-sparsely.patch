From: Gleb Pesin <dormancygrace@gmail.com>
Subject: [PATCH] interdrv: cvi_vc_drv: register polls read the clock every 64 turns

The register polls in vdi.c (vdi_wait_vpu_busy, vdi_wait_bus_busy and
the polling build of vdi_wait_interrupt) read the wall clock with
ktime_get_real_ts64 on entry and on every turn. Most polls end after a
few register reads, so the clock reads cost more than the polls: about
3 % of the capture thread with a moving picture.

The timeout now reads ktime_get_ns() every 64 turns, starting the
deadline at the first read; a short poll reads no clock at all. The
timeouts keep their length (plus a few microseconds), use the
monotonic clock instead of the wall clock, and still work with
interrupts disabled, which jiffies would not. cviGetSysTime and
vdi_timeval_t had no other users and are removed.
---
  interdrv/cvi_vc_drv/vcodec/vdi/linux/vdi.c | 76 ++++++++--------------
  1 file changed, 28 insertions(+), 48 deletions(-)

diff --git a/interdrv/cvi_vc_drv/vcodec/vdi/linux/vdi.c b/interdrv/cvi_vc_drv/vcodec/vdi/linux/vdi.c
index 1743517..0cdcdcb 100644
--- a/interdrv/cvi_vc_drv/vcodec/vdi/linux/vdi.c
+++ b/interdrv/cvi_vc_drv/vcodec/vdi/linux/vdi.c
@@ -15,6 +15,7 @@
 #define MMAP mmap
 #endif
 
+#include <linux/timekeeping.h>
 #include <linux/time.h>
 #include <linux/moduleparam.h>
 #include <linux/dma-buf.h>
@@ -120,32 +121,30 @@ typedef struct {
 
 } vdi_info_t;
 
-typedef struct {
-	unsigned long tv_sec;
-	unsigned long tv_usec;
-} vdi_timeval_t;
+/*
+ * Poll timeouts. Most register polls end after a few reads, and reading the
+ * clocksource on every turn (as the vendor code did) cost more than the
+ * poll. The clock is read only every 64 turns, starting the deadline at the
+ * first read; the delay that adds to a timeout is a few microseconds.
+ * ktime_get_ns() also works with interrupts disabled, unlike jiffies.
+ */
+struct vdi_poll_deadline {
+	u64 end_ns;
+	unsigned int turns;
+};
 
-static void cviGetSysTime(vdi_timeval_t *pstTimeval)
+static bool vdi_poll_expired(struct vdi_poll_deadline *d, int timeout_ms)
 {
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0))
-	struct timespec64 ts = {0};
-#else
-	struct timeval tv = {0};
-#endif
-
-	if (!pstTimeval)
-		return;
+	u64 now;
 
-	memset(pstTimeval, 0, sizeof(vdi_timeval_t));
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0))
-	ktime_get_real_ts64(&ts);
-	pstTimeval->tv_sec = ts.tv_sec;
-	pstTimeval->tv_usec = ts.tv_nsec/1000;
-#else
-		do_gettimeofday(&tv);
-		pstTimeval->tv_sec = tv.tv_sec;
-		pstTimeval->tv_usec = tv.tv_usec;
-#endif
+	if (timeout_ms <= 0 || (++d->turns & 63))
+		return false;
+	now = ktime_get_ns();
+	if (!d->end_ns) {
+		d->end_ns = now + (u64)timeout_ms * NSEC_PER_MSEC;
+		return false;
+	}
+	return now > d->end_ns;
 }
 
 vdi_info_t *s_vdi_info[MAX_NUM_VPU_CORE] = { 0 };
@@ -2232,15 +2231,11 @@ int vdi_get_clock_gate(unsigned long core_idx)
 int vdi_wait_bus_busy(unsigned long core_idx, int timeout,
 		      unsigned int gdi_busy_flag)
 {
-	Int64 elapse, cur;
-	vdi_timeval_t tv;
+	struct vdi_poll_deadline deadline = { 0 };
 	vdi_info_t *vdi;
 
 	vdi = s_vdi_info[core_idx];
 
-	cviGetSysTime(&tv);
-	elapse = tv.tv_sec * 1000 + tv.tv_usec / 1000;
-
 	while (1) {
 		if (vdi->product_code == WAVE420L_CODE) {
 			if (vdi_fio_read_register(core_idx, gdi_busy_flag) ==
@@ -2265,10 +2260,7 @@ int vdi_wait_bus_busy(unsigned long core_idx, int timeout,
 		}
 
 		if (timeout > 0) {
-			cviGetSysTime(&tv);
-			cur = tv.tv_sec * 1000 + tv.tv_usec / 1000;
-
-			if ((cur - elapse) > timeout) {
+			if (vdi_poll_expired(&deadline, timeout)) {
 				CVI_VC_ERR(
 					"[VDI] vdi_wait_bus_busy timeout, PC=0x%x\n",
 					vdi_read_register(core_idx, 0x018));
@@ -2287,14 +2279,10 @@ MODULE_PARM_DESC(busy_poll_sleep_us, "VPU busy poll delay in us, 0=spin, capped
 int vdi_wait_vpu_busy(unsigned long core_idx, int timeout,
 		      unsigned int addr_bit_busy_flag)
 {
-	Int64 elapse, cur;
-	vdi_timeval_t tv;
+	struct vdi_poll_deadline deadline = { 0 };
 	Uint32 pc;
 	Uint32 code, normalReg = TRUE;
 
-	cviGetSysTime(&tv);
-	elapse = tv.tv_sec * 1000 + tv.tv_usec / 1000;
-
 	code = vdi_read_register(core_idx, VPU_PRODUCT_CODE_REGISTER);
 	/* read product code */
 	if (PRODUCT_CODE_W_SERIES(code)) {
@@ -2325,10 +2313,7 @@ int vdi_wait_vpu_busy(unsigned long core_idx, int timeout,
 		}
 
 		if (timeout > 0) {
-			cviGetSysTime(&tv);
-			cur = tv.tv_sec * 1000 + tv.tv_usec / 1000;
-
-			if ((cur - elapse) > timeout) {
+			if (vdi_poll_expired(&deadline, timeout)) {
 				Uint32 index;
 				for (index = 0; index < 50; index++) {
 					CVI_VC_ERR("[VDI] timeout, PC=0x%x\n",
@@ -2369,10 +2354,9 @@ int vdi_wait_interrupt(unsigned long coreIdx, int timeout,
 				 ((long int)intr_info.intr_tv_nsec / 1000);
 	}
 #else
-	vdi_timeval_t tv;
+	struct vdi_poll_deadline deadline = { 0 };
 	Uint32 intrStatusReg;
 	Uint32 pc;
-	Int32 startTime, endTime, elaspedTime;
 
 	UNREFERENCED_PARAMETER(intr_info);
 
@@ -2387,8 +2371,6 @@ int vdi_wait_interrupt(unsigned long coreIdx, int timeout,
 		return -1;
 	}
 
-	cviGetSysTime(&tv);
-	startTime = tv.tv_sec * 1000 + tv.tv_usec / 1000;
 	while (TRUE) {
 		if (vdi_read_register(coreIdx, intrStatusReg)) {
 			intr_reason =
@@ -2397,9 +2379,7 @@ int vdi_wait_interrupt(unsigned long coreIdx, int timeout,
 				break;
 		}
 
-		cviGetSysTime(&tv);
-		endTime = tv.tv_sec * 1000 + tv.tv_usec / 1000;
-		if (timeout > 0 && (endTime - startTime) >= timeout) {
+		if (vdi_poll_expired(&deadline, timeout)) {
 			return -1;
 		}
 	}
