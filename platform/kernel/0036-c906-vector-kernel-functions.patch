diff --git a/arch/riscv/include/asm/xtheadvector_kernel.h b/arch/riscv/include/asm/xtheadvector_kernel.h
new file mode 100644
index 000000000..f36450b19
--- /dev/null
+++ b/arch/riscv/include/asm/xtheadvector_kernel.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_RISCV_XTHEADVECTOR_KERNEL_H
+#define _ASM_RISCV_XTHEADVECTOR_KERNEL_H
+
+#include <linux/types.h>
+#include <asm/simd.h>
+#include <asm/vector.h>
+
+/*
+ * Common gate for the optional legacy RVV 0.7.1 (xtheadvector) kernel
+ * backends: the request must be large enough to pay for the vector context,
+ * the core must implement xtheadvector with VLEN >= 128, and SIMD must be
+ * usable in the current context. Callers bracket the vector code with
+ * kernel_vector_begin()/kernel_vector_end() and keep their scalar path.
+ */
+static __always_inline bool xtheadvector_kernel_usable(size_t len, size_t threshold)
+{
+	return len >= threshold && has_xtheadvector() &&
+	       riscv_vector_vlen() >= 128 && may_use_simd();
+}
+
+#endif /* _ASM_RISCV_XTHEADVECTOR_KERNEL_H */
