pkgname=nanokvm-release
pkgver=${PKGVER:-0.1.0}
pkgrel=0
pkgdesc="Tested NanoKVM Alpine package set"
url="https://github.com/sipeed/NanoKVM"
arch="riscv64"
license="GPL-3.0-only"
depends="alpine-base busybox-extras tzdata busybox-openrc !openvpn3 !openssl4-libs avahi avahi-openrc bash chrony chrony-openrc curl dbus dbus-openrc dnsmasq iproute2-tc nftables openresolv util-linux wireguard-tools ca-certificates coreutils eudev nanokvm-exfatprogs f2fs-tools hostapd nanokvm-i2c-tools iproute2 iw kmod libgcc libstdc++ openssh openssl util-linux-misc wpa_supplicant xz zstd nanokvm-keys>=${V_nanokvm_keys:-$pkgver}-r0 nanokvm-base>=${V_nanokvm_base:-$pkgver}-r0 nanokvm-kernel-sg2002>=${V_nanokvm_kernel_sg2002:-$pkgver}-r0 nanokvm-kmod-sg2002>=${V_nanokvm_kmod_sg2002:-$pkgver}-r0 nanokvm-firmware-sg2002>=${V_nanokvm_firmware_sg2002:-$pkgver}-r0 nanokvm-bootloader-sg2002>=${V_nanokvm_bootloader_sg2002:-$pkgver}-r0 nanokvm-app>=${V_nanokvm_app:-$pkgver}-r0 nanokvm-zlib>=${V_nanokvm_zlib:-$pkgver}-r0"
source="$pkgname-$pkgver.tar.gz"
# /kvmapp/version moved here from nanokvm (3.3.0).
replaces="nanokvm"
options="!check !strip !tracedeps"

build() {
	:
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/"
}

sha256sums=""
