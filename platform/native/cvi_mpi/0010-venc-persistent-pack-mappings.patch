+		vencUnmapWindows(&stChnMap[VeChn]);
 	}
 
 	u32ChannelCreatedCnt -= 1;
@@ -234,14 +401,29 @@ CVI_S32 CVI_VENC_GetStream(VENC_CHN VeChn, VENC_STREAM_S *pstStream, CVI_S32 S32
 		s32Ret = ioctl(s32VencFd[VeChn], CVI_VC_VENC_GET_STREAM, pstStreamEx);
 
 		if (s32Ret == CVI_SUCCESS) {
