# embed_scripts.cmake -DSRC=<server-cpp/data/network-scripts> -DOUT=<header>: the udhcpc hooks and the IPv6 boot script
# the network family installs and runs, as string literals (network/scripts.cpp), byte for byte the files the Go
# server embeds.
set(out "// Generated by network/embed_scripts.cmake from server-cpp/data/network-scripts.\n#pragma once\n\n")
string(APPEND out "#include <string_view>\n\nnamespace nkos::network::embedded {\n\n")
foreach(pair "dns_hook=99-nanokvm-dns" "gateway_hook=99-nanokvm-gateway" "wifi_source_hook=98-nanokvm-wifi-source"
             "ipv6_boot_script=S02ipv6")
	string(REPLACE "=" ";" parts "${pair}")
	list(GET parts 0 name)
	list(GET parts 1 file)
	file(READ "${SRC}/${file}" content)
	string(APPEND out "inline constexpr std::string_view ${name} = R\"nkosscript(${content})nkosscript\";\n\n")
endforeach()
string(APPEND out "} // namespace nkos::network::embedded\n")
file(WRITE "${OUT}" "${out}")
